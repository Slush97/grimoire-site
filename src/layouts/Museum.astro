---
/*
 * Museum.astro
 * Minimal HTML shell for the era-museum page. Holds no chrome of its
 * own; every stage component paints its own world. Fonts for all six
 * eras are requested here so we only emit one stylesheet link.
 */
import '../styles/museum.css';
import Neko from '../components/Neko.astro';
import EraSwitcher from '../components/EraSwitcher.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Grimoire',
  description = 'Mod manager for Deadlock. Browse and install mods from GameBanana, manage your library, swap profiles.',
  ogImage = '/og.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />

    <!--
      Pre-paint era restore. Must run before first paint (inline, in
      head) so the saved channel shows with no flash of the default era.
      Keep the id list in sync with src/data/eras.ts.
    -->
    <script is:inline>
      (function () {
        var era = null;
        try { era = localStorage.getItem('grimoire.era'); } catch (e) {}
        var ok = ['terminal', 'win95', 'geocities', 'aero', 'fugazi', 'grimoire'];
        document.documentElement.dataset.era = ok.indexOf(era) >= 0 ? era : 'geocities';
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=IM+Fell+English:ital@0;1&family=IM+Fell+English+SC&family=UnifrakturMaguntia&family=Comic+Neue:wght@400;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Grimoire" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <a href="#museum-main" class="museum-skip">Skip to content</a>
    <main id="museum-main">
      <slot />
    </main>
    <EraSwitcher />
    <Neko />
  </body>
</html>

---
/*
 * Museum.astro
 * Minimal HTML shell for the era-museum page. Holds no chrome of its
 * own; every stage component paints its own world. Fonts for all five
 * eras are requested here so we only emit one stylesheet link.
 */
import '../styles/museum.css';
import Neko from '../components/Neko.astro';
import EraSwitcher from '../components/EraSwitcher.astro';
import Lightbox from '../components/Lightbox.astro';
import SeoJsonLd from '../components/SeoJsonLd.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Grimoire: a Free Deadlock Mod Manager',
  description = 'Grimoire is a free, open-source Deadlock mod manager. Browse and one-click install mods from GameBanana, manage your library, run a Hero Locker, and swap mod profiles.',
  ogImage = '/og.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />

    <!--
      Pre-paint era restore. Must run before first paint (inline, in
      head) so the saved channel shows with no flash of the default era.
      Keep the id list in sync with src/data/eras.ts.

      It also starts the display face for the restored era. Only two eras
      have one (the rest dress in system faces), and the map is allowed to
      drift without breaking anything: a wrong entry costs one unused
      preload, never a broken page. JetBrains Mono is preloaded in the
      markup below instead, since every era's chrome uses it.
    -->
    <script is:inline>
      (function () {
        var era = null;
        try { era = localStorage.getItem('grimoire.era'); } catch (e) {}
        var ok = ['terminal', 'win95', 'geocities', 'aero', 'fugazi'];
        era = ok.indexOf(era) >= 0 ? era : 'geocities';
        document.documentElement.dataset.era = era;

        var face = { geocities: 'comic-neue-400-normal-latin', fugazi: 'inter-400-700-normal-latin' }[era];
        if (face) {
          var l = document.createElement('link');
          l.rel = 'preload';
          l.as = 'font';
          l.type = 'font/woff2';
          l.crossOrigin = 'anonymous';
          l.href = '/fonts/' + face + '.woff2';
          document.head.appendChild(l);
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <!--
      Faces are self-hosted and declared in src/styles/fonts.css, which
      Vite inlines into the page's stylesheet: no third-party origin, no
      extra request. JetBrains Mono is the one face every era needs (the
      TIME MACHINE remote is mounted on every page), so it starts here
      rather than waiting for the CSS to parse.
    -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/jetbrains-mono-400-700-normal-latin.woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Grimoire" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <SeoJsonLd />
  </head>
  <body>
    <a href="#museum-main" class="museum-skip">Skip to content</a>
    <!--
      Stable crawlable heading. The five era stages each render their own
      costume <h1> (and only one stage is shown at a time), but none of
      them say "Deadlock mod manager" in plain text. This sr-only line is
      always in the DOM, era-independent, and states the entity in the
      words people actually search for. Visually hidden, not display:none,
      so it stays crawlable.
    -->
    <h1 class="museum-seo-h1">Grimoire: a free, open-source Deadlock mod manager</h1>
    <main id="museum-main">
      <slot />
    </main>
    <EraSwitcher />
    <Neko />
    <Lightbox />
  </body>
</html>

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Grimoire',
  description = 'Mod manager for Deadlock. Browse and install mods from GameBanana, manage your library, swap profiles, and more.',
  ogImage = '/og.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const githubUrl = 'https://github.com/Slush97/grimoire';
const discordUrl = 'https://discord.gg/KgYGHEMq2P';
const gameBananaUrl = 'https://gamebanana.com/tools/22583';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (p: string) => path === p;

// Brand SVG paths (Simple Icons, MIT).
const ICON_GITHUB =
  'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12';
const ICON_DISCORD =
  'M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z';
// Hand-built banana glyph — no official Simple Icon exists for GameBanana.
const ICON_GAMEBANANA =
  'M4.4 17.8c-1-1.6-1.3-3.7-.7-5.9C4.9 8 8.7 4.5 13.1 3.9c1.9-.3 3.7.1 4.9 1 .6.4.7 1.2.2 1.7-.9.9-2 2.1-3 3.6-1.8 2.7-3.1 5.3-5.4 7-1.2.9-2.5 1.3-3.6 1.3-.7 0-1.3-.2-1.8-.7zm13.4-13.2c.7-.7 1.7-1 2.5-.8.7.2.9.9.5 1.5-.4.6-1.2 1-2 1-.6 0-1.2-.2-1.5-.6-.3-.4-.1-.8.5-1.1z';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&family=IM+Fell+English:ital@0;1&family=IM+Fell+English+SC&family=UnifrakturMaguntia&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Grimoire" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="antialiased">
    <a href="#main" class="skip-link">Skip to content</a>

    <svg class="svg-defs" aria-hidden="true" focusable="false">
      <defs>
        <filter id="rough" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="3" />
          <feDisplacementMap in="SourceGraphic" scale="2" />
        </filter>
        <filter id="rough-strong" x="-8%" y="-8%" width="116%" height="116%">
          <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="2" seed="7" />
          <feDisplacementMap in="SourceGraphic" scale="3.5" />
        </filter>
      </defs>
    </svg>

    <span class="ghost-sigil" aria-hidden="true">
      <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="100" cy="100" r="88" />
        <circle cx="100" cy="100" r="62" />
        <circle cx="100" cy="100" r="6" />
        <g>
          <line x1="100" y1="100" x2="100" y2="12" />
          <line x1="100" y1="100" x2="162" y2="38" />
          <line x1="100" y1="100" x2="188" y2="100" />
          <line x1="100" y1="100" x2="162" y2="162" />
          <line x1="100" y1="100" x2="100" y2="188" />
          <line x1="100" y1="100" x2="38" y2="162" />
          <line x1="100" y1="100" x2="12" y2="100" />
          <line x1="100" y1="100" x2="38" y2="38" />
          <path d="M 94 20 L 100 12 L 106 20" />
          <path d="M 156 32 L 162 38 L 156 44" />
          <path d="M 180 94 L 188 100 L 180 106" />
          <path d="M 156 156 L 162 162 L 156 168" />
          <path d="M 94 180 L 100 188 L 106 180" />
          <path d="M 44 156 L 38 162 L 44 168" />
          <path d="M 20 94 L 12 100 L 20 106" />
          <path d="M 44 32 L 38 38 L 44 44" />
        </g>
        <path d="M 70 70 Q 100 56 130 70 Q 150 86 130 110 Q 100 124 70 110 Q 50 86 70 70 Z" opacity="0.6" />
      </svg>
    </span>

    <header class="folio-bar">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3">
        <a href="/" class="folio-wordmark" aria-label="Grimoire, home">
          <img src="/logo.png" alt="" width="20" height="20" class="h-5 w-5 opacity-90" />
          <span>Liber Grimoire</span>
          <span class="vol hidden sm:inline">vol i · mmxxvi</span>
        </a>
        <nav class="folio-nav" aria-label="Primary">
          <a
            href="/#features"
            class="hidden sm:inline"
            aria-current={isActive('/') ? 'page' : undefined}
          >Features</a>
          <span class="sep hidden sm:inline" aria-hidden="true">✦</span>
          <a
            href="/download"
            aria-current={isActive('/download') ? 'page' : undefined}
          >Download</a>
          <span class="sep hidden sm:inline" aria-hidden="true">✦</span>
          <a href={githubUrl} target="_blank" rel="noopener" class="hidden sm:inline">GitHub</a>
          <span class="sep hidden md:inline" aria-hidden="true">✦</span>
          <a href={discordUrl} target="_blank" rel="noopener" class="hidden md:inline">Discord</a>
          <a href="/download" class="folio-cta ml-2">Conjure</a>
        </nav>
      </div>
    </header>

    <div id="main">
      <slot />
    </div>

    <footer class="relative z-10 mt-12 border-t border-border">
      <div class="mx-auto max-w-6xl px-6 pt-10 pb-12">
        <div class="webring">
          <div class="webring-title">The Dark Codex</div>
          <div class="webring-sub">A ring of obscure tools</div>
          <div class="webring-rail">
            <a href={githubUrl} target="_blank" rel="noopener" class="webring-link">
              <svg class="webring-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={ICON_GITHUB} />
              </svg>
              <span class="webring-link-label">Slush97/grimoire</span>
            </a>
            <span class="sep" aria-hidden="true">✦</span>
            <a href={gameBananaUrl} target="_blank" rel="noopener" class="webring-link">
              <svg class="webring-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={ICON_GAMEBANANA} />
              </svg>
              <span class="webring-link-label">gamebanana/22583</span>
            </a>
            <span class="sep" aria-hidden="true">✦</span>
            <a href={discordUrl} target="_blank" rel="noopener" class="webring-link">
              <svg class="webring-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={ICON_DISCORD} />
              </svg>
              <span class="webring-link-label">discord.gg/KgYGHEMq2P</span>
            </a>
          </div>
        </div>

        <div class="mt-8 flex flex-col items-start justify-between gap-5 text-sm text-muted sm:flex-row sm:items-center">
          <span class="stat-panel">
            <span>Souls bound</span>
            <span class="led-counter" aria-label="visitor counter, decorative">
              <span>0</span><span>0</span><span>1</span><span>3</span><span>3</span><span>7</span>
            </span>
          </span>
          <div class="flex items-center gap-2.5">
            <img src="/logo.png" alt="" width="20" height="20" class="h-5 w-5 opacity-80" />
            <span>
              Built by <a href={githubUrl} target="_blank" rel="noopener" class="text-white hover:text-accent">Slush</a>. MIT. Not affiliated with Valve.
            </span>
          </div>
        </div>
      </div>
    </footer>

  </body>
</html>

---
type DoodleName =
  | 'pentagram'
  | 'chaos-star'
  | 'sigil'
  | 'sigil-alt'
  | 'ouroboros'
  | 'snake'
  | 'eye'
  | 'third-eye'
  | 'moon'
  | 'skull'
  | 'candle'
  | 'book'
  | 'crystal'
  | 'sparkle'
  | 'hand'
  | 'mushroom';

interface Props {
  name: DoodleName;
  size?: number;
  rotate?: number;
  opacity?: number;
  top?: string;
  left?: string;
  right?: string;
  bottom?: string;
  color?: string;
  rough?: boolean;
  strokeWidth?: number;
  spin?: boolean;
  class?: string;
}

const {
  name,
  size = 80,
  rotate = 0,
  opacity = 0.22,
  top,
  left,
  right,
  bottom,
  color,
  rough = true,
  strokeWidth = 2.2,
  spin = false,
  class: classProp = '',
} = Astro.props;

const styleParts = [
  top !== undefined && `top:${top}`,
  left !== undefined && `left:${left}`,
  right !== undefined && `right:${right}`,
  bottom !== undefined && `bottom:${bottom}`,
  `width:${size}px`,
  `height:${size}px`,
  `transform:rotate(${rotate}deg)`,
  `opacity:${opacity}`,
  color && `color:${color}`,
].filter(Boolean);
const style = styleParts.join(';');
---
<span class={`doodle ${classProp}`} style={style} aria-hidden="true">
  <svg
    viewBox="0 0 100 100"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    filter={rough ? 'url(#rough)' : undefined}
    class={spin ? 'spin-slow' : undefined}
  >
    {name === 'pentagram' && (
      <>
        <circle cx="50" cy="50" r="42" />
        <path d="M 50 12 L 73 80 L 13 38 L 87 38 L 27 80 Z" />
      </>
    )}
    {name === 'chaos-star' && (
      <>
        <circle cx="50" cy="50" r="6" />
        <line x1="50" y1="50" x2="50" y2="10" />
        <line x1="50" y1="50" x2="78" y2="22" />
        <line x1="50" y1="50" x2="90" y2="50" />
        <line x1="50" y1="50" x2="78" y2="78" />
        <line x1="50" y1="50" x2="50" y2="90" />
        <line x1="50" y1="50" x2="22" y2="78" />
        <line x1="50" y1="50" x2="10" y2="50" />
        <line x1="50" y1="50" x2="22" y2="22" />
        <path d="M 46 16 L 50 10 L 54 16" />
        <path d="M 73 19 L 78 22 L 75 27" />
        <path d="M 84 46 L 90 50 L 84 54" />
        <path d="M 75 73 L 78 78 L 73 81" />
        <path d="M 46 84 L 50 90 L 54 84" />
        <path d="M 25 81 L 22 78 L 27 73" />
        <path d="M 16 46 L 10 50 L 16 54" />
        <path d="M 27 27 L 22 22 L 25 19" />
      </>
    )}
    {name === 'sigil' && (
      <>
        <path d="M 22 28 C 30 18 44 22 42 36 C 40 50 24 48 28 64 C 32 76 56 76 60 64 C 64 50 50 44 56 30 C 60 20 76 22 76 38" />
        <circle cx="22" cy="28" r="2.5" fill="currentColor" stroke="none" />
        <line x1="76" y1="38" x2="76" y2="48" />
        <line x1="72" y1="44" x2="80" y2="44" />
        <line x1="40" y1="70" x2="48" y2="78" />
        <line x1="48" y1="70" x2="40" y2="78" />
      </>
    )}
    {name === 'sigil-alt' && (
      <>
        <circle cx="50" cy="50" r="38" />
        <path d="M 50 14 L 50 60" />
        <path d="M 32 38 L 68 38" />
        <path d="M 50 60 L 36 80" />
        <path d="M 50 60 L 64 80" />
        <circle cx="50" cy="14" r="2.5" fill="currentColor" stroke="none" />
        <circle cx="32" cy="38" r="2" fill="currentColor" stroke="none" />
        <circle cx="68" cy="38" r="2" fill="currentColor" stroke="none" />
      </>
    )}
    {name === 'ouroboros' && (
      <>
        <path d="M 78 44 A 34 34 0 1 1 60 18" />
        <path d="M 60 18 L 76 14 L 78 30 L 72 26 Z" fill="currentColor" stroke="none" />
        <path d="M 78 44 L 72 50 L 80 56 L 88 50 Z" />
        <circle cx="80" cy="50" r="1.5" fill="currentColor" stroke="none" />
        <path d="M 26 60 L 30 64" />
        <path d="M 22 50 L 26 54" />
        <path d="M 24 36 L 28 40" />
        <path d="M 32 26 L 36 30" />
      </>
    )}
    {name === 'snake' && (
      <>
        <path d="M 14 78 Q 30 60 50 70 Q 70 80 80 60 Q 86 44 70 38 Q 56 34 60 22" />
        <path d="M 60 22 L 56 18 L 64 18 Z" fill="currentColor" stroke="none" />
        <path d="M 60 22 L 54 14" />
        <path d="M 60 22 L 66 14" />
        <circle cx="58" cy="20" r="0.8" fill="currentColor" stroke="none" />
      </>
    )}
    {name === 'eye' && (
      <>
        <path d="M 12 50 Q 50 16 88 50 Q 50 84 12 50 Z" />
        <circle cx="50" cy="50" r="13" />
        <circle cx="50" cy="50" r="5" fill="currentColor" stroke="none" />
        <line x1="50" y1="22" x2="50" y2="14" />
        <line x1="32" y1="28" x2="26" y2="22" />
        <line x1="68" y1="28" x2="74" y2="22" />
        <line x1="20" y1="46" x2="12" y2="44" />
        <line x1="80" y1="46" x2="88" y2="44" />
      </>
    )}
    {name === 'third-eye' && (
      <>
        <path d="M 22 50 Q 50 24 78 50 Q 50 76 22 50 Z" />
        <circle cx="50" cy="50" r="12" />
        <circle cx="50" cy="50" r="5" fill="currentColor" stroke="none" />
        <line x1="50" y1="18" x2="50" y2="6" />
        <line x1="50" y1="82" x2="50" y2="94" />
        <line x1="18" y1="50" x2="6" y2="50" />
        <line x1="82" y1="50" x2="94" y2="50" />
        <line x1="28" y1="28" x2="20" y2="20" />
        <line x1="72" y1="28" x2="80" y2="20" />
        <line x1="28" y1="72" x2="20" y2="80" />
        <line x1="72" y1="72" x2="80" y2="80" />
      </>
    )}
    {name === 'moon' && (
      <>
        <path d="M 66 12 A 38 38 0 1 0 66 88 A 30 30 0 1 1 66 12 Z" />
        <path d="M 52 40 Q 56 36 60 40" />
        <path d="M 48 56 Q 56 64 64 58" />
      </>
    )}
    {name === 'skull' && (
      <>
        <path d="M 18 50 Q 18 16 50 16 Q 82 16 82 50 L 82 66 L 72 66 L 72 80 L 28 80 L 28 66 L 18 66 Z" />
        <path d="M 38 18 Q 44 22 50 30 Q 56 22 62 18" />
        <circle cx="38" cy="48" r="7" fill="currentColor" stroke="none" />
        <circle cx="62" cy="48" r="7" fill="currentColor" stroke="none" />
        <path d="M 47 60 L 50 68 L 53 60 Z" fill="currentColor" stroke="none" />
        <line x1="40" y1="72" x2="40" y2="80" />
        <line x1="50" y1="72" x2="50" y2="80" />
        <line x1="60" y1="72" x2="60" y2="80" />
      </>
    )}
    {name === 'candle' && (
      <>
        <path d="M 50 8 Q 40 18 44 28 Q 48 32 50 30 Q 52 32 56 28 Q 60 18 50 8 Z" />
        <line x1="50" y1="30" x2="50" y2="38" />
        <rect x="34" y="38" width="32" height="42" rx="2" />
        <path d="M 34 58 Q 30 64 32 70" />
        <path d="M 66 50 Q 70 56 68 64" />
        <path d="M 26 80 L 74 80 L 70 90 L 30 90 Z" />
      </>
    )}
    {name === 'book' && (
      <>
        <line x1="50" y1="22" x2="50" y2="84" />
        <path d="M 50 22 L 12 28 L 12 80 L 50 84 Z" />
        <path d="M 50 22 L 88 28 L 88 80 L 50 84 Z" />
        <line x1="20" y1="38" x2="42" y2="38" />
        <line x1="20" y1="46" x2="42" y2="46" />
        <line x1="20" y1="54" x2="38" y2="54" />
        <line x1="58" y1="38" x2="80" y2="38" />
        <line x1="58" y1="46" x2="80" y2="46" />
        <line x1="58" y1="54" x2="76" y2="54" />
        <path d="M 68 64 L 70 70 L 76 70 L 71 73 L 73 79 L 68 75 L 63 79 L 65 73 L 60 70 L 66 70 Z" fill="currentColor" stroke="none" />
      </>
    )}
    {name === 'crystal' && (
      <>
        <circle cx="50" cy="42" r="26" />
        <path d="M 38 32 Q 32 36 32 46" />
        <path d="M 30 64 L 70 64 L 66 76 L 34 76 Z" />
        <line x1="24" y1="80" x2="76" y2="80" />
      </>
    )}
    {name === 'sparkle' && (
      <>
        <path d="M 50 14 Q 52 38 50 50 Q 48 38 50 14 Z" fill="currentColor" stroke="none" />
        <path d="M 50 86 Q 48 62 50 50 Q 52 62 50 86 Z" fill="currentColor" stroke="none" />
        <path d="M 14 50 Q 38 48 50 50 Q 38 52 14 50 Z" fill="currentColor" stroke="none" />
        <path d="M 86 50 Q 62 52 50 50 Q 62 48 86 50 Z" fill="currentColor" stroke="none" />
        <circle cx="50" cy="50" r="2.5" fill="currentColor" stroke="none" />
      </>
    )}
    {name === 'hand' && (
      <>
        <path d="M 32 88 Q 28 70 28 56 L 28 46 Q 30 40 36 42 L 36 22 Q 38 16 44 18 L 44 42 L 48 42 L 48 12 Q 50 8 54 10 L 54 42 L 58 42 L 58 16 Q 60 12 64 14 L 64 42 L 68 42 L 68 30 Q 70 24 74 26 L 74 56 Q 74 76 64 86 Q 56 92 50 88 Z" />
        <ellipse cx="50" cy="60" rx="11" ry="7" />
        <circle cx="50" cy="60" r="3" fill="currentColor" stroke="none" />
        <path d="M 50 53 L 50 49" />
        <path d="M 50 67 L 50 71" />
      </>
    )}
    {name === 'mushroom' && (
      <>
        <path d="M 16 48 Q 16 20 50 20 Q 84 20 84 48 Z" />
        <line x1="16" y1="48" x2="84" y2="48" />
        <circle cx="36" cy="34" r="3.5" fill="currentColor" stroke="none" />
        <circle cx="60" cy="30" r="2.5" fill="currentColor" stroke="none" />
        <circle cx="68" cy="40" r="3" fill="currentColor" stroke="none" />
        <path d="M 40 48 Q 40 80 50 88 Q 60 80 60 48" />
      </>
    )}
  </svg>
</span>

---
/*
 * Lightbox.astro
 * Shared screenshot overlay for the era museum. Mounted once by the
 * Museum layout, like the EraSwitcher: chrome that belongs to the TV,
 * not to any one channel. Intercepts left-clicks on full-size
 * screenshot links (a[href^="/screenshots/"][href$=".png"]) in
 * whichever stage is on screen and opens them in a modal <dialog>
 * with prev/next paging instead of a new tab. The stage links keep
 * target="_blank" so no-JS visitors still get the PNG.
 *
 * Navigation: side buttons, ArrowLeft/ArrowRight, clicking the image
 * advances, Escape closes (native dialog), backdrop click closes.
 * Zapping channels while open closes it (era:change).
 */
---

<dialog class="lightbox" id="shot-lightbox" aria-label="Screenshot viewer">
  <figure>
    <img alt="" />
    <figcaption>
      <span class="lb-caption"></span>
      <span class="lb-counter"></span>
    </figcaption>
  </figure>
  <button class="lb-btn lb-prev" type="button" aria-label="Previous screenshot">&#x2039;</button>
  <button class="lb-btn lb-next" type="button" aria-label="Next screenshot" autofocus>&#x203a;</button>
  <button class="lb-btn lb-close" type="button" aria-label="Close">&#x2715;</button>
</dialog>

<style>
  dialog.lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(6, 6, 6, 0.93);
    color: #fff;
    z-index: 2147483000;
  }
  dialog.lightbox:not([open]) {
    display: none;
  }
  dialog.lightbox::backdrop {
    background: transparent;
  }

  figure {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 2.5rem 4.5rem;
    box-sizing: border-box;
  }
  figure img {
    max-width: 100%;
    max-height: calc(100vh - 8rem);
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 12px 60px rgba(0, 0, 0, 0.8);
    cursor: pointer;
  }
  figure img:not([src]) {
    display: none;
  }
  figcaption {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: #d4d4d8;
    text-align: center;
  }
  .lb-counter {
    color: #71717a;
    white-space: nowrap;
  }

  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    background: rgba(20, 20, 20, 0.65);
    color: #e4e4e7;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .lb-btn:hover {
    background: rgba(50, 50, 50, 0.85);
    border-color: rgba(255, 255, 255, 0.4);
  }
  .lb-btn:focus-visible {
    outline: 2px solid #f97316;
    outline-offset: 2px;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.9rem;
    padding-bottom: 0.2rem;
  }
  .lb-prev { left: 0.9rem; }
  .lb-next { right: 0.9rem; }
  .lb-close {
    top: 0.9rem;
    right: 0.9rem;
    font-size: 1rem;
  }

  @media (max-width: 640px) {
    figure {
      padding: 1rem 0.75rem 4.5rem;
    }
    figure img {
      max-height: calc(100vh - 9rem);
    }
    /* Thumb-reach row along the bottom instead of overlapping the shot */
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 0.9rem;
      transform: none;
    }
    .lb-prev { left: 25%; }
    .lb-next { right: 25%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    dialog.lightbox[open] {
      animation: lb-fade 0.18s ease;
    }
    @keyframes lb-fade {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  }
</style>

<script>
  const dlg = document.getElementById('shot-lightbox') as HTMLDialogElement | null;

  if (dlg && typeof dlg.showModal === 'function') {
    const img = dlg.querySelector('img')!;
    const caption = dlg.querySelector('.lb-caption')!;
    const counter = dlg.querySelector('.lb-counter')!;
    const prevBtn = dlg.querySelector('.lb-prev')!;
    const nextBtn = dlg.querySelector('.lb-next')!;
    const closeBtn = dlg.querySelector('.lb-close')!;

    let shots: { href: string; alt: string }[] = [];
    let idx = 0;

    const isShotLink = (a: HTMLAnchorElement) => {
      const href = a.getAttribute('href') || '';
      return href.startsWith('/screenshots/') && href.endsWith('.png');
    };

    function show() {
      const s = shots[idx];
      img.src = s.href;
      img.alt = s.alt;
      caption.textContent = s.alt;
      counter.textContent = `${idx + 1} / ${shots.length}`;
      // Warm the cache for the neighbors so paging feels instant
      const n = shots.length;
      for (const i of [(idx + 1) % n, (idx - 1 + n) % n]) {
        if (i !== idx) new Image().src = shots[i].href;
      }
    }

    function step(delta: number) {
      const n = shots.length;
      if (!n) return;
      idx = (idx + delta + n) % n;
      show();
    }

    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element).closest?.('a') as HTMLAnchorElement | null;
      if (!a || !isShotLink(a)) return;

      // Only the active stage's gallery is rendered; visibility check
      // keeps the five hidden stages out of the paging group.
      const visible = (
        [...document.querySelectorAll('a[href^="/screenshots/"]')] as HTMLAnchorElement[]
      ).filter((el) => isShotLink(el) && el.getClientRects().length > 0);
      const i = visible.indexOf(a);
      if (i < 0) return;

      e.preventDefault();
      shots = visible.map((el) => ({
        href: el.getAttribute('href')!,
        alt: el.querySelector('img')?.alt || '',
      }));
      idx = i;
      show();
      dlg.showModal();
      document.documentElement.classList.add('lb-open');
    });

    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));
    img.addEventListener('click', () => step(1));
    closeBtn.addEventListener('click', () => dlg.close());

    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    });

    // Backdrop close: a click that lands on the dialog or figure itself
    // (not the image, caption, or buttons) dismisses.
    dlg.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t === dlg || t.tagName === 'FIGURE') dlg.close();
    });

    dlg.addEventListener('close', () => {
      img.removeAttribute('src');
      document.documentElement.classList.remove('lb-open');
    });

    // Zapping the TV while the overlay is up: drop the overlay
    document.addEventListener('era:change', () => {
      if (dlg.open) dlg.close();
    });
  }
</script>

<style is:global>
  /* Native <dialog> does not lock the page behind it */
  html.lb-open,
  html.lb-open body {
    overflow: hidden;
  }
</style>

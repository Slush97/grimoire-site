---
/*
 * Stage 5 : GRIMOIRE / parchment (the product's actual brand)
 *
 * The "real" face under the costumes. Parchment-dark page, warm wash,
 * candle illustration, drifting sigils, ghost chaos-star spinning faintly
 * behind everything. Voice: mid-sincere occult zine : Liber Grimoire vol
 * i mmxxvi, bound by candlelight, the Order of Slush.
 *
 * Lifted and re-scoped from the existing parchment system in
 * src/styles/global.css. All styles are scoped to this component via
 * Astro's <style> block; no global pollution.
 */
import type { DownloadUrls } from '../../data/content';
import { features as coreFeatures, brand, fmtBytes } from '../../data/content';
const dl = Astro.props as DownloadUrls;

/*
 * Rites of binding: every shipped artifact, named in-character. The
 * platform name and asset size come from the live release; the prose
 * stays the same so the costume reads even when the release is missing.
 */
const rites = [
  { roman: 'i',   sigil: '☥', name: 'For the Windows-bound',        rite: 'The installer rite. Double-click to invoke; Setup will lead.', asset: dl.windowsInstaller, href: dl.windowsInstaller?.browser_download_url ?? dl.releaseUrl },
  { roman: 'ii',  sigil: '✶', name: 'For the unrooted Windows',     rite: 'A single binding. No registry incision, no shortcut planted.',  asset: dl.windowsPortable,  href: dl.windowsPortable?.browser_download_url  ?? dl.releaseUrl },
  { roman: 'iii', sigil: '☽', name: 'For the wandering Linux',      rite: 'A universal AppImage. Mark executable and run; needs no host.',  asset: dl.linuxAppImage,    href: dl.linuxAppImage?.browser_download_url    ?? dl.releaseUrl },
  { roman: 'iv',  sigil: '⚝', name: 'For the Debian-bound',         rite: 'Pass to apt to weave into the system, as is proper.',           asset: dl.linuxDeb,         href: dl.linuxDeb?.browser_download_url         ?? dl.releaseUrl },
  { roman: 'v',   sigil: '⚜', name: 'For the disciples of Arch',    rite: 'Conjured from the AUR: `yay -S grimoire-bin`.',                 asset: null,                href: brand.aur },
];

const occult = [
  { kicker: 'fol. v · recto',  title: 'Browse the catalog by candlelight', body: 'The full GameBanana library, transcribed and indexed locally. Sub-millisecond divination through the catalog. One-click rites via gb1click://, no folder spelunking.' },
  { kicker: 'fol. v · verso',  title: 'Bind, unbind, reorder',              body: 'Your library, ordered. Conflicts between two VPK paths revealed before the round begins. Toggle a binding off without losing it from disk.' },
  { kicker: 'fol. vi · recto', title: 'Every variant, ready to wear',       body: 'One active skin per hero, picked from every variant you have ever bound. The rest stay on disk. Switch in a single click; the closet remembers.' },
  { kicker: 'fol. vi · verso', title: 'Profiles as sigils',                 body: 'Full mod loadouts saved as short mp1: codes. Trade like talismans. Restore like spells. Or as .modprofile.json if a link feels too sketchy.' },
];

/*
 * Plates: impressions taken from the living instrument and pressed
 * between these pages. Thumbs are 880w webp in /screenshots/thumbs/;
 * each plate links out to the full-size impression in /screenshots/.
 * Engraved in sepia at rest; living colour on hover and focus.
 */
const plates = [
  { roman: 'I',   name: 'browse',    w: 880, h: 522, alt: 'Grimoire mod browser showing the GameBanana catalog for Deadlock', caption: 'Fig. I. The catalogue of workes, wherein the seeker browseth ye offerings of GameBanana.' },
  { roman: 'II',  name: 'installed', w: 880, h: 522, alt: 'The installed mods library with per-mod on and off toggles',        caption: 'Fig. II. The library of bindings, each worke toggled on or off and never struck from ye disk.' },
  { roman: 'III', name: 'locker',    w: 880, h: 522, alt: 'The Hero Locker, a per-hero skin picker',                           caption: 'Fig. III. The Hero Locker, wherein one skin per hero is chosen from all the seeker hath bound.' },
  { roman: 'IV',  name: 'variants',  w: 880, h: 550, alt: 'The mod variant picker listing the variants a mod ships with',      caption: 'Fig. IV. The chooser of variants, that a worke may wear whichever of its faces pleaseth.' },
  { roman: 'V',   name: 'conflicts', w: 880, h: 550, alt: 'VPK conflict warnings between two installed mods',                  caption: 'Fig. V. The augury of conflicts, whereby two bindings that contend for one VPK path are revealed before the round.' },
  { roman: 'VI',  name: 'profiles',  w: 880, h: 522, alt: 'Saved mod loadout profiles in Grimoire',                            caption: 'Fig. VI. Profiles of the loadout, saved whole and carried betwixt machines as sigils.' },
];

const motes = [
  { glyph: '✦', left: '6%',  size: 18, dur: '34s', delay: '-2s',  op: 0.26 },
  { glyph: '⚝', left: '16%', size: 26, dur: '46s', delay: '-12s', op: 0.18 },
  { glyph: '☉', left: '24%', size: 22, dur: '38s', delay: '-22s', op: 0.20 },
  { glyph: '✶', left: '34%', size: 16, dur: '28s', delay: '-6s',  op: 0.32 },
  { glyph: '☥', left: '46%', size: 30, dur: '52s', delay: '-30s', op: 0.16 },
  { glyph: '☽', left: '58%', size: 22, dur: '40s', delay: '-16s', op: 0.22 },
  { glyph: '✦', left: '66%', size: 18, dur: '32s', delay: '-4s',  op: 0.26 },
  { glyph: '⚜', left: '74%', size: 28, dur: '48s', delay: '-26s', op: 0.18 },
  { glyph: '✧', left: '82%', size: 14, dur: '30s', delay: '-10s', op: 0.34 },
  { glyph: '❉', left: '90%', size: 24, dur: '42s', delay: '-18s', op: 0.20 },
];
---

<section class="stage stage-grimoire" data-era="grimoire" aria-labelledby="grim-h1">
  <!-- decorative: parchment grain + warm wash overlays + ghost sigil + motes -->
  <div class="grain" aria-hidden="true"></div>
  <div class="warm-wash" aria-hidden="true"></div>
  <span class="ghost-sigil" aria-hidden="true">
    <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="100" cy="100" r="88" />
      <circle cx="100" cy="100" r="62" />
      <circle cx="100" cy="100" r="6" />
      <g>
        <line x1="100" y1="100" x2="100" y2="12" />
        <line x1="100" y1="100" x2="162" y2="38" />
        <line x1="100" y1="100" x2="188" y2="100" />
        <line x1="100" y1="100" x2="162" y2="162" />
        <line x1="100" y1="100" x2="100" y2="188" />
        <line x1="100" y1="100" x2="38" y2="162" />
        <line x1="100" y1="100" x2="12" y2="100" />
        <line x1="100" y1="100" x2="38" y2="38" />
        <path d="M 94 20 L 100 12 L 106 20" />
        <path d="M 156 32 L 162 38 L 156 44" />
        <path d="M 180 94 L 188 100 L 180 106" />
        <path d="M 156 156 L 162 162 L 156 168" />
        <path d="M 94 180 L 100 188 L 106 180" />
        <path d="M 44 156 L 38 162 L 44 168" />
        <path d="M 20 94 L 12 100 L 20 106" />
        <path d="M 44 32 L 38 38 L 44 44" />
      </g>
    </svg>
  </span>

  <div class="mote-field" aria-hidden="true">
    {motes.map((m) => (
      <span class="mote" style={`left:${m.left};font-size:${m.size}px;--mote-dur:${m.dur};--mote-delay:${m.delay};--mote-op:${m.op}`}>{m.glyph}</span>
    ))}
  </div>

  <!-- ─── HERO ─── -->
  <section class="hero">
    <span class="folio-page" aria-hidden="true">fol. v · recto</span>
    <div class="candle-wrap" aria-hidden="true">
      <div class="candle">
        <span class="glow"></span>
        <span class="flame"></span>
        <span class="wick"></span>
        <span class="drip"></span>
        <span class="body"></span>
        <span class="puddle"></span>
      </div>
    </div>
    <div class="wrap">
      <span class="kicker">Liber Grimoire ·  vol i · mmxxvi</span>
      <h1 id="grim-h1">
        Bound by <em>candlelight</em>.<br />Read by the seeker.
      </h1>
      <p class="lead">
        Underneath every costume is the same tool: a small, offline-first mod
        manager for Deadlock. No telemetry. No accounts. No upsell. Just the
        catalog, your library, and a profile you can carry on a sigil.
      </p>
      <div class="actions">
        <a class="parchment-btn parchment-btn--accent" href={dl.primaryHref}>Bind to your PC</a>
        <a class="parchment-btn" href={brand.github} target="_blank" rel="noopener">View on GitHub</a>
      </div>
      <p class="micro">
        Windows + Linux · MIT · <span class="blink" aria-hidden="true">▸</span> bound mmxxvi by the Order of Slush
      </p>
    </div>
  </section>

  <!-- ─── DIVIDER ─── -->
  <div class="glyph-rule" aria-hidden="true">
    <span>✦ ⚝ ☥ ⚝ ✦</span>
  </div>

  <!-- ─── ENTRIES ─── -->
  <section class="entries">
    <div class="wrap">
      <span class="kicker kicker--centered">What it does</span>
      <h2>All four rites,<br />in one cursed window.</h2>
      <p class="section-lead">
        The features have not changed. Only the language has. Underneath the
        SaaS, the optimism, the chrome, and the starfield: these four bindings.
      </p>

      <div class="codex-grid">
        {occult.map((e) => (
          <article class="codex-entry">
            <div class="codex-kicker">{e.kicker}</div>
            <h3 class="codex-title">{e.title}</h3>
            <p class="codex-body">{e.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── DIVIDER ─── -->
  <div class="glyph-rule" aria-hidden="true">
    <span>⚝ ☉ ⚝ ☽ ⚝</span>
  </div>

  <!-- ─── PLATES (engravings of the instrument) ─── -->
  <section class="plates">
    <div class="wrap">
      <span class="kicker kicker--centered">The plates</span>
      <h2>Engravings taken<br />from the living instrument.</h2>
      <p class="section-lead">
        Six impressions, pressed between these pages so the seeker need not
        bind sight unseen. Lay the cursor upon any plate and behold it in
        living colour; press it to summon the full folio.
      </p>

      <div class="plate-grid">
        {plates.map((p) => (
          <figure class="plate">
            <span class="plate-label">Plate {p.roman}</span>
            <a
              class="plate-frame"
              href={`/screenshots/${p.name}.png`}
              target="_blank"
              rel="noopener"
            >
              <img
                class="plate-img"
                src={`/screenshots/thumbs/${p.name}.webp`}
                alt={p.alt}
                width={p.w}
                height={p.h}
                loading="lazy"
                decoding="async"
              />
            </a>
            <figcaption class="plate-caption">{p.caption}</figcaption>
          </figure>
        ))}
      </div>

      <p class="plate-foot">
        The engravings are sepia by the limits of the press, not of the
        instrument. The instrument itself runs in full colour.
      </p>
    </div>
  </section>

  <!-- ─── DIVIDER ─── -->
  <div class="glyph-rule" aria-hidden="true">
    <span>☽ ✶ ☥ ✶ ☽</span>
  </div>

  <!-- ─── RITES OF BINDING (per-platform downloads) ─── -->
  <section class="rites">
    <div class="wrap">
      <span class="kicker kicker--centered">Rites of binding</span>
      <h2>Five ways to bind it<br />to your machine.</h2>
      <p class="section-lead">
        Same volume, five bindings. Choose the rite your system already
        observes. The provenance of each is verifiable by checksum.
      </p>

      <ol class="rite-list" aria-label="Download by platform">
        {rites.map((r) => (
          <li class="rite">
            <span class="rite-roman" aria-hidden="true">{r.roman}.</span>
            <span class="rite-sigil" aria-hidden="true">{r.sigil}</span>
            <div class="rite-text">
              <h3 class="rite-name">{r.name}</h3>
              <p class="rite-rite">{r.rite}</p>
              {r.asset && (
                <p class="rite-meta">
                  <code>{r.asset.name}</code>
                  <span class="rite-sep" aria-hidden="true">·</span>
                  <span>{fmtBytes(r.asset.size)}</span>
                </p>
              )}
            </div>
            <a
              class="parchment-btn rite-btn"
              href={r.href}
              {...(r.href.startsWith('http') && !r.href.includes('grimoiremods.com') ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {r.asset ? 'Bind' : 'Invoke'}
            </a>
          </li>
        ))}
      </ol>

      <p class="rite-foot">
        Every rite ships a <code>SHA256SUMS</code> file and a GitHub build
        attestation. Verify before you bind. See <a href="/download">/download</a>
        for the full provenance.
      </p>
    </div>
  </section>

  <!-- ─── DIVIDER ─── -->
  <div class="glyph-rule" aria-hidden="true">
    <span>☉ ☽ ⚝ ☽ ☉</span>
  </div>

  <!-- ─── THE WIRELESS ─── -->
  {/* A real radio behind the occult dressing: free, listener-kept
      dark-ambient streams (SomaFM, somafm.com), played by the shared
      era-radio engine (on by default, rides the TIME MACHINE). */}
  <section class="wireless">
    <div class="wrap">
      <span class="kicker kicker--centered">The wireless</span>
      <h2>Voices, drawn<br />from the aether.</h2>
      <p class="section-lead">
        Three frequencies of dark ambience, broadcast freely and kept alive
        by listeners. The séance begins of its own accord; bid it cease,
        and it obeys.
      </p>
      <div class="wireless-rig" data-era-radio>
        <div class="freq-list" role="group" aria-label="Frequencies">
          <button type="button" class="freq" data-radio-station="doomed" aria-pressed="true">
            <span class="freq-sigil" aria-hidden="true">☥</span>
            <span class="freq-name">Doomed</span>
            <span class="freq-note">industrial gloom</span>
          </button>
          <button type="button" class="freq" data-radio-station="dronezone" aria-pressed="false">
            <span class="freq-sigil" aria-hidden="true">☽</span>
            <span class="freq-name">Drone Zone</span>
            <span class="freq-note">weightless drones</span>
          </button>
          <button type="button" class="freq" data-radio-station="darkzone" aria-pressed="false">
            <span class="freq-sigil" aria-hidden="true">⚝</span>
            <span class="freq-name">The Dark Zone</span>
            <span class="freq-note">deeper still</span>
          </button>
        </div>
        <button
          type="button"
          class="parchment-btn parchment-btn--accent wireless-btn"
          data-radio-play
          data-label-play="Begin the séance"
          data-label-pause="Break the circle"
          aria-pressed="false"
        >Begin the séance</button>
        <p class="wireless-status" data-radio-status aria-live="polite">The aether is silent.</p>
      </div>
    </div>
  </section>

  <!-- ─── DIVIDER ─── -->
  <div class="glyph-rule" aria-hidden="true">
    <span>✶ ⚝ ☥ ⚝ ✶</span>
  </div>

  <!-- ─── COLOPHON + STAMP ─── -->
  <section class="colophon">
    <div class="wrap">
      <span class="stamp">Bound by the Order of Slush · mmxxvi</span>
      <p class="colophon-body">
        Composed in the small hours on a single laptop. Set in IM Fell English
        for the body, with Comic Neue for the louder spells two stages up. No
        telemetry was harmed in the making of this page. The candle is real.
        The mods are also real.
      </p>
      <div class="links">
        <a href={brand.github} target="_blank" rel="noopener">github</a>
        <span class="sep" aria-hidden="true">✦</span>
        <a href={brand.gamebanana} target="_blank" rel="noopener">gamebanana/22583</a>
        <span class="sep" aria-hidden="true">✦</span>
        <a href={brand.discord} target="_blank" rel="noopener">discord</a>
        <span class="sep" aria-hidden="true">✦</span>
        <a href="/download">/download</a>
      </div>
    </div>
  </section>
</section>

<style>
  /* ─────────────────────────────────────────────────────────────────
     GRIMOIRE: scoped parchment-dark world. Lifted from the existing
     identity, re-scoped to this stage only. Candle illustration in the
     hero, drifting sigil motes, ghost chaos-star rotating faintly,
     warm-wash + parchment-grain overlays. IM Fell English serif with
     IM Fell SC for small-caps labels.
     ───────────────────────────────────────────────────────────────── */
  .stage-grimoire {
    background: #0a0907;
    color: #ffffff;
    font-family: 'IM Fell English', 'Iowan Old Style', 'Hoefler Text',
      'Palatino Linotype', Palatino, ui-serif, Cambria, Georgia, serif;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100vh;
  }
  .stage-grimoire a { color: inherit; text-decoration: none; }
  .stage-grimoire h1, .stage-grimoire h2, .stage-grimoire h3 { margin: 0; color: #ffffff; }
  .stage-grimoire h1 em, .stage-grimoire h2 em, .stage-grimoire h3 em {
    font-style: italic;
    color: #f97316;
    font-weight: 400;
  }
  .stage-grimoire p { margin: 0; }
  .stage-grimoire .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 2;
  }

  /* ─── Parchment grain + warm wash ─── */
  .stage-grimoire .grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.18;
    mix-blend-mode: soft-light;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='3'/%3E%3CfeColorMatrix type='matrix' values='0.85 0 0 0 0.22  0.55 0 0 0 0.10  0.25 0 0 0 0.03  0 0 0 1 0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }
  .stage-grimoire .warm-wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.13;
    mix-blend-mode: soft-light;
    background: #c47a32;
  }

  /* ─── Ghost sigil ─── */
  .stage-grimoire .ghost-sigil {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(120vmin, 1100px);
    height: min(120vmin, 1100px);
    transform: translate(-50%, -50%);
    opacity: 0.045;
    pointer-events: none;
    z-index: 0;
    color: #e7d2a3;
  }
  .stage-grimoire .ghost-sigil svg {
    width: 100%; height: 100%; display: block;
    animation: ghost-spin 320s linear infinite;
    transform-origin: 50% 50%;
  }
  @keyframes ghost-spin { to { transform: rotate(360deg); } }

  /* ─── Mote field ─── */
  .stage-grimoire .mote-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }
  .stage-grimoire .mote {
    position: absolute;
    bottom: -30px;
    color: #e7d2a3;
    opacity: 0;
    text-shadow: 0 0 4px rgba(231, 210, 163, 0.4);
    animation: mote-drift var(--mote-dur, 36s) linear infinite;
    animation-delay: var(--mote-delay, 0s);
    will-change: transform, opacity;
  }
  @keyframes mote-drift {
    0%   { transform: translateY(0); opacity: 0; }
    8%   { opacity: var(--mote-op, 0.25); }
    92%  { opacity: var(--mote-op, 0.25); }
    100% { transform: translateY(-110vh); opacity: 0; }
  }

  /* ─── Folio page label ─── */
  .stage-grimoire .folio-page {
    position: absolute;
    top: 24px;
    right: 24px;
    font-family: 'IM Fell English SC', 'IM Fell English', serif;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(231, 210, 163, 0.55);
    z-index: 3;
  }

  /* ─── Kicker ─── */
  .stage-grimoire .kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: 'IM Fell English SC', 'IM Fell English', serif;
    font-size: 14px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #e7d2a3;
  }
  .stage-grimoire .kicker::before {
    content: "";
    width: 24px;
    height: 1px;
    background: currentColor;
    opacity: 0.65;
  }
  .stage-grimoire .kicker--centered::after {
    content: "";
    width: 24px;
    height: 1px;
    background: currentColor;
    opacity: 0.65;
  }

  /* ─── Hero ─── */
  .stage-grimoire .hero {
    position: relative;
    padding: 96px 0 64px;
    z-index: 2;
  }
  .stage-grimoire .hero h1 {
    margin-top: 22px;
    font-size: clamp(40px, 7vw, 72px);
    line-height: 1.05;
    letter-spacing: 0.005em;
    max-width: 720px;
    font-weight: 400;
  }
  .stage-grimoire .hero .lead {
    margin: 24px 0 36px;
    color: rgba(255,255,255,0.78);
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.55;
    max-width: 600px;
  }
  .stage-grimoire .hero .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 18px;
  }
  .stage-grimoire .hero .micro {
    font-size: 12px;
    color: rgba(231, 210, 163, 0.6);
    font-family: 'IM Fell English SC', 'IM Fell English', serif;
    letter-spacing: 0.05em;
  }
  .stage-grimoire .blink {
    color: #f97316;
    animation: grim-blink 1s steps(2, end) infinite;
    display: inline-block;
  }
  @keyframes grim-blink { 50% { visibility: hidden; } }

  /* ─── Candle (decorative, top-right of hero) ─── */
  .stage-grimoire .candle-wrap {
    position: absolute;
    right: 48px;
    top: 80px;
    z-index: 3;
  }
  @media (max-width: 980px) {
    .stage-grimoire .candle-wrap { display: none; }
  }
  .stage-grimoire .candle {
    position: relative;
    width: 88px;
    height: 200px;
  }
  .stage-grimoire .candle .puddle {
    position: absolute;
    bottom: 0;
    left: 8px;
    right: 8px;
    height: 12px;
    background: radial-gradient(ellipse at center, #d8b07a 0%, #a47238 70%, transparent 100%);
    border-radius: 50%;
    filter: blur(0.4px);
  }
  .stage-grimoire .candle .puddle::after {
    content: "";
    position: absolute;
    left: 16%;
    right: 16%;
    top: 3px;
    bottom: 3px;
    background: radial-gradient(ellipse at center, #f4e2b5 0%, #d8b07a 80%, transparent 100%);
    border-radius: 50%;
    opacity: 0.7;
  }
  .stage-grimoire .candle .body {
    position: absolute;
    bottom: 6px;
    left: 18px;
    width: 52px;
    height: 130px;
    background:

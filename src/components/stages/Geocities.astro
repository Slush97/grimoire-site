  /* ─── WordArt headline ─── */
  .stage-geocities .hero { margin-bottom: 32px; }
  .stage-geocities .wordart {
    margin: 0;
    font-family: 'Comic Neue', 'Comic Sans MS', 'Impact', sans-serif;
    font-weight: 700;
    font-size: clamp(42px, 8.5vw, 72px);
    line-height: 1;
    letter-spacing: 0.005em;
  }
  /*
   * Brass-foil letterforms : same WordArt outline silhouette as 1996
   * but each glyph is filled with a vertical gilt gradient (highlight
   * → brass → deep brass → shadow) using background-clip:text. Drop
   * shadow cascade is plum + oxblood + soft black, replacing the
   * cyan/magenta/black "3D" stack. Letters shimmer in sequence rather
   * than bounce, which sells "candlelit" instead of "rainbow party".
   */
  .stage-geocities .wa {
    display: inline-block;
    background: linear-gradient(180deg,
      #fff8d4 0%,
      #ffd96a 22%,
      #e8b840 48%,
      #a87018 78%,
      #4a2a08 100%);
    -webkit-background-clip: text;
            background-clip: text;
    color: transparent;
    /*
     * Flat black drop-shadow only — no gold halo, no shimmer pulse.
     * The brass-foil gradient carries the warmth; the black shadow
     * gives legibility against the plum background.
     */
    filter:
      drop-shadow(0 2px 0 rgba(10, 6, 18, 0.9))
      drop-shadow(0 6px 10px rgba(0, 0, 0, 0.7));
    transform-origin: center bottom;
  }
  .stage-geocities .wa-sub {
    display: block;
    font-size: 0.28em;
    font-family: 'Times New Roman', Times, serif;
    font-style: italic;
    font-weight: 400;
    color: #fff5db;
    text-shadow:
      0 1px 0 #000,
      0 0 10px rgba(244, 219, 166, 0.7);
    margin-top: 16px;
    letter-spacing: 0.08em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
  }
  .stage-geocities .tagline {
    margin: 18px 0 0;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    color: #fff5db;
    font-size: 17px;
    font-weight: 700;
    text-shadow:
      1px 1px 0 #000,
      0 0 10px rgba(212, 175, 90, 0.5);
  }
  .stage-geocities .tagline em {
    color: #ffd96a;
    font-style: italic;
    font-weight: 700;
    text-shadow: 1px 1px 0 #000, 0 0 8px rgba(255, 217, 106, 0.75);
  }
  .stage-geocities .heart {
    color: #ff3a4a;
    text-shadow: 0 0 8px #ff3a4a, 0 0 16px rgba(255, 58, 74, 0.5);
    animation: heart-beat 1s ease-in-out infinite;
    display: inline-block;
  }
  @keyframes heart-beat {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.2); }
  }

  /* ─── Altar : brass sphere on perspective checker with masonic circle ───
     POVRay-flavored tracing board. Three flat planes rotated into the
     ground plane (checker floor, magic circle SVG, contact shadow) +
     two upright planes (halo and sphere). Sphere is layered radial
     gradients: bright highlight at top-left, brass body, reflected
     horizon band across the equator, faint hint of striations in the
     lower hemisphere that suggest reflection of the floor below. */
  .stage-geocities .altar {
    position: relative;
    margin: 12px auto 8px;
    /*
     * Break the altar out of the .page max-width so the floor and its
     * fade can extend to the stage edges. Without this, the altar is
     * clipped to ~1108px wide and the floor's left/right edges show a
     * hard rectangular cut behind the sphere ("box seam" artifact).
     */
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    width: 100vw;
    height: 300px;
    overflow: hidden;
    perspective: 820px;
    isolation: isolate;
  }
  .stage-geocities .altar-glyph {
    position: absolute;
    left: 50%;
    top: 4px;
    transform: translateX(-50%);
    font-family: 'Times New Roman', Times, serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5em;
    color: #ffd96a;
    text-transform: uppercase;
    text-shadow: 0 1px 0 #000;
    z-index: 5;
  }
  .stage-geocities .altar-floor {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 2400px;
    height: 480px;
    margin-left: -1200px;
    /*
     * Saturated indigo + violet checker. Deeper, more pigmented than
     * the original muted purple so the floor reads as a real masonic
     * tile surface under the sphere instead of a grey haze. Grid lines
     * use molten gold instead of muted brass.
     */
    background-image:
      linear-gradient(rgba(255, 208, 96, 0.4) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 208, 96, 0.4) 1px, transparent 1px),
      conic-gradient(
        from 0deg at 50% 50%,
        #0c0524 0% 25%,
        #3a1080 25% 50%,
        #0c0524 50% 75%,
        #3a1080 75% 100%
      );
    background-size: 64px 64px, 64px 64px, 64px 64px;
    transform: rotateX(74deg);
    transform-origin: top center;
    /*
     * Fade all four sides into the starfield. Aggressive radial fall-off
     * keeps a bright halo of checker behind the sphere and dissolves
     * the rest into the dark stage, so there's no rectangular "box
     * seam" cut anywhere on the page. Ellipse is narrow horizontally
     * so even at wide viewports the floor doesn't reach the page edges
     * with hard tone.
     */
    -webkit-mask-image: radial-gradient(ellipse 28% 60% at 50% 36%, #000 0%, rgba(0,0,0,0.85) 35%, transparent 90%);
            mask-image: radial-gradient(ellipse 28% 60% at 50% 36%, #000 0%, rgba(0,0,0,0.85) 35%, transparent 90%);
    z-index: 0;
  }
  .stage-geocities .altar-circle {
    position: absolute;
    left: 50%;
    bottom: -20px;
    width: 420px;
    height: 420px;
    margin-left: -210px;
    transform: rotateX(74deg);
    transform-origin: center 70%;
    z-index: 1;
  }
  .stage-geocities .altar-shadow {
    position: absolute;
    left: 50%;
    bottom: 78px;
    width: 220px;
    height: 28px;
    margin-left: -110px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.3) 50%, transparent 75%);
    filter: blur(4px);
    pointer-events: none;
    z-index: 2;
  }
  /*
   * Halo was a gold radial blob behind the sphere that bled up into the
   * "as above so below" area and read as a glowing column. Kept the
   * element so layering stays the same but made it invisible. Restore
   * with a tighter, lower-positioned gradient if a candle pool is
   * wanted again later.
   */
  .stage-geocities .altar-halo {
    display: none;
  }
  .stage-geocities .altar-sphere {
    position: absolute;
    left: 50%;
    bottom: 92px;
    width: 168px;
    height: 168px;
    margin-left: -84px;
    border-radius: 50%;
    background:
      /* Top-left specular highlight */
      radial-gradient(circle at 34% 24%,
        rgba(255, 255, 255, 0.98) 0%,
        rgba(255, 248, 220, 0.7) 6%,
        transparent 20%),
      /* Reflected horizon band — bright equator line */
      radial-gradient(ellipse 90% 6% at 50% 54%,
        rgba(255, 240, 180, 0.7) 0%,
        rgba(232, 184, 64, 0.35) 40%,
        transparent 70%),
      /* Hint of reflected checker — alternating bands in lower hemisphere */
      repeating-radial-gradient(
        circle at 50% 100%,
        transparent 0,
        transparent 12px,
        rgba(255, 217, 106, 0.1) 12px,
        rgba(255, 217, 106, 0.1) 16px
      ),
      /* Molten brass body : richer pigment, deeper shadow */
      radial-gradient(circle at 50% 50%,
        #f0c050 0%,
        #c89028 45%,
        #6a4810 78%,
        #1a0a08 100%);
    /*
     * Inset shadows give the sphere its dimension; the contact drop
     * shadow grounds it on the floor. The outer gold rim glow was
     * removed — it broadcast a halo that read as ambient lighting in
     * the area behind the sphere and the "as above so below" glyph.
     */
    box-shadow:
      inset -14px -22px 36px rgba(0, 0, 0, 0.85),
      inset 10px 12px 20px rgba(255, 248, 220, 0.28),
      0 24px 44px -10px rgba(0, 0, 0, 0.92);
    animation: altar-bob 6s ease-in-out infinite;
    z-index: 4;
  }
  @keyframes altar-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }

  /* ─── Construction + Visitor row ─── */
  .stage-geocities .row-2 {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin: 28px 0;
  }
  .stage-geocities .construction {
    background: rgba(0,0,0,0.6);
    border: 3px ridge #d4af5a;
    padding: 12px;
    width: 240px;
  }
  /*
   * Hazard tape. Earlier version painted the gradient directly on the
   * div with `background-size: 200% 100%` and animated bg-position by
   * 40px. The 200% size stretched the repeating pattern so its tile
   * boundary fell inside the visible area, showing a faint seam line.
   *
   * Fix: keep the gradient at its natural period (28px diagonal), wrap
   * in overflow:hidden, and translate an oversized child by exactly
   * one diagonal period (28*sqrt(2) ≈ 39.6px). No edge ever shows; the
   * loop is seamless because the translate matches one full period.
   */
  .stage-geocities .hazard {
    width: 100%;
    height: 26px;
    margin-bottom: 8px;
    overflow: hidden;
    position: relative;
  }
  .stage-geocities .hazard-tape {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -56px;
    right: -56px;
    background: repeating-linear-gradient(
      -45deg,
      #d4af5a 0,
      #d4af5a 14px,
      #000000 14px,
      #000000 28px
    );
    animation: hazard-scroll 1s linear infinite;
    will-change: transform;
  }
  @keyframes hazard-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(39.6px); }
  }
  .stage-geocities .construction p {
    margin: 8px 0 4px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    color: #d4af5a;

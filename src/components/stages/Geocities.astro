<script>
  /*
   * Sparkle cursor trail. Scoped to the geocities stage only. Emits a
   * tiny ★ at the cursor every ~80ms while the mouse is inside the
   * section; each sparkle fades + drifts for 700ms. Respects
   * prefers-reduced-motion. Pointer-events:none so it never interferes
   * with clicks. Uses passive event listeners to keep scroll smooth.
   */
  if (typeof window !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const stage = document.querySelector('.stage-geocities');
    const trail = stage?.querySelector('.sparkle-trail');
    if (stage && trail) {
      let last = 0;
      const colors = ['#d4af5a', '#a47ac0', '#b0a8d9', '#7a8f4a', '#c44a2a'];
      stage.addEventListener('mousemove', (event) => {
        const e = event as MouseEvent;
        const now = performance.now();
        if (now - last < 70) return;
        last = now;
        const rect = stage.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const s = document.createElement('span');
        s.className = 'sparkle';
        s.textContent = '★';
        s.style.left = x + 'px';
        s.style.top = y + 'px';
        s.style.color = colors[Math.floor(Math.random() * colors.length)];
        s.style.setProperty('--dx', (Math.random() * 24 - 12) + 'px');
        s.style.setProperty('--dy', (Math.random() * -32 - 8) + 'px');
        trail.appendChild(s);
        setTimeout(() => s.remove(), 700);
      }, { passive: true });
    }
  }

  /*
   * Vaporwave radio. Two open-source stream families:
   *   - Plaza One (plaza.one)  : pure vaporwave, public JSON now-playing
   *   - Nightride.fm           : synthwave/vaporwave, multi-station
   * Click-to-start: audio is paused by default to respect browser
   * autoplay policy. While playing, the now-playing label cycles
   * Plaza's JSON; Nightride stations show a static LIVE label.
   * Volume button cycles 4 quiet/medium/loud levels.
   */
  (function radio() {
    const widget = document.querySelector('[data-radio]');
    if (!widget) return;

    type StationId = 'plaza' | 'nightride' | 'chillsynth' | 'spacesynth';
    interface Station { url: string; label: string; }

    /*
     * Direct stream URLs. Plaza One redirects plaza.one/mp3 ->
     * radio.plaza.one/mp3 and may lose CORS on the redirect, so we
     * use the final URL. Nightride exposes both .m4a (HLS-ish AAC)
     * and .mp3; the .mp3 versions have wider browser support.
     */
    const stations: Record<StationId, Station> = {
      plaza:      { url: 'https://radio.plaza.one/mp3',                 label: 'PLAZA.ONE'  },
      nightride:  { url: 'https://stream.nightride.fm/nightride.mp3',   label: 'NIGHTRIDE'  },
      chillsynth: { url: 'https://stream.nightride.fm/chillsynth.mp3',  label: 'CHILLSYNTH' },
      spacesynth: { url: 'https://stream.nightride.fm/spacesynth.mp3',  label: 'SPACESYNTH' },
    };

    const audio   = widget.querySelector('audio') as HTMLAudioElement;
    const track   = widget.querySelector('[data-role="track"]') as HTMLElement;
    const status  = widget.querySelector('[data-role="status"]') as HTMLElement;
    const playBtn = widget.querySelector('[data-role="play"]')  as HTMLButtonElement;
    const stopBtn = widget.querySelector('[data-role="stop"]')  as HTMLButtonElement;
    const volBtn  = widget.querySelector('[data-role="vol"]')   as HTMLButtonElement;
    const tabs    = widget.querySelectorAll<HTMLButtonElement>('.station-tab');

    let current: StationId = 'spacesynth';
    let pollTimer: number | null = null;
    let volStep = 2;
    const volLevels = [0.25, 0.5, 0.75, 1.0];

    audio.volume = volLevels[volStep];

    /*
     * Web Audio visualizer. Real frequency analysis driven by the
     * actual stream samples. Built lazily on first play() so the
     * AudioContext starts in the user-gesture allowance window.
     *
     * Falls back gracefully if MediaElementSource throws (eg. CORS
     * blocked on a station that doesn't allow our origin) — in that
     * case the bars revert to their CSS keyframe stagger so the
     * widget still looks alive.
     */
    let audioCtx: AudioContext | null = null;
    let analyser: AnalyserNode | null = null;
    let freqData: Uint8Array | null = null;
    let vizRaf = 0;
    const bars = Array.from(widget.querySelectorAll<HTMLElement>('.midi-bars span'));
    /* Map each of the 10 visible bars to a frequency bin. Log-ish
     * distribution so low/mid/high all get representation; index 0 is
     * bass, index 9 is treble. fftSize=64 gives 32 bins, only the
     * lower ~24 carry useful audio energy for music. */
    const binMap = [1, 2, 3, 4, 6, 8, 10, 13, 17, 22];

    function ensureViz() {
      if (audioCtx) return true;
      try {
        const Ctor = (window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext);
        audioCtx = new Ctor();
        const source = audioCtx.createMediaElementSource(audio);
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 64;
        analyser.smoothingTimeConstant = 0.78;
        source.connect(analyser);
        analyser.connect(audioCtx.destination);
        freqData = new Uint8Array(analyser.frequencyBinCount);
        return true;
      } catch (e) {
        console.warn('[radio] visualizer disabled', e);
        audioCtx = null; analyser = null; freqData = null;
        return false;
      }
    }
    function vizTick() {
      vizRaf = requestAnimationFrame(vizTick);
      if (audio.paused || !analyser || !freqData) return;
      analyser.getByteFrequencyData(freqData as Uint8Array<ArrayBuffer>);
      for (let i = 0; i < bars.length; i++) {
        const idx = Math.min(binMap[i], freqData.length - 1);
        const v = freqData[idx] / 255;
        /* Floor at 0.06 so bars don't fully collapse during quiet
         * passages — keeps the LCD looking "on". */
        bars[i].style.transform = `scaleY(${Math.max(0.06, v)})`;
      }
    }
    function startViz() {
      if (!ensureViz()) return;
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume().catch(() => {});
      if (!vizRaf) vizTick();
    }
    function stopViz() {
      if (vizRaf) { cancelAnimationFrame(vizRaf); vizRaf = 0; }
      /* Reset bars to a flat baseline so they read as "off". */
      bars.forEach((b) => { b.style.transform = ''; });
    }

    function setStation(id: StationId, restart: boolean) {
      current = id;
      tabs.forEach((t) => t.classList.toggle('is-on', t.dataset.station === id));
      if (restart) {
        audio.src = stations[id].url;
        audio.play().catch(() => { status.textContent = 'could not tune in 😵'; });
      }
      if (audio.paused) track.textContent = `▶ ${stations[id].label} ▶`;
      updateTrack();
    }

    async function updateTrack() {
      if (current === 'plaza' && !audio.paused) {
        try {
          /* Plaza One status JSON: { song: { artist, title, ... }, listeners, ... }. */
          const r = await fetch('https://api.plaza.one/status', { cache: 'no-store' });
          const d = await r.json();
          const artist = d?.song?.artist || '';
          const title  = d?.song?.title  || 'live stream';
          track.textContent = artist ? `${artist} : ${title}` : title;
        } catch {
          track.textContent = `${stations.plaza.label} : LIVE`;
        }
      } else if (!audio.paused) {
        track.textContent = `${stations[current].label} : LIVE`;
      }
    }

    function play() {
      if (!audio.src) audio.src = stations[current].url;
      return audio.play().then(() => {
        widget.classList.add('is-playing');
        playBtn.textContent = '❚❚';
        status.textContent = 'tuned in!!! turn ur speakers UP!!1!';
        startViz();
        updateTrack();
        if (pollTimer) clearInterval(pollTimer);
        pollTimer = window.setInterval(updateTrack, 15000);
      }).catch((err) => {
        console.warn('[radio] play() failed', err);
        status.textContent = err && err.name === 'NotAllowedError'
          ? 'click ▶ to tune in!!1!'
          : 'stream failed : try another station';
        throw err;
      });
    }
    function pause() {
      audio.pause();
      widget.classList.remove('is-playing');
      playBtn.textContent = '▶';
      track.textContent = `▶ ${stations[current].label} ▶`;
      status.textContent = 'paused';
      stopViz();
      if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    }
    function stop() {
      audio.pause();
      audio.removeAttribute('src');
      audio.load();
      widget.classList.remove('is-playing');
      playBtn.textContent = '▶';
      track.textContent = `▶ ${stations[current].label} ▶`;
      status.textContent = 'click ▶ to tune in!!1!';
      stopViz();
      if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    }

    playBtn.addEventListener('click', () => { audio.paused ? play() : pause(); });
    stopBtn.addEventListener('click', stop);
    volBtn.addEventListener('click', () => {
      volStep = (volStep + 1) % volLevels.length;
      audio.volume = volLevels[volStep];
      status.textContent = `volume : ${'▮'.repeat(volStep + 1)}${'▯'.repeat(volLevels.length - volStep - 1)}`;
    });
    tabs.forEach((t) => t.addEventListener('click', () => {
      const id = t.dataset.station as StationId;
      setStation(id, !audio.paused);
    }));

    audio.addEventListener('error', () => {
      const e = audio.error;
      console.warn('[radio] audio error', e && { code: e.code, message: e.message }, 'src=', audio.currentSrc);
      status.textContent = 'stream error : try another station';
      stopViz();
    });
    audio.addEventListener('stalled', () => console.warn('[radio] stalled', audio.currentSrc));

    /*
     * "have space be on automatically as a sound": browsers block
     * autoplay with sound until the user has interacted with the
     * page. We do the best we can:
     *   1. Set Space as the default station (already selected in
     *      markup).
     *   2. Try play() immediately on load. Most browsers reject it
     *      with NotAllowedError.
     *   3. Bind a one-shot listener for any user gesture (pointer,
     *      key, scroll) and retry play() then — that's the moment
     *      autoplay policy unlocks. After that the radio is "on".
     * Status text walks the user through whichever path triggers.
     */
    audio.src = stations[current].url;
    audio.preload = 'auto';

    let autoPlayed = false;
    function tryAutoPlay() {
      if (autoPlayed || !audio.paused) return;
      autoPlayed = true;
      status.textContent = 'tuning in to SPACE...';
      play().catch(() => {
        autoPlayed = false;
        status.textContent = 'click ▶ or anywhere to tune in!!1!';
        bindFirstGesture();
      });
    }
    function bindFirstGesture() {
      const opts = { once: true, passive: true } as AddEventListenerOptions;
      const fire = () => tryAutoPlay();
      window.addEventListener('pointerdown', fire, opts);
      window.addEventListener('keydown',     fire, opts);
      window.addEventListener('scroll',      fire, opts);
      window.addEventListener('touchstart',  fire, opts);
    }

    /* Kick off: optimistic first attempt, then arm the gesture
     * listener for the (more common) blocked case. */
    tryAutoPlay();
    bindFirstGesture();
  })();
</script>

<style>
  /* ─────────────────────────────────────────────────────────────────
     GEOCITIES: scoped 1996 amateur web world. Starfield bg, marquees,
     WordArt headline, hazard-tape Under Construction GIF (CSS-only),
     LED visitor counter, blinking NEW!!! ribbon, 88x31 webring badges.
     Times Roman body + Comic Sans accents. Hot pink, cyan, lime, yellow.
     ───────────────────────────────────────────────────────────────── */
  .stage-geocities {
    /*
     * Deep indigo base, not flat black. A near-black ground with a
     * saturated plum vignette at the top and an oxblood pool at the
     * bottom gives the stage real candlelight depth instead of the
     * washed grey-purple it used to read as.
     */
    background:
      radial-gradient(ellipse 90% 55% at 50% 0%, rgba(120, 40, 180, 0.55) 0%, transparent 65%),
      radial-gradient(ellipse 70% 40% at 50% 100%, rgba(140, 20, 50, 0.32) 0%, transparent 70%),
      #07041a;
    color: #ffffff;
    font-family: 'Times New Roman', Times, serif;
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
    display: block;
    min-height: 100vh;
    padding: 0;
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .stage-geocities .starfield {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: transparent;
    background-image:
      radial-gradient(1px 1px at 5% 8%, #ffffff, transparent),
      radial-gradient(1px 1px at 15% 22%, #ffffff, transparent),
      radial-gradient(2px 2px at 24% 12%, #ffffff, transparent),
      radial-gradient(1px 1px at 38% 28%, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 50% 18%, #cce, transparent),
      radial-gradient(1px 1px at 63% 32%, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 75% 14%, #ffffff, transparent),
      radial-gradient(1px 1px at 88% 26%, #fcc, transparent),
      radial-gradient(1.5px 1.5px at 11% 48%, #ffffff, transparent),
      radial-gradient(1px 1px at 28% 56%, #ffffff, transparent),
      radial-gradient(2px 2px at 44% 64%, #ffffff, transparent),
      radial-gradient(1px 1px at 58% 48%, #ccf, transparent),
      radial-gradient(1.5px 1.5px at 72% 56%, #ffffff, transparent),
      radial-gradient(1px 1px at 86% 68%, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 8% 78%, #ffffff, transparent),
      radial-gradient(1px 1px at 22% 88%, #fcc, transparent),
      radial-gradient(2px 2px at 36% 76%, #ffffff, transparent),
      radial-gradient(1px 1px at 54% 92%, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 68% 84%, #ccf, transparent),
      radial-gradient(1px 1px at 81% 96%, #ffffff, transparent),
      radial-gradient(1px 1px at 94% 80%, #ffffff, transparent);
    background-size: 100% 100%;
    /*
     * Twinkle animation removed: it pulsed the whole starfield's
     * opacity, which read as the stage shimmering behind the headline
     * and altar instead of as individual stars twinkling.
     */
  }

  .stage-geocities a {
    color: #b0a8d9;
    text-decoration: underline;
  }
  .stage-geocities a:visited { color: #a47ac0; }
  .stage-geocities a:hover { color: #d4af5a; }

  /* ─── Marquees ─── */
  .stage-geocities .top-marquee,
  .stage-geocities .bot-marquee {
    position: relative;
    z-index: 2;
    overflow: hidden;
    background: linear-gradient(90deg, #1a0840 0%, #2c0e6a 50%, #1a0840 100%);
    border-top: 2px solid #c8243d;
    border-bottom: 2px solid #c8243d;
    color: #ffd96a;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-weight: 700;
    font-size: 14px;
    text-shadow: 1px 1px 0 #000, 0 0 6px rgba(255, 217, 106, 0.45);
    padding: 4px 0;
  }
  .stage-geocities .track {
    display: inline-flex;
    white-space: nowrap;
    animation: geo-scroll 22s linear infinite;
  }
  .stage-geocities .track > span { padding: 0 18px; }
  @keyframes geo-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ─── Page wrapper ─── */
  .stage-geocities .page {
    position: relative;
    z-index: 2;
    max-width: 1140px;
    margin: 0 auto;
    padding: 36px 16px 0;
  }

  /* ─── Tiled wallpaper layered behind the stars ───
     Authentic GeoCities pages used a repeating .gif tile. We approximate
     with a CSS-generated radial tile so the bg has texture even where
     stars don't land. Subtle on purpose: starfield still dominates. */
  .stage-geocities::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /*
     * Old tile mixed brass + cyan + yellow at 4-8% opacity — read as
     * grey noise. Swapped for plum + indigo + brass with higher
     * pigment, so the dark stage has tinted "candlelit dust" texture
     * instead of grey static.
     */
    background-image:
      radial-gradient(circle at 25% 25%, rgba(168, 32, 100, 0.14) 0, transparent 22%),
      radial-gradient(circle at 75% 75%, rgba(90, 30, 160, 0.14) 0, transparent 22%),
      linear-gradient(45deg, transparent 48%, rgba(232, 184, 64, 0.06) 49%, rgba(232, 184, 64, 0.06) 51%, transparent 52%);
    background-size: 80px 80px, 80px 80px, 36px 36px;
    opacity: 0.85;
  }

  /* ─── Frameset 3-column layout ─── */
  .stage-geocities .frameset {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 240px;
    gap: 18px;
    align-items: start;
    margin-top: 24px;
  }
  .stage-geocities .content {
    min-width: 0;
  }
  /*
   * Top alignment: the rails start flush with the grid top, but the
   * center's first element (.row-2) used to add a 28px top margin,
   * pushing the construction/visitor row below the rail tops. Zero
   * the first-child top margin in any column to keep all three
   * starting at the same Y.
   */
  .stage-geocities .content > :first-child,
  .stage-geocities .rail > :first-child {
    margin-top: 0;
  }
  .stage-geocities .rail {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* ─── Sidebar widget shell ─── */
  .stage-geocities .widget {
    background:
      linear-gradient(180deg, rgba(40, 14, 92, 0.55) 0%, rgba(12, 4, 38, 0.92) 100%);
    border: 3px ridge #e8b840;
    padding: 10px;
    text-align: left;
    color: #fff;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-size: 12px;
    line-height: 1.4;
    box-shadow:
      inset 0 0 24px rgba(120, 40, 180, 0.25),
      0 2px 0 #000;
  }
  .stage-geocities .rail-left .widget:nth-child(2n) { border-color: #9c7ae6; }
  .stage-geocities .rail-left .widget:nth-child(3n) { border-color: #c8243d; }
  .stage-geocities .rail-right .widget:nth-child(2n) { border-color: #8db04a; }
  .stage-geocities .rail-right .widget:nth-child(3n) { border-color: #b660e0; }
  .stage-geocities .widget-h {
    margin: -10px -10px 10px;
    padding: 5px 8px;
    background:
      linear-gradient(90deg,
        #5a0a18 0%,
        #a82010 20%,
        #e8b840 50%,
        #a82010 80%,
        #5a0a18 100%);
    color: #1a0a08;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    text-shadow: 1px 1px 0 rgba(255, 248, 212, 0.65);
    border-top: 1px solid #ffd96a;
    border-bottom: 2px solid #1a0a08;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ─── NAV widget ─── */
  .stage-geocities .widget-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stage-geocities .widget-nav a {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    color: #b0a8d9;
    text-decoration: underline;
    font-weight: 700;
    text-shadow: 1px 1px 0 #000;
    border: 1px dotted transparent;
  }
  .stage-geocities .widget-nav a:hover {
    color: #d4af5a;
    background: rgba(212, 175, 90, 0.18);
    border-color: #a83247;
  }
  .stage-geocities .navico { font-size: 13px; }

  /* ─── ABOUT ME widget + CRT photo placeholder ─── */
  .stage-geocities .widget-about .photo {
    text-align: center;
    margin-bottom: 8px;
  }
  /* Obsidian scrying mirror in a brass frame. Replaces the cartoon
     CRT-face (green eyes + smile) that read too "haha 1996" against
     the rest of the candlelit tone. */
  .stage-geocities .crt {
    position: relative;
    width: 110px;
    height: 96px;
    margin: 0 auto;
    background:
      radial-gradient(ellipse at 40% 30%, #2a1a3a 0%, #0a0612 65%);
    border: 4px solid;
    border-image: linear-gradient(135deg, #f4dba6 0%, #8a6a2a 50%, #c9a961 100%) 1;
    border-radius: 50% / 42%;
    overflow: hidden;
    box-shadow:
      0 3px 0 #1a0a08,
      inset 0 0 16px rgba(0, 0, 0, 0.85),
      0 0 10px rgba(212, 175, 90, 0.3);
  }
  .stage-geocities .crt-scan {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      rgba(212, 175, 90, 0.07) 0,
      rgba(212, 175, 90, 0.07) 1px,
      transparent 1px,
      transparent 4px
    );
    pointer-events: none;
    animation: crt-flicker 2.4s ease-in-out infinite;
  }
  @keyframes crt-flicker {
    0%, 100% { opacity: 0.7; }
    50%      { opacity: 1; }
  }
  .stage-geocities .crt-face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .stage-geocities .scry-rune {
    font-size: 42px;
    line-height: 1;
    color: #d4af5a;
    text-shadow:
      0 0 8px rgba(212, 175, 90, 0.7),
      0 0 16px rgba(212, 175, 90, 0.3);
    animation: scry-pulse 3.6s ease-in-out infinite;
  }
  .stage-geocities .scry-pupil {
    position: absolute;
    width: 3px;
    height: 3px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 6px #fff, 0 0 12px rgba(255, 240, 200, 0.7);
    animation: scry-blink 5s steps(2, end) infinite;
  }
  @keyframes scry-pulse {
    0%, 100% { opacity: 0.85; transform: scale(1); }
    50%      { opacity: 1;    transform: scale(1.06); }
  }
  @keyframes scry-blink {
    0%, 90%, 100% { opacity: 1; }
    92%, 96%      { opacity: 0; }
  }
  .stage-geocities .photo-caption {
    margin: 6px 0 0;
    font-family: 'Times New Roman', Times, serif;
    font-size: 11px;
    font-style: italic;
    color: #d4af5a;
    text-shadow: 1px 1px 0 #000;
    letter-spacing: 0.1em;
  }
  .stage-geocities .about-blurb {
    margin: 0 0 8px;
    color: #fff;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .about-blurb strong { color: #d4af5a; }
  .stage-geocities .about-blurb em { color: #7a8f4a; font-style: italic; }
  .stage-geocities .vitals {
    list-style: none;
    margin: 0;
    padding: 8px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px dashed #a47ac0;
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: #b0a8d9;
  }
  .stage-geocities .vitals li { line-height: 1.5; }
  .stage-geocities .vitals b { color: #d4af5a; margin-right: 4px; }

  /* ─── MAILBOX widget ─── */
  .stage-geocities .mailbox {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    background: rgba(0, 0, 0, 0.4);
    border: 2px ridge #b0a8d9;
  }
  .stage-geocities .mail-icon {
    font-size: 30px;
    line-height: 1;
  }
  .stage-geocities .mail-count {
    font-family: 'Impact', 'Comic Neue', sans-serif;
    font-size: 28px;
    color: #c44a2a;
    line-height: 1;
    text-shadow: 0 0 6px #c44a2a, 1px 1px 0 #000;
  }
  .stage-geocities .mail-sub {
    font-size: 11px;
    color: #d4af5a;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .mail-link {
    display: block;
    margin-top: 8px;
    text-align: center;
    color: #a47ac0;
    text-decoration: underline;
    font-weight: 700;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .mail-link:hover { color: #d4af5a; }

  /* ─── MIDI player widget ─── */
  .stage-geocities .midi-player {
    background: #c0c0c0;
    border-top: 3px solid #fff;
    border-left: 3px solid #fff;
    border-right: 3px solid #404040;
    border-bottom: 3px solid #404040;
    padding: 6px;
  }
  .stage-geocities .midi-screen {
    background: #000;
    border: 2px inset #808080;
    padding: 4px 6px;
    margin-bottom: 4px;
  }
  .stage-geocities .midi-title {
    color: #50e878;
    font-family: 'Courier New', monospace;
    font-size: 10px;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
    text-shadow: 0 0 6px rgba(80, 232, 120, 0.85);
  }
  .stage-geocities .midi-bars {
    display: flex;
    align-items: end;
    justify-content: space-between;
    height: 24px;
    gap: 1px;
  }
  .stage-geocities .midi-bars span {
    flex: 1;
    background: linear-gradient(to top, #50e878 0%, #e8b840 50%, #c8243d 100%);
    animation: midi-bar 0.6s ease-in-out infinite alternate;
    transform-origin: bottom;
  }
  .stage-geocities .midi-bars span:nth-child(1)  { animation-delay: 0.0s; animation-duration: 0.55s; }
  .stage-geocities .midi-bars span:nth-child(2)  { animation-delay: 0.1s; animation-duration: 0.70s; }
  .stage-geocities .midi-bars span:nth-child(3)  { animation-delay: 0.2s; animation-duration: 0.65s; }
  .stage-geocities .midi-bars span:nth-child(4)  { animation-delay: 0.3s; animation-duration: 0.50s; }
  .stage-geocities .midi-bars span:nth-child(5)  { animation-delay: 0.4s; animation-duration: 0.80s; }
  .stage-geocities .midi-bars span:nth-child(6)  { animation-delay: 0.5s; animation-duration: 0.60s; }
  .stage-geocities .midi-bars span:nth-child(7)  { animation-delay: 0.6s; animation-duration: 0.45s; }
  .stage-geocities .midi-bars span:nth-child(8)  { animation-delay: 0.7s; animation-duration: 0.75s; }
  .stage-geocities .midi-bars span:nth-child(9)  { animation-delay: 0.8s; animation-duration: 0.55s; }
  .stage-geocities .midi-bars span:nth-child(10) { animation-delay: 0.9s; animation-duration: 0.65s; }
  @keyframes midi-bar {
    from { transform: scaleY(0.15); }
    to   { transform: scaleY(1); }
  }
  .stage-geocities .midi-controls {
    display: flex;
    gap: 2px;
    justify-content: center;
  }
  .stage-geocities .midi-btn {
    flex: 1;
    padding: 2px 0;
    background: #c0c0c0;
    border-top: 2px solid #fff;
    border-left: 2px solid #fff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    color: #000;
    font-family: 'Courier New', monospace;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
  }
  .stage-geocities .midi-btn:active {
    border-top-color: #404040;
    border-left-color: #404040;
    border-right-color: #fff;
    border-bottom-color: #fff;
  }
  .stage-geocities .midi-note {
    margin: 6px 0 0;
    text-align: center;
    font-size: 11px;
    color: #a47ac0;
    text-shadow: 1px 1px 0 #000;
    font-style: italic;
  }

  /* ─── Radio widget : station tabs + playing state ─── */
  .stage-geocities .widget-radio audio { display: none; }
  .stage-geocities .station-tabs {
    list-style: none;
    margin: 0 0 4px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
  }
  .stage-geocities .station-tab {
    width: 100%;
    padding: 3px 2px;
    background: linear-gradient(180deg, #c0c0c0 0%, #808080 100%);
    border-top: 2px solid #fff;
    border-left: 2px solid #fff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    color: #1a0a08;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    text-shadow: none;
  }
  .stage-geocities .station-tab:hover {
    background: linear-gradient(180deg, #fff8d4 0%, #e8b840 100%);
    color: #1a0a08;
  }
  .stage-geocities .station-tab.is-on {
    background: linear-gradient(180deg, #ffd96a 0%, #a87018 100%);
    color: #1a0a08;
    border-top-color: #404040;
    border-left-color: #404040;
    border-right-color: #fff8d4;
    border-bottom-color: #fff8d4;
    text-shadow: 1px 1px 0 rgba(255, 248, 212, 0.5);
  }
  /*
   * Bar animation handoff. The default .midi-bars span has a CSS
   * keyframe stagger that's right for the *fake* MIDI player. The
   * radio widget overrides that:
   *   - stopped : no animation, bars flat low
   *   - playing : no keyframe either — the visualizer's JS sets
   *     scaleY() inline from Web Audio frequency data each frame.
   *     Adding `transition: transform 60ms linear` smooths the
   *     per-frame jumps so quiet bins don't twitch visibly.
   */
  .stage-geocities .widget-radio:not(.is-playing) .midi-bars span {
    animation: none;
    transform: scaleY(0.15);
  }
  .stage-geocities .widget-radio.is-playing .midi-bars span {
    animation: none;
    transition: transform 60ms linear;
    background: linear-gradient(to top, #50e878 0%, #ffd96a 45%, #ff4a3a 100%);
  }
  .stage-geocities .widget-radio.is-playing .midi-title::before {
    content: "● ";
    color: #ff4a3a;
    text-shadow: 0 0 6px rgba(255, 74, 58, 0.9);
    animation: geo-blink 1.2s steps(2, end) infinite;
  }
  .stage-geocities .widget-radio .midi-title {
    /* Track name + scrolling */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }
  .stage-geocities .midi-btn[data-role="play"].is-playing { color: #c8243d; }

  /* ─── STATS widget ─── */
  .stage-geocities .stats {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 8px;
    font-family: 'Courier New', monospace;
    font-size: 11px;
  }
  .stage-geocities .stats dt {
    color: #d4af5a;
    text-shadow: 1px 1px 0 #000;
    font-weight: 700;
  }
  .stage-geocities .stats dd {
    margin: 0;
    color: #b0a8d9;
    text-shadow: 1px 1px 0 #000;
  }

  /* ─── AWARDS widget ─── */
  .stage-geocities .awards-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .stage-geocities .award {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    background: linear-gradient(135deg, #c9a961 0%, #d4af5a 50%, #c9a961 100%);
    color: #4a2c00;
    border: 2px ridge #fff;
    box-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .award-ribbon {
    font-size: 20px;
    color: #c00;
    text-shadow: 1px 1px 0 #fff;
    flex-shrink: 0;
    animation: geo-blink 1.6s steps(2, end) infinite;
  }
  .stage-geocities .award-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .stage-geocities .award-text strong {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #4a2c00;
    text-shadow: 1px 1px 0 rgba(255,255,255,0.6);
  }
  .stage-geocities .award-text small {
    font-size: 10px;
    color: #6b3a00;
    font-style: italic;
  }

  /* ─── QUOTE widget ─── */
  .stage-geocities .qotd {
    margin: 0;
    padding: 8px 10px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px dashed #b0a8d9;
  }
  .stage-geocities .qotd p {
    margin: 0 0 6px;
    color: #fff;
    font-style: italic;
    text-shadow: 1px 1px 0 #000;
    line-height: 1.4;
  }
  .stage-geocities .qotd cite {
    display: block;
    text-align: right;
    color: #d4af5a;
    font-style: normal;
    font-size: 11px;
    text-shadow: 1px 1px 0 #000;
  }

  /* ─── BANNER AD widget ─── */
  .stage-geocities .widget-ad { padding: 6px; border-color: #8b1a1a; }
  .stage-geocities .ad-tag {
    font-family: 'Courier New', monospace;
    font-size: 9px;
    color: #a47ac0;
    text-align: center;
    margin-bottom: 4px;
    letter-spacing: 0.15em;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .banner-ad {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .stage-geocities .ad-blitz {
    position: relative;
    height: 140px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #6b1f2a 0%, #c9a961 50%, #8090c8 100%);
    border: 2px solid #000;
    overflow: hidden;
    text-align: center;
  }
  /*
   * Stripe overlay. Earlier version animated background-position by
   * (22px, 22px), but a 45deg repeating gradient with a 16px stripe
   * period actually has a CSS-space period of 16*sqrt(2) = 22.627px.
   * The 0.627px-per-cycle mismatch showed as a visible vertical seam
   * cutting across the ad each loop.
   *
   * Fix mirrors the hazard-tape: wrap in overflow:hidden, paint the
   * stripes on an oversized child, and translate the child by exactly
   * one diagonal period (16*sqrt(2) px). The loop is seamless because
   * the translate matches one full pattern period.
   */
  .stage-geocities .ad-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .stage-geocities .ad-bg-stripes {
    position: absolute;
    top: -32px;
    bottom: -32px;
    left: -48px;
    right: -48px;
    background-image: repeating-linear-gradient(
      45deg,
      transparent 0,
      transparent 8px,
      rgba(255,255,255,0.18) 8px,
      rgba(255,255,255,0.18) 16px
    );
    animation: ad-stripes 1.2s linear infinite;
    will-change: transform;
  }
  @keyframes ad-stripes {
    /*
     * Translate vector must project onto the gradient axis (45deg =
     * (sin45, -cos45) ≈ (0.707, -0.707)) by exactly an integer period
     * of 16px. translate(0, 22.627px) projects to -16 along that axis:
     * one full period back, so the loop reads as seamless downward
     * scroll instead of a jumpy diagonal that was the original bug.
     * Stripes orientation (top-left → bottom-right) is unchanged.
     */
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(0, 22.627417px, 0); }
  }
  .stage-geocities .ad-text-1,
  .stage-geocities .ad-text-2,
  .stage-geocities .ad-text-3,
  .stage-geocities .ad-text-4 {
    position: relative;
    font-family: 'Impact', 'Comic Neue', sans-serif;
    line-height: 1;
    color: #fff;
    text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000;
    letter-spacing: 0.02em;
  }
  .stage-geocities .ad-text-1 {
    font-size: 24px;
    color: #d4af5a;
    animation: ad-pulse 0.6s ease-in-out infinite alternate;
  }
  .stage-geocities .ad-text-2 {
    font-family: 'Comic Neue', cursive;
    font-size: 12px;
    color: #d4af5a;
    transform: rotate(-3deg);
  }
  .stage-geocities .ad-text-3 {
    font-size: 22px;
    color: #fff;
    letter-spacing: 0.03em;
  }
  .stage-geocities .ad-text-4 {
    font-size: 18px;
    color: #d4af5a;
    animation: ad-pulse 0.5s ease-in-out infinite alternate;
  }
  @keyframes ad-pulse {
    from { transform: scale(1); }
    to   { transform: scale(1.07); }
  }
  .stage-geocities .ad-icon {
    position: absolute;
    right: 6px;
    bottom: 6px;
    font-size: 28px;
    filter: drop-shadow(1px 1px 0 #000);
    animation: ad-pulse 0.7s ease-in-out infinite alternate;
  }
  /*
   * Attention-grab without ever going invisible: alternate the
   * background between black and dark-red on a 0.6s cycle while the
   * yellow text stays solidly readable the whole time. Previous
   * implementation used .blink (opacity 0/1 step animation), which
   * made the CTA disappear for half of each cycle — explains the
   * "missing button" screenshot.
   */
  .stage-geocities .ad-cta {
    margin-top: 4px;
    padding: 6px 4px;
    background: #000;
    color: #d4af5a;
    text-align: center;
    font-family: 'Impact', 'Comic Neue', sans-serif;
    font-size: 15px;
    letter-spacing: 0.05em;
    border: 2px dashed #a83247;
    text-shadow: 1px 1px 0 #c00;
    animation: ad-cta-flash 0.6s steps(2, end) infinite;
  }
  @keyframes ad-cta-flash {
    0%, 49%   { background: #000; border-color: #a83247; }
    50%, 100% { background: #c00; border-color: #d4af5a; }
  }
  .stage-geocities .banner-ad:hover .ad-cta {
    animation: none;
    background: #a83247;
    color: #d4af5a;

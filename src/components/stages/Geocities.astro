  .stage-geocities .mit-banner-title {
    margin: 0;
    font-weight: 900;
    font-family: 'Impact', 'Arial Black', sans-serif;
    font-size: 30px;
    line-height: 1;
    letter-spacing: 0.04em;
    text-shadow:

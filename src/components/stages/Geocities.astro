  /* ─── GUESTBOOK preview widget ─── */
  .stage-geocities .widget-gbook { border-color: #b0a8d9; }
  .stage-geocities .gbook-list {
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .stage-geocities .gbook-list li {
    padding: 5px 7px;
    background: rgba(0, 0, 0, 0.4);
    border-left: 3px solid #d4af5a;
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.3;
  }
  .stage-geocities .gbook-list li:nth-child(2) { border-left-color: #a47ac0; }
  .stage-geocities .gbook-list li:nth-child(3) { border-left-color: #b0a8d9; }
  .stage-geocities .gbook-q {
    color: #fff;
    font-style: italic;
    text-shadow: 1px 1px 0 #000;
    font-size: 11px;
  }
  .stage-geocities .gbook-sig {
    color: #d4af5a;
    font-family: 'Courier New', monospace;
    font-size: 10px;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .gbook-all {
    display: block;
    text-align: center;
    color: #a47ac0;
    text-decoration: underline;
    font-size: 11px;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .gbook-all:hover { color: #d4af5a; }

  /* Highlighted nav entry (GITHUB!!! at the top) */
  .stage-geocities .widget-nav .nav-hot {
    background: linear-gradient(90deg, #a83247 0%, #d4af5a 50%, #b0a8d9 100%);
    color: #000 !important;
    text-shadow: 1px 1px 0 #fff;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px dashed #000;
    animation: btn-pulse 1.3s ease-in-out infinite;
  }
  .stage-geocities .widget-nav .nav-hot:hover {
    background: linear-gradient(90deg, #b0a8d9 0%, #d4af5a 50%, #a83247 100%);
    color: #000 !important;
  }
  @keyframes btn-pulse {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.03); }
  }
  .stage-geocities .cta-sub {
    margin: 10px 0 0;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    color: #d4af5a;
    font-size: 14px;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .cta-sub .blink { color: #c44a2a; }

  /* ─── NOW FEATURING : affiliate banner trio ─── */
  .stage-geocities .featuring { margin: 28px 0; }
  .stage-geocities .feat-sub {
    margin: 0 0 16px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-weight: 700;
    color: #d4af5a;
    font-size: 14px;
    text-align: center;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .feat-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .stage-geocities .feat { display: flex; }
  .stage-geocities .feat > a {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 12px 10px 10px;
    text-decoration: none;
    color: #fff;
    background: linear-gradient(180deg, rgba(40, 14, 92, 0.65) 0%, rgba(10, 4, 32, 0.95) 100%);
    border: 3px ridge #e8b840;
    box-shadow: inset 0 0 20px rgba(120, 40, 180, 0.3), 3px 3px 0 #000;
    transition: transform 90ms ease, box-shadow 90ms ease;
  }
  .stage-geocities .feat > a:hover {
    transform: translate(-1px, -1px);
    box-shadow: inset 0 0 24px rgba(168, 32, 100, 0.4), 5px 5px 0 #000;
  }
  .stage-geocities .feat > a:active { transform: translate(2px, 2px); box-shadow: inset 0 0 20px rgba(120,40,180,0.3), 1px 1px 0 #000; }
  .stage-geocities .feat-repo > a { border-color: #8db04a; }
  .stage-geocities .feat-spec > a { border-color: #e8b840; }
  .stage-geocities .feat-vpk  > a { border-color: #b660e0; }
  .stage-geocities .feat-tag {
    align-self: stretch;
    margin: -12px -10px 4px;
    padding: 3px 6px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
    color: #1a0a08;
    background: linear-gradient(90deg, #5a0a18, #a82010 30%, #e8b840 50%, #a82010 70%, #5a0a18);
    border-bottom: 2px solid #1a0a08;
    text-shadow: 1px 1px 0 rgba(255, 248, 212, 0.6);
  }
  .stage-geocities .feat-ico {
    font-size: 30px;
    line-height: 1;
    filter: drop-shadow(1px 1px 0 #000);
    animation: feat-bob 2.2s ease-in-out infinite;
  }
  .stage-geocities .feat-spec .feat-ico { animation-delay: 0.3s; }
  .stage-geocities .feat-vpk .feat-ico { animation-delay: 0.6s; }
  @keyframes feat-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
  .stage-geocities .feat-title {
    font-family: 'Comic Neue', 'Comic Sans MS', 'Impact', sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 1.05;
    text-align: center;
    background: linear-gradient(180deg, #fff8d4 0%, #ffd96a 40%, #e8b840 70%, #a87018 100%);
    -webkit-background-clip: text;
            background-clip: text;
    color: transparent;
    filter: drop-shadow(0 1px 0 rgba(10, 6, 18, 0.9));
  }
  .stage-geocities .feat-pitch {
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-size: 11px;
    line-height: 1.35;
    text-align: center;
    color: #fff5db;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .feat-cta {
    margin-top: 2px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;

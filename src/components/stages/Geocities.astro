<script>
  /*
   * Sparkle cursor trail. Scoped to the geocities stage only. Emits a
   * tiny ★ at the cursor every ~80ms while the mouse is inside the
   * section; each sparkle fades + drifts for 700ms. Respects
   * prefers-reduced-motion. Pointer-events:none so it never interferes
   * with clicks. Uses passive event listeners to keep scroll smooth.
   */
  if (typeof window !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const stage = document.querySelector('.stage-geocities');
    const trail = stage?.querySelector('.sparkle-trail');
    if (stage && trail) {
      let last = 0;
      const colors = ['#ffff00', '#ff66ff', '#00ffff', '#66ff66', '#ff3b1f'];
      stage.addEventListener('mousemove', (event) => {
        const e = event as MouseEvent;
        const now = performance.now();
        if (now - last < 70) return;
        last = now;
        const rect = stage.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const s = document.createElement('span');
        s.className = 'sparkle';
        s.textContent = '★';
        s.style.left = x + 'px';
        s.style.top = y + 'px';
        s.style.color = colors[Math.floor(Math.random() * colors.length)];
        s.style.setProperty('--dx', (Math.random() * 24 - 12) + 'px');
        s.style.setProperty('--dy', (Math.random() * -32 - 8) + 'px');
        trail.appendChild(s);
        setTimeout(() => s.remove(), 700);
      }, { passive: true });
    }
  }
</script>

<style>
  /* ─────────────────────────────────────────────────────────────────
     GEOCITIES: scoped 1996 amateur web world. Starfield bg, marquees,
     WordArt headline, hazard-tape Under Construction GIF (CSS-only),
     LED visitor counter, blinking NEW!!! ribbon, 88x31 webring badges.
     Times Roman body + Comic Sans accents. Hot pink, cyan, lime, yellow.
     ───────────────────────────────────────────────────────────────── */
  .stage-geocities {
    background: #000010;
    color: #ffffff;
    font-family: 'Times New Roman', Times, serif;
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
    display: block;
    min-height: 100vh;
    padding: 0;
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .stage-geocities .starfield {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: #000010;
    background-image:
      radial-gradient(1px 1px at 5% 8%, #ffffff, transparent),
      radial-gradient(1px 1px at 15% 22%, #ffffff, transparent),
      radial-gradient(2px 2px at 24% 12%, #ffffff, transparent),
      radial-gradient(1px 1px at 38% 28%, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 50% 18%, #cce, transparent),
      radial-gradient(1px 1px at 63% 32%, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 75% 14%, #ffffff, transparent),
      radial-gradient(1px 1px at 88% 26%, #fcc, transparent),
      radial-gradient(1.5px 1.5px at 11% 48%, #ffffff, transparent),
      radial-gradient(1px 1px at 28% 56%, #ffffff, transparent),
      radial-gradient(2px 2px at 44% 64%, #ffffff, transparent),
      radial-gradient(1px 1px at 58% 48%, #ccf, transparent),
      radial-gradient(1.5px 1.5px at 72% 56%, #ffffff, transparent),
      radial-gradient(1px 1px at 86% 68%, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 8% 78%, #ffffff, transparent),
      radial-gradient(1px 1px at 22% 88%, #fcc, transparent),
      radial-gradient(2px 2px at 36% 76%, #ffffff, transparent),
      radial-gradient(1px 1px at 54% 92%, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 68% 84%, #ccf, transparent),
      radial-gradient(1px 1px at 81% 96%, #ffffff, transparent),
      radial-gradient(1px 1px at 94% 80%, #ffffff, transparent);
    background-size: 100% 100%;
    animation: stars-twinkle 4s ease-in-out infinite alternate;
  }
  @keyframes stars-twinkle {
    from { opacity: 0.7; }
    to   { opacity: 1; }
  }

  .stage-geocities a {
    color: #00ffff;
    text-decoration: underline;
  }
  .stage-geocities a:visited { color: #ff66ff; }
  .stage-geocities a:hover { color: #ffff00; }

  /* ─── Marquees ─── */
  .stage-geocities .top-marquee,
  .stage-geocities .bot-marquee {
    position: relative;
    z-index: 2;
    overflow: hidden;
    background: #000080;
    border-top: 2px solid #ff00ff;
    border-bottom: 2px solid #ff00ff;
    color: #ffff00;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-weight: 700;
    font-size: 14px;
    text-shadow: 1px 1px 0 #000;
    padding: 4px 0;
  }
  .stage-geocities .track {
    display: inline-flex;
    white-space: nowrap;
    animation: geo-scroll 22s linear infinite;
  }
  .stage-geocities .track > span { padding: 0 18px; }
  @keyframes geo-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ─── Page wrapper ─── */
  .stage-geocities .page {
    position: relative;
    z-index: 2;
    max-width: 1140px;
    margin: 0 auto;
    padding: 36px 16px 0;
  }

  /* ─── Tiled wallpaper layered behind the stars ───
     Authentic GeoCities pages used a repeating .gif tile. We approximate
     with a CSS-generated radial tile so the bg has texture even where
     stars don't land. Subtle on purpose: starfield still dominates. */
  .stage-geocities::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 25% 25%, rgba(255, 0, 255, 0.08) 0, transparent 18%),
      radial-gradient(circle at 75% 75%, rgba(0, 255, 255, 0.08) 0, transparent 18%),
      linear-gradient(45deg, transparent 48%, rgba(255, 255, 0, 0.04) 49%, rgba(255, 255, 0, 0.04) 51%, transparent 52%);
    background-size: 64px 64px, 64px 64px, 32px 32px;
    opacity: 0.7;
  }

  /* ─── Frameset 3-column layout ─── */
  .stage-geocities .frameset {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 240px;
    gap: 18px;
    align-items: start;
    margin-top: 24px;
  }
  .stage-geocities .content {
    min-width: 0;
  }
  .stage-geocities .rail {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* ─── Sidebar widget shell ─── */
  .stage-geocities .widget {
    background: rgba(0, 0, 32, 0.78);
    border: 3px ridge #ffff00;
    padding: 10px;
    text-align: left;
    color: #fff;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-size: 12px;
    line-height: 1.4;
  }
  .stage-geocities .rail-left .widget:nth-child(2n) { border-color: #00ffff; }
  .stage-geocities .rail-left .widget:nth-child(3n) { border-color: #ff00ff; }
  .stage-geocities .rail-right .widget:nth-child(2n) { border-color: #66ff00; }
  .stage-geocities .rail-right .widget:nth-child(3n) { border-color: #ff66ff; }
  .stage-geocities .widget-h {
    margin: -10px -10px 10px;
    padding: 4px 8px;
    background: linear-gradient(90deg, #ff00ff 0%, #ffff00 50%, #00ffff 100%);
    color: #000;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    text-shadow: 1px 1px 0 #fff;
    border-bottom: 2px solid #000;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* ─── NAV widget ─── */
  .stage-geocities .widget-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stage-geocities .widget-nav a {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    color: #00ffff;
    text-decoration: underline;
    font-weight: 700;
    text-shadow: 1px 1px 0 #000;
    border: 1px dotted transparent;
  }
  .stage-geocities .widget-nav a:hover {
    color: #ffff00;
    background: rgba(255, 0, 255, 0.18);
    border-color: #ff00ff;
  }
  .stage-geocities .navico { font-size: 13px; }

  /* ─── ABOUT ME widget + CRT photo placeholder ─── */
  .stage-geocities .widget-about .photo {
    text-align: center;
    margin-bottom: 8px;
  }
  .stage-geocities .crt {
    position: relative;
    width: 110px;
    height: 90px;
    margin: 0 auto;
    background: #1a3a1a;
    border: 4px outset #888;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 3px 0 #333;
  }
  .stage-geocities .crt-scan {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      rgba(0, 255, 0, 0.08) 0,
      rgba(0, 255, 0, 0.08) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
    animation: crt-flicker 2.4s ease-in-out infinite;
  }
  @keyframes crt-flicker {
    0%, 100% { opacity: 0.8; }
    50%      { opacity: 1; }
  }
  .stage-geocities .crt-face {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    place-items: center;
  }
  .stage-geocities .crt-face .eye {
    width: 14px;
    height: 14px;
    background: #00ff00;
    border-radius: 50%;
    box-shadow: 0 0 8px #00ff00;
  }
  .stage-geocities .crt-face .e-l { grid-column: 1; grid-row: 1; justify-self: end; margin-right: 6px; }
  .stage-geocities .crt-face .e-r { grid-column: 2; grid-row: 1; justify-self: start; margin-left: 6px; }
  .stage-geocities .crt-face .mouth {
    grid-column: 1 / -1;
    grid-row: 2;
    width: 36px;
    height: 10px;
    border-bottom: 3px solid #00ff00;
    border-radius: 0 0 18px 18px;
    box-shadow: 0 4px 8px -2px #00ff00;
  }
  .stage-geocities .photo-caption {
    margin: 6px 0 0;
    font-family: 'Courier New', monospace;
    font-size: 10px;
    color: #ffff00;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .about-blurb {
    margin: 0 0 8px;
    color: #fff;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .about-blurb strong { color: #ffff00; }
  .stage-geocities .about-blurb em { color: #66ff66; font-style: italic; }
  .stage-geocities .vitals {
    list-style: none;
    margin: 0;
    padding: 8px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px dashed #ff66ff;
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: #00ffff;
  }
  .stage-geocities .vitals li { line-height: 1.5; }
  .stage-geocities .vitals b { color: #ffff00; margin-right: 4px; }

  /* ─── MAILBOX widget ─── */
  .stage-geocities .mailbox {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    background: rgba(0, 0, 0, 0.4);
    border: 2px ridge #00ffff;
  }
  .stage-geocities .mail-icon {
    font-size: 30px;
    line-height: 1;
  }
  .stage-geocities .mail-count {
    font-family: 'Impact', 'Comic Neue', sans-serif;
    font-size: 28px;
    color: #ff3b1f;
    line-height: 1;
    text-shadow: 0 0 6px #ff3b1f, 1px 1px 0 #000;
  }
  .stage-geocities .mail-sub {
    font-size: 11px;
    color: #ffff00;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .mail-link {
    display: block;
    margin-top: 8px;
    text-align: center;
    color: #ff66ff;
    text-decoration: underline;
    font-weight: 700;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .mail-link:hover { color: #ffff00; }

  /* ─── MIDI player widget ─── */
  .stage-geocities .midi-player {
    background: #c0c0c0;
    border-top: 3px solid #fff;
    border-left: 3px solid #fff;
    border-right: 3px solid #404040;
    border-bottom: 3px solid #404040;
    padding: 6px;
  }
  .stage-geocities .midi-screen {
    background: #000;
    border: 2px inset #808080;
    padding: 4px 6px;
    margin-bottom: 4px;
  }
  .stage-geocities .midi-title {
    color: #00ff00;
    font-family: 'Courier New', monospace;
    font-size: 10px;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
    text-shadow: 0 0 4px #00ff00;
  }
  .stage-geocities .midi-bars {
    display: flex;
    align-items: end;
    justify-content: space-between;
    height: 24px;
    gap: 1px;
  }
  .stage-geocities .midi-bars span {
    flex: 1;
    background: linear-gradient(to top, #00ff00 0%, #ffff00 50%, #ff0000 100%);
    animation: midi-bar 0.6s ease-in-out infinite alternate;
    transform-origin: bottom;
  }
  .stage-geocities .midi-bars span:nth-child(1)  { animation-delay: 0.0s; animation-duration: 0.55s; }
  .stage-geocities .midi-bars span:nth-child(2)  { animation-delay: 0.1s; animation-duration: 0.70s; }
  .stage-geocities .midi-bars span:nth-child(3)  { animation-delay: 0.2s; animation-duration: 0.65s; }
  .stage-geocities .midi-bars span:nth-child(4)  { animation-delay: 0.3s; animation-duration: 0.50s; }
  .stage-geocities .midi-bars span:nth-child(5)  { animation-delay: 0.4s; animation-duration: 0.80s; }
  .stage-geocities .midi-bars span:nth-child(6)  { animation-delay: 0.5s; animation-duration: 0.60s; }
  .stage-geocities .midi-bars span:nth-child(7)  { animation-delay: 0.6s; animation-duration: 0.45s; }
  .stage-geocities .midi-bars span:nth-child(8)  { animation-delay: 0.7s; animation-duration: 0.75s; }
  .stage-geocities .midi-bars span:nth-child(9)  { animation-delay: 0.8s; animation-duration: 0.55s; }
  .stage-geocities .midi-bars span:nth-child(10) { animation-delay: 0.9s; animation-duration: 0.65s; }
  @keyframes midi-bar {
    from { transform: scaleY(0.15); }
    to   { transform: scaleY(1); }
  }
  .stage-geocities .midi-controls {
    display: flex;
    gap: 2px;
    justify-content: center;
  }
  .stage-geocities .midi-btn {
    flex: 1;
    padding: 2px 0;
    background: #c0c0c0;
    border-top: 2px solid #fff;
    border-left: 2px solid #fff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    color: #000;
    font-family: 'Courier New', monospace;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
  }
  .stage-geocities .midi-btn:active {
    border-top-color: #404040;
    border-left-color: #404040;
    border-right-color: #fff;
    border-bottom-color: #fff;
  }
  .stage-geocities .midi-note {
    margin: 6px 0 0;
    text-align: center;
    font-size: 11px;
    color: #ff66ff;
    text-shadow: 1px 1px 0 #000;
    font-style: italic;
  }

  /* ─── STATS widget ─── */
  .stage-geocities .stats {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 8px;
    font-family: 'Courier New', monospace;
    font-size: 11px;
  }
  .stage-geocities .stats dt {
    color: #ffff00;
    text-shadow: 1px 1px 0 #000;
    font-weight: 700;
  }
  .stage-geocities .stats dd {
    margin: 0;
    color: #00ffff;
    text-shadow: 1px 1px 0 #000;
  }

  /* ─── AWARDS widget ─── */
  .stage-geocities .awards-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .stage-geocities .award {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    background: linear-gradient(135deg, #ffd700 0%, #ffeb3b 50%, #ffd700 100%);
    color: #4a2c00;
    border: 2px ridge #fff;
    box-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .award-ribbon {
    font-size: 20px;
    color: #c00;
    text-shadow: 1px 1px 0 #fff;
    flex-shrink: 0;
    animation: geo-blink 1.6s steps(2, end) infinite;
  }
  .stage-geocities .award-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .stage-geocities .award-text strong {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #4a2c00;
    text-shadow: 1px 1px 0 rgba(255,255,255,0.6);
  }
  .stage-geocities .award-text small {
    font-size: 10px;
    color: #6b3a00;
    font-style: italic;
  }

  /* ─── QUOTE widget ─── */
  .stage-geocities .qotd {
    margin: 0;
    padding: 8px 10px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px dashed #00ffff;
  }
  .stage-geocities .qotd p {
    margin: 0 0 6px;
    color: #fff;
    font-style: italic;
    text-shadow: 1px 1px 0 #000;
    line-height: 1.4;
  }
  .stage-geocities .qotd cite {
    display: block;
    text-align: right;
    color: #ffff00;
    font-style: normal;
    font-size: 11px;
    text-shadow: 1px 1px 0 #000;
  }

  /* ─── BANNER AD widget ─── */
  .stage-geocities .widget-ad { padding: 6px; border-color: #ff0000; }
  .stage-geocities .ad-tag {
    font-family: 'Courier New', monospace;
    font-size: 9px;
    color: #ff66ff;
    text-align: center;
    margin-bottom: 4px;
    letter-spacing: 0.15em;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .banner-ad {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .stage-geocities .ad-monkey {
    position: relative;
    height: 110px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #ff0066 0%, #ffcc00 50%, #00ccff 100%);
    border: 2px solid #000;
    overflow: hidden;
    text-align: center;
  }
  .stage-geocities .ad-bg {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      45deg,
      transparent 0,
      transparent 8px,
      rgba(255,255,255,0.18) 8px,
      rgba(255,255,255,0.18) 16px
    );
    animation: ad-stripes 1.2s linear infinite;
  }
  @keyframes ad-stripes {
    from { background-position: 0 0; }
    to   { background-position: 22px 22px; }
  }
  .stage-geocities .ad-text-1,
  .stage-geocities .ad-text-2,
  .stage-geocities .ad-text-3 {
    position: relative;
    font-family: 'Impact', 'Comic Neue', sans-serif;
    line-height: 1;
    color: #fff;
    text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000;
    letter-spacing: 0.02em;
  }
  .stage-geocities .ad-text-1 { font-size: 24px; }
  .stage-geocities .ad-text-2 {
    font-family: 'Comic Neue', cursive;
    font-size: 13px;
    color: #ffff00;
    transform: rotate(-4deg);
  }
  .stage-geocities .ad-text-3 {
    font-size: 26px;
    color: #ff0;
    animation: ad-pulse 0.6s ease-in-out infinite alternate;
  }
  @keyframes ad-pulse {
    from { transform: scale(1); }
    to   { transform: scale(1.07); }
  }
  .stage-geocities .ad-monkey-face {
    position: absolute;
    right: 6px;
    bottom: 6px;
    font-size: 32px;
    filter: drop-shadow(1px 1px 0 #000);
  }
  .stage-geocities .ad-cta {
    margin-top: 4px;
    padding: 4px;
    background: #000;
    color: #ffff00;
    text-align: center;
    font-family: 'Impact', 'Comic Neue', sans-serif;
    font-size: 14px;
    letter-spacing: 0.04em;
    border: 1px dashed #ff00ff;
  }
  .stage-geocities .banner-ad:hover .ad-cta {
    background: #ff00ff;
    color: #ffff00;
  }
  .stage-geocities .ad-disclaimer {
    margin: 4px 0 0;
    font-size: 9px;
    color: #888;
    text-align: center;
    font-style: italic;
  }

  /* ─── FRIENDS widget ─── */
  .stage-geocities .friends-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: 'Courier New', monospace;
    font-size: 11px;
  }
  .stage-geocities .friends-list li {
    display: flex;
    gap: 6px;
    padding: 3px 0;
    border-bottom: 1px dotted rgba(255, 255, 255, 0.18);
  }
  .stage-geocities .friends-list li:last-child { border-bottom: none; }
  .stage-geocities .dot { color: #ff66ff; }
  .stage-geocities .friend-name {
    color: #00ffff;
    text-decoration: underline;
    flex: 1;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .friend-tag { color: #ffff00; text-shadow: 1px 1px 0 #000; }
  .stage-geocities .friend-note {
    margin: 6px 0 0;
    font-size: 10px;
    color: #888;
    font-style: italic;
    text-align: center;
  }

  /* ─── FAMILY FRIENDLY seal ─── */
  .stage-geocities .widget-seal { text-align: center; }
  .stage-geocities .seal {
    position: relative;
    width: 130px;
    height: 130px;
    margin: 0 auto;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, #fff 0, #fff 45%, transparent 46%),
      conic-gradient(from 0deg, #ff00ff, #ffff00, #00ffff, #66ff66, #ff00ff);
    display: grid;
    place-items: center;
    animation: seal-spin 8s linear infinite;
    box-shadow: 0 0 10px #ff00ff, 0 0 20px rgba(255, 0, 255, 0.5);
  }
  @keyframes seal-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  .stage-geocities .seal-ring {
    position: absolute;
    inset: 10%;
    border: 2px dashed #000;
    border-radius: 50%;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0;
    background: #fff;
    color: #c00;
    font-family: 'Impact', 'Comic Neue', sans-serif;
    text-shadow: 1px 1px 0 #ffeb3b;
    line-height: 1;
    animation: seal-spin 8s linear infinite reverse;
  }
  .stage-geocities .seal-ring strong { font-size: 14px; }
  .stage-geocities .seal-ring span   { font-size: 10px; color: #000; margin: 2px 0; }
  .stage-geocities .seal-star {
    position: absolute;
    color: #ff0;
    font-size: 16px;
    bottom: 8px;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .seal-cap {
    margin: 6px 0 0;
    color: #ffff00;
    font-size: 11px;
    text-shadow: 1px 1px 0 #000;
  }

  /* ─── TIME widget ─── */
  .stage-geocities .today {
    text-align: center;
    padding: 6px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px dashed #00ff00;
  }
  .stage-geocities .today-date {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: #00ff00;
    text-shadow: 0 0 4px #00ff00;
    letter-spacing: 0.04em;
  }
  .stage-geocities .today-sub {
    margin-top: 4px;
    font-size: 11px;
    color: #ffff00;
    text-shadow: 1px 1px 0 #000;
  }

  /* ─── Animated separators (GIF stand-ins) ─── */
  .stage-geocities .sep {
    margin: 18px 0;
    height: 14px;
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
  }
  .stage-geocities .sep-flame {
    background:
      repeating-linear-gradient(
        90deg,
        #ff0000 0,
        #ff6600 8px,
        #ffcc00 16px,
        #ff6600 24px,
        #ff0000 32px
      );
    background-size: 32px 100%;
    animation: sep-scroll-l 1.2s linear infinite;
  }
  .stage-geocities .sep-rainbow {
    background: linear-gradient(
      90deg,
      #ff0000, #ff8800, #ffff00, #00ff00, #00ffff, #0066ff, #ff00ff, #ff0000
    );
    background-size: 200% 100%;
    animation: sep-scroll-r 2.4s linear infinite;
  }
  .stage-geocities .sep-lightning {
    background:
      repeating-linear-gradient(
        135deg,
        #ffff00 0,
        #ffff00 6px,
        #000080 6px,
        #000080 12px,
        #00ffff 12px,
        #00ffff 18px,
        #000080 18px,
        #000080 24px
      );
    background-size: 48px 100%;
    animation: sep-scroll-l 0.8s linear infinite;
  }
  @keyframes sep-scroll-l {
    from { background-position: 0 0; }
    to   { background-position: -64px 0; }
  }
  @keyframes sep-scroll-r {
    from { background-position: 0 0; }
    to   { background-position: 100% 0; }
  }

  /* ─── Extra webring badges ─── */
  .stage-geocities .b-ie  { background: linear-gradient(180deg, #fff 0%, #cce 100%); color: #003; text-shadow: none; }
  .stage-geocities .b-vim { background: #006400; color: #ffffff; }

  /* ─── ASCII signature ─── */
  .stage-geocities .ascii-sig {
    margin: 24px auto 10px;
    padding: 12px;
    background: rgba(0, 0, 0, 0.55);
    border: 2px ridge #66ff00;
    color: #66ff00;
    font-family: 'Courier New', monospace;
    font-size: 11px;
    line-height: 1.1;
    text-align: left;
    text-shadow: 0 0 4px rgba(102, 255, 0, 0.6);
    overflow-x: auto;
    white-space: pre;
    display: inline-block;
  }
  .stage-geocities .built-with {
    margin: 6px 0 18px;
    text-align: center;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    color: #ffff00;
    font-size: 12px;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .built-with strong { color: #ff66ff; }

  /* ─── Sparkle cursor trail ─── */
  .stage-geocities .sparkle-trail {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    overflow: hidden;
  }
  .stage-geocities .sparkle-trail :global(.sparkle) {
    position: absolute;
    font-size: 14px;
    line-height: 1;
    text-shadow: 0 0 6px currentColor, 0 0 2px #fff;
    pointer-events: none;
    animation: sparkle-fade 700ms ease-out forwards;
    transform: translate3d(0, 0, 0);
  }
  @keyframes sparkle-fade {
    from {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
    }
    to {
      opacity: 0;
      transform: translate3d(var(--dx, 0), var(--dy, -20px), 0) scale(0.4) rotate(180deg);
    }
  }

  /* ─── WordArt headline ─── */
  .stage-geocities .hero { margin-bottom: 32px; }
  .stage-geocities .wordart {
    margin: 0;

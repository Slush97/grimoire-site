      radial-gradient(circle at 12px 50%, #d4af5a 0 3px, transparent 4px) repeat-x,
      radial-gradient(circle at 12px 50%, transparent 5px, rgba(212, 175, 90, 0.45) 5px 6px, transparent 7px) repeat-x,
      linear-gradient(90deg, #1f1240, #2a1a4a, #1f1240);
    background-size: 24px 100%, 24px 100%, 100% 100%;
    animation: sep-scroll-l 5s linear infinite;
    border-top: 1px solid rgba(212, 175, 90, 0.5);
    border-bottom: 1px solid rgba(212, 175, 90, 0.5);

  /* ─── Webring : framed centerpiece with MIT medallion ─── */
  .stage-geocities .webring {
    margin: 36px auto;
    padding: 0;
  }
  .stage-geocities .webring-frame {
    position: relative;
    padding: 28px 18px 18px;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(168, 32, 100, 0.18) 0%, transparent 70%),
      linear-gradient(180deg, rgba(30, 10, 70, 0.55) 0%, rgba(8, 4, 26, 0.85) 100%);
    border: 3px ridge #c8243d;
    box-shadow:
      inset 0 0 0 1px rgba(255, 217, 106, 0.35),
      inset 0 0 30px rgba(120, 30, 60, 0.35),
      0 4px 0 #000;
  }
  .stage-geocities .webring-corner {
    position: absolute;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    color: #ffd96a;
    font-size: 18px;
    line-height: 1;
    background: #07041a;
    border: 2px ridge #c8243d;
    text-shadow: 0 0 6px rgba(255, 217, 106, 0.9);
    z-index: 2;
    animation: corner-pulse 2.4s ease-in-out infinite;
  }
  .stage-geocities .webring-corner-tl { top: -12px; left:  -12px; }
  .stage-geocities .webring-corner-tr { top: -12px; right: -12px; animation-delay: 0.6s; }
  .stage-geocities .webring-corner-bl { bottom: -12px; left:  -12px; animation-delay: 1.2s; }
  .stage-geocities .webring-corner-br { bottom: -12px; right: -12px; animation-delay: 1.8s; }
  @keyframes corner-pulse {
    0%, 100% { transform: rotate(0deg);   text-shadow: 0 0 4px rgba(255, 217, 106, 0.7); }
    50%      { transform: rotate(180deg); text-shadow: 0 0 12px rgba(255, 217, 106, 1); }
  }
  .stage-geocities .webring-h {
    margin: 0 0 14px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    color: #ffd96a;
    font-size: 18px;
    text-align: center;
    text-shadow: 1px 1px 0 #000, 0 0 10px rgba(255, 217, 106, 0.55);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stage-geocities .webring-h-star {
    color: #c8243d;
    margin: 0 6px;
  }

  /* ─── MIT LICENSED!! Geocities banner ─── */
  .stage-geocities .mit-medallion {
    display: block;
    position: relative;
    width: 100%;
    max-width: 540px;
    margin: 8px auto 14px;
    text-decoration: none;
    color: inherit;
    transition: transform 180ms ease;
  }
  .stage-geocities .mit-medallion:hover {
    transform: translateY(-2px) scale(1.01);
  }
  .stage-geocities .mit-banner {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(
        90deg,
        #ff2eb5 0%,
        #ffd96a 22%,
        #50e878 44%,
        #5acafe 66%,
        #b660e0 88%,
        #ff2eb5 100%
      );
    background-size: 220% 100%;
    border-top: 4px ridge #ffd96a;
    border-bottom: 4px ridge #ffd96a;
    border-left: 4px ridge #c8243d;
    border-right: 4px ridge #c8243d;
    box-shadow:
      inset 0 0 0 2px #000,
      inset 0 0 30px rgba(0, 0, 0, 0.35),
      0 4px 0 #000,
      0 6px 14px rgba(0, 0, 0, 0.55);
    animation: mit-rainbow-slide 5s linear infinite;
  }
  @keyframes mit-rainbow-slide {
    from { background-position:   0% 0%; }
    to   { background-position: 220% 0%; }
  }

  /* Diagonal hatch overlay for that broken-GIF texture */
  .stage-geocities .mit-banner-stripes {
    position: absolute;
    inset: 22px 0;
    background:
      repeating-linear-gradient(
        45deg,
        transparent 0 16px,
        rgba(0, 0, 0, 0.10) 16px 32px
      );
    pointer-events: none;
    z-index: 0;
  }

  /* Scrolling marquee strips top + bottom */
  .stage-geocities .mit-banner-top,
  .stage-geocities .mit-banner-bot {
    position: relative;
    height: 20px;
    background: #07041a;
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
    overflow: hidden;
    z-index: 1;
  }
  .stage-geocities .mit-banner-top    { box-shadow: inset 0 -1px 0 rgba(255, 217, 106, 0.55); }
  .stage-geocities .mit-banner-bot    { box-shadow: inset 0  1px 0 rgba(255, 217, 106, 0.55); }
  .stage-geocities .mit-banner-marquee {
    display: flex;
    white-space: nowrap;
    font-family: 'Courier New', monospace;
    font-size: 11px;
    line-height: 20px;
    color: #50e878;
    text-shadow: 0 0 4px rgba(80, 232, 120, 0.85), 1px 1px 0 #000;
    letter-spacing: 0.08em;
    animation: mit-marquee 14s linear infinite;
  }
  .stage-geocities .mit-banner-marquee.reverse {
    color: #ff66cc;
    text-shadow: 0 0 4px rgba(255, 102, 204, 0.85), 1px 1px 0 #000;
    animation-direction: reverse;
    animation-duration: 16s;
  }
  .stage-geocities .mit-banner-marquee > span { padding-right: 16px; }
  @keyframes mit-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* Main row */
  .stage-geocities .mit-banner-main {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 14px;
  }

  /* FREE!! / NO CATCH!! tilted sticker stamps */

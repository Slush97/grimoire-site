    background: linear-gradient(135deg, #6b1f2a 0%, #c9a961 50%, #8090c8 100%);
    border: 2px solid #000;
    overflow: hidden;
    text-align: center;
  }
  /*
   * Stripe overlay. Earlier version animated background-position by
   * (22px, 22px), but a 45deg repeating gradient with a 16px stripe
   * period actually has a CSS-space period of 16*sqrt(2) = 22.627px.
   * The 0.627px-per-cycle mismatch showed as a visible vertical seam
   * cutting across the ad each loop.
   *
   * Fix mirrors the hazard-tape: wrap in overflow:hidden, paint the
   * stripes on an oversized child, and translate the child by exactly
   * one diagonal period (16*sqrt(2) px). The loop is seamless because
   * the translate matches one full pattern period.
   */
  .stage-geocities .ad-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .stage-geocities .ad-bg-stripes {
    position: absolute;
    top: -32px;
    bottom: -32px;
    left: -48px;
    right: -48px;
    background-image: repeating-linear-gradient(
      45deg,
      transparent 0,
      transparent 8px,
      rgba(255,255,255,0.18) 8px,
      rgba(255,255,255,0.18) 16px
    );
    animation: ad-stripes 1.2s linear infinite;
    will-change: transform;
  }
  @keyframes ad-stripes {
    /*
     * Translate vector must project onto the gradient axis (45deg =
     * (sin45, -cos45) ≈ (0.707, -0.707)) by exactly an integer period
     * of 16px. translate(0, 22.627px) projects to -16 along that axis:
     * one full period back, so the loop reads as seamless downward
     * scroll instead of a jumpy diagonal that was the original bug.
     * Stripes orientation (top-left → bottom-right) is unchanged.
     */
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(0, 22.627417px, 0); }
  }
  .stage-geocities .ad-text-1,
  .stage-geocities .ad-text-2,
  .stage-geocities .ad-text-3,
  .stage-geocities .ad-text-4 {
    position: relative;
    font-family: 'Impact', 'Comic Neue', sans-serif;
    line-height: 1;
    color: #fff;
    text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000;
    letter-spacing: 0.02em;
  }
  .stage-geocities .ad-text-1 {
    font-size: 24px;
    color: #d4af5a;
    animation: ad-pulse 1.4s ease-in-out infinite alternate;
  }
  .stage-geocities .ad-text-2 {
    font-family: 'Comic Neue', cursive;
    font-size: 12px;
    color: #d4af5a;
    transform: rotate(-3deg);

  .stage-geocities .news-list li:nth-child(4n) { border-color: #9c7ae6; }
  .stage-geocities .news-list li:nth-child(4n) .bullet { background: #8db04a; color: #1a0a08; }

  /* ─── Download CTA ─── */
  .stage-geocities .download-cta { margin: 36px 0; }
  .stage-geocities .gdl-grid {
    list-style: none;
    margin: 18px auto 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    max-width: 560px;
  }
  .stage-geocities .gdl-grid li { display: flex; }
  .stage-geocities .gdl-grid .gdl-5,
  .stage-geocities .gdl-grid .gdl-gh,
  .stage-geocities .gdl-grid .gdl-codex { grid-column: span 2; }
  .stage-geocities .gdl-btn {
    flex: 1;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-size: 16px;
    font-weight: 700;
    color: #000;
    text-decoration: underline;
    border-top: 3px solid #fff;
    border-left: 3px solid #fff;
    border-right: 3px solid #000;
    border-bottom: 3px solid #000;
    box-shadow: 3px 3px 0 #000;
    text-shadow: none;
    transition: transform 80ms ease;
  }
  .stage-geocities .gdl-btn:hover { color: #8b1a1a; transform: translate(-1px, -1px); box-shadow: 4px 4px 0 #000; }
  .stage-geocities .gdl-btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
  .stage-geocities .gdl-arrow { color: #c44a2a; font-size: 16px; }
  .stage-geocities .gdl-label { text-align: left; font-size: 14px; letter-spacing: 0.02em; }
  .stage-geocities .gdl-size {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: #1f1240;
    text-decoration: none;
    background: rgba(255,255,255,0.55);
    padding: 1px 5px;
    border: 1px solid #000;
  }
  /* Five garish palettes, one per button. The grid pulses at staggered
     phases so the whole block feels alive. */
  .stage-geocities .gdl-1 .gdl-btn { background: #d4af5a; animation: btn-pulse 1.6s ease-in-out infinite; }
  .stage-geocities .gdl-2 .gdl-btn { background: #b0a8d9; animation: btn-pulse 1.7s ease-in-out infinite 0.1s; }
  .stage-geocities .gdl-3 .gdl-btn { background: #7a8f4a; animation: btn-pulse 1.8s ease-in-out infinite 0.2s; }
  .stage-geocities .gdl-4 .gdl-btn { background: #a47ac0; animation: btn-pulse 1.9s ease-in-out infinite 0.3s; color: #000; }
  /*
   * AUR + GITHUB tiles are the two full-width rows. They share
   * dimensions deliberately (same padding, same font, same icon
   * sizing) so the download grid reads as a symmetric stack instead
   * of one tile being visibly larger than the other.
   */
  .stage-geocities .gdl-5 .gdl-btn,
  .stage-geocities .gdl-gh .gdl-btn,
  .stage-geocities .gdl-codex .gdl-btn {
    padding: 12px 14px;
    font-size: 16px;
    color: #000 !important;
    text-decoration: none;
    border-color: #000;
    box-shadow: 4px 4px 0 #000;
  }
  .stage-geocities .gdl-5 .gdl-btn {
    background: linear-gradient(90deg, #8b3a1a 0%, #c9a961 50%, #8b3a1a 100%);
    animation: btn-pulse 1.5s ease-in-out infinite 0.05s;
  }
  .stage-geocities .gdl-gh .gdl-btn {
    background: linear-gradient(90deg, #869a4a 0%, #5a8a5a 50%, #869a4a 100%);
    animation: btn-pulse 1.2s ease-in-out infinite;
  }
  .stage-geocities .gdl-codex .gdl-btn {
    background: linear-gradient(90deg, #b66a2a 0%, #e8b840 50%, #b66a2a 100%);
    animation: btn-pulse 1.4s ease-in-out infinite 0.15s;
  }
  /* AUR + GH + CODEX labels : monospace command-style, bold, no underline,
     centered, with a white text-shadow that gives contrast against
     the gradient on both light and dark stripes. */
  .stage-geocities .gdl-5 .gdl-label,
  .stage-geocities .gdl-gh .gdl-label,
  .stage-geocities .gdl-codex .gdl-label {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-weight: 700;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.45);
  }
  .stage-geocities .gh-octo {
    font-size: 22px;
    line-height: 1;
    filter: drop-shadow(1px 1px 0 #000);
  }
  /* Side-badges on the three full-width rows share a black/brass chip
     so the trio reads as a stack. */
  .stage-geocities .gdl-5 .gdl-size,
  .stage-geocities .gdl-gh .gdl-size,
  .stage-geocities .gdl-codex .gdl-size {
    background: #000;
    color: #d4af5a;
    border-color: #d4af5a;
    font-weight: 700;
  }
  .stage-geocities .gdl-gh .gdl-size {
    animation: geo-blink 1.1s steps(2, end) infinite;
  }

  /* ─── POLL widget ─── */
  .stage-geocities .widget-poll { border-color: #869a4a; }
  .stage-geocities .poll-q {
    margin: 0 0 6px;

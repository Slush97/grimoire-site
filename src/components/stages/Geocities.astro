      1px -1px 0 #000,
      -1px 1px 0 #000;
  }
  .stage-geocities .mit-banner-title .mit-rainbow {
    background: linear-gradient(90deg, #ff0099, #ffd96a, #50e878, #5acafe, #b660e0, #ff0099);
    background-size: 200% 100%;
    -webkit-background-clip: text;
            background-clip: text;

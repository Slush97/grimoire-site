  /* sep-rainbow : sigil chain — brass beads on plum, scrolling */
  .stage-geocities .sep-rainbow {
    background:
      radial-gradient(circle at 12px 50%, #d4af5a 0 3px, transparent 4px) repeat-x,
      radial-gradient(circle at 12px 50%, transparent 5px, rgba(212, 175, 90, 0.45) 5px 6px, transparent 7px) repeat-x,
      linear-gradient(90deg, #1f1240, #2a1a4a, #1f1240);
    background-size: 24px 100%, 24px 100%, 100% 100%;
    animation: sep-scroll-l 5s linear infinite;
    border-top: 1px solid rgba(212, 175, 90, 0.5);
    border-bottom: 1px solid rgba(212, 175, 90, 0.5);
    height: 16px;
  }
  /* sep-lightning : crossed-diagonals lattice (chain of X / lozenges) */
  .stage-geocities .sep-lightning {
    background:
      repeating-linear-gradient(
        45deg,
        transparent 0,
        transparent 10px,
        rgba(212, 175, 90, 0.75) 10px,
        rgba(212, 175, 90, 0.75) 11px,
        transparent 11px,
        transparent 21px
      ),
      repeating-linear-gradient(
        -45deg,
        transparent 0,
        transparent 10px,
        rgba(212, 175, 90, 0.75) 10px,
        rgba(212, 175, 90, 0.75) 11px,
        transparent 11px,
        transparent 21px
      ),
      linear-gradient(90deg, #1f1240, #0a0612, #1f1240);
    background-size: 22px 100%, 22px 100%, 100% 100%;
    animation: sep-scroll-l 2.4s linear infinite;
    border-top: 1px solid rgba(168, 50, 71, 0.5);
    border-bottom: 1px solid rgba(168, 50, 71, 0.5);
    height: 16px;
  }
  @keyframes sep-scroll-l {
    from { background-position: 0 0; }
    to   { background-position: -64px 0; }

---
/*
 * Stage 4 : GEOCITIES (1996-2001), chaos-magick re-skin
 *
 * Same 1996 amateur-web bones (starfield, WordArt, marquees, hazard
 * barricade, LED visitor counter, blinking "NEW!!!", webring, sign
 * the book of names) recolored to a candlelit grimoire palette:
 * deep indigo + oxblood + brass + moonlight, parchment text.
 *
 * Two added structural pieces that sell the masonic / occult lean:
 *   - .altar : POVRay-flavored brass sphere resting on a 3D-perspective
 *     checkerboard floor with a candle-glow halo. Sits under the
 *     WordArt headline as a "tracing board" centerpiece.
 *   - .seal  : eye-in-triangle replacing the spinning "FAMILY FRIENDLY
 *     SITE" badge, framed by AS ABOVE / SO BELOW arc text.
 *
 * Voice: same 1996 amateur web sincerity, ALL CAPS for emphasis, but
 * with a chaos-magick zine vocabulary: lodge, sigils, initiates, book
 * of names, by moonlight.
 */
import type { DownloadUrls } from '../../data/content';
import { brand, fmtBytes } from '../../data/content';
const dl = Astro.props as DownloadUrls;

/*
 * Every binary the release shipped, in WordArt-loud form. Each is its own
 * blinking 90s button. AUR is a copy/paste command tile since it's an
 * install incantation, not a file.
 */
const geoDownloads = [
  { label: 'WINDOWS .EXE',     asset: dl.windowsInstaller, kind: 'file' as const, cls: 'gdl-1' },
  { label: 'PORTABLE',         asset: dl.windowsPortable,  kind: 'file' as const, cls: 'gdl-2' },
  { label: 'LINUX .APPIMAGE',  asset: dl.linuxAppImage,    kind: 'file' as const, cls: 'gdl-3' },
  { label: 'LINUX .DEB',       asset: dl.linuxDeb,         kind: 'file' as const, cls: 'gdl-4' },
];

const newsFeatures = [
  { abbr: 'GB', text: '★ GameBanana mods!!! Look at all these mods you can get!!! New ones every day!!! One click and they INSTALL THEMSELVES!!!' },
  { abbr: 'LIB', text: '★ Library Manager!! Click click click! Turn mods ON and OFF! Organize them! NO MORE CRASHES when two mods fight!!!' },
  { abbr: 'HL', text: '★ Hero Locker!!1! Pick which skin you wanna wear on each hero! It is like a CLOSET but for VIDEO GAMES!!' },
  { abbr: 'mp1', text: '★ Profiles!!! Save all your mods together and switch back and forth!!! Trade them with your friends like POG CARDS!' },
];

/*
 * Left sidebar nav. Classic "MY PAGES" frameset list. Anchors point at
 * the on-page sections we already render below, so the in-page hash
 * navigation actually works.
 */
const sidebarNav = [
  { href: brand.github,    label: 'GITHUB!!!',  icon: '🐙', external: true, highlight: true },
  { href: '#geo-h1',       label: 'HOME',       icon: '🏠' },
  { href: '#geo-about',    label: 'ABOUT ME',   icon: '👤' },
  { href: '#geo-news',     label: "WHAT'S NEW", icon: '📣' },
  { href: '#geo-download', label: 'GET MY MOD MGR', icon: '💾' },
  { href: '#geo-webring',  label: 'WEBRING',    icon: '🔗' },
  { href: brand.discord,   label: 'GUESTBOOK',  icon: '✒', external: true },
  { href: 'mailto:slusheliott@gmail.com', label: 'E-MAIL ME', icon: '✉', external: true },
];

/*
 * Quote of the day. Rotates daily based on day-of-year so the page
 * feels alive across visits without needing any client state. Pure
 * modder-zine voice.
 */
const modQuotes = [
  { who: 'a modder', text: 'Make the game look how it should have looked.' },
  { who: 'somebody on Discord', text: 'I came here for one skin and now my whole roster is anime.' },
  { who: 'me, slush', text: "If the game won't change, change the game." },
  { who: 'the README', text: 'No telemetry. No login. No subscription. The mods are yours.' },
  { who: 'a wise modder', text: 'Mods are how a game outlives its publisher.' },
  { who: 'an unverified source', text: 'Grimoire installed 47,000 mods and crashed exactly zero times.' },
  { who: 'a guestbook entry', text: 'COOL SITE!!! 5 stars!!! Will sign again!!!' },
];
const dayOfYear = Math.floor((Date.now() - new Date(new Date().getFullYear(), 0, 0).getTime()) / 86400000);
const quote = modQuotes[dayOfYear % modQuotes.length];

const friends = [
  { name: 'tF2.party', tag: '~mods' },
  { name: 'sourceMod.zone', tag: '~src' },
  { name: 'crowbar.codex', tag: '~vpk' },
  { name: 'gmod.haus', tag: '~lua' },
  { name: 'vault-tec.tilde', tag: '~fo4' },
  { name: 'nexus.lair', tag: '~plg' },
];

const awards = [
  { title: 'CIRCLE OF INITIATES', sub: 'May 21, 1998' },
  { title: 'BLESSED OF THE WEB',  sub: '✦✦✦✦✦'        },
  { title: 'TOP 10% LODGE',       sub: 'Silicon Lodge' },
  { title: 'NETSCAPE PICK',       sub: 'by moonlight'  },
];
---

<section class="stage stage-geocities" data-era="geocities" aria-labelledby="geo-h1">
  <div class="starfield" aria-hidden="true"></div>

  <!-- Top marquee bar -->
  <div class="top-marquee">
    <span class="track">
      <span>✦ WELCOME TO GRIMOIRE'S HOMEPAGE!!1! ✦ BEST VIEWED IN NETSCAPE NAVIGATOR 4.0 BY MOONLIGHT ✦ NEW SIGILS!!! ✦ SIGN THE BOOK OF NAMES!!! ✦ </span>
      <span>✦ WELCOME TO GRIMOIRE'S HOMEPAGE!!1! ✦ BEST VIEWED IN NETSCAPE NAVIGATOR 4.0 BY MOONLIGHT ✦ NEW SIGILS!!! ✦ SIGN THE BOOK OF NAMES!!! ✦ </span>
    </span>
  </div>

  <!-- Sparkle cursor trail mount point. Script below populates it. -->
  <div class="sparkle-trail" aria-hidden="true"></div>

  <div class="page">
    <!-- WordArt headline (full width above the frameset) -->
    <header class="hero">
      <h1 id="geo-h1" class="wordart">
        <span class="wa l-1">G</span><span class="wa l-2">R</span><span class="wa l-3">I</span><span class="wa l-4">M</span><span class="wa l-5">O</span><span class="wa l-6">I</span><span class="wa l-7">R</span><span class="wa l-8">E</span>
        <span class="wa-sub">✦ a homepage for the modding arts ✦</span>
      </h1>
      <p class="tagline">A GRIMOIRE FOR <em>DEADLOCK</em>!!! invoked with <span class="heart">♥</span> by slush!</p>
    </header>

    <!--
      Tracing-board altar. POVRay-flavored chrome/brass orb resting on a
      perspective-warped masonic checker floor. Pure CSS: conic-gradient
      checker pattern + rotateX for the floor, radial-gradient + box
      shadow for the sphere, soft brass halo behind it. The visual hinge
      of the chaos-magick repaint.
    -->
    <div class="altar" aria-hidden="true">
      <span class="altar-glyph">✦ as above ✦ so below ✦</span>
      <div class="altar-floor"></div>
      <svg class="altar-circle" viewBox="0 0 400 400">
        <g fill="none" stroke="#ffd96a">
          <circle cx="200" cy="200" r="194" stroke-width="2" opacity="0.85"/>
          <circle cx="200" cy="200" r="172" stroke-width="1" opacity="0.65"/>
          <circle cx="200" cy="200" r="132" stroke-width="1" stroke-dasharray="5 5" opacity="0.7"/>
          <circle cx="200" cy="200" r="100" stroke-width="1" opacity="0.55"/>
        </g>
        <g fill="#ffd96a" font-size="34" text-anchor="middle" font-family="'Times New Roman', Times, serif" opacity="0.95">
          <text x="200" y="44">☉</text>
          <text x="200" y="380">☽</text>
          <text x="34" y="214">⚹</text>
          <text x="366" y="214">✦</text>
        </g>
        <g fill="#ffd96a" font-size="18" text-anchor="middle" font-family="'Times New Roman', Times, serif" opacity="0.7">
          <text x="316" y="78">☥</text>
          <text x="84" y="78">☥</text>
          <text x="316" y="334">☥</text>
          <text x="84" y="334">☥</text>
        </g>
      </svg>
      <div class="altar-shadow"></div>
      <div class="altar-halo"></div>
      <div class="altar-sphere"></div>
    </div>

    <!--
      Frameset-style 3-column layout. Real 1996 amateur sites used HTML
      framesets or 3-column tables; we approximate with CSS grid and let
      it stack on mobile.
    -->
    <div class="frameset">
      <!-- ─── LEFT SIDEBAR ─── -->
      <aside class="rail rail-left" aria-label="Site navigation">

        <!-- MY PAGES nav -->
        <nav class="widget widget-nav">
          <h3 class="widget-h">★ MY PAGES ★</h3>
          <ul>
            {sidebarNav.map((n) => (
              <li>
                <a
                  href={n.href}
                  class={n.highlight ? 'nav-hot' : undefined}
                  {...(n.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  <span class="navico" aria-hidden="true">{n.icon}</span>
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- ABOUT ME card with CRT-monitor photo placeholder -->
        <div id="geo-about" class="widget widget-about">
          <h3 class="widget-h">✦ ABOUT ME ✦</h3>
          <div class="photo" aria-hidden="true">
            <div class="crt">
              <div class="crt-scan"></div>
              <div class="crt-face">
                <span class="scry-rune">☽</span>
                <span class="scry-pupil"></span>
              </div>
            </div>
            <p class="photo-caption">~ scrying glass ~</p>
          </div>
          <p class="about-blurb">
            HI my name is <strong>SLUSH</strong>!! I am a MODDER and I made
            this site to share my MOD MANAGER for the video game DEADLOCK!!
            I like <em>arch linux</em>, <em>pog cards</em>, and
            <em>FREE software</em>!!
          </p>
          <ul class="vitals">
            <li><b>AGE:</b> ageless</li>
            <li><b>ASL?:</b> NO</li>
            <li><b>FAVE GAME:</b> DEADLOCK!!</li>
            <li><b>OS:</b> arch btw</li>
          </ul>
        </div>

        <!-- MAILBOX widget -->
        <div class="widget widget-mail">
          <h3 class="widget-h">✉ U HAVE MAIL ✉</h3>
          <div class="mailbox">
            <span class="mail-icon" aria-hidden="true">📬</span>
            <div>
              <div class="mail-count blink">3</div>
              <div class="mail-sub">new scrolls await!!!</div>
            </div>
          </div>
          <a class="mail-link" href="mailto:slusheliott@gmail.com">CHECK INBOX →</a>
        </div>

        <!--
          Real vaporwave radio. Replaces the fake THE.HERMIT.MID widget
          with an HTML5 audio player wired to two open-source streams:
            - Plaza One (plaza.one)        : canonical vaporwave radio
            - Nightride.fm                 : synthwave/vaporwave family
          User picks a station, clicks PLAY, audio starts. Now-playing
          metadata is polled from Plaza's public JSON endpoint; the
          Nightride stations fall back to a "● LIVE" label. Bars only
          animate while the audio is actually playing.
        -->
        <div class="widget widget-midi widget-radio" data-radio>
          <h3 class="widget-h">♫ TUNE IN ♫</h3>
          <div class="midi-player">
            <ul class="station-tabs" aria-label="Pick a station">
              <li><button type="button" class="station-tab" data-station="plaza">PLAZA</button></li>
              <li><button type="button" class="station-tab" data-station="nightride">NITERIDE</button></li>
              <li><button type="button" class="station-tab" data-station="chillsynth">CHILL</button></li>
              <li><button type="button" class="station-tab is-on" data-station="spacesynth">SPACE</button></li>
            </ul>
            <div class="midi-screen">
              <div class="midi-title" data-role="track">▶ SPACESYNTH ▶</div>
              <div class="midi-bars" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span>
              </div>
            </div>
            <div class="midi-controls">
              <button type="button" class="midi-btn" data-role="play" title="play / pause">▶</button>
              <button type="button" class="midi-btn" data-role="stop" title="stop">■</button>
              <button type="button" class="midi-btn" data-role="vol" title="volume" aria-label="cycle volume">♪</button>
            </div>
          </div>
          <p class="midi-note" data-role="status">tuning in to SPACE...</p>
          <!--
            crossorigin="anonymous" is required for the Web Audio
            visualizer (MediaElementSource won't expose data without
            CORS). Nightride.fm streams (default = Space) return
            Access-Control-Allow-Origin: * so they work everywhere.
            Plaza One's stream allows only grimoiremods.com origin
            so it works on prod but not on dev — acceptable since
            most listening happens in prod.
          -->
          <audio data-role="audio" preload="none" crossorigin="anonymous"></audio>
        </div>

        <!-- Site stats -->
        <div class="widget widget-stats">
          <h3 class="widget-h">★ SITE STATS ★</h3>
          <dl class="stats">
            <dt>PAGES:</dt>           <dd>12</dd>
            <dt>LAST UPDATE:</dt>     <dd>{brand.year}</dd>
            <dt>HOSTED ON:</dt>       <dd>GeoCities</dd>
            <dt>LODGE:</dt>           <dd>SiliconLodge/4287</dd>
            <dt>BANDWIDTH:</dt>       <dd>28.8K READY</dd>
          </dl>
        </div>

        <!-- POLL!!! widget : balances left rail height against right -->
        <div class="widget widget-poll">
          <h3 class="widget-h">✦ CAST YOUR LOT ✦</h3>
          <p class="poll-q">Which element guides your mods??</p>
          <ul class="poll-opts">
            <li><span class="radio">○</span> ☉ Fire</li>
            <li><span class="radio">○</span> ☽ Water</li>
            <li><span class="radio">●</span> ⚹ Aether</li>
            <li><span class="radio">○</span> ✦ Earth</li>
          </ul>
          <button type="button" class="poll-btn">DIVINE!!!</button>
          <p class="poll-tally">1,337 souls have cast so far!!1!</p>
        </div>
      </aside>

      <!-- ─── CENTER COLUMN ─── -->
      <div class="content">

        <!-- Under Construction + Visitor counter row -->
        <section class="row row-2">
          <div class="construction" aria-hidden="true">
            <div class="hazard"><div class="hazard-tape"></div></div>
            <p>UNDER CONSECRATION!!1!</p>
            <span class="caption">RETURN BY MOONLIGHT!!!</span>
          </div>

          <div class="visitor">
            <div class="label">YOU ARE VISITOR</div>
            <div class="led-counter">
              <span>0</span><span>0</span><span>1</span><span>3</span><span>3</span><span>7</span>
            </div>
            <div class="caption-sm">souls beheld since 1996</div>
          </div>
        </section>

        <!-- Flame-bar separator (GIF stand-in, CSS only) -->
        <div class="sep sep-flame" aria-hidden="true"></div>

        <!-- What's NEW!!! -->
        <section id="geo-news" class="news">
          <h2 class="ribbon">
            <span class="blink">★</span> WHAT'S <em>NEW!!!1!</em> <span class="blink">★</span>
          </h2>
          <ol class="news-list">
            {newsFeatures.map((f) => (
              <li>
                <span class="bullet">{f.abbr}</span>
                <span>{f.text}</span>
              </li>
            ))}
          </ol>
        </section>

        <!-- Rainbow-bar separator -->
        <div class="sep sep-rainbow" aria-hidden="true"></div>

        <!-- Download CTA, Geocities style -->
        <section id="geo-download" class="download-cta">
          <h2 class="ribbon ribbon-orange">CLICK HERE TO GET GRIMOIRE!!!</h2>
          <ul class="gdl-grid">
            {geoDownloads.map((d) => (
              <li class={`gdl ${d.cls}`}>
                <a class="gdl-btn" href={d.asset?.browser_download_url ?? dl.releaseUrl}>
                  <span class="gdl-arrow">▶</span>
                  <span class="gdl-label">{d.label}</span>
                  <span class="gdl-size">{d.asset ? fmtBytes(d.asset.size) : '★'}</span>
                </a>
              </li>
            ))}
            <li class="gdl gdl-5">
              <a class="gdl-btn" href={brand.aur} target="_blank" rel="noopener">
                <span class="gdl-arrow">▶</span>
                <span class="gdl-label">yay -S grimoire-bin</span>
                <span class="gdl-size">AUR</span>
              </a>
            </li>
            <li class="gdl gdl-gh">
              <a class="gdl-btn" href={brand.github} target="_blank" rel="noopener">
                <span class="gh-octo" aria-hidden="true">🐙</span>
                <span class="gdl-label">VIEW SOURCE ON GITHUB!!!</span>
                <span class="gdl-size">★ FREE ★</span>
              </a>
            </li>
          </ul>
          <p class="cta-sub">
            IT IS <span class="blink">FREE</span>!!! NO TELEMETRY!! NO ADWARE!!!
          </p>
          <p class="cta-sub">VERSION {dl.version || '1.x'}{dl.releaseDate ? ` ★ ${dl.releaseDate}` : ''}</p>
        </section>

        <!-- Lightning-bar separator -->
        <div class="sep sep-lightning" aria-hidden="true"></div>

        <!--
          Webring : tricked-out version with a featured MIT LICENSE
          medallion centerpiece, redesigned 88x31 badges, and a chained
          brass frame. The medallion links to the OSI MIT license text;
          badges are pure CSS gradients with sigil-style accents.
        -->
        <section id="geo-webring" class="webring">
          <div class="webring-frame">
            <div class="webring-corner webring-corner-tl">✦</div>
            <div class="webring-corner webring-corner-tr">✦</div>
            <div class="webring-corner webring-corner-bl">✦</div>
            <div class="webring-corner webring-corner-br">✦</div>

            <h3 class="webring-h">
              <span class="webring-h-star blink">★</span>
              THE DARK CODEX WEBRING
              <span class="webring-h-star blink">★</span>
            </h3>

            <!--
              Hermetic MIT seal : centerpiece. Outer brass rim carries
              the dictum AS ABOVE / SO BELOW + MIT LICENTIA LIBERA in
              arc text. Inner occult panel holds the seven classical
              planetary glyphs in a ring around Solomon's hexagram,
              with MIT seated in the central hexagon.
            -->
            <a class="mit-medallion" href="https://opensource.org/license/mit/" target="_blank" rel="noopener" aria-label="MIT License">
              <svg class="mit-medal" viewBox="0 0 220 220" aria-hidden="true">
                <defs>
                  <radialGradient id="herm-rim" cx="36%" cy="30%" r="82%">
                    <stop offset="0%"   stop-color="#fff4c4"/>
                    <stop offset="22%"  stop-color="#f5d066"/>
                    <stop offset="55%"  stop-color="#c9892e"/>
                    <stop offset="85%"  stop-color="#7a4810"/>
                    <stop offset="100%" stop-color="#2a1408"/>
                  </radialGradient>
                  <radialGradient id="herm-inner" cx="50%" cy="40%" r="72%">
                    <stop offset="0%"   stop-color="#2c1450"/>
                    <stop offset="55%"  stop-color="#150830"/>
                    <stop offset="100%" stop-color="#06031a"/>
                  </radialGradient>
                  <path id="herm-arc-top" d="M 32,110 A 78,78 0 0 1 188,110"/>
                  <path id="herm-arc-bot" d="M 32,114 A 78,78 0 0 0 188,114"/>
                </defs>

                <!-- Outer brass disc -->
                <circle cx="110" cy="110" r="100" fill="url(#herm-rim)" stroke="#1a0a08" stroke-width="2"/>

                <!-- 12 zodiac ticks around the rim -->
                <g class="mit-rim-ticks" stroke="#1a0a08" stroke-width="1.3" stroke-linecap="round">
                  <line x1="110" y1="12"  x2="110" y2="20"/>
                  <line x1="155" y1="22"  x2="151" y2="29"/>
                  <line x1="184" y1="55"  x2="178" y2="59"/>
                  <line x1="200" y1="110" x2="192" y2="110"/>
                  <line x1="184" y1="165" x2="178" y2="161"/>
                  <line x1="155" y1="198" x2="151" y2="191"/>
                  <line x1="110" y1="208" x2="110" y2="200"/>
                  <line x1="65"  y1="198" x2="69"  y2="191"/>
                  <line x1="36"  y1="165" x2="42"  y2="161"/>
                  <line x1="20"  y1="110" x2="28"  y2="110"/>
                  <line x1="36"  y1="55"  x2="42"  y2="59"/>
                  <line x1="65"  y1="22"  x2="69"  y2="29"/>
                </g>

                <!-- Arc text on the brass rim -->
                <g class="mit-arc-text" fill="#1a0a08" font-family="'Cardo', 'Times New Roman', Times, serif" font-weight="700" font-size="10" letter-spacing="1.8">
                  <text text-anchor="middle"><textPath href="#herm-arc-top" startOffset="50%">✦ AS ABOVE ✦ SO BELOW ✦</textPath></text>
                  <text text-anchor="middle"><textPath href="#herm-arc-bot" startOffset="50%">✦ LICENTIA LIBERA MCMLXXXVIII ✦</textPath></text>
                </g>

                <!-- Inner occult panel -->
                <circle cx="110" cy="110" r="80" fill="url(#herm-inner)" stroke="#1a0a08" stroke-width="1.4"/>
                <circle cx="110" cy="110" r="82" fill="none" stroke="rgba(255, 244, 196, 0.55)" stroke-width="0.6"/>
                <circle cx="110" cy="110" r="76" fill="none" stroke="rgba(212, 175, 90, 0.35)" stroke-width="0.5" stroke-dasharray="2 3"/>

                <!-- Seven classical planets, ringed at r=64 -->
                <g class="mit-planets" font-family="'Cardo', 'Times New Roman', serif" font-size="13" fill="#d4af5a" text-anchor="middle" dominant-baseline="middle">
                  <text x="110" y="50" font-size="15">☉</text>
                  <text x="160" y="70">☽</text>
                  <text x="172" y="124">☿</text>
                  <text x="138" y="168">♀</text>
                  <text x="82"  y="168">♂</text>
                  <text x="48"  y="124">♃</text>
                  <text x="60"  y="70">♄</text>
                </g>

                <!-- Solomon's hexagram (centroid at 110,110) -->
                <g class="mit-hex" fill="none" stroke="#d4af5a" stroke-width="1.5" stroke-linejoin="round" opacity="0.95">
                  <polygon points="110,82 80,134 140,134"/>
                  <polygon points="110,138 80,86 140,86"/>
                </g>
                <g class="mit-hex-glow" fill="none" stroke="#fff4c4" stroke-width="0.5" stroke-linejoin="round" opacity="0.6">
                  <polygon points="110,82 80,134 140,134"/>
                  <polygon points="110,138 80,86 140,86"/>
                </g>

                <!-- MIT in the central hexagon -->
                <text x="110" y="116" text-anchor="middle" font-family="'Cinzel', 'Cardo', 'Times New Roman', serif" font-size="20" font-weight="900" fill="#fff4c4" letter-spacing="3" class="mit-wordmark">MIT</text>
              </svg>
              <div class="mit-spark mit-spark-1">✶</div>
              <div class="mit-spark mit-spark-2">✶</div>
              <div class="mit-spark mit-spark-3">✶</div>
              <div class="mit-spark mit-spark-4">✶</div>
            </a>
            <p class="mit-blurb">
              <span class="herm-glyph-row" aria-hidden="true">🜂 🜁 🜄 🜃</span>
              <strong>LICENTIA LIBERA</strong> ✦ this codex is
              <strong>open</strong> as the firmament: fork it, ship it,
              transmute it into your own dark gospel.
              <em>(but leave the copyright notice ye who enter)</em>
            </p>

            <div class="ring-links">
              <a href={brand.github} target="_blank" rel="noopener">[« prev]</a>
              <span>·</span>
              <a href={brand.gamebanana} target="_blank" rel="noopener">[?random?]</a>
              <span>·</span>
              <a href={brand.discord} target="_blank" rel="noopener">[next »]</a>

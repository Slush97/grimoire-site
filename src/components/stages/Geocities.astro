  }

  /* Corner sigil bursts that spin */
  .stage-geocities .mit-banner-burst {
    position: absolute;
    font-size: 22px;
    color: #fff8d4;
    text-shadow:
      0 0 6px #ffd96a,
      0 0 12px rgba(255, 217, 106, 0.85),
      1px 1px 0 #000;
    z-index: 3;
    pointer-events: none;
    animation: mit-burst-spin 2.6s linear infinite;

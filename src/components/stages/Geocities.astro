---
/*
 * Stage 4 : GEOCITIES (1996–2001)
 *
 * Tiled starfield wallpaper, multi-color WordArt headline, marquees,
 * "Under Construction" hazard barricade (CSS only, no GIFs), visitor
 * counter, "What's NEW!!!" with blinking text, webring rail, sign-the-
 * guestbook link. Voice: 1996 amateur web sincerity, ALL CAPS for
 * emphasis, exclamation points.
 */
import type { DownloadUrls } from '../../data/content';
import { brand, fmtBytes } from '../../data/content';
const dl = Astro.props as DownloadUrls;

/*
 * Every binary the release shipped, in WordArt-loud form. Each is its own
 * blinking 90s button. AUR is a copy/paste command tile since it's an
 * install incantation, not a file.
 */
const geoDownloads = [
  { label: 'WINDOWS .EXE',     asset: dl.windowsInstaller, kind: 'file' as const, cls: 'gdl-1' },
  { label: 'PORTABLE',         asset: dl.windowsPortable,  kind: 'file' as const, cls: 'gdl-2' },
  { label: 'LINUX .APPIMAGE',  asset: dl.linuxAppImage,    kind: 'file' as const, cls: 'gdl-3' },
  { label: 'LINUX .DEB',       asset: dl.linuxDeb,         kind: 'file' as const, cls: 'gdl-4' },
];

const newsFeatures = [
  { abbr: 'GB', text: '★ GameBanana mods!!! Look at all these mods you can get!!! New ones every day!!! One click and they INSTALL THEMSELVES!!!' },
  { abbr: 'LIB', text: '★ Library Manager!! Click click click! Turn mods ON and OFF! Organize them! NO MORE CRASHES when two mods fight!!!' },
  { abbr: 'HL', text: '★ Hero Locker!!1! Pick which skin you wanna wear on each hero! It is like a CLOSET but for VIDEO GAMES!!' },
  { abbr: 'mp1', text: '★ Profiles!!! Save all your mods together and switch back and forth!!! Trade them with your friends like POG CARDS!' },
];
---

<section class="stage stage-geocities" data-era="geocities" aria-labelledby="geo-h1">
  <div class="starfield" aria-hidden="true"></div>

  <!-- Top marquee bar -->
  <div class="top-marquee">
    <span class="track">
      <span>★ WELCOME TO GRIMOIRE'S HOMEPAGE!!1! ★ BEST VIEWED IN NETSCAPE NAVIGATOR 4.0 AT 800x600 ★ NEW!!! ★ SIGN MY GUESTBOOK!!! ★ </span>
      <span>★ WELCOME TO GRIMOIRE'S HOMEPAGE!!1! ★ BEST VIEWED IN NETSCAPE NAVIGATOR 4.0 AT 800x600 ★ NEW!!! ★ SIGN MY GUESTBOOK!!! ★ </span>
    </span>
  </div>

  <div class="page">
    <!-- WordArt headline -->
    <header class="hero">
      <h1 id="geo-h1" class="wordart">
        <span class="wa l-1">G</span><span class="wa l-2">R</span><span class="wa l-3">I</span><span class="wa l-4">M</span><span class="wa l-5">O</span><span class="wa l-6">I</span><span class="wa l-7">R</span><span class="wa l-8">E</span>
        <span class="wa-sub">'s homepage!!1!</span>
      </h1>
      <p class="tagline">A MOD MANAGER FOR <em>DEADLOCK</em>!!! made with <span class="heart">♥</span> by slush!</p>
    </header>

    <!-- Under Construction + Visitor counter row -->
    <section class="row row-2">
      <div class="construction" aria-hidden="true">
        <div class="hazard"></div>
        <p>UNDER CONSTRUCTION!!1!</p>
        <span class="caption">CHECK BACK SOON!!!</span>
      </div>

      <div class="visitor">
        <div class="label">YOU ARE VISITOR</div>
        <div class="led-counter">
          <span>0</span><span>0</span><span>1</span><span>3</span><span>3</span><span>7</span>
        </div>
        <div class="caption-sm">since 1996</div>
      </div>
    </section>

    <!-- What's NEW!!! -->
    <section class="news">
      <h2 class="ribbon">
        <span class="blink">★</span> WHAT'S <em>NEW!!!1!</em> <span class="blink">★</span>
      </h2>
      <ol class="news-list">
        {newsFeatures.map((f) => (
          <li>
            <span class="bullet">{f.abbr}</span>
            <span>{f.text}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Download CTA, Geocities style -->
    <section class="download-cta">
      <h2 class="ribbon ribbon-orange">CLICK HERE TO GET GRIMOIRE!!!</h2>
      <ul class="gdl-grid">
        {geoDownloads.map((d) => (
          <li class={`gdl ${d.cls}`}>
            <a class="gdl-btn" href={d.asset?.browser_download_url ?? dl.releaseUrl}>
              <span class="gdl-arrow">▶</span>
              <span class="gdl-label">{d.label}</span>
              <span class="gdl-size">{d.asset ? fmtBytes(d.asset.size) : '★'}</span>
            </a>
          </li>
        ))}
        <li class="gdl gdl-5">
          <a class="gdl-btn" href={brand.aur} target="_blank" rel="noopener">
            <span class="gdl-arrow">▶</span>
            <span class="gdl-label">AUR :: grimoire-bin</span>
            <span class="gdl-size">yay -S</span>
          </a>
        </li>
      </ul>
      <p class="cta-sub">
        IT IS <span class="blink">FREE</span>!!! NO TELEMETRY!! NO ADWARE!!!
      </p>
      <p class="cta-sub">VERSION {dl.version || '1.x'}{dl.releaseDate ? ` ★ ${dl.releaseDate}` : ''}</p>
    </section>

    <!-- Webring -->
    <section class="webring">
      <h3>★ THE DARK CODEX WEBRING ★</h3>
      <div class="ring-links">
        <a href={brand.github} target="_blank" rel="noopener">[« prev]</a>
        <span>·</span>
        <a href={brand.gamebanana} target="_blank" rel="noopener">[?random?]</a>
        <span>·</span>
        <a href={brand.discord} target="_blank" rel="noopener">[next »]</a>
      </div>
      <ul class="badges">
        <li class="b88 b-netscape">NETSCAPE NOW!</li>
        <li class="b88 b-blink">BEST VIEWED IN HELLFIRE</li>
        <li class="b88 b-1024">1024x768 OR BUST</li>
        <li class="b88 b-mit">MIT LICENSED!!</li>
      </ul>
    </section>

    <!-- Guestbook + Email -->
    <section class="signoff">
      <a class="guestbook" href={brand.discord} target="_blank" rel="noopener">
        <span class="quill" aria-hidden="true">✒</span>
        Sign my GUESTBOOK!!!
      </a>
      <a class="email" href="mailto:slusheliott@gmail.com">
        <span class="mail" aria-hidden="true">✉</span>
        E-MAIL ME!!
      </a>
      <p class="midi-toggle">♫ Now playing: <em>GREENSLEEVES.MID</em></p>
    </section>

    <!-- Bottom marquee -->
    <div class="bot-marquee">
      <span class="track">
        <span>★ © 1996-{brand.year} SLUSH ★ THIS PAGE WAS LAST UPDATED IN THE YEAR OF OUR LORD {brand.year} ★ NO TELEMETRY EVER!!! ★ </span>
        <span>★ © 1996-{brand.year} SLUSH ★ THIS PAGE WAS LAST UPDATED IN THE YEAR OF OUR LORD {brand.year} ★ NO TELEMETRY EVER!!! ★ </span>
      </span>
    </div>
  </div>
</section>

<style>
  /* ─────────────────────────────────────────────────────────────────
     GEOCITIES: scoped 1996 amateur web world. Starfield bg, marquees,
     WordArt headline, hazard-tape Under Construction GIF (CSS-only),
     LED visitor counter, blinking NEW!!! ribbon, 88x31 webring badges.
     Times Roman body + Comic Sans accents. Hot pink, cyan, lime, yellow.
     ───────────────────────────────────────────────────────────────── */
  .stage-geocities {
    background: #000010;
    color: #ffffff;
    font-family: 'Times New Roman', Times, serif;
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
    display: block;
    min-height: 100vh;
    padding: 0;
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .stage-geocities .starfield {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: #000010;
    background-image:
      radial-gradient(1px 1px at 5% 8%, #ffffff, transparent),
      radial-gradient(1px 1px at 15% 22%, #ffffff, transparent),
      radial-gradient(2px 2px at 24% 12%, #ffffff, transparent),
      radial-gradient(1px 1px at 38% 28%, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 50% 18%, #cce, transparent),
      radial-gradient(1px 1px at 63% 32%, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 75% 14%, #ffffff, transparent),
      radial-gradient(1px 1px at 88% 26%, #fcc, transparent),
      radial-gradient(1.5px 1.5px at 11% 48%, #ffffff, transparent),
      radial-gradient(1px 1px at 28% 56%, #ffffff, transparent),
      radial-gradient(2px 2px at 44% 64%, #ffffff, transparent),
      radial-gradient(1px 1px at 58% 48%, #ccf, transparent),
      radial-gradient(1.5px 1.5px at 72% 56%, #ffffff, transparent),
      radial-gradient(1px 1px at 86% 68%, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 8% 78%, #ffffff, transparent),
      radial-gradient(1px 1px at 22% 88%, #fcc, transparent),
      radial-gradient(2px 2px at 36% 76%, #ffffff, transparent),
      radial-gradient(1px 1px at 54% 92%, #ffffff, transparent),
      radial-gradient(1.5px 1.5px at 68% 84%, #ccf, transparent),
      radial-gradient(1px 1px at 81% 96%, #ffffff, transparent),
      radial-gradient(1px 1px at 94% 80%, #ffffff, transparent);
    background-size: 100% 100%;
    animation: stars-twinkle 4s ease-in-out infinite alternate;
  }
  @keyframes stars-twinkle {
    from { opacity: 0.7; }
    to   { opacity: 1; }
  }

  .stage-geocities a {
    color: #00ffff;
    text-decoration: underline;
  }
  .stage-geocities a:visited { color: #ff66ff; }
  .stage-geocities a:hover { color: #ffff00; }

  /* ─── Marquees ─── */
  .stage-geocities .top-marquee,
  .stage-geocities .bot-marquee {
    position: relative;
    z-index: 2;
    overflow: hidden;
    background: #000080;
    border-top: 2px solid #ff00ff;
    border-bottom: 2px solid #ff00ff;
    color: #ffff00;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-weight: 700;
    font-size: 14px;
    text-shadow: 1px 1px 0 #000;
    padding: 4px 0;
  }
  .stage-geocities .track {
    display: inline-flex;
    white-space: nowrap;
    animation: geo-scroll 22s linear infinite;
  }
  .stage-geocities .track > span { padding: 0 18px; }
  @keyframes geo-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ─── Page wrapper ─── */
  .stage-geocities .page {
    position: relative;
    z-index: 2;
    max-width: 720px;
    margin: 0 auto;
    padding: 36px 16px 0;
  }

  /* ─── WordArt headline ─── */
  .stage-geocities .hero { margin-bottom: 32px; }
  .stage-geocities .wordart {
    margin: 0;
    font-family: 'Comic Neue', 'Comic Sans MS', 'Impact', sans-serif;
    font-weight: 700;
    font-size: clamp(38px, 8vw, 64px);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .stage-geocities .wa {
    display: inline-block;
    text-shadow:
      2px 2px 0 #000,
      3px 3px 0 #ff00ff,
      4px 4px 0 #000,
      5px 5px 0 #00ffff,
      6px 6px 6px rgba(0,0,0,0.5);
    transform-origin: center bottom;
    animation: wa-bounce 2s ease-in-out infinite;
  }
  .stage-geocities .l-1 { color: #ff00ff; animation-delay: 0s; }
  .stage-geocities .l-2 { color: #ff66ff; animation-delay: 0.1s; }
  .stage-geocities .l-3 { color: #ffff00; animation-delay: 0.2s; }
  .stage-geocities .l-4 { color: #66ff00; animation-delay: 0.3s; }
  .stage-geocities .l-5 { color: #00ffff; animation-delay: 0.4s; }
  .stage-geocities .l-6 { color: #66ccff; animation-delay: 0.5s; }
  .stage-geocities .l-7 { color: #ff66ff; animation-delay: 0.6s; }
  .stage-geocities .l-8 { color: #ffff00; animation-delay: 0.7s; }
  @keyframes wa-bounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-3px); }
  }
  .stage-geocities .wa-sub {
    display: block;
    font-size: 0.4em;
    color: #ffffff;
    text-shadow: 1px 1px 0 #ff00ff, 2px 2px 0 #000;
    margin-top: 6px;
    letter-spacing: 0;
  }
  .stage-geocities .tagline {
    margin: 18px 0 0;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    color: #ffff00;
    font-size: 16px;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .tagline em { color: #ff66ff; font-style: italic; }
  .stage-geocities .heart {
    color: #ff3b1f;
    text-shadow: 0 0 6px #ff3b1f;
    animation: heart-beat 1s ease-in-out infinite;
    display: inline-block;
  }
  @keyframes heart-beat {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.2); }
  }

  /* ─── Construction + Visitor row ─── */
  .stage-geocities .row-2 {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin: 28px 0;
  }
  .stage-geocities .construction {
    background: rgba(0,0,0,0.6);
    border: 3px ridge #ffff00;
    padding: 12px;
    width: 240px;
  }
  .stage-geocities .hazard {
    width: 100%;
    height: 26px;
    background:
      repeating-linear-gradient(
        -45deg,
        #ffff00 0,
        #ffff00 14px,
        #000000 14px,
        #000000 28px
      );
    margin-bottom: 8px;
    animation: hazard-scroll 1s linear infinite;
    background-size: 200% 100%;
  }
  @keyframes hazard-scroll {
    from { background-position: 0 0; }
    to   { background-position: 40px 0; }
  }
  .stage-geocities .construction p {
    margin: 8px 0 4px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    color: #ffff00;
    font-weight: 700;
    font-size: 13px;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .construction .caption {
    color: #ff66ff;
    font-size: 12px;
    font-style: italic;
  }
  .stage-geocities .visitor {
    background: rgba(0,0,0,0.6);
    border: 3px ridge #00ffff;
    padding: 12px;
    width: 240px;
  }
  .stage-geocities .visitor .label {
    color: #00ffff;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-weight: 700;
    font-size: 13px;
    text-shadow: 1px 1px 0 #000;
    margin-bottom: 8px;
  }
  .stage-geocities .led-counter {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    background: #050505;
    border: 1px solid #ff3b1f;
  }
  .stage-geocities .led-counter span {
    width: 22px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #1a0404;
    color: #ff3b1f;
    font-family: 'Courier New', monospace;
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
    text-shadow: 0 0 5px #ff3b1f, 0 0 10px rgba(255,59,31,0.5);
  }
  .stage-geocities .caption-sm {
    margin-top: 6px;
    color: #ff66ff;
    font-style: italic;
    font-size: 11px;
  }

  /* ─── What's NEW ─── */
  .stage-geocities .news {
    margin: 28px 0;
    text-align: left;
  }
  .stage-geocities .ribbon {
    margin: 0 0 14px;
    padding: 6px 12px;
    background: linear-gradient(90deg, #ff00ff 0%, #ffff00 50%, #00ffff 100%);
    color: #000000;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-size: 22px;
    font-weight: 700;
    text-align: center;
    text-shadow: 1px 1px 0 #fff;
    border-top: 2px solid #fff;
    border-bottom: 2px solid #000;
    text-transform: uppercase;
  }
  .stage-geocities .ribbon em {
    font-style: normal;
    color: #ff0000;
    text-shadow: 1px 1px 0 #fff;
  }
  .stage-geocities .ribbon-orange {
    background: linear-gradient(90deg, #ff6600 0%, #ffcc00 50%, #ff6600 100%);
  }
  .stage-geocities .blink {
    color: #ff3b1f;
    animation: geo-blink 0.8s steps(2, end) infinite;
    display: inline-block;
  }
  @keyframes geo-blink { 50% { opacity: 0; } }
  .stage-geocities .news-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    color: #ffffff;
  }
  .stage-geocities .news-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 12px;
    background: rgba(0,0,0,0.55);
    border: 2px ridge #00ff00;
  }
  .stage-geocities .news-list .bullet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    padding: 2px 6px;
    background: #ffff00;
    color: #000;
    font-weight: 700;
    font-size: 12px;
    text-shadow: none;
    flex-shrink: 0;
  }
  .stage-geocities .news-list li:nth-child(2n) { border-color: #ff00ff; }
  .stage-geocities .news-list li:nth-child(2n) .bullet { background: #00ffff; }
  .stage-geocities .news-list li:nth-child(3n) { border-color: #ffff00; }
  .stage-geocities .news-list li:nth-child(3n) .bullet { background: #ff00ff; color: #fff; }
  .stage-geocities .news-list li:nth-child(4n) { border-color: #00ffff; }
  .stage-geocities .news-list li:nth-child(4n) .bullet { background: #66ff00; }

  /* ─── Download CTA ─── */
  .stage-geocities .download-cta { margin: 36px 0; }
  .stage-geocities .gdl-grid {
    list-style: none;
    margin: 18px auto 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    max-width: 560px;
  }
  .stage-geocities .gdl-grid li { display: flex; }
  .stage-geocities .gdl-grid li:last-child { grid-column: span 2; }
  .stage-geocities .gdl-btn {
    flex: 1;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-size: 16px;
    font-weight: 700;
    color: #000;
    text-decoration: underline;
    border-top: 3px solid #fff;
    border-left: 3px solid #fff;
    border-right: 3px solid #000;
    border-bottom: 3px solid #000;
    box-shadow: 3px 3px 0 #000;
    text-shadow: none;
    transition: transform 80ms ease;
  }
  .stage-geocities .gdl-btn:hover { color: #ff0000; transform: translate(-1px, -1px); box-shadow: 4px 4px 0 #000; }
  .stage-geocities .gdl-btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
  .stage-geocities .gdl-arrow { color: #ff3b1f; font-size: 16px; }
  .stage-geocities .gdl-label { text-align: left; font-size: 14px; letter-spacing: 0.02em; }
  .stage-geocities .gdl-size {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: #003;
    text-decoration: none;
    background: rgba(255,255,255,0.55);
    padding: 1px 5px;
    border: 1px solid #000;
  }
  /* Five garish palettes, one per button. The grid pulses at staggered
     phases so the whole block feels alive. */
  .stage-geocities .gdl-1 .gdl-btn { background: #ffff00; animation: btn-pulse 1.6s ease-in-out infinite; }
  .stage-geocities .gdl-2 .gdl-btn { background: #00ffff; animation: btn-pulse 1.7s ease-in-out infinite 0.1s; }
  .stage-geocities .gdl-3 .gdl-btn { background: #66ff66; animation: btn-pulse 1.8s ease-in-out infinite 0.2s; }
  .stage-geocities .gdl-4 .gdl-btn { background: #ff66ff; animation: btn-pulse 1.9s ease-in-out infinite 0.3s; color: #000; }
  .stage-geocities .gdl-5 .gdl-btn {
    background: linear-gradient(90deg, #ff6600 0%, #ffcc00 50%, #ff6600 100%);
    animation: btn-pulse 1.5s ease-in-out infinite 0.05s;
  }
  @keyframes btn-pulse {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.03); }
  }
  .stage-geocities .cta-sub {
    margin: 10px 0 0;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    color: #ffff00;
    font-size: 14px;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .cta-sub .blink { color: #ff3b1f; }

  /* ─── Webring ─── */
  .stage-geocities .webring {
    margin: 36px auto;
    padding: 14px;
    border: 3px ridge #ff00ff;
    background: rgba(0,0,0,0.6);
  }
  .stage-geocities .webring h3 {
    margin: 0 0 10px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    color: #ffff00;
    font-size: 16px;
    text-shadow: 1px 1px 0 #000;
  }
  .stage-geocities .ring-links {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 14px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-size: 14px;
    color: #ffffff;
  }
  .stage-geocities .badges {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stage-geocities .b88 {
    width: 88px;
    height: 31px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Courier New', monospace;
    font-size: 9px;
    font-weight: 700;
    text-align: center;
    line-height: 1.05;
    text-shadow: 1px 1px 0 #000;
    border: 1px solid #000;
    padding: 1px;
  }
  .stage-geocities .b-netscape { background: linear-gradient(180deg, #003 0%, #069 100%); color: #ffffff; }
  .stage-geocities .b-blink    { background: #ff0000; color: #ffff00; animation: geo-blink 1s steps(2, end) infinite; }
  .stage-geocities .b-1024     { background: #008080; color: #ffffff; }
  .stage-geocities .b-mit      { background: #ffcc00; color: #000; text-shadow: 1px 1px 0 #fff; }


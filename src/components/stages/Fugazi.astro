---
/*
 * Stage 1 : FUGAZI (2024 SaaS lie)
 *
 * The entry impression. Reads as a credible Linear / Stripe / Vercel-tier
 * SaaS landing for an open-source mod manager dressed up as enterprise
 * platform. The lie is told with care: mesh-gradient hero, Fortune 500
 * trust wall, pricing tiers, compliance badges. Every CTA resolves to
 * the actual GitHub release. A user who never scrolls past Fugazi still
 * gets the binary.
 */
import type { DownloadUrls } from '../../data/content';
import { fmtBytes } from '../../data/content';
const dl = Astro.props as DownloadUrls;

/*
 * Platform chips under the hero CTA. Standard "select your runtime"
 * SaaS pattern. AUR is included so Arch users don't have to leave to
 * find it; macOS sits in dim state because we don't ship for it yet.
 */
const fugaziPlatforms = [
  { os: 'Windows', label: 'Installer',  asset: dl.windowsInstaller, href: dl.windowsInstaller?.browser_download_url ?? dl.releaseUrl, available: !!dl.windowsInstaller },
  { os: 'Windows', label: 'Portable',   asset: dl.windowsPortable,  href: dl.windowsPortable?.browser_download_url  ?? dl.releaseUrl, available: !!dl.windowsPortable  },
  { os: 'Linux',   label: 'AppImage',   asset: dl.linuxAppImage,    href: dl.linuxAppImage?.browser_download_url    ?? dl.releaseUrl, available: !!dl.linuxAppImage    },
  { os: 'Linux',   label: '.deb',       asset: dl.linuxDeb,         href: dl.linuxDeb?.browser_download_url         ?? dl.releaseUrl, available: !!dl.linuxDeb         },
];

const corpFeatures = [
  {
    title: 'Mod orchestration',
    body: 'Single-pane catalog indexed against the entire GameBanana ecosystem. Sub-millisecond queries, infinite filters, zero infrastructure.',
    icon: 'orchestrate',
  },
  {
    title: 'Library management',
    body: 'Detect conflicts before they hit production. Granular toggle controls, full audit trail, per-mod priority routing at the VPK layer.',
    icon: 'library',
  },
  {
    title: 'Asset locker',
    body: 'Per-character variant pinning with zero-downtime swaps. Version every skin you ship. Roll forward, roll back, never overwrite.',
    icon: 'locker',
  },
  {
    title: 'Profile distribution',
    body: 'Share full configurations as short signed codes or JSON manifests. Stateless, replay-safe, designed for the wire.',
    icon: 'distribute',
  },
];

/*
 * Trust-wall "customers." Standard SaaS social-proof pattern, except
 * every logo is a famous fictional megacorp from sci-fi and games. The
 * joke gets funnier the longer you stare at it. Costume stays in
 * character (real corporate typography) while the names give it away.
 */
const trustWall = [
  { name: 'APERTURE SCIENCE',   cls: 'wm wm-cond'   },
  { name: 'Weyland-Yutani',     cls: 'wm wm-serif'  },
  { name: 'UMBRELLA CORP',      cls: 'wm wm-sans'   },
  { name: 'OmniCorp',           cls: 'wm wm-tight'  },
  { name: 'CYBERDYNE SYSTEMS',  cls: 'wm wm-spread' },
  { name: 'Tyrell | Initech | Hooli', cls: 'wm wm-split' },
  { name: 'VAULT-TEC',          cls: 'wm wm-mono'   },
];

const tiers = [
  {
    name: 'Hobbyist',
    price: '$0',
    period: '/month',
    tagline: 'For the solo modder building something nobody asked for.',
    features: [
      'Unlimited mods, locally indexed',
      'Full library management',
      'Hero Locker variant control',
      'Community support via Discord',
      'MIT licensed source code',
    ],
    cta: 'Get started',
    href: dl.primaryHref,
    featured: false,
  },
  {
    name: 'Team',
    price: '$99',
    period: '/seat/month',
    tagline: 'For growing studios that need governance.',
    features: [
      'Everything in Hobbyist',
      'SSO via SAML 2.0',
      'Audit logs · 90-day retention',
      'Profile sharing with role-based access',
      'Priority support · 24h SLA',
    ],
    cta: 'Start free trial',
    href: dl.primaryHref,
    featured: true,
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    period: '',
    tagline: 'For organizations with compliance requirements.',
    features: [
      'Everything in Team',
      'SOC 2 Type II attestation',
      'Custom SLA · 99.99% uptime',
      'Dedicated solutions engineer',
      'On-prem deployment available',
      'Procurement onboarding',
    ],
    cta: 'Contact sales',
    href: '#contact',
    featured: false,
  },
];

/*
 * Product tour. The one section of Fugazi that is not a lie: these are
 * real screenshots of the real app. The costume is the framing: fake
 * browser chrome with an enterprise vanity domain (Grimoire is an
 * Electron app; there is no app.grimoire.enterprise), captions written
 * by someone paid per buzzword. Thumbs are 880w webp; the click-through
 * is the full-size png.
 */
const tourShots = [
  {
    name: 'browse',
    w: 880, h: 522,
    url: 'app.grimoire.enterprise/discovery',
    title: 'Frictionless mod discovery at planetary scale.',
    body: 'The entire GameBanana catalog, indexed into a single procurement surface. Evaluate, shortlist, and acquire assets without opening a browser tab like some kind of individual contributor.',
    alt: 'Grimoire mod browser showing a searchable grid of GameBanana mods',
  },
  {
    name: 'installed',
    w: 880, h: 522,
    url: 'app.grimoire.enterprise/orchestration',
    title: 'Your mod estate, under management.',
    body: 'Every installed mod with one toggle between enabled and disabled. We call this bidirectional state governance. It is a checkbox.',
    alt: 'Grimoire installed-mods library with per-mod enable and disable toggles',
  },
  {
    name: 'locker',
    w: 880, h: 522,
    url: 'app.grimoire.enterprise/cosmetics',
    title: 'A single pane of glass for your hero cosmetics estate.',
    body: 'Per-hero skin selection with visual previews. Pin a variant to a hero and it stays pinned: the kind of durability guarantee our customers tell us they can no longer live without.',
    alt: 'Grimoire Hero Locker showing a per-hero skin picker with previews',
  },
  {
    name: 'conflicts',
    w: 880, h: 550,
    url: 'app.grimoire.enterprise/incidents',
    title: 'Shift-left conflict remediation.',
    body: 'When two mods write to the same VPK surface, Grimoire flags the collision before it ever reaches your runtime. Mean time to detection: before you press the button.',
    alt: 'Grimoire conflict warnings listing mods that modify the same VPK files',
  },
  {
    name: 'profiles',
    w: 880, h: 522,
    url: 'app.grimoire.enterprise/loadouts',
    title: 'Loadouts as a strategic asset.',
    body: 'Snapshot entire mod configurations as named profiles and move between them with zero downtime. Ranked-night compliance posture, achieved in one click.',
    alt: 'Grimoire profiles screen with saved mod loadouts',
  },
  {
    name: 'collectionimport',
    w: 880, h: 550,
    url: 'app.grimoire.enterprise/ingestion',
    title: 'Bulk ingestion for the high-velocity organization.',
    body: 'Import a full GameBanana collection in a single operation. What your analysts call a download queue, we call a throughput-optimized acquisition pipeline.',
    alt: 'Grimoire GameBanana collection import dialog listing mods to install in bulk',
  },
];

const compliance = [
  { abbr: 'SOC 2', full: 'Type II' },
  { abbr: 'ISO 27001', full: 'Certified' },
  { abbr: 'GDPR', full: 'Compliant' },
  { abbr: 'HIPAA', full: 'Ready' },
  { abbr: 'FedRAMP', full: 'Authorized' },
  { abbr: 'CCPA', full: 'Compliant' },
];
---

<section class="stage stage-fugazi" data-era="fugazi" aria-labelledby="fugazi-h1">
  <!-- ─── HERO ─── -->
  <section class="hero">
    {/*
      Stripe-style silk ribbon. Three layered SVG paths, each on its own
      slow drift cycle, blended together. Pure decoration; aria-hidden.
      Lives inside the hero so it doesn't bleed into Features/Pricing.
    */}
    <div class="ribbon-wrap" aria-hidden="true">
      <svg class="ribbon" viewBox="0 0 1500 1700" preserveAspectRatio="xMaxYMid slice">
        <defs>
          <linearGradient id="silk-a" x1="0%" y1="0%" x2="55%" y2="100%">
            <stop offset="0%"   stop-color="#a78bfa" />
            <stop offset="35%"  stop-color="#ec4899" />
            <stop offset="70%"  stop-color="#fb7185" />
            <stop offset="100%" stop-color="#fb923c" />
          </linearGradient>
          <linearGradient id="silk-b" x1="100%" y1="0%" x2="20%" y2="100%">
            <stop offset="0%"   stop-color="#c4b5fd" />
            <stop offset="45%"  stop-color="#f0abfc" />
            <stop offset="100%" stop-color="#fdba74" />
          </linearGradient>
          <linearGradient id="silk-c" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%"   stop-color="#fb923c" />
            <stop offset="50%"  stop-color="#f472b6" />
            <stop offset="100%" stop-color="#8b5cf6" />
          </linearGradient>
          <filter id="silk-soften" x="-10%" y="-10%" width="120%" height="120%">
            <feGaussianBlur stdDeviation="0.6" />
          </filter>
        </defs>

        <path class="silk silk-a" filter="url(#silk-soften)" fill="url(#silk-a)"
          d="M 1600 -120
             C 1250 120, 980 360, 720 600
             C 460 840, 220 1000, -40 1180
             L 60 1500
             C 280 1300, 580 1080, 860 820
             C 1140 560, 1400 300, 1700 80 Z" />

        <path class="silk silk-b" filter="url(#silk-soften)" fill="url(#silk-b)"
          d="M 1620 60
             C 1320 320, 1020 540, 760 760
             C 500 980, 240 1140, 0 1340
             L 130 1620
             C 360 1400, 660 1200, 940 960
             C 1220 720, 1480 480, 1720 240 Z" />

        <path class="silk silk-c" fill="url(#silk-c)"
          d="M 1650 220
             C 1380 480, 1080 700, 820 900
             C 580 1080, 320 1240, 100 1440
             L 200 1700
             C 420 1500, 720 1320, 1000 1100
             C 1280 880, 1540 660, 1760 420 Z" />
      </svg>
    </div>

    <div class="wrap">
      <a class="pill" href={dl.releaseUrl}>
        <span class="pill-tag">New</span>
        <span>Grimoire {dl.version ? `v${dl.version}` : '1.x'} is here. See what shipped</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>

      <h1 id="fugazi-h1">The platform for<br />modern modding.</h1>
      <p class="lead">
        Mod orchestration, library management, and profile distribution in one
        place. Built for the teams who ship the mods that ship the games.
      </p>

      <div class="ctas">
        <a class="btn btn-primary" href={dl.primaryHref}>Get started for free</a>
        <a class="btn btn-ghost" href="#contact">
          Talk to sales
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="plat-chips" aria-label="Download by platform">
        {fugaziPlatforms.map((p) => (
          <li>
            <a class="plat-chip" href={p.href} title={p.asset ? `${p.asset.name} (${fmtBytes(p.asset.size)})` : 'Open releases'}>
              <span class="plat-chip-os">{p.os}</span>
              <span class="plat-chip-label">{p.label}</span>
              {p.asset && <span class="plat-chip-size">{fmtBytes(p.asset.size)}</span>}
            </a>
          </li>
        ))}
      </ul>

      <p class="micro">12,000+ developers · 47,000 mods deployed · MIT licensed</p>
    </div>
  </section>

  <!-- ─── TRUST WALL ─── -->
  <section class="trust">
    <div class="wrap">
      <ul class="logo-strip" aria-label="Customers">
        {trustWall.map((b) => <li class={b.cls}>{b.name}</li>)}
      </ul>
    </div>
  </section>

  <!-- ─── FEATURES ─── -->
  <section class="features">
    <div class="wrap">
      <header>
        <span class="eyebrow">Platform</span>
        <h2>Everything you need to ship mods at scale.</h2>
        <p class="section-lead">
          From discovery to distribution, Grimoire is the system of record for
          every artifact your team ships.
        </p>
      </header>

      <div class="grid">
        {corpFeatures.map((f) => (
          <article class="card">
            <span class="card-icon" aria-hidden="true">
              {f.icon === 'orchestrate' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="16" cy="6" r="3" />
                  <circle cx="6" cy="24" r="3" />
                  <circle cx="26" cy="24" r="3" />
                  <path d="M16 9v6m-2 1L8 22m10-6l6 6" />
                </svg>
              )}
              {f.icon === 'library' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="6" y="6" width="20" height="4" rx="0.5" />
                  <rect x="6" y="14" width="20" height="4" rx="0.5" />
                  <rect x="6" y="22" width="14" height="4" rx="0.5" />
                </svg>
              )}
              {f.icon === 'locker' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="5" width="6" height="6" />
                  <rect x="13" y="5" width="6" height="6" />
                  <rect x="21" y="5" width="6" height="6" />
                  <rect x="5" y="13" width="6" height="6" />
                  <rect x="13" y="13" width="6" height="6" fill="currentColor" />
                  <rect x="21" y="13" width="6" height="6" />
                  <rect x="5" y="21" width="6" height="6" />
                  <rect x="13" y="21" width="6" height="6" />
                  <rect x="21" y="21" width="6" height="6" />
                </svg>
              )}
              {f.icon === 'distribute' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="8" cy="8" r="3" />
                  <circle cx="24" cy="16" r="3" />
                  <circle cx="8" cy="24" r="3" />
                  <path d="M11 9.5l10 5m0 3l-10 5" />
                </svg>
              )}
            </span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── PRODUCT TOUR ─── -->
  <section class="tour">
    <div class="wrap">
      <header>
        <span class="eyebrow">Product</span>
        <h2>See the platform in production.</h2>
        <p class="section-lead">
          A guided tour of the surfaces where modern mod operations happen.
          Captured live, from real workloads, with no staging-environment
          trickery whatsoever.
        </p>
      </header>

      <div class="tour-rows">
        {tourShots.map((s, i) => (
          <article class={`tour-row ${i % 2 === 1 ? 'is-flipped' : ''}`}>
            <a class="shot" href={`/screenshots/${s.name}.png`} target="_blank" rel="noopener">
              <span class="shot-chrome" aria-hidden="true">
                <span class="shot-dots"><i></i><i></i><i></i></span>
                <span class="shot-url">{s.url}</span>
              </span>
              <img
                src={`/screenshots/thumbs/${s.name}.webp`}
                alt={s.alt}
                width={s.w}
                height={s.h}
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="tour-copy">
              <span class="tour-step">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── PRICING ─── -->
  <section class="pricing">
    <div class="wrap">
      <header>
        <span class="eyebrow">Pricing</span>
        <h2>Pricing that scales with your team.</h2>
        <p class="section-lead">
          Start free. Upgrade when your team needs SSO, audit logs, or a
          dedicated solutions engineer.
        </p>
      </header>

      <div class="tiers">
        {tiers.map((t) => (
          <article class={`tier ${t.featured ? 'is-featured' : ''}`}>
            {t.featured && <span class="tier-badge">Most popular</span>}
            <h3>{t.name}</h3>
            <p class="tier-tag">{t.tagline}</p>
            <div class="tier-price">
              <span class="amt">{t.price}</span>
              {t.period && <span class="per">{t.period}</span>}
            </div>
            <a class={`btn ${t.featured ? 'btn-primary' : 'btn-ghost'} btn-block`} href={t.href}>
              {t.cta}
            </a>
            <ul class="tier-list">
              {t.features.map((f) => (
                <li>
                  <svg class="tick" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 8.5l3.5 3.5L13 5" />
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── COMPLIANCE ─── -->
  <section class="compliance">
    <div class="wrap">
      <span class="eyebrow">Security</span>
      <h2>Enterprise-grade security and compliance.</h2>
      <p class="section-lead">
        Grimoire is built on the same primitives trusted by global teams. We
        invest in third-party audits so you do not have to.
      </p>
      <ul class="cmp-strip">
        {compliance.map((c) => (
          <li class="cmp">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 3l11 4v8c0 7.5-5 12.5-11 14-6-1.5-11-6.5-11-14V7l11-4z" />
              <path d="M11 16l3.5 3.5L21 13" />
            </svg>
            <div class="cmp-text">
              <strong>{c.abbr}</strong>
              <small>{c.full}</small>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── OFFICE RADIO ─── -->
  {/* A real player behind the SaaS satire: free, listener-supported
      streams (laut.fm, SomaFM), driven by the shared era-radio engine
      (sound on by default, follows the TIME MACHINE between channels). */}
  <section class="radio-band">
    <div class="wrap">
      <div class="radio-card" data-era-radio>
        <div class="radio-copy">
          <span class="eyebrow">Grimoire FM</span>
          <strong class="radio-title">Deep-work radio, zero meetings.</strong>
          <span class="radio-status" data-radio-status aria-live="polite">Paused. Focus metrics at risk.</span>
        </div>
        <div class="radio-controls">
          <div class="st-chips" role="group" aria-label="Stations">
            <button type="button" class="st-chip" data-radio-station="lofi" aria-pressed="true">Lofi</button>
            <button type="button" class="st-chip" data-radio-station="fluid" aria-pressed="false">Fluid</button>
          </div>
          <button
            type="button"
            class="btn btn-primary"
            data-radio-play
            data-label-play="Start listening"
            data-label-pause="Pause"
            aria-pressed="false"
          >Start listening</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FINAL CTA ─── -->
  <section class="cta-final" id="contact">
    <div class="wrap">
      <h2>Start orchestrating modern mod operations.</h2>
      <p class="section-lead">
        No credit card required. Forever free for solo modders.
      </p>
      <div class="ctas">
        <a class="btn btn-primary btn-lg" href={dl.primaryHref}>Get started for free</a>
        <a class="btn btn-ghost btn-lg" href={dl.primaryHref}>
          Contact sales
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</section>

<style>
  /* ─────────────────────────────────────────────────────────────────
     FUGAZI: scoped 2024-SaaS world. Inter, off-white, mesh-gradient
     hero, monochrome Fortune-500 trust wall, pricing tiers, faux
     compliance badges. Every CTA hits a real GitHub release.
     ───────────────────────────────────────────────────────────────── */

  .stage-fugazi {
    background: #fafafa;
    color: #0a0a0a;
    font-family: 'Inter', ui-sans-serif, -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11', 'ss01';
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    min-height: auto;
    overflow: visible;
  }
  .stage-fugazi .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .stage-fugazi h1,
  .stage-fugazi h2,
  .stage-fugazi h3 {
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #0a0a0a;
  }
  .stage-fugazi p { margin: 0; }
  .stage-fugazi a { color: inherit; text-decoration: none; }
  .stage-fugazi ul { margin: 0; padding: 0; list-style: none; }

  .stage-fugazi .eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: #6366f1;
    margin-bottom: 16px;
  }
  .stage-fugazi .section-lead {
    color: #52525b;
    font-size: 18px;
    line-height: 1.55;
    max-width: 640px;
    margin: 16px 0 0;
  }

  /* ─── Buttons ─── */
  .stage-fugazi .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
    transition: background-color 140ms ease, transform 80ms ease, border-color 140ms ease, box-shadow 200ms ease;
    line-height: 1;
    cursor: pointer;
  }
  .stage-fugazi .btn-primary {
    background: #0a0a0a;
    color: #fafafa;
    border: 1px solid #0a0a0a;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.12),
      0 1px 2px rgba(0,0,0,0.08),
      0 6px 24px -8px rgba(0,0,0,0.45);
  }
  .stage-fugazi .btn-primary:hover {
    background: #18181b;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.14),
      0 2px 4px rgba(0,0,0,0.12),
      0 10px 32px -8px rgba(0,0,0,0.55);
  }
  .stage-fugazi .btn-primary:active { transform: translateY(1px); }

  .stage-fugazi .btn-ghost {
    background: transparent;
    color: #0a0a0a;
    border: 1px solid rgba(10,10,10,0.12);
  }
  .stage-fugazi .btn-ghost:hover {
    background: rgba(10,10,10,0.04);
    border-color: rgba(10,10,10,0.22);
  }
  .stage-fugazi .btn-lg { padding: 13px 22px; font-size: 15px; }
  .stage-fugazi .btn-block { width: 100%; justify-content: center; }
  .stage-fugazi .btn .arrow {
    transition: transform 160ms ease;
  }
  .stage-fugazi .btn:hover .arrow { transform: translateX(2px); }

  /* ─── Stripe-silk ribbon ───
     Three layered SVG paths, each drifting on its own slow cycle. The
     wrap is masked off on the left so the headline sits on clean white
     and the silk bleeds off the right edge. */
  .stage-fugazi .ribbon-wrap {
    position: absolute;
    inset: 0 -10% 0 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    mask-image:
      linear-gradient(95deg, transparent 0%, transparent 18%, #000 70%, #000 100%),
      linear-gradient(180deg, #000 0%, #000 55%, transparent 92%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(95deg, transparent 0%, transparent 18%, #000 70%, #000 100%),
      linear-gradient(180deg, #000 0%, #000 55%, transparent 92%);
    -webkit-mask-composite: source-in;
  }
  .stage-fugazi .ribbon {
    position: absolute;
    top: -8%;
    right: -8%;
    width: 70%;
    height: 116%;
    filter: saturate(1.15) blur(0.4px);
  }
  .stage-fugazi .silk {
    transform-box: fill-box;
    transform-origin: 70% 40%;
    mix-blend-mode: multiply;
    will-change: transform;
  }
  .stage-fugazi .silk-a {
    opacity: 0.78;
    animation: silk-drift-a 22s ease-in-out infinite alternate;
  }
  .stage-fugazi .silk-b {
    opacity: 0.55;
    mix-blend-mode: screen;
    animation: silk-drift-b 28s ease-in-out infinite alternate;
  }
  .stage-fugazi .silk-c {
    opacity: 0.42;
    mix-blend-mode: multiply;
    animation: silk-drift-c 34s ease-in-out infinite alternate;
  }
  @keyframes silk-drift-a {
    0%   { transform: rotate(-2.5deg) translate3d(0, 0, 0) scale(1); }
    100% { transform: rotate(2.5deg)  translate3d(-1.5%, 1%, 0) scale(1.04); }
  }
  @keyframes silk-drift-b {
    0%   { transform: rotate(2deg)  translate3d(0, 0, 0) scale(1.02); }
    100% { transform: rotate(-3deg) translate3d(1.5%, -1%, 0) scale(0.98); }
  }
  @keyframes silk-drift-c {
    0%   { transform: rotate(-1deg) translate3d(0, 1%, 0); }
    100% { transform: rotate(3.5deg) translate3d(-1%, -1.5%, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage-fugazi .silk-a,
    .stage-fugazi .silk-b,
    .stage-fugazi .silk-c { animation: none; }
  }

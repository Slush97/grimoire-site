---
/*
 * PROTOTYPE: background picker. Mounts every ambient variant behind the
 * page and shows one, chosen by ?bg=<id>, then remembered in localStorage.
 * Once a variant wins, mount it directly and delete this file and the
 * losers.
 *
 * Variant contract:
 *   - root is <div class="amb" data-amb="<id>" aria-hidden="true">
 *   - only the variant whose id matches html[data-amb] is displayed; its
 *     script must start/stop itself on load and on the `amb:change` event
 *     (detail: the new id) so hidden variants cost nothing
 *   - pause on document.hidden, draw one still frame under
 *     prefers-reduced-motion, never request anything off-site
 */
import Ink from './Ink.astro';
import Sigils from './Sigils.astro';
import Beam from './Beam.astro';
import Stars from './Stars.astro';

const variants = [
  { id: 'ink', label: 'Ink smoke' },
  { id: 'sigils', label: 'Sigil rings' },
  { id: 'beam', label: 'Lamp beam' },
  { id: 'stars', label: 'Constellations' },
  { id: 'ribbon', label: 'Current ribbon' },
  { id: 'none', label: 'None' },
];
const ids = variants.map((v) => v.id);
const show = ids.map((id) => `html[data-amb='${id}'] .amb[data-amb='${id}']`).join(',');
---

<script is:inline define:vars={{ ids }}>
  (() => {
    const KEY = 'grimoire.amb.proto';
    let id = new URLSearchParams(location.search).get('bg');
    if (!ids.includes(id)) {
      try {
        id = localStorage.getItem(KEY);
      } catch {}
    }
    if (!ids.includes(id)) id = ids[0];
    document.documentElement.dataset.amb = id;
    try {
      localStorage.setItem(KEY, id);
    } catch {}
  })();
</script>

<Ink />
<Sigils />
<Beam />
<Stars />

<div class="amb-pick" role="group" aria-label="Background prototype">
  <span>Background</span>
  {variants.map((v) => (
    <button type="button" data-pick={v.id}>{v.label}</button>
  ))}
</div>

<style is:global set:html={`
  .amb {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: none;
    pointer-events: none;
    overflow: hidden;
  }
  ${show} { display: block; }
`}></style>

<style>
  .amb-pick {
    position: fixed;
    left: 12px;
    bottom: 12px;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    max-width: calc(100vw - 24px);
    padding: 6px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: rgba(14, 14, 17, 0.92);
    font-size: 12px;
  }
  .amb-pick span {
    padding: 0 6px;
    color: var(--dim);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .amb-pick button {
    height: 26px;
    padding: 0 10px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }
  .amb-pick button:hover {
    color: var(--text);
    background: var(--surface-hi);
  }
  :global(html[data-amb]) .amb-pick button[aria-pressed='true'] {
    color: #fff;
    background: var(--accent);
  }
</style>

<script>
  const KEY = 'grimoire.amb.proto';
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  const sync = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pick === root.dataset.amb)));
  sync();
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const id = b.dataset.pick!;
      root.dataset.amb = id;
      try {
        localStorage.setItem(KEY, id);
      } catch {}
      const url = new URL(location.href);
      url.searchParams.set('bg', id);
      history.replaceState(null, '', url);
      sync();
      document.dispatchEvent(new CustomEvent('amb:change', { detail: id }));
    }),
  );
</script>

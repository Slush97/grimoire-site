---
const angle = 26;
const len = 3600;
const fade = [0, 1300, 3000, len];
const core = { s: 0.22, p: 2.6 };
const halo = { s: 0.5, p: 2 };

const shape = (n: number, s: number, p: number) => Math.exp(-Math.pow(Math.abs(n / s), p));
const taper = (n: number) => (1 - n * n) ** 2;
const ease = (x: number) => x * x * (3 - 2 * x);
const rays = (n: number) => 0.8 + 0.2 * (0.5 * Math.sin(n * 19 + 1.3) + 0.3 * Math.sin(n * 41 + 0.4) + 0.2 * Math.sin(n * 7.3 + 2.1));

const across = (rgb: string, a: number, steps: number, f: (n: number) => number) =>
  `linear-gradient(${Array.from({ length: steps + 1 }, (_, i) => {
    const n = (2 * i) / steps - 1;
    return `rgba(${rgb},${(a * f(n) * taper(n)).toFixed(4)}) ${((100 * i) / steps).toFixed(2)}%`;
  }).join()})`;

const glow = `radial-gradient(closest-side,${Array.from({ length: 21 }, (_, i) => {
  const r = i / 20;
  const k = ease(Math.min(1, Math.max(0, (r - 0.1) / 0.6)));
  const rgb = [236 + (167 - 236) * k, 168 + (139 - 168) * k, 120 + (250 - 120) * k].map(Math.round).join(',');
  return `rgba(${rgb},${(0.06 * Math.exp(-((r / 0.5) ** 2)) * taper(r)).toFixed(4)}) ${i * 5}%`;
}).join()})`;

const ramp = (from: number, to: number, rise: boolean) =>
  Array.from({ length: 7 }, (_, i) => {
    const k = ease(i / 6);
    return `rgba(0,0,0,${(rise ? k : 1 - k).toFixed(3)}) ${Math.round(from + (to - from) * (i / 6))}px`;
  });
const mask = `linear-gradient(90deg,${[...ramp(fade[0], fade[1], true), ...ramp(fade[2], fade[3], false)].join()})`;

const vars = [
  `--tilt:${-angle}deg`,
  `--len:${len}px`,
  `--core:${across('194,155,76', 0.15, 80, (n) => shape(n, core.s, core.p) * rays(n))}`,
  `--halo:${across('167,139,250', 0.04, 40, (n) => shape(n, halo.s, halo.p))},${across('124,58,237', 0.022, 40, (n) => shape(n, 0.8, 2))}`,
  `--mask:${mask}`,
].join(';');
---

<div class="amb" data-amb="beam" aria-hidden="true" data-beam={JSON.stringify({ angle, len, fade, core, halo })}>
  <div class="rig">
    <i class="glow" style={`background:${glow}`}></i>
    <div class="shaft" style={vars}>
      <i class="halo"></i>
      <i class="core"></i>
      <canvas class="band"></canvas>
    </div>
  </div>
  <canvas class="dust"></canvas>
</div>

<style>
  /* Screen over an opaque base so faint gradient tails can never round darker than the page and leave a seam. */
  .amb {
    background: var(--bg);
  }
  .rig,
  .dust {
    mix-blend-mode: screen;
  }
  .rig {
    position: absolute;
    inset: 0;
    animation: beam-warm 2.8s ease-out both;
  }
  .shaft {
    position: absolute;
    left: calc(50% - 82px);
    top: min(730px, 82vh);
    width: var(--len);
    height: 680px;
    transform: translate(-50%, -50%) rotate(var(--tilt));
    mask-image: var(--mask);
  }
  .shaft i {
    position: absolute;
    inset: 0;
    will-change: opacity;
  }
  .glow {
    position: absolute;
    right: -22vw;
    top: -40vh;
    width: 80vw;
    height: 90vh;
    will-change: opacity;
  }
  .core {
    background: var(--core);
  }
  .halo {
    background: var(--halo);
  }
  /* The CSS gradients are the fallback; with WebGL the band canvas replaces them. */
  .band {
    display: none;
  }
  .shaft:global(.gl) .band {
    display: block;
  }
  .shaft:global(.gl) .core,
  .shaft:global(.gl) .halo {
    display: none;
  }
  .band,
  .dust {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  @keyframes beam-warm {
    from {
      opacity: 0;
    }
  }
  @media (max-width: 960px) {
    .shaft {
      left: 50%;
      top: min(600px, 72vh);
      height: 480px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rig {
      animation: none;
    }
  }
</style>

<script>
  type Cfg = { angle: number; len: number; fade: number[]; core: { s: number; p: number }; halo: { s: number; p: number } };
  type Mote = {
    x: number;
    y: number;
    z: number;
    d: number;
    a: number;
    soft: boolean;
    flake: number;
    p1: number;
    p2: number;
    spin: number;
    w: number;
    age: number;
    lc: number;
    lh: number;
  };

  const root = document.querySelector<HTMLElement>('.amb[data-amb="beam"]')!;
  const cfg: Cfg = JSON.parse(root.dataset.beam!);
  const rig = root.querySelector<HTMLElement>('.rig')!;
  const shaft = root.querySelector<HTMLElement>('.shaft')!;
  const coreEl = root.querySelector<HTMLElement>('.core')!;
  const haloEl = root.querySelector<HTMLElement>('.halo')!;
  const glowEl = root.querySelector<HTMLElement>('.glow')!;
  const band = root.querySelector<HTMLCanvasElement>('.band')!;
  const canvas = root.querySelector<HTMLCanvasElement>('.dust')!;
  const ctx = canvas.getContext('2d')!;
  const html = document.documentElement;
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  const rad = (cfg.angle * Math.PI) / 180;
  const cos = Math.cos(rad);
  const sin = Math.sin(rad);
  const tan = sin / cos;
  const [, f1, f2, flen] = cfg.fade;
  const TAU = Math.PI * 2;
  const OPACITY = Array.from({ length: 65 }, (_, i) => (i / 64).toFixed(3));

  const ease = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));
  const shape = (n: number, s: number, p: number) => Math.exp(-Math.pow(Math.abs(n / s), p));
  const taper = (n: number) => (n >= 1 || n <= -1 ? 0 : (1 - n * n) * (1 - n * n));
  const gauss = () => Math.sqrt(-2 * Math.log(1 - Math.random())) * Math.cos(TAU * Math.random());

  const sprite = (size: number, stops: [number, string][]) => {
    const c = document.createElement('canvas');
    c.width = c.height = size;
    const g = c.getContext('2d')!;
    const r = size / 2;
    const grad = g.createRadialGradient(r, r, 0, r, r, r);
    for (const [o, col] of stops) grad.addColorStop(o, col);
    g.fillStyle = grad;
    g.fillRect(0, 0, size, size);
    return c;
  };
  const GOLD = sprite(32, [
    [0, 'rgba(255,247,228,1)'],
    [0.16, 'rgba(255,228,176,0.8)'],
    [0.42, 'rgba(226,184,104,0.2)'],
    [1, 'rgba(194,155,76,0)'],
  ]);
  const LILAC = sprite(32, [
    [0, 'rgba(244,238,255,1)'],
    [0.16, 'rgba(206,190,255,0.75)'],
    [0.42, 'rgba(167,139,250,0.18)'],
    [1, 'rgba(167,139,250,0)'],
  ]);
  const GOLD_SOFT = sprite(64, [
    [0, 'rgba(255,232,186,0.5)'],
    [0.55, 'rgba(236,198,130,0.38)'],
    [0.8, 'rgba(210,170,100,0.12)'],
    [1, 'rgba(194,155,76,0)'],
  ]);
  const LILAC_SOFT = sprite(64, [
    [0, 'rgba(226,214,255,0.5)'],
    [0.55, 'rgba(190,168,252,0.36)'],
    [0.8, 'rgba(167,139,250,0.1)'],
    [1, 'rgba(167,139,250,0)'],
  ]);

  /*
   * The band: a galactic plane painted once by the GPU in the shaft's own
   * space (x along the beam, n across it). A warm core with filaments, a
   * patchy dust lane just off centre, and violet, rose and teal nebula in
   * the halo. Every term fades to zero at the edges, and the shaft's mask
   * fades the ends, so there is no seam anywhere.
   */
  const VERT = `
attribute vec2 a;
varying vec2 v_uv;
void main() {
  v_uv = a * 0.5 + 0.5;
  gl_Position = vec4(a, 0.0, 1.0);
}
`;

  const BAND = `
precision highp float;
uniform vec2 u_size;
varying vec2 v_uv;

float hash(vec2 p) {
  p = fract(p * vec2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

float noise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}

float fbm(vec2 p) {
  float s = 0.0;
  float a = 0.5;
  mat2 r = mat2(0.8, -0.6, 0.6, 0.8);
  for (int i = 0; i < 6; i++) {
    s += a * noise(p);
    p = r * p * 2.03 + 17.1;
    a *= 0.5;
  }
  return s;
}

void main() {
  float x = v_uv.x * u_size.x;
  float n = v_uv.y * 2.0 - 1.0;
  float edge = (1.0 - n * n) * (1.0 - n * n);

  // The plane wanders a little along its length.
  float m = n - (fbm(vec2(x / 1100.0, 3.1)) - 0.5) * 0.22;
  vec2 q = vec2(x / 560.0, m * 1.7);
  vec2 w = vec2(fbm(q * 1.3 + vec2(1.7, 9.2)), fbm(q * 1.3 + vec2(8.3, 2.8)));
  float cloud = fbm(q * 2.0 + 1.8 * w);
  float fil = fbm(vec2(x / 170.0, m * 6.0) + 2.4 * w);
  float c2 = cloud * cloud;

  float core = exp(-pow(abs(m) / 0.2, 2.2));
  float halo = exp(-pow(abs(m) / 0.48, 2.0));
  float wide = exp(-pow(abs(m) / 0.85, 2.0));

  float lc = 0.05 + (fbm(vec2(x / 760.0, 7.7)) - 0.5) * 0.24;
  float lw = 0.045 + 0.05 * fbm(vec2(x / 420.0, 1.3));
  float lane = exp(-pow((m - lc) / lw, 2.0)) * smoothstep(0.38, 0.62, fbm(vec2(x / 640.0, 4.4)));
  float dust = smoothstep(0.5, 0.78, fbm(q * 1.1 + 1.4 * w + 31.0));
  float clear = (1.0 - 0.8 * lane) * (1.0 - 0.5 * dust * halo);

  vec3 gold = vec3(0.76, 0.61, 0.3);
  vec3 cream = vec3(1.0, 0.92, 0.78);
  vec3 lilac = vec3(0.65, 0.55, 0.98);
  vec3 violet = vec3(0.49, 0.23, 0.93);
  vec3 rose = vec3(0.86, 0.42, 0.72);
  vec3 teal = vec3(0.32, 0.62, 0.78);

  vec3 hot = mix(gold, cream, smoothstep(0.35, 0.8, 2.0 * c2 * core));
  vec3 neb = mix(lilac, violet, smoothstep(0.35, 0.65, fbm(q * 0.7 + 50.0)));
  neb = mix(neb, rose, 0.4 * smoothstep(0.55, 0.78, fbm(q * 0.9 + 80.0)));
  neb = mix(neb, teal, 0.3 * smoothstep(0.6, 0.82, fbm(q * 0.8 + 120.0)));

  vec3 col = hot * core * (0.35 + 1.3 * c2) * 0.2
    + neb * halo * (0.2 + 1.2 * fil * cloud) * 0.055
    + violet * wide * (0.6 + 0.6 * cloud) * 0.025;
  col *= clear * edge;

  // Dither where there is light, so the faint tails do not band.
  float lum = max(col.r, max(col.g, col.b));
  col += (hash(gl_FragCoord.xy) + hash(gl_FragCoord.yx + 41.0) - 1.0) / 255.0 * smoothstep(0.0, 0.02, lum);
  col = max(col, 0.0);
  gl_FragColor = vec4(col, max(col.r, max(col.g, col.b)));
}
`;

  let gl: WebGLRenderingContext | null = null;
  let uSize: WebGLUniformLocation | null = null;
  let bandKey = '';
  let broken = false;

  const initBand = () => {
    gl = band.getContext('webgl', {
      alpha: true,
      premultipliedAlpha: true,
      preserveDrawingBuffer: true,
      antialias: false,
      depth: false,
      stencil: false,
      powerPreference: 'low-power',
      failIfMajorPerformanceCaveat: true,
    });
    // Without highp the noise lattice falls apart at the fine octaves; the CSS band looks better.
    if (!gl || !gl.getShaderPrecisionFormat(gl.FRAGMENT_SHADER, gl.HIGH_FLOAT)?.precision) return false;
    const p = gl.createProgram()!;
    for (const [type, src] of [
      [gl.VERTEX_SHADER, VERT],
      [gl.FRAGMENT_SHADER, BAND],
    ] as const) {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      gl.attachShader(p, sh);
    }
    gl.bindAttribLocation(p, 0, 'a');
    gl.linkProgram(p);
    if (!gl.getProgramParameter(p, gl.LINK_STATUS)) return false;
    gl.useProgram(p);
    uSize = gl.getUniformLocation(p, 'u_size');
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    return true;
  };

  const paintBand = () => {
    if (broken) return;
    const w = shaft.offsetWidth;
    const h = shaft.offsetHeight;
    const k = Math.min(devicePixelRatio || 1, 2400 / w);
    const key = `${Math.round(w * k)}x${Math.round(h * k)}`;
    if (key === bandKey) return;
    if (!gl && !initBand()) {
      broken = true;
      return;
    }
    band.width = Math.round(w * k);
    band.height = Math.round(h * k);
    gl!.viewport(0, 0, band.width, band.height);
    gl!.uniform2f(uSize, w, h);
    gl!.drawArrays(gl!.TRIANGLES, 0, 3);
    bandKey = key;
    shaft.classList.add('gl');
  };

  band.addEventListener('webglcontextlost', (e) => {
    e.preventDefault();
    shaft.classList.remove('gl');
    gl = null;
    bandKey = '';
  });
  band.addEventListener('webglcontextrestored', paintBand);

  /*
   * Stars: fixed points in the band, dense along the plane and thin at its
   * edges, so they ride the shaft and fade with it. A few bright ones carry
   * soft diffraction spikes.
   */
  type Star = { a: number; n: number; r: number; al: number; c: number; spike: boolean; tw: number; f: number; ph: number; sx: number; sy: number };

  const seeded = (seed: number) => () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let q = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    q = (q + Math.imul(q ^ (q >>> 7), 61 | q)) ^ q;
    return ((q ^ (q >>> 14)) >>> 0) / 4294967296;
  };

  const point = (rgb: string) =>
    sprite(16, [
      [0, `rgba(${rgb},1)`],
      [0.18, `rgba(${rgb},0.7)`],
      [0.45, `rgba(${rgb},0.12)`],
      [1, `rgba(${rgb},0)`],
    ]);
  const STAR_RGB = ['244,240,255', '204,216,255', '255,228,176', '255,196,214'];
  const POINTS = STAR_RGB.map(point);

  const spikes = (rgb: string) => {
    const c = point(rgb);
    const big = document.createElement('canvas');
    big.width = big.height = 48;
    const g = big.getContext('2d')!;
    for (const vertical of [false, true]) {
      const grad = vertical ? g.createLinearGradient(0, 0, 0, 48) : g.createLinearGradient(0, 0, 48, 0);
      grad.addColorStop(0, `rgba(${rgb},0)`);
      grad.addColorStop(0.5, `rgba(${rgb},0.55)`);
      grad.addColorStop(1, `rgba(${rgb},0)`);
      g.fillStyle = grad;
      if (vertical) g.fillRect(23.5, 0, 1, 48);
      else g.fillRect(0, 23.5, 48, 1);
    }
    g.drawImage(c, 14, 14, 20, 20);
    return big;
  };
  const SPIKES = [spikes(STAR_RGB[0]), spikes(STAR_RGB[1])];

  const stars: Star[] = (() => {
    const rnd = seeded(0x5ee1);
    const out: Star[] = [];
    while (out.length < 640) {
      const g = Math.sqrt(-2 * Math.log(1 - rnd())) * Math.cos(TAU * rnd());
      const n = g * (rnd() < 0.6 ? 0.16 : 0.36);
      if (Math.abs(n) > 0.95) continue;
      const m = rnd() ** 3;
      const pick = rnd();
      const c = pick < 0.55 ? 0 : pick < 0.75 ? 1 : pick < 0.93 ? 2 : 3;
      out.push({
        a: rnd() * cfg.len,
        n,
        r: 1.2 + 2.6 * m,
        al: 0.16 + 0.7 * m,
        c,
        spike: m > 0.72 && c < 2,
        tw: rnd() < 0.4 ? 0.2 + 0.35 * rnd() : 0,
        f: 0.5 + 1.6 * rnd(),
        ph: rnd() * TAU,
        sx: 0,
        sy: 0,
      });
    }
    return out;
  })();

  const alongFade = (along: number) => (along < f1 ? ease(along / f1) : along > f2 ? ease((flen - along) / (flen - f2)) : 1);

  let W = 0;
  let H = 0;
  let ax = 0;
  let ay = 0;
  let half = 1;
  let maxShift = 0;
  let shift = 0;
  let raf = 0;
  let last = 0;
  let t = 0;
  let coreLvl = -1;
  let haloLvl = -1;
  const motes: Mote[] = [];

  const light = (m: Mote) => {
    const dx = m.x - ax;
    const dy = m.y - ay;
    const along = dx * cos - dy * sin + cfg.len / 2;
    const n = (dx * sin + dy * cos) / half;
    const f = (along < f1 ? ease(along / f1) : along > f2 ? ease((flen - along) / (flen - f2)) : 1) * taper(n);
    m.lc = shape(n, cfg.core.s, cfg.core.p) * f;
    m.lh = 0.3 * shape(n, cfg.halo.s, cfg.halo.p) * f;
  };

  const spawn = (m: Mote, age: number) => {
    for (let i = 0; i < 12; i++) {
      const x = Math.random() * W;
      const v = gauss() * half * 0.3;
      m.x = x + v * sin;
      m.y = ay - (x - ax) * tan + v * cos;
      const sy = m.y + shift;
      if (sy > -20 && sy < H + 20) break;
    }
    m.z = Math.pow(Math.random(), 1.7);
    m.soft = m.z > 0.9;
    m.d = m.soft ? 16 + 150 * (m.z - 0.9) : 3 + 8 * m.z;
    m.a = m.soft ? 0.3 : 0.3 + 0.7 * m.z;
    m.flake = Math.random() < 0.5 ? 0.6 + 0.4 * Math.random() : 0.25 * Math.random();
    m.p1 = Math.random() * TAU;
    m.p2 = Math.random() * TAU;
    m.spin = Math.random() * TAU;
    m.w = 0.4 + Math.random() * 1.2;
    m.age = age;
    light(m);
    return m;
  };

  const blank = (): Mote => ({ x: 0, y: 0, z: 0, d: 0, a: 0, soft: false, flake: 0, p1: 0, p2: 0, spin: 0, w: 0, age: 0, lc: 0, lh: 0 });

  const measure = () => {
    W = canvas.clientWidth;
    H = canvas.clientHeight;
    const dpr = Math.min(devicePixelRatio || 1, 1.5);
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.globalCompositeOperation = 'lighter';
    const r = shaft.getBoundingClientRect();
    ax = r.left + r.width / 2;
    ay = r.top + r.height / 2 - shift;
    half = shaft.offsetHeight / 2;
    maxShift = still.matches ? 0 : H * 0.35;
    for (const st of stars) {
      const u = st.a - cfg.len / 2;
      const v = st.n * half;
      st.sx = u * cos + v * sin;
      st.sy = -u * sin + v * cos;
    }
    paintBand();
    const want = Math.max(60, Math.min(150, Math.round(W / 9)));
    while (motes.length < want) motes.push(spawn(blank(), -2 * Math.random()));
    motes.length = want;
  };

  const update = (dt: number) => {
    const lo = -shift - 80;
    const hi = H - shift + 80;
    for (let i = 0; i < motes.length; i++) {
      const m = motes[i];
      const sp = 0.35 + m.z;
      m.x += (-1.6 + 5 * Math.sin(t * 0.21 + m.p1 + m.y * 0.006)) * sp * dt;
      m.y += (1.1 + 4 * Math.sin(t * 0.17 + m.p2 + m.x * 0.005)) * sp * dt;
      m.spin += m.w * dt;
      m.age += dt;
      light(m);
      if (m.lc + m.lh < 0.006 || m.y < lo || m.y > hi || m.x < -80 || m.x > W + 80) spawn(m, 0);
    }
  };

  const draw = (b: number, settled: boolean) => {
    ctx.clearRect(0, 0, W, H);
    for (let i = 0; i < stars.length; i++) {
      const st = stars[i];
      const x = ax + st.sx;
      const y = ay + st.sy + shift;
      if (x < -30 || x > W + 30 || y < -30 || y > H + 30) continue;
      const tw = settled || !st.tw ? 1 : 1 - st.tw * (0.5 - 0.5 * Math.sin(t * st.f + st.ph));
      const a = st.al * tw * alongFade(st.a) * (1 - st.n * st.n) * b;
      if (a < 0.01) continue;
      ctx.globalAlpha = a > 1 ? 1 : a;
      if (st.spike) {
        const d = 12 + 14 * st.al;
        ctx.drawImage(SPIKES[st.c], x - d / 2, y - d / 2, d, d);
      } else {
        ctx.drawImage(POINTS[st.c], x - st.r / 2, y - st.r / 2, st.r, st.r);
      }
    }
    for (let i = 0; i < motes.length; i++) {
      const m = motes[i];
      const life = settled ? 1 : ease(m.age / 3);
      if (life === 0) continue;
      const sy = m.y + shift * (0.85 + 0.3 * m.z);
      if (sy < -40 || sy > H + 40) continue;
      const g = Math.abs(Math.cos(m.spin));
      const glint = g * g * g * g * g * g * g * g;
      const tw = (1 - m.flake) * (0.75 + 0.25 * g) + m.flake * (0.3 + 1.1 * glint);
      const a = m.a * tw * life * b;
      const d = m.d * (1 + 0.25 * m.flake * glint);
      const x = m.x - d / 2;
      const y = sy - d / 2;
      const ga = a * m.lc;
      const va = a * m.lh;
      if (ga > 0.003) {
        ctx.globalAlpha = ga > 1 ? 1 : ga;
        ctx.drawImage(m.soft ? GOLD_SOFT : GOLD, x, y, d, d);
      }
      if (va > 0.003) {
        ctx.globalAlpha = va > 1 ? 1 : va;
        ctx.drawImage(m.soft ? LILAC_SOFT : LILAC, x, y, d, d);
      }
    }
  };

  const tick = (now: number) => {
    raf = requestAnimationFrame(tick);
    const ms = now - last;
    if (ms < 31) return;
    last = now;
    const dt = Math.min(ms / 1000, 0.1);
    t += dt;
    const s = -Math.round(Math.min(scrollY * 0.35, maxShift));
    if (s !== shift) {
      shift = s;
      rig.style.transform = `translate3d(0,${s}px,0)`;
    }
    const b = 0.9 + 0.055 * Math.sin(t * 0.42) + 0.045 * Math.sin(t * 0.173 + 1.1);
    const qc = Math.round(b * 64);
    if (qc !== coreLvl) coreEl.style.opacity = band.style.opacity = glowEl.style.opacity = OPACITY[(coreLvl = qc)];
    const qh = Math.round((0.95 + 0.05 * Math.sin(t * 0.29 + 2)) * 64);
    if (qh !== haloLvl) haloEl.style.opacity = OPACITY[(haloLvl = qh)];
    update(dt);
    draw(b, false);
  };

  const stop = () => {
    cancelAnimationFrame(raf);
    raf = 0;
  };

  const start = () => {
    stop();
    if (html.dataset.amb !== 'beam' || document.hidden) return;
    if (still.matches) {
      shift = 0;
      rig.style.transform = '';
      coreEl.style.opacity = haloEl.style.opacity = band.style.opacity = glowEl.style.opacity = '';
      coreLvl = haloLvl = -1;
      measure();
      for (let i = 0; i < motes.length; i++) spawn(motes[i], 3);
      draw(1, true);
      return;
    }
    measure();
    last = performance.now();
    raf = requestAnimationFrame(tick);
  };

  let resizeTimer = 0;
  addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(start, 150);
  });
  document.addEventListener('amb:change', (e) => ((e as CustomEvent<string>).detail === 'beam' ? start() : stop()));
  document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  still.addEventListener('change', start);
  start();
</script>

---
/*
 * /download : the install guide. The per-OS panel is shared with the
 * homepage; this page adds first-run notes and verification. Release data
 * is build-time (data/content.ts), memoized so every page shares one fetch.
 */
import Site from '../layouts/Site.astro';
import DownloadPanel from '../components/DownloadPanel.astro';
import { brand, getDownloadUrls } from '../data/content';

const dl = await getDownloadUrls();
const appImage = dl.linuxAppImage;
const deb = dl.linuxDeb;
const rpm = dl.linuxRpm;

const APT = [
  'sudo install -d -m 0755 /etc/apt/keyrings',
  'curl -fsSL https://apt.grimoiremods.com/grimoire.gpg | sudo tee /etc/apt/keyrings/grimoire.gpg >/dev/null',
  'echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/grimoire.gpg] https://apt.grimoiremods.com stable main" | sudo tee /etc/apt/sources.list.d/grimoire.list >/dev/null',
  'sudo apt update && sudo apt install grimoire',
];

const DNF = [
  'sudo curl -fsSL -o /etc/yum.repos.d/grimoire.repo https://rpm.grimoiremods.com/grimoire.repo',
  'sudo dnf install grimoire',
];

const steps = [
  {
    id: 'windows',
    title: 'Windows',
    body: [
      'Run the installer. Grimoire is not code-signed yet, so SmartScreen may say "Windows protected your PC". Click More info, then Run anyway.',
      'The portable .exe is the same app without an install step.',
    ],
  },
  {
    id: 'apt',
    title: 'Debian and Ubuntu',
    body: [
      'Add the apt repo once and Grimoire updates with the rest of your system on apt upgrade. The in-app updater stays off, since apt owns updates.',
    ],
    cmds: [APT.join('\n')],
    after: deb ? `Or install the .deb directly with sudo apt install ./${deb.name}, without the repo.` : undefined,
  },
  {
    id: 'dnf',
    title: 'Fedora',
    body: [
      'Add the dnf repo once and Grimoire updates with the rest of your system, from dnf upgrade or the software center. dnf asks you to accept the signing key on the first install. The in-app updater stays off, since dnf owns updates.',
      'On Bazzite, Silverblue and other atomic Fedoras, use the AppImage instead. It updates itself.',
    ],
    cmds: [DNF.join('\n')],
    after: rpm ? `Or install the .rpm directly with sudo dnf install ./${rpm.name}, without the repo.` : undefined,
  },
  {
    id: 'appimage',
    title: 'AppImage',
    body: ['Works on most distros. Make it executable, then run it.'],
    cmds: appImage ? [`chmod +x ${appImage.name}\n./${appImage.name}`] : undefined,
  },
  {
    id: 'arch',
    title: 'Arch Linux',
    body: ['grimoire-bin on the AUR is the prebuilt release, repackaged.'],
    cmds: ['yay -S grimoire-bin'],
  },
];

const verify = [
  { label: 'Linux and macOS', cmd: 'sha256sum -c SHA256SUMS' },
  { label: 'PowerShell', cmd: 'Get-FileHash <file>' },
  { label: 'Build provenance (gh CLI)', cmd: 'gh attestation verify <file> --owner Slush97' },
];
---

<Site
  title="Download Grimoire: Deadlock Mod Manager (Windows, Linux, macOS)"
  description="Download Grimoire, the free open-source Deadlock mod manager, for Windows, Linux, and macOS. Free and MIT licensed."
>
  <header class="wrap page-head">
    <p class="kicker">Download</p>
    <h1>Get Grimoire</h1>
    <p>
      {dl.version && <>Version {dl.version}{dl.releaseDate && `, released ${dl.releaseDate}`}. </>}
      Free and MIT licensed. You need Deadlock installed through Steam.
    </p>
  </header>

  <div class="sheet">
    <div class="wrap">
      <DownloadPanel />
      <p class="links">
        <a href={dl.releaseUrl}>Release notes</a>
        <a href={`${brand.github}/releases`}>All releases</a>
      </p>
    </div>

    <section class="wrap steps" aria-labelledby="steps-h">
      <h2 id="steps-h">Installing</h2>
      {steps.map((s) => (
        <div class="step" id={s.id}>
          <h3>{s.title}</h3>
          <div>
            {s.body.map((p) => <p>{p}</p>)}
            {s.cmds?.map((c) => (
              <div class="cmd">
                <pre><code>{c.split('\n').map((l) => <span>{l}</span>)}</code></pre>
                <button class="copy" type="button" data-copy={c} hidden>Copy</button>
              </div>
            ))}
            {s.after && <p class="after">{s.after}</p>}
          </div>
        </div>
      ))}
    </section>

    <section class="wrap steps" aria-labelledby="verify-h">
      <h2 id="verify-h">Verify your download</h2>
      <div class="step">
        <h3>Checksums and provenance</h3>
        <div>
          <p>
            Every release ships a SHA256SUMS file and a GitHub build provenance attestation.
            Either one proves the file came from Grimoire's own GitHub Actions build and not
            from someone re-hosting it.
          </p>
          {verify.map((v) => (
            <>
              <p class="cap">{v.label}</p>
              <div class="cmd">
                <pre><code><span>{v.cmd}</span></code></pre>
                <button class="copy" type="button" data-copy={v.cmd} hidden>Copy</button>
              </div>
            </>
          ))}
          {dl.sha256Sums && (
            <p class="after"><a href={dl.sha256Sums.browser_download_url}>Download SHA256SUMS</a></p>
          )}
        </div>
      </div>
    </section>
  </div>
</Site>

<style>
  .sheet {
    padding: 24px 0 96px;
  }
  .links {
    display: flex;
    justify-content: center;
    gap: 28px;
    margin: 24px 0 0;
    font-size: 14px;
  }
  .links a {
    color: var(--muted);
  }
  .links a:hover {
    color: var(--text);
  }
  .steps {
    margin-top: 96px;
  }
  .steps h2 {
    margin-bottom: 8px;
    font-size: 28px;
  }
  .step {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 88px;
  }
  .step h3 {
    font-size: 18px;
  }
  .step p {
    max-width: 68ch;
    margin: 0 0 12px;
    color: var(--body);
    font-size: 16px;
  }
  .step .after {
    margin-top: 12px;
    color: var(--muted);
    font-size: 15px;
  }
  .cap {
    margin: 18px 0 8px !important;
    color: var(--dim) !important;
    font-size: 12px !important;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cmd {
    position: relative;
  }
  .cmd pre {
    margin: 0;
    padding: 12px 84px 12px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    font-size: 13px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .cmd pre span {
    display: block;
    padding-left: 2ch;
    text-indent: -2ch;
  }
  .copy {
    position: absolute;
    top: 8px;
    right: 8px;
    height: 26px;
    padding: 0 10px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font: 500 12px/1 'Inter', system-ui, sans-serif;
    cursor: pointer;
  }
  .copy:hover {
    color: var(--text);
    background: var(--surface-hi);
  }
  .copy[hidden] {
    display: none;
  }
  @media (max-width: 719px) {
    .steps {
      margin-top: 64px;
    }
    .step {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cmd .copy').forEach((b) => {
    b.hidden = false;
    b.addEventListener('click', () => {
      navigator.clipboard.writeText(b.dataset.copy ?? '').then(() => {
        b.textContent = 'Copied';
        setTimeout(() => (b.textContent = 'Copy'), 1600);
      });
    });
  });
</script>

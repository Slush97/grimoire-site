-1.746.712-2.457 1.57-.618.737-1.37 1.14-2.036 1.191-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69.176-.668.428-1.344.463-1.897.037-.714.076-1.335.195-1.814.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01c.053 0 .105.005.157.014.376.055.706.333 1.023.752l.91 1.664.003.003c.243.533.754 1.064 1.189 1.637.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294-.645.135-1.52.002-2.395-.464-.968-.536-2.118-.469-2.857-.602-.369-.066-.61-.2-.723-.4-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118-.055-.401-.083-.71.043-.94.16-.334.396-.4.69-.533.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838.19-.201.38-.336.663-.336zm7.159-9.074c-.435.201-.945.535-1.488.535-.542 0-.97-.267-1.28-.466-.154-.134-.28-.268-.373-.335-.164-.134-.144-.333-.074-.333.109.016.129.134.199.2.096.066.215.2.36.333.292.2.68.467 1.167.467.485 0 1.053-.267 1.398-.466.195-.135.445-.334.648-.467.156-.136.149-.267.279-.267.128.016.034.134-.147.332a8.097 8.097 0 01-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05.074-.043.18-.027.26.004.063 0 .16.067.15.135-.006.049-.085.066-.135.066-.055 0-.092-.043-.141-.068-.052-.018-.146-.008-.163-.065zm-.551 0c-.02.058-.113.049-.166.066-.047.025-.086.068-.14.068-.05 0-.13-.02-.136-.068-.01-.066.088-.133.15-.133.08-.031.184-.047.259-.005.019.009.036.03.03.05v.02h.003z';
const ICON_ARCH =
  'M11.39.605C10.376 3.092 9.764 4.72 8.635 7.132c.693.734 1.543 1.589 2.923 2.554-1.484-.61-2.496-1.224-3.252-1.86C6.86 10.842 4.596 15.138 0 23.395c3.612-2.085 6.412-3.37 9.021-3.862a6.61 6.61 0 01-.171-1.547l.003-.115c.058-2.315 1.261-4.095 2.687-3.973 1.426.12 2.534 2.096 2.478 4.409a6.52 6.52 0 01-.146 1.243c2.58.505 5.352 1.787 8.914 3.844-.702-1.293-1.33-2.459-1.929-3.57-.943-.73-1.926-1.682-3.933-2.713 1.38.359 2.367.772 3.137 1.234-6.09-11.334-6.582-12.84-8.67-17.74z';
---

<Geo
  title="Download Grimoire"
  description="Download Grimoire, the open-source Deadlock mod manager, for Windows, Linux, and Arch. MIT, free, no telemetry."
  marquee="✦ DOWNLOAD GRIMOIRE!!1! ✦ FREE!! ✦ NO TELEMETRY!! ✦ NO ADWARE!! ✦ WINDOWS · LINUX · ARCH ✦ "
>
  <header class="geo-hero">
    <h1 class="geo-wordart">GET GRIMOIRE!!!</h1>
    <span class="geo-subtitle">✦ free · MIT · no telemetry · no adware ✦</span>
  </header>

  <p class="dl-intro">
    Only does anything useful if you have <strong>DEADLOCK</strong> installed via Steam!!
    <span class="blink">★</span>
  </p>

  <div class="geo-glyph-rule" aria-hidden="true">✶ ⚝ ☥ ⚝ ✶</div>

  <!-- WINDOWS-FIRST PRIMARY -->
  <section class="dl-section">
    <h2 class="geo-ribbon"><span class="blink">★</span> CLICK HERE 4 <em>WINDOWS!!</em> <span class="blink">★</span></h2>

    {winInstaller ? (
      <div class="geo-card">
        <div class="geo-card-h">💾 the big one · windows installer</div>
        <div class="geo-card-body dl-primary">
          <a class="geo-btn geo-btn--gold geo-btn--lg geo-btn--block" href={winInstaller.browser_download_url}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON_WINDOWS} /></svg>
            <span>DOWNLOAD FOR WINDOWS</span>
            <span class="geo-btn-meta">{fmtBytes(winInstaller.size)}</span>
          </a>
          <dl class="dl-meta">
            <dt>FILE</dt><dd><code class="geo-code">{winInstaller.name}</code></dd>
            <dt>SIZE</dt><dd>{fmtBytes(winInstaller.size)}</dd>
            {version && (<><dt>VER</dt><dd>v{version}{releaseDate ? ` ★ ${releaseDate}` : ''}</dd></>)}
          </dl>
          <div class="dl-links">
            <a href={releaseUrl} target="_blank" rel="noopener">READ DA RELEASE NOTES »</a>
            <a href="#other">OTHER PLATFORMS ↓</a>
          </div>
        </div>
      </div>
    ) : (
      <div class="geo-card">
        <div class="geo-card-h">⚠ couldn't reach github</div>
        <div class="geo-card-body">
          <p>Couldn't reach the GitHub release feed when this page was built!!</p>
          <a class="geo-btn geo-btn--green geo-btn--center" href={releaseUrl} target="_blank" rel="noopener">
            <span class="geo-btn-arrow">▶</span><span>SEE RELEASES ON GITHUB</span>
          </a>
        </div>
      </div>
    )}

    <div class="geo-notice">
      <span class="geo-notice-bang" aria-hidden="true">⚠</span>
      <span>
        Grimoire isn't code-signed yet, so Windows SmartScreen may holler
        <strong>Unknown Publisher</strong>!! Just click <strong>More info » Run anyway</strong>. It's fine, promise!!
      </span>
    </div>
  </section>

  <div class="geo-sep geo-sep--flame" aria-hidden="true"></div>

  <!-- OTHER PLATFORMS -->
  <section id="other" class="dl-section">
    <h2 class="geo-ribbon"><span class="blink">★</span> 4 DA <em>UNWINDOWED</em> <span class="blink">★</span></h2>

    <!-- Windows portable -->
    <div class="geo-card">
      <div class="geo-card-h">
        <svg class="dl-h-ico" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON_WINDOWS} /></svg>
        windows portable .exe
      </div>
      <div class="geo-card-body">
        <p>Single executable, NO INSTALL!! Same app as the installer, just rawer!!</p>
        {winPortable && <p><code class="geo-code">{winPortable.name}</code></p>}
        <a class="geo-btn geo-btn--blue geo-btn--center" href={winPortable?.browser_download_url ?? releaseUrl}>
          <span class="geo-btn-arrow">▶</span><span>{winPortable ? `PORTABLE · ${fmtBytes(winPortable.size)}` : 'DOWNLOAD'}</span>
        </a>
      </div>
    </div>

    <!-- Linux -->
    <div class="geo-card">
      <div class="geo-card-h">
        <svg class="dl-h-ico" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON_LINUX} /></svg>
        4 linux
      </div>
      <div class="geo-card-body">
        <div class="dl-twocol">
          <div>
            <p><strong>AppImage</strong> · universal, works on most distros.</p>
            <a class="geo-btn geo-btn--green geo-btn--center" href={appImage?.browser_download_url ?? releaseUrl}>
              <span class="geo-btn-arrow">▶</span><span>{appImage ? `APPIMAGE · ${fmtBytes(appImage.size)}` : 'DOWNLOAD'}</span>
            </a>
            {appImage && (
              <div class="dl-cmd-wrap">
                <span class="geo-cmd-label">then run</span>
                <div class="geo-cmd" data-copy={`chmod +x ${appImage.name} && ./${appImage.name}`}>
                  <span class="dl-cmd-txt"><span class="geo-cmd-dim">$ </span>chmod +x {appImage.name}</span>
                  <button type="button" class="geo-copy-btn" aria-label="Copy command">COPY</button>
                </div>
              </div>
            )}
          </div>
          <div>
            <p><strong>Debian / Ubuntu</strong> · .deb, installs via apt.</p>
            <a class="geo-btn geo-btn--green geo-btn--center" href={deb?.browser_download_url ?? releaseUrl}>
              <span class="geo-btn-arrow">▶</span><span>{deb ? `.DEB · ${fmtBytes(deb.size)}` : 'DOWNLOAD'}</span>
            </a>
            {deb && (
              <div class="dl-cmd-wrap">
                <span class="geo-cmd-label">then install</span>
                <div class="geo-cmd" data-copy={`sudo apt install ./${deb.name}`}>
                  <span class="dl-cmd-txt"><span class="geo-cmd-dim">$ </span>sudo apt install ./{deb.name}</span>
                  <button type="button" class="geo-copy-btn" aria-label="Copy command">COPY</button>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Arch -->
    <div class="geo-card">
      <div class="geo-card-h">
        <svg class="dl-h-ico" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON_ARCH} /></svg>
        4 arch (btw)
      </div>
      <div class="geo-card-body">
        <p><strong>grimoire-bin</strong> · pre-built binary package on the AUR.</p>
        <div class="dl-cmd-wrap">
          <span class="geo-cmd-label">install with yay</span>
          <div class="geo-cmd" data-copy="yay -S grimoire-bin">
            <span class="dl-cmd-txt"><span class="geo-cmd-dim">$ </span>yay -S grimoire-bin</span>
            <button type="button" class="geo-copy-btn" aria-label="Copy command">COPY</button>
          </div>
        </div>
        <a class="dl-aur-link" href={brand.aur} target="_blank" rel="noopener">VIEW ON AUR »</a>
      </div>
    </div>

    <p class="dl-allreleases">
      <a href={allReleasesUrl} target="_blank" rel="noopener">»» ALL RELEASES ON GITHUB ««</a>
    </p>
  </section>

  <div class="geo-sep geo-sep--lightning" aria-hidden="true"></div>

  <!-- VERIFY -->
  <section class="dl-section">
    <h2 class="geo-ribbon"><span class="blink">★</span> VERIFY UR <em>LOOT!!</em> <span class="blink">★</span></h2>
    <div class="geo-card">
      <div class="geo-card-h">⚖ provenance · trust but verify</div>
      <div class="geo-card-body">
        <p>
          Every release ships a <code class="geo-code">SHA256SUMS</code> file and a GitHub build
          provenance attestation. Either one proves a binary came from the real GitHub Actions
          build, not some rando re-hosting it!!
        </p>
        <div class="dl-twocol">
          <div>
            <span class="geo-cmd-label">checksum · linux / macos</span>
            <div class="geo-cmd" data-copy="sha256sum -c SHA256SUMS">
              <span class="dl-cmd-txt"><span class="geo-cmd-dim">$ </span>sha256sum -c SHA256SUMS</span>
              <button type="button" class="geo-copy-btn" aria-label="Copy command">COPY</button>
            </div>
            <span class="geo-cmd-label" style="margin-top:10px">checksum · powershell</span>
            <div class="geo-cmd" data-copy="Get-FileHash <file>">
              <span class="dl-cmd-txt"><span class="geo-cmd-dim">PS&gt; </span>Get-FileHash &lt;file&gt;</span>
              <button type="button" class="geo-copy-btn" aria-label="Copy command">COPY</button>
            </div>
          </div>
          <div>
            <span class="geo-cmd-label">build provenance · gh cli</span>
            <div class="geo-cmd" data-copy="gh attestation verify <file> --owner Slush97">
              <span class="dl-cmd-txt"><span class="geo-cmd-dim">$ </span>gh attestation verify &lt;file&gt; --owner Slush97</span>
              <button type="button" class="geo-copy-btn" aria-label="Copy command">COPY</button>
            </div>
            <p class="dl-verify-note">Confirms the binary was built by Grimoire's GitHub Actions workflow.</p>
          </div>
        </div>
        {sums && (
          <a class="dl-aur-link" href={sums.browser_download_url}>DOWNLOAD SHA256SUMS ↓</a>
        )}
      </div>
    </div>
  </section>

  <div class="geo-glyph-rule" aria-hidden="true">☉ ⚝ ⚜ ⚝ ☉</div>
</Geo>

<style>
  .dl-intro {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-size: 16px;
    color: #fff5db;
    text-shadow: 1px 1px 0 #000;
  }
  .dl-intro strong { color: #ffd96a; }
  .dl-section { max-width: 760px; margin: 0 auto; }
  .dl-primary .geo-btn svg { justify-self: start; }
  .dl-meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 4px 14px;
    margin: 14px 0 0;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-size: 13px;
  }
  .dl-meta dt {
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #b660e0;
    align-self: center;
  }
  .dl-meta dd { margin: 0; color: #fff5db; align-self: center; }
  .dl-meta code { word-break: break-all; }
  .dl-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 14px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-weight: 700;
    font-size: 13px;
  }
  .dl-h-ico { vertical-align: -1px; margin-right: 4px; }
  .dl-twocol {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: start;
  }
  /* min-width:0 lets the columns shrink below their nowrap command text so
     the ellipsis can engage instead of forcing the grid past the viewport. */
  .dl-twocol > div { min-width: 0; }
  .dl-twocol .geo-btn { width: 100%; margin-top: 6px; }
  .dl-cmd-wrap { margin-top: 10px; }
  .dl-cmd-txt {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dl-aur-link {
    display: inline-block;
    margin-top: 12px;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-weight: 700;
    font-size: 13px;
  }
  .dl-verify-note {
    margin: 8px 0 0;
    font-size: 12px;
    color: #c8b8e8;
    line-height: 1.5;
  }
  .dl-allreleases {
    margin: 16px 0 0;
    text-align: center;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-weight: 700;
  }
  @media (max-width: 640px) {
    .dl-twocol { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Copy-to-clipboard for the .geo-cmd command tiles.
  for (const host of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    const btn = host.querySelector<HTMLButtonElement>('.geo-copy-btn');
    if (!btn) continue;
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(host.dataset.copy ?? '');
        const prev = btn.textContent;
        btn.textContent = 'COPIED!!';
        btn.classList.add('is-copied');
        setTimeout(() => {
          btn.textContent = prev;
          btn.classList.remove('is-copied');
        }, 1400);
      } catch {
        // Clipboard API unavailable (insecure context, etc.); fail silently.
      }
    });
  }
</script>

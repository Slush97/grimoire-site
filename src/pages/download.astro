-1.746.712-2.457 1.57-.618.737-1.37 1.14-2.036 1.191-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69.176-.668.428-1.344.463-1.897.037-.714.076-1.335.195-1.814.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01c.053 0 .105.005.157.014.376.055.706.333 1.023.752l.91 1.664.003.003c.243.533.754 1.064 1.189 1.637.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294-.645.135-1.52.002-2.395-.464-.968-.536-2.118-.469-2.857-.602-.369-.066-.61-.2-.723-.4-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118-.055-.401-.083-.71.043-.94.16-.334.396-.4.69-.533.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838.19-.201.38-.336.663-.336zm7.159-9.074c-.435.201-.945.535-1.488.535-.542 0-.97-.267-1.28-.466-.154-.134-.28-.268-.373-.335-.164-.134-.144-.333-.074-.333.109.016.129.134.199.2.096.066.215.2.36.333.292.2.68.467 1.167.467.485 0 1.053-.267 1.398-.466.195-.135.445-.334.648-.467.156-.136.149-.267.279-.267.128.016.034.134-.147.332a8.097 8.097 0 01-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05.074-.043.18-.027.26.004.063 0 .16.067.15.135-.006.049-.085.066-.135.066-.055 0-.092-.043-.141-.068-.052-.018-.146-.008-.163-.065zm-.551 0c-.02.058-.113.049-.166.066-.047.025-.086.068-.14.068-.05 0-.13-.02-.136-.068-.01-.066.088-.133.15-.133.08-.031.184-.047.259-.005.019.009.036.03.03.05v.02h.003z';
const ICON_ARCH =
  'M11.39.605C10.376 3.092 9.764 4.72 8.635 7.132c.693.734 1.543 1.589 2.923 2.554-1.484-.61-2.496-1.224-3.252-1.86C6.86 10.842 4.596 15.138 0 23.395c3.612-2.085 6.412-3.37 9.021-3.862a6.61 6.61 0 01-.171-1.547l.003-.115c.058-2.315 1.261-4.095 2.687-3.973 1.426.12 2.534 2.096 2.478 4.409a6.52 6.52 0 01-.146 1.243c2.58.505 5.352 1.787 8.914 3.844-.702-1.293-1.33-2.459-1.929-3.57-.943-.73-1.926-1.682-3.933-2.713 1.38.359 2.367.772 3.137 1.234-6.09-11.334-6.582-12.84-8.67-17.74z';
---

<Base
  title="Download Grimoire"
  description="Download Grimoire, the open-source Deadlock mod manager, for Windows, Linux, and Arch."
>
  <main class="relative z-10">
    <!-- HERO: Windows-first big button -->
    <section class="relative overflow-hidden">
      <div class="relative mx-auto max-w-4xl px-6 pt-20 pb-12 text-center sm:pt-28">
        <div class="flex justify-center">
          <span class="kicker kicker--centered">Download</span>
        </div>
        <h1 class="font-display mt-5 text-5xl text-white sm:text-7xl">
          Get <em>Grimoire</em>.
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted">
          MIT-licensed, free, no telemetry, no analytics. Only does anything useful if
          you have Deadlock installed via Steam.
        </p>

      {winInstaller ? (
        <div class="mx-auto mt-12">
          <div class="relative">
            {version && (
              <span
                class="pointer-events-none absolute -top-5 right-2 z-10 hidden sm:inline-block"
                aria-hidden="true"
              >
                <span class="stamp stamp--sm">Conjured · v{version} · mmxxvi</span>
              </span>
            )}
            <a
              href={winInstaller.browser_download_url}
              class="btn-win95 btn-win95--lg btn-win95--accent w-full"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={ICON_WINDOWS} />
              </svg>
              <span>Download for Windows</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" />
              </svg>
            </a>
          </div>

          <div class="codex-entry mt-6 text-left">
            <div class="relative">
              <dl class="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-1.5 text-sm">
                <dt class="font-sc text-[11px] uppercase tracking-[0.22em] text-paper opacity-70">File</dt>
                <dd class="font-mono text-xs text-fg break-all">{winInstaller.name}</dd>

                <dt class="font-sc text-[11px] uppercase tracking-[0.22em] text-paper opacity-70">Size</dt>
                <dd class="text-fg">{fmtBytes(winInstaller.size)}</dd>

                {release && (
                  <>
                    <dt class="font-sc text-[11px] uppercase tracking-[0.22em] text-paper opacity-70">Version</dt>
                    <dd class="text-fg">v{version} <span class="text-muted">· {releaseDate}</span></dd>
                  </>
                )}
              </dl>
              <div class="mt-5 flex flex-col items-center gap-3 border-t border-paper/15 pt-4 text-sm sm:flex-row sm:justify-between sm:gap-6">
                {release && (
                  <a
                    href={releaseUrl}
                    target="_blank"
                    rel="noopener"
                    class="codex-action codex-action--link"
                  >Read the release notes →</a>
                )}
                <a href="#other-platforms" class="codex-action codex-action--link">
                  Other platforms ↓
                </a>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="mx-auto mt-12">
          <div class="codex-entry text-center">
            <div class="relative">
              <p class="text-sm text-muted">Couldn't reach the GitHub release feed at build time.</p>
              <a href={releaseUrl} target="_blank" rel="noopener" class="codex-action mt-4 inline-flex">
                See releases on GitHub →
              </a>
            </div>
          </div>
        </div>
      )}
      </div>
    </section>

    <!-- SmartScreen note (only relevant on Windows; show always since most users are on Windows) -->
    {winInstaller && (
      <section class="relative mx-auto max-w-4xl px-6 pb-12">
        <div class="codex-notice">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 8v4M12 16h.01" />
          </svg>
          <span>
            Grimoire isn't code-signed yet, so Windows SmartScreen may flag the installer as
            <strong>Unknown Publisher</strong>. Click <strong>More info → Run anyway</strong>.
          </span>
        </div>
      </section>
    )}

    <!-- OTHER PLATFORMS -->
    <section id="other-platforms" class="relative mx-auto max-w-4xl px-6 pb-12">
      <div class="glyph-rule" aria-hidden="true">
        <span class="glyph-rule-text">✶ ⚝ ☥ ⚝ ✶</span>
      </div>
      <div class="pt-10 text-center">
        <span class="kicker kicker--centered">Other platforms</span>
        <h2 class="font-display mt-4 text-3xl text-white sm:text-4xl">For the unwindowed.</h2>
        <p class="mt-3">
          <a
            href={allReleasesUrl}
            target="_blank"
            rel="noopener"
            class="codex-action codex-action--link"
          >All releases on github →</a>
        </p>
      </div>

      <!-- Windows portable -->
      <div class="mt-12">
        <div class="codex-chapter mb-6">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={ICON_WINDOWS} />
          </svg>
          <span>For Windows</span>
        </div>
        <div class="codex-entry">
          <div class="relative flex flex-wrap items-start justify-between gap-4">
            <div>
              <div class="codex-entry-title">Portable .exe</div>
              <div class="codex-entry-body">Single executable, no install. Same app as the installer.</div>
              {winPortable && (
                <code class="codex-entry-meta">{winPortable.name}</code>
              )}
            </div>
            <a
              href={winPortable?.browser_download_url ?? releaseUrl}
              class="codex-action"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" />
              </svg>
              {winPortable ? fmtBytes(winPortable.size) : 'Download'}
            </a>
          </div>
        </div>
      </div>

      <!-- Linux -->
      <div class="mt-12">
        <div class="codex-chapter mb-6">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={ICON_LINUX} />
          </svg>
          <span>For Linux</span>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="codex-entry">
            <div class="relative flex items-start justify-between gap-3">
              <div>
                <div class="codex-entry-title">AppImage</div>
                <div class="codex-entry-body">Universal. Works on most distros.</div>
              </div>
              <a
                href={appImage?.browser_download_url ?? releaseUrl}
                class="codex-action"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" />
                </svg>
                {appImage ? fmtBytes(appImage.size) : 'Download'}
              </a>
            </div>
            {appImage && (
              <div class="relative mt-4">
                <span class="codex-cmd-label">Then run</span>
                <div class="codex-cmd" data-copy={`chmod +x ${appImage.name} && ./${appImage.name}`}>
                  <span class="truncate">
                    <span class="select-none text-paper-dim">$ </span>chmod +x {appImage.name}
                  </span>
                  <button type="button" class="copy-btn" aria-label="Copy command">
                    <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="9" width="13" height="13" rx="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                    <svg class="check-icon hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </button>
                </div>
              </div>
            )}
          </div>

          <div class="codex-entry">
            <div class="relative flex items-start justify-between gap-3">
              <div>
                <div class="codex-entry-title">Debian / Ubuntu</div>
                <div class="codex-entry-body">.deb package, installs via apt.</div>
              </div>
              <a
                href={deb?.browser_download_url ?? releaseUrl}
                class="codex-action"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" />
                </svg>
                {deb ? fmtBytes(deb.size) : 'Download'}
              </a>
            </div>
            {deb && (
              <div class="relative mt-4">
                <span class="codex-cmd-label">Then install</span>
                <div class="codex-cmd" data-copy={`sudo apt install ./${deb.name}`}>
                  <span class="truncate">
                    <span class="select-none text-paper-dim">$ </span>sudo apt install ./{deb.name}
                  </span>
                  <button type="button" class="copy-btn" aria-label="Copy command">
                    <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="9" width="13" height="13" rx="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                    <svg class="check-icon hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Arch -->
      <div class="mt-12">
        <div class="codex-chapter mb-6">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={ICON_ARCH} />
          </svg>
          <span>For Arch</span>
        </div>
        <div class="codex-entry">
          <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div class="flex items-center gap-3">
                <div class="codex-entry-title">grimoire-bin</div>
                <span class="font-sc text-[11px] tracking-[0.22em] uppercase text-paper opacity-70">aur</span>
              </div>
              <div class="codex-entry-body">Pre-built binary package on the AUR.</div>
              <a
                href={aurUrl}
                target="_blank"
                rel="noopener"
                class="mt-2 codex-action codex-action--link"
              >View on AUR →</a>
            </div>
            <div class="codex-cmd sm:min-w-[280px]" data-copy="yay -S grimoire-bin">
              <span>
                <span class="select-none text-paper-dim">$ </span>yay -S grimoire-bin
              </span>
              <button type="button" class="copy-btn" aria-label="Copy command">
                <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="9" y="9" width="13" height="13" rx="2" />
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                </svg>
                <svg class="check-icon hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VERIFY -->
    <section class="relative mx-auto max-w-4xl px-6 pb-20">
      <div class="glyph-rule" aria-hidden="true">
        <span class="glyph-rule-text">☉ ⚝ ⚜ ⚝ ☉</span>
      </div>
      <div class="pt-10 text-center">
        <span class="kicker kicker--centered">Provenance</span>
        <h2 class="font-display mt-4 text-3xl text-white sm:text-4xl">Verify your download.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted">
          Every release ships a <code class="bg-black/40 border border-border px-1.5 py-0.5 font-mono text-xs text-paper">SHA256SUMS</code> file and a GitHub build provenance attestation. Either is enough to confirm a binary came from the GitHub Actions build, not someone re-hosting it.
        </p>
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        <div class="codex-entry">
          <div class="relative">
            <div class="flex items-baseline justify-between gap-3">
              <div class="codex-entry-title">Checksum</div>
              <span class="font-sc text-[11px] tracking-[0.22em] uppercase text-paper opacity-70">sha-256</span>
            </div>
            <div class="mt-4 space-y-3">
              <div>
                <span class="codex-cmd-label">Linux / macOS</span>
                <div class="codex-cmd" data-copy="sha256sum -c SHA256SUMS">
                  <span><span class="select-none text-paper-dim">$ </span>sha256sum -c SHA256SUMS</span>
                  <button type="button" class="copy-btn" aria-label="Copy command">
                    <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="9" width="13" height="13" rx="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                    <svg class="check-icon hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </button>
                </div>
              </div>
              <div>
                <span class="codex-cmd-label">PowerShell</span>
                <div class="codex-cmd" data-copy="Get-FileHash <file>">
                  <span><span class="select-none text-paper-dim">PS&gt; </span>Get-FileHash &lt;file&gt;</span>
                  <button type="button" class="copy-btn" aria-label="Copy command">
                    <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="9" width="13" height="13" rx="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                    <svg class="check-icon hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
            {sums && (
              <a
                href={sums.browser_download_url}
                class="mt-4 codex-action codex-action--link inline-flex"
              >Download SHA256SUMS ↓</a>
            )}
          </div>
        </div>

        <div class="codex-entry">
          <div class="relative">
            <div class="flex items-baseline justify-between gap-3">
              <div class="codex-entry-title">Build provenance</div>
              <span class="font-sc text-[11px] tracking-[0.22em] uppercase text-paper opacity-70">gh cli</span>
            </div>
            <div class="mt-4">
              <span class="codex-cmd-label">Any platform with gh installed</span>
              <div class="codex-cmd" data-copy="gh attestation verify <file> --owner Slush97">
                <span class="truncate"><span class="select-none text-paper-dim">$ </span>gh attestation verify &lt;file&gt; --owner Slush97</span>
                <button type="button" class="copy-btn" aria-label="Copy command">
                  <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                  <svg class="check-icon hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </button>
              </div>
            </div>
            <p class="mt-4 text-xs text-muted">
              Confirms the binary was built by Grimoire's GitHub Actions workflow.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // Copy-to-clipboard buttons
  for (const host of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    const btn = host.querySelector<HTMLButtonElement>('.copy-btn');
    const copyIcon = host.querySelector<SVGElement>('.copy-icon');
    const checkIcon = host.querySelector<SVGElement>('.check-icon');
    if (!btn) continue;
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const text = host.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        btn.classList.add('text-accent');
        setTimeout(() => {
          checkIcon?.classList.add('hidden');
          copyIcon?.classList.remove('hidden');
          btn.classList.remove('text-accent');
        }, 1400);
      } catch {
        // Clipboard API unavailable (insecure context, etc.); fail silently.
      }
    });
  }
</script>

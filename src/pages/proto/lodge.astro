---
/*
 * Prototype A: The Gilded Lodge.
 * Art deco occult. A members-only lodge in Deadlock's 1920s city:
 * black lacquer, bone, gilt rules, oxblood depth. Orange is spent on
 * the download button and nowhere else.
 */
import EasterEgg from '../../components/proto/EasterEgg.astro';
import { brand, getDownloadUrls, getReach, fmtBytes } from '../../data/content';
import { commas } from '../../lib/reach';

const dl = await getDownloadUrls();
const reach = await getReach();

const win = dl.windowsInstaller ?? dl.windowsPortable;
const winKind = dl.windowsInstaller ? 'installer' : 'portable';
const winMeta = [dl.version && `v${dl.version}`, win && `${fmtBytes(win.size)} ${winKind}`]
  .filter(Boolean)
  .join(' · ');

interface Entry {
  n: number;
  label: string;
  href: string;
}
const register: Entry[] = [];
if (reach.githubInstalls !== null)
  register.push({ n: reach.githubInstalls, label: 'downloads from GitHub releases', href: `${brand.github}/releases` });
if (reach.gamebananaDownloads !== null)
  register.push({ n: reach.gamebananaDownloads, label: 'downloads on GameBanana', href: brand.gamebanana });
if (reach.aptInstalls !== null)
  register.push({ n: reach.aptInstalls, label: 'installs through apt', href: 'https://apt.grimoiremods.com' });

const ticks = Array.from({ length: 60 }, (_, i) => {
  const a = (i / 60) * Math.PI * 2;
  const major = i % 5 === 0;
  const r1 = major ? 49.5 : 52.5;
  const r2 = 57;
  const f = (v: number) => Math.round(v * 100) / 100;
  return {
    x1: f(60 + Math.cos(a) * r1),
    y1: f(60 + Math.sin(a) * r1),
    x2: f(60 + Math.cos(a) * r2),
    y2: f(60 + Math.sin(a) * r2),
    major,
  };
});

const divider = `<svg class="divider-svg" viewBox="0 0 400 24" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1">
    <line x1="24" y1="12" x2="183" y2="12"/><line x1="217" y1="12" x2="376" y2="12"/>
    <line x1="140" y1="7.5" x2="181" y2="7.5"/><line x1="140" y1="16.5" x2="181" y2="16.5"/>
    <line x1="219" y1="7.5" x2="260" y2="7.5"/><line x1="219" y1="16.5" x2="260" y2="16.5"/>
    <polygon points="200,1 211,12 200,23 189,12"/>
  </g>
  <g fill="currentColor">
    <polygon points="200,6 206,12 200,18 194,12"/>
    <polygon points="24,9 27,12 24,15 21,12"/><polygon points="376,9 379,12 376,15 373,12"/>
    <rect x="136" y="6" width="3" height="3" transform="rotate(45 137.5 7.5)"/><rect x="261" y="6" width="3" height="3" transform="rotate(45 262.5 7.5)"/>
    <rect x="136" y="15" width="3" height="3" transform="rotate(45 137.5 16.5)"/><rect x="261" y="15" width="3" height="3" transform="rotate(45 262.5 16.5)"/>
  </g>
</svg>`;

const lesser = [
  {
    name: 'Launch',
    text: 'Launch Modded or Launch Vanilla from the sidebar. Vanilla stashes your mods and puts them back once the game starts.',
  },
  {
    name: 'Profiles',
    text: 'Save sets of enabled mods and swap between them. Share one as a short mp1: code or a .modprofile.json file.',
  },
  {
    name: 'Autoexec',
    text: 'Console commands that run every time the game launches, kept in one list.',
  },
  {
    name: 'VPK merge',
    text: 'Fold several mods into one VPK, and pull individual sources back out later.',
  },
  {
    name: 'Stats',
    text: 'MMR, match history and hero stats from deadlock-api.com.',
    tag: 'Experimental',
  },
  {
    name: 'Crosshair',
    text: 'Design a crosshair and watch the live preview while you tune it.',
    tag: 'Experimental',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0c0a08" />
    <title>Grimoire: The Gilded Lodge</title>
    <link rel="preload" href="/fonts/proto/limelight-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/proto/bodoni-moda-400-900-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#rites">Skip to the features</a>

    <header class="nav">
      <div class="wrap nav-row">
        <a class="nav-brand" href="#top" aria-label="Grimoire, back to top">
          <svg class="nav-seal" viewBox="0 0 120 120" aria-hidden="true">
            <circle cx="60" cy="60" r="52" fill="none" stroke="currentColor" stroke-width="5" />
            <circle cx="60" cy="52" r="13" fill="currentColor" />
            <path d="M52 58 L68 58 L72 86 L48 86 Z" fill="currentColor" />
          </svg>
          <span>Grimoire</span>
        </a>
        <nav class="nav-links" aria-label="Sections">
          <a href="#rites">Features</a>
          <a href="/docs">Guide</a>
          <a href={brand.github}>Source</a>
          <a class="nav-cta" href="#download">Download</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero" data-lodge-hero>
        <canvas class="burst" aria-hidden="true"></canvas>

        <div class="wrap hero-copy">
          <p class="plaque">
            <span class="plaque-step" aria-hidden="true"></span>
            <span>A free mod manager for Deadlock</span>
            <span class="plaque-step plaque-step--r" aria-hidden="true"></span>
          </p>
          <h1 class="wordmark">Grimoire</h1>
          <p class="hero-line">
            Find mods, install them in one click, and give every hero the look you want.
          </p>
          <p class="hero-sub">
            Grimoire browses GameBanana for you, keeps your load order and conflicts in check, and
            launches Deadlock modded or vanilla.
          </p>

          <div class="cta-row">
            <a class="cta" href={dl.primaryHref}>
              <span class="cta-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" /></svg>
              </span>
              <span class="cta-text">
                <span class="cta-main">Download for Windows</span>
                {winMeta && <span class="cta-meta">{winMeta}</span>}
              </span>
            </a>
            <div class="cta-alt">
              <a href="/download">Linux, AUR, apt and Nix</a>
              <a href={brand.github}>Read the source on GitHub</a>
            </div>
          </div>

          <ul class="vows" aria-label="Promises">
            <li>Open source, MIT</li>
            <li>No telemetry</li>
            <li>Works offline</li>
          </ul>

          <aside class="note note--l note--hero-l" aria-hidden="true">
            it really doesn't phone home. go read the source, we'll wait
            <svg viewBox="0 0 80 40"><path d="M4 6 C 30 4, 50 14, 70 30 M70 30 l-9 -2 M70 30 l-1 -9" /></svg>
          </aside>
          <aside class="note note--r note--hero-r" aria-hidden="true">
            <svg viewBox="0 0 80 40" class="flip"><path d="M4 6 C 30 4, 50 14, 70 30 M70 30 l-9 -2 M70 30 l-1 -9" /></svg>
            peek through the keyhole
          </aside>
        </div>

        <div class="wrap stage">
          <div class="seal" data-seal>
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <defs>
                <linearGradient id="lodge-gilt" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#8a6528" />
                  <stop offset=".35" stop-color="#fbe7ae" />
                  <stop offset=".6" stop-color="#d6b066" />
                  <stop offset="1" stop-color="#8a6528" />
                </linearGradient>
                <radialGradient id="lodge-glow" cx=".5" cy=".42" r=".5">
                  <stop offset="0" stop-color="#5a3a14" />
                  <stop offset="1" stop-color="#050403" />
                </radialGradient>
              </defs>
              <circle cx="60" cy="60" r="59" fill="#0c0a08" />
              <g stroke="url(#lodge-gilt)">
                {ticks.map((t) => (
                  <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke-width={t.major ? 1.6 : 0.8} />
                ))}
              </g>
              <circle cx="60" cy="60" r="47" fill="none" stroke="url(#lodge-gilt)" stroke-width="1.6" />
              <circle cx="60" cy="60" r="43" fill="#120e0a" stroke="url(#lodge-gilt)" stroke-width=".6" />
              <path
                d="M60 31 a14 14 0 0 1 6.6 26.3 L70 84 H50 L53.4 57.3 A14 14 0 0 1 60 31 Z"
                fill="url(#lodge-glow)"
                stroke="url(#lodge-gilt)"
                stroke-width="1.4"
              />
            </svg>
            <div class="keyhole-egg">
              <EasterEgg size={16} label="Something behind the keyhole" />
            </div>
          </div>

          <figure class="frame frame--hero">
            <div class="frame-gap">
              <div class="frame-inner">
                <img
                  src="/proto/shots/locker.webp"
                  width="1528"
                  height="924"
                  alt="Grimoire's Locker: a gallery of Deadlock hero cards, each showing how many skins and sounds are installed"
                  fetchpriority="high"
                />
              </div>
            </div>
          </figure>
          <p class="caption">Plate I. The Locker, version {dl.version || '1.30'}.</p>
        </div>
      </section>

      {register.length > 0 && (
        <section class="register" aria-labelledby="register-h">
          <div class="wrap">
            <h2 id="register-h" class="eyebrow">The register</h2>
            <ul class="register-list">
              {register.map((r) => (
                <li>
                  <a href={r.href}>
                    <span class="register-n">{commas(r.n)}</span>
                    <span class="register-l">{r.label}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="register-note">
              Public counters kept by other people, read when this page was built. GitHub counts installers
              only, not update checks.
            </p>
          </div>
        </section>
      )}

      <div class="wrap divider"><Fragment set:html={divider} /></div>

      <section id="rites" class="rites" aria-labelledby="rites-h">
        <div class="wrap">
          <header class="section-head">
            <p class="eyebrow">What it does</p>
            <h2 id="rites-h" class="section-title">The Rites</h2>
          </header>

          <article class="rite">
            <div class="rite-copy">
              <div class="medal" aria-hidden="true"><span>I</span></div>
              <p class="rite-kicker">Rite I · Browse</p>
              <h3 class="rite-title">GameBanana, inside the app.</h3>
              <p>
                Search the whole Deadlock catalog without opening a browser. Sort by popularity, flip between
                Mods, Sounds and WiPs, and install with one click. ZIP, 7Z and RAR archives unpack themselves.
              </p>
              <ul class="facts">
                <li>One-click <code>gb1click://</code> installs from the GameBanana site</li>
                <li>Import a whole collection by URL</li>
                <li>Mods with several files let you pick the one you want</li>
              </ul>
            </div>
            <div class="rite-art rite-art--stack">
              <figure class="frame">
                <div class="frame-gap">
                  <div class="frame-inner">
                    <img src="/proto/shots/browse.webp" width="1528" height="924" loading="lazy" alt="Browse tab sorted by popularity, showing GameBanana mods with like and view counts and an Install button on each" />
                  </div>
                </div>
              </figure>
              <figure class="frame frame--inset">
                <div class="frame-gap">
                  <div class="frame-inner">
                    <img src="/proto/shots/browse-detail.webp" width="1528" height="924" loading="lazy" alt="A mod window listing four color variants, each with its own Install button" />
                  </div>
                </div>
              </figure>
            </div>
          </article>

          <article class="rite rite--flip">
            <div class="rite-copy">
              <div class="medal" aria-hidden="true"><span>II</span></div>
              <p class="rite-kicker">Rite II · The Locker</p>
              <h3 class="rite-title">Every hero, one wardrobe.</h3>
              <p>
                All 44 heroes sit in one gallery. Open a hero to choose the skin they wear, then swap cards,
                sounds and effects. Preview in 2D or 3D. Turn on Shuffle on launch for a different look each
                time you play.
              </p>
              <ul class="facts">
                <li>One active skin per hero, the rest wait on disk</li>
                <li>2D and live 3D pose previews</li>
                <li>Star your favorites</li>
              </ul>
            </div>
            <div class="rite-art">
              <figure class="frame">
                <div class="frame-gap">
                  <div class="frame-inner">
                    <img src="/proto/shots/locker-hero.webp" width="1528" height="924" loading="lazy" alt="Celeste's page in the Locker with five installed skins to choose from" />
                  </div>
                </div>
              </figure>
            </div>
            <aside class="note note--l note--rite" aria-hidden="true">
              44 heroes. yes, all of them.
              <svg viewBox="0 0 80 40"><path d="M4 6 C 30 4, 50 14, 70 30 M70 30 l-9 -2 M70 30 l-1 -9" /></svg>
            </aside>
          </article>

          <article class="rite">
            <div class="rite-copy">
              <div class="medal" aria-hidden="true"><span>III</span></div>
              <p class="rite-kicker">Rite III · Color and sound</p>
              <h3 class="rite-title">Recolor the magic.</h3>
              <p>
                Shift a hero's ability effects to a single color, a gradient or a rainbow. Pick a sound for each
                ability. Every choice stays separate from your other mods, so it is easy to undo.
              </p>
            </div>
            <div class="rite-art">
              <figure class="frame">
                <div class="frame-gap">
                  <div class="frame-inner">
                    <img src="/proto/shots/recolor-old.webp" width="1442" height="826" loading="lazy" alt="Ability color controls for Abrams with hue, saturation and brightness sliders, from an earlier version" />
                  </div>
                </div>
              </figure>
            </div>
            <aside class="note note--r note--rite" aria-hidden="true">
              <svg viewBox="0 0 80 40" class="flip"><path d="M4 6 C 30 4, 50 14, 70 30 M70 30 l-9 -2 M70 30 l-1 -9" /></svg>
              rainbow abrams. you're welcome
            </aside>
          </article>

          <article class="rite rite--flip">
            <div class="rite-copy">
              <div class="medal" aria-hidden="true"><span>IV</span></div>
              <p class="rite-kicker">Rite IV · Your library</p>
              <h3 class="rite-title">A load order you can see.</h3>
              <p>
                Enable, disable, reorder and bulk-select from one screen. Every enabled mod shows its place in
                the order. When two mods overwrite the same game files, Conflicts tells you which ones.
              </p>
              <ul class="facts">
                <li>Offline catalog with full-text search</li>
                <li>Conflict detection before you launch</li>
              </ul>
            </div>
            <div class="rite-art">
              <figure class="frame">
                <div class="frame-gap">
                  <div class="frame-inner">
                    <img src="/proto/shots/installed.webp" width="1528" height="924" loading="lazy" alt="Installed tab with twelve enabled mods, numbered in load order, each with a toggle" />
                  </div>
                </div>
              </figure>
            </div>
          </article>

          <article class="rite">
            <div class="rite-copy">
              <div class="medal" aria-hidden="true"><span>V</span></div>
              <p class="rite-kicker">Rite V · General</p>
              <h3 class="rite-title">The small things, too.</h3>
              <p>
                Cursors, soul containers, the hideout, HUD and icon packs all live under General. Import a cursor
                pack or make your own, then set it active.
              </p>
            </div>
            <div class="rite-art">
              <figure class="frame">
                <div class="frame-gap">
                  <div class="frame-inner">
                    <img src="/proto/shots/cursors.webp" width="1528" height="924" loading="lazy" alt="Cursor mods under General, with Mask Of Eternity Cursors set active" />
                  </div>
                </div>
              </figure>
            </div>
          </article>

          <div class="lesser">
            <h3 class="lesser-title">Lesser rites</h3>
            <ul class="lesser-grid">
              {lesser.map((l) => (
                <li class="lesser-card">
                  <p class="lesser-name">
                    {l.name}
                    {l.tag && <span class="tag">{l.tag}</span>}
                  </p>
                  <p class="lesser-text">{l.text}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="bylaws" aria-labelledby="bylaws-h">
        <div class="wrap">
          <h2 id="bylaws-h" class="eyebrow eyebrow--bone">Bylaws of the lodge</h2>
          <ol class="bylaw-list">
            <li>
              <span class="bylaw-n" aria-hidden="true">I</span>
              <p class="bylaw-head">The source is open.</p>
              <p class="bylaw-text">MIT licensed. Every line is on GitHub, and you can build it yourself.</p>
            </li>
            <li>
              <span class="bylaw-n" aria-hidden="true">II</span>
              <p class="bylaw-head">Nothing phones home.</p>
              <p class="bylaw-text">No analytics, no tracking, no heartbeat. A fresh install phones home for nothing.</p>
            </li>
            <li>
              <span class="bylaw-n" aria-hidden="true">III</span>
              <p class="bylaw-head">It works offline.</p>
              <p class="bylaw-text">Your mods, profiles and load order live on your machine, searchable without a connection.</p>
            </li>
          </ol>
        </div>
      </section>

      <section id="download" class="download" aria-labelledby="download-h">
        <div class="wrap download-grid">
          <div class="download-main">
            <p class="eyebrow">Download</p>
            <h2 id="download-h" class="section-title section-title--left">Enter the lodge</h2>
            <p class="download-lede">
              Free, for Windows and Linux. You need Deadlock installed through Steam.
            </p>
            <a class="cta cta--big" href={dl.primaryHref}>
              <span class="cta-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" /></svg>
              </span>
              <span class="cta-text">
                <span class="cta-main">Download for Windows</span>
                {winMeta && <span class="cta-meta">{winMeta}</span>}
              </span>
            </a>
            <p class="download-fine">
              {dl.releaseDate && <>Released {dl.releaseDate}. </>}
              <a href={dl.releaseUrl}>Release notes</a> · <a href="/download">All builds and checksums</a>
            </p>
          </div>

          <dl class="builds">
            {dl.windowsPortable && (
              <div class="build">
                <dt>Windows portable</dt>
                <dd><a href={dl.windowsPortable.browser_download_url}>{dl.windowsPortable.name}</a> <span>{fmtBytes(dl.windowsPortable.size)}</span></dd>
              </div>
            )}
            {dl.linuxAppImage && (
              <div class="build">
                <dt>Linux AppImage</dt>
                <dd><a href={dl.linuxAppImage.browser_download_url}>{dl.linuxAppImage.name}</a> <span>{fmtBytes(dl.linuxAppImage.size)}</span></dd>
              </div>
            )}
            <div class="build">
              <dt>Debian and Ubuntu</dt>
              <dd>An apt repo that updates with <code>apt upgrade</code>. <a href="/download">Setup</a></dd>
            </div>
            <div class="build">
              <dt>Arch Linux</dt>
              <dd><code>yay -S grimoire-bin</code> <a href={brand.aur}>AUR</a></dd>
            </div>
            <div class="build">
              <dt>Nix and NixOS</dt>
              <dd>Flake at <code>github:Slush97/grimoire</code></dd>
            </div>
          </dl>
          <aside class="note note--r note--dl" aria-hidden="true">
            <svg viewBox="0 0 80 40" class="flip"><path d="M4 6 C 30 4, 50 14, 70 30 M70 30 l-9 -2 M70 30 l-1 -9" /></svg>
            the vanilla button stashes your mods and puts them back after. handy before a ranked night
          </aside>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="wrap-divider"><Fragment set:html={divider} /></div>
        <p class="eyebrow">Lodge register</p>
        <ul class="buttons" aria-label="Badges and links">
          <li><a class="b88 b88--gilt" href={brand.github}><span class="b88-k">MIT</span><span>open<br />source</span></a></li>
          <li><span class="b88 b88--ox"><span class="b88-k">0</span><span>telemetry<br />calls</span></span></li>
          <li><span class="b88 b88--bone"><span class="b88-k">⌂</span><span>offline<br />first</span></span></li>
          <li><span class="b88 b88--lac"><span class="b88-k">1</span><span>made by<br />one person</span></span></li>
          <li><a class="b88 b88--gilt" href={brand.discord}><span class="b88-k">✦</span><span>join the<br />discord</span></a></li>
          <li><a class="b88 b88--bone" href={brand.gamebanana}><span class="b88-k">GB</span><span>tool<br />22583</span></a></li>
          <li><a class="b88 b88--ox" href={brand.aur}><span class="b88-k">AUR</span><span>grimoire<br />-bin</span></a></li>
          <li><span class="b88 b88--lac b88--candle"><span class="b88-k b88-candle" aria-hidden="true"><svg viewBox="0 0 10 18"><path d="M5 1.2c1.6 2 1.6 3.6 0 4.8-1.6-1.2-1.6-2.8 0-4.8z" fill="#fbbf5c"/><rect x="3" y="7" width="4" height="10" fill="#efe5cf"/><rect x="4.6" y="5.6" width=".8" height="1.6" fill="#1b1307"/></svg></span><span>best by<br />candlelight</span></span></li>
        </ul>
        <nav class="foot-links" aria-label="Footer">
          <a href="/download">Download</a>
          <a href="/docs">Player guide</a>
          <a href="/tools">Tools</a>
          <a href={brand.github}>GitHub</a>
          <a href={brand.discord}>Discord</a>
          <a href={brand.gamebanana}>GameBanana</a>
        </nav>
        <p class="legal">
          Grimoire is a fan-made tool and is not affiliated with Valve. Deadlock is a trademark of Valve
          Corporation. Est. {brand.year}.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Limelight';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/proto/limelight-400-normal-latin.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Bodoni Moda';
    font-style: italic;
    font-weight: 400 900;
    font-display: swap;
    src: url('/fonts/proto/bodoni-moda-400-900-italic-latin.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Bodoni Moda';
    font-style: normal;
    font-weight: 400 900;
    font-display: swap;
    src: url('/fonts/proto/bodoni-moda-400-900-normal-latin.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Josefin Sans';
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url('/fonts/proto/josefin-sans-300-700-normal-latin.woff2') format('woff2');
  }

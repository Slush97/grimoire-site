</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-lodge-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('canvas.burst');
  const seal = hero?.querySelector<HTMLElement>('[data-seal]');

  if (hero && canvas && seal) {
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const RAYS = 132;
    const GILT = '232, 200, 128';
    let W = 0;
    let H = 0;
    let ox = 0;
    let oy = 0;
    let rmax = 0;
    let start = performance.now();
    let raf = 0;
    let visible = true;
    let last = 0;

    const ease = (x: number) => 1 - Math.pow(1 - x, 3);
    const clamp = (x: number) => Math.min(1, Math.max(0, x));

    function measure() {
      const r = hero!.getBoundingClientRect();
      const s = seal!.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = r.width;
      H = r.height;
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ox = s.left - r.left + s.width / 2;
      oy = s.top - r.top + s.height / 2;
      rmax = Math.hypot(Math.max(ox, W - ox), Math.max(oy, H - oy));
    }

    function draw(t: number) {
      ctx.clearRect(0, 0, W, H);
      const glintAt = -Math.PI / 2 + Math.sin(t * 0.11) * 1.25;
      const r0 = 74;

      for (let i = 0; i < RAYS; i++) {
        const a = -Math.PI / 2 + (i / RAYS) * Math.PI * 2;
        const fromTop = Math.abs((((i / RAYS) + 0.5) % 1) - 0.5) * 2;
        const local = reduce ? 1 : ease(clamp((t - 0.15 - fromTop * 0.9) / 1.1));
        if (local <= 0) continue;
        const major = i % 2 === 0;
        const quarter = i % 6 === 0;
        const len = r0 + (major ? rmax : rmax * 0.52) * local;
        let d = Math.abs(a - glintAt) % (Math.PI * 2);
        if (d > Math.PI) d = Math.PI * 2 - d;
        const glint = reduce ? 0 : Math.exp(-(d * d) / (2 * 0.05 * 0.05));
        const base = quarter ? 0.42 : major ? 0.26 : 0.15;
        const alpha = Math.min(0.9, base + glint * 0.55);
        const cx = Math.cos(a);
        const cy = Math.sin(a);
        const g = ctx.createLinearGradient(ox + cx * r0, oy + cy * r0, ox + cx * len, oy + cy * len);
        g.addColorStop(0, `rgba(${GILT}, ${alpha})`);
        g.addColorStop(0.55, `rgba(${GILT}, ${alpha * 0.35})`);
        g.addColorStop(1, `rgba(${GILT}, 0)`);
        ctx.strokeStyle = g;
        ctx.lineWidth = quarter ? 1.4 : major ? 1 : 0.6;
        ctx.beginPath();
        ctx.moveTo(ox + cx * r0, oy + cy * r0);
        ctx.lineTo(ox + cx * len, oy + cy * len);
        ctx.stroke();
      }

      const rings = [
        { r: 96, a: 0.32, dash: [] as number[] },
        { r: 104, a: 0.16, dash: [2, 6] },
        { r: 170, a: 0.2, dash: [] },
        { r: 290, a: 0.12, dash: [1, 9] },
        { r: 460, a: 0.08, dash: [] },
      ];
      rings.forEach((ring, k) => {
        const p = reduce ? 1 : ease(clamp((t - 0.5 - k * 0.18) / 0.9));
        if (p <= 0) return;
        ctx.setLineDash(ring.dash);
        ctx.strokeStyle = `rgba(${GILT}, ${ring.a * p})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(ox, oy, ring.r, -Math.PI / 2 - Math.PI * p, -Math.PI / 2 + Math.PI * p);
        ctx.stroke();
      });
      ctx.setLineDash([]);

      const tickP = reduce ? 1 : ease(clamp((t - 1.1) / 0.8));
      if (tickP > 0) {
        ctx.strokeStyle = `rgba(${GILT}, ${0.35 * tickP})`;
        ctx.lineWidth = 1;
        for (let i = 0; i < 72; i++) {
          const a = (i / 72) * Math.PI * 2;
          const r1 = 170;
          const r2 = i % 6 === 0 ? 184 : 176;
          ctx.beginPath();
          ctx.moveTo(ox + Math.cos(a) * r1, oy + Math.sin(a) * r1);
          ctx.lineTo(ox + Math.cos(a) * r2, oy + Math.sin(a) * r2);
          ctx.stroke();
        }
      }
    }

    function loop(now: number) {
      raf = 0;
      if (!visible || document.hidden) return;
      const t = (now - start) / 1000;
      if (t < 3 || now - last > 33) {
        draw(t);
        last = now;
      }
      raf = requestAnimationFrame(loop);
    }

    function kick() {
      if (reduce) {
        draw(10);
        return;
      }
      if (!raf && visible && !document.hidden) raf = requestAnimationFrame(loop);
    }

    measure();
    draw(reduce ? 10 : 0);
    kick();

    new ResizeObserver(() => {
      measure();
      draw(reduce ? 10 : (performance.now() - start) / 1000);
    }).observe(hero);
    document.fonts?.ready.then(() => {
      measure();
      if (reduce) draw(10);
    });
    new IntersectionObserver((entries) => {
      visible = entries[0]?.isIntersecting ?? true;
      kick();
    }).observe(hero);
    document.addEventListener('visibilitychange', kick);
  }
</script>

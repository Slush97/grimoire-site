  @media (prefers-reduced-motion: reduce) {
    .wordmark,
    .seal,
    .frame--hero,
    .frame--hero .frame-inner::after,
    .b88-candle path {
      animation: none;
    }
    .frame--hero .frame-inner::after {
      display: none;
    }

<script>
  /* Rain on the facade. Low density, DPR 1, paused offscreen and on hidden tabs. */
  const canvas = document.querySelector<HTMLCanvasElement>('.facade .rain');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas && !reduce) {
    const ctx = canvas.getContext('2d')!;
    let drops: { x: number; y: number; l: number; v: number }[] = [];
    let running = false;
    let visible = true;
    let raf = 0;

    const resize = () => {
      canvas.width = canvas.clientWidth;
      canvas.height = canvas.clientHeight;
      const n = Math.round((canvas.width * canvas.height) / 9000);
      drops = Array.from({ length: n }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        l: 8 + Math.random() * 14,
        v: 7 + Math.random() * 6,
      }));
    };

    const tick = () => {
      const { width: w, height: h } = canvas;
      ctx.clearRect(0, 0, w, h);
      ctx.strokeStyle = 'rgba(190, 205, 255, 0.22)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (const d of drops) {
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(d.x - d.l * 0.18, d.y + d.l);
        d.y += d.v;
        d.x -= d.v * 0.18;
        if (d.y > h) {
          d.y = -d.l;
          d.x = Math.random() * (w + 60);
        }
      }
      ctx.stroke();
      raf = requestAnimationFrame(tick);
    };

    const sync = () => {
      const should = visible && !document.hidden;
      if (should && !running) {
        running = true;
        raf = requestAnimationFrame(tick);
      } else if (!should && running) {
        running = false;
        cancelAnimationFrame(raf);
      }
    };

    resize();
    addEventListener('resize', resize);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      sync();
    }).observe(canvas);
    document.addEventListener('visibilitychange', sync);
    sync();
  }
</script>

---
/*
 * Midnight Marquee. A 1920s picture palace on a wet city street, playing
 * Grimoire. Prototype only: lives at /proto/marquee, noindex.
 */
import '../../styles/fonts.css';
import EasterEgg from '../../components/proto/EasterEgg.astro';
import { brand, getDownloadUrls, getReach, fmtBytes } from '../../data/content';

const dl = await getDownloadUrls();
const reach = await getReach();

const assets = dl.release?.assets ?? [];
const flatpak = assets.find((a) => a.name.toLowerCase().endsWith('.flatpak')) ?? null;
const win = dl.windowsInstaller;
const ticketDate = dl.release
  ? new Date(dl.release.published_at)
      .toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
      .toUpperCase()
  : '';
const fmt = (n: number) => n.toLocaleString('en-US');

const returns = [
  reach.githubInstalls !== null && {
    n: reach.githubInstalls,
    label: 'installer downloads from GitHub',
    src: 'counted from release assets, updater files excluded',
  },
  reach.gamebananaDownloads !== null && {
    n: reach.gamebananaDownloads,
    label: 'downloads on GameBanana',
    src: 'from the tool page counter',
  },
  reach.aptInstalls !== null && {
    n: reach.aptInstalls,
    label: 'apt installs',
    src: 'new machines on apt.grimoiremods.com',
  },
].filter(Boolean) as { n: number; label: string; src: string }[];

/* Letterboard: each word is a no-wrap group of tiles, so rows reflow by word on a phone. */
let tileIndex = 0;
function tiles(text: string): string {
  return text
    .split(' ')
    .map((word) => {
      const letters = [...word]
        .map((ch) => `<span class="tile" style="--i:${tileIndex++}">${ch}</span>`)
        .join('');
      return `<span class="word">${letters}</span>`;
    })
    .join('');
}
const boardTop = tiles('NOW SHOWING');
const boardMain = tiles('A MOD MANAGER FOR DEADLOCK');
const boardSub = tiles('FREE · OPEN SOURCE · NO TELEMETRY');
const strip = (text: string) => {
  tileIndex = 0;
  return tiles(text);
};
const stripAttractions = strip('COMING ATTRACTIONS');
const stripBox = strip('BOX OFFICE');

/* Deterministic skyline so the street looks the same on every build. */
function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function skyline(seed: number, minH: number, maxH: number, lit: number) {
  const r = rng(seed);
  const blocks: { x: number; w: number; h: number; spire: boolean }[] = [];
  const wins: { x: number; y: number; o: number }[] = [];
  let x = -20;
  while (x < 1460) {
    const w = 46 + r() * 96;
    const h = minH + r() * (maxH - minH);
    blocks.push({ x, w, h, spire: h > maxH * 0.86 });
    for (let wy = 400 - h + 16; wy < 392; wy += 15) {
      for (let wx = x + 9; wx < x + w - 9; wx += 12) {
        if (r() < lit) wins.push({ x: wx, y: wy, o: 0.3 + r() * 0.65 });
      }
    }
    x += w + (r() < 0.35 ? 6 : 0);
  }
  return { blocks, wins };
}
const far = skyline(1926, 90, 250, 0.08);
const near = skyline(1931, 60, 200, 0.14);

const posters = [
  {
    title: 'Browse GameBanana',
    kicker: 'Now showing',
    img: 'browse.webp',
    alt: 'Grimoire Browse page: a grid of GameBanana mods sorted by popularity, each with likes, views and an Install button.',
    line: 'Search the catalog, sort by popularity, install in one click. ZIP, 7Z and RAR archives unpack themselves.',
    tilt: '-0.7deg',
  },
  {
    title: 'Pick Your Variant',
    kicker: 'Now showing',
    img: 'browse-detail.webp',
    alt: 'A mod window listing four variant files, each with its size, download count and its own Install button.',
    line: 'When a mod ships several files, every variant is listed with its size and download count.',
    tilt: '0.5deg',
  },
  {
    title: 'Load Order',
    kicker: 'Held over',
    img: 'installed.webp',
    alt: 'Installed page: twelve enabled mods numbered one to twelve, each with a toggle.',
    line: 'Enable, disable and reorder what you have installed. Conflict detection flags mods that overwrite the same files.',
    tilt: '-0.3deg',
  },
  {
    title: 'Cursors & Cosmetics',
    kicker: 'New this season',
    img: 'cursors.webp',
    alt: 'Locker General section showing four cursor mods, one marked Active, with categories like Soul Containers, HUD and Hideout.',
    line: 'Soul containers, HUD, icon packs, hideout and cursor mods live under General in the Locker.',
    tilt: '0.6deg',
  },
  {
    title: 'Ability Recolor',
    kicker: 'In glorious color',
    img: 'recolor-old.webp',
    alt: 'Ability color panel for Abrams with hue, saturation and brightness sliders.',
    line: "Shift a hero's ability effects to a solid color, a gradient or a rainbow.",
    tilt: '-0.5deg',
    w: 1442,
    h: 826,
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Grimoire · Midnight Marquee</title>
    <meta name="description" content="Grimoire is a free, open source mod manager for Deadlock." />
    <link rel="preload" href="/fonts/proto/big-shoulders-display-500-900-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/proto/limelight-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the show</a>

    <header class="awning">
      <a class="wordmark" href="/proto/marquee"><span class="wm-bulb" aria-hidden="true"></span>Grimoire</a>
      <nav aria-label="Primary">
        <a href="#attractions">Features</a>
        <a href="#box-office">Downloads</a>
        <a href="/docs">Guide</a>
        <a href={brand.github}>Source</a>
      </nav>
      <a class="awning-cta" href={dl.primaryHref}>Download</a>
    </header>

    <main id="main">
      <!-- THE FACADE -->
      <section class="facade" aria-labelledby="crown-title">
        <canvas class="rain" aria-hidden="true"></canvas>
        <svg class="skyline" viewBox="0 0 1440 400" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
          <g class="sky-far">
            {far.blocks.map((b) => <rect x={b.x} y={400 - b.h} width={b.w} height={b.h} />)}
            {far.blocks.filter((b) => b.spire).map((b) => (
              <polygon points={`${b.x + b.w * 0.2},${400 - b.h} ${b.x + b.w * 0.3},${400 - b.h - 26} ${b.x + b.w * 0.42},${400 - b.h - 26} ${b.x + b.w * 0.5},${400 - b.h - 70} ${b.x + b.w * 0.58},${400 - b.h - 26} ${b.x + b.w * 0.7},${400 - b.h - 26} ${b.x + b.w * 0.8},${400 - b.h}`} />
            ))}
          </g>
          <g class="sky-far-lit">
            {far.wins.map((w) => <rect x={w.x} y={w.y} width="4" height="6" opacity={w.o} />)}
          </g>
          <g class="sky-near">
            {near.blocks.map((b) => <rect x={b.x} y={400 - b.h} width={b.w} height={b.h} />)}
          </g>
          <g class="sky-near-lit">
            {near.wins.map((w) => <rect x={w.x} y={w.y} width="5" height="7" opacity={w.o} />)}
          </g>
        </svg>

        <div class="facade-inner">
          <p class="usher usher--crown" aria-hidden="true">
            nightly, no cover charge
            <svg viewBox="0 0 80 40" class="usher-arrow"><path d="M4 8 C 30 4, 52 14, 70 32 M70 32 l-12 -2 M70 32 l-1 -12" /></svg>
          </p>

          <div class="crown">
            <h1 id="crown-title" class="crown-text">Grimoire</h1>
          </div>

          <div class="canopy">
            <span class="edge edge-t" aria-hidden="true"></span>
            <span class="edge edge-r" aria-hidden="true"></span>
            <span class="edge edge-b" aria-hidden="true"></span>
            <span class="edge edge-l" aria-hidden="true"></span>
            <div class="board">
              <p class="row row-top"><span class="sr">Now showing</span><span aria-hidden="true" set:html={boardTop} /></p>
              <p class="row row-main"><span class="sr">A mod manager for Deadlock</span><span aria-hidden="true" set:html={boardMain} /></p>
              <p class="row row-sub"><span class="sr">Free, open source, no telemetry</span><span aria-hidden="true" set:html={boardSub} /></p>
            </div>
          </div>

          <div class="underneath">
            <figure class="screen">
              <div class="proscenium">
                <div class="valance" aria-hidden="true"></div>
                <div class="screen-glass">
                  <img src="/proto/shots/locker.webp" width="1528" height="924" alt="The Grimoire Locker: a gallery of Deadlock hero cards, each showing how many skins and sounds are installed for that hero." fetchpriority="high" />
                  <span class="flicker" aria-hidden="true"></span>
                </div>
                <span class="curtain curtain-l" aria-hidden="true"></span>
                <span class="curtain curtain-r" aria-hidden="true"></span>
                <span class="beam" aria-hidden="true"></span>
              </div>
              <figcaption><span>Tonight</span> The Locker. Every hero, one gallery. Version {dl.version}.</figcaption>
            </figure>

            <div class="booth" id="ticket">
              <div class="booth-sign">Box office</div>
              <div class="booth-window" aria-hidden="true">
                <span class="booth-tickets">Tickets</span>
                <span class="booth-open">All shows free</span>
                <span class="grille"></span>
              </div>
              <div class="slot">
                <a class="ticket" href={dl.primaryHref}>
                  <span class="stub" aria-hidden="true">Admit one</span>
                  <span class="ticket-body">
                    <span class="t-top">Admit one · Grimoire</span>
                    <span class="t-main">Download for Windows</span>
                    <span class="t-file">{win?.name ?? 'Windows installer'}</span>
                    <span class="t-meta">v{dl.version}{win ? ` · ${fmtBytes(win.size)}` : ''}</span>
                    <span class="t-seat">{ticketDate ? `${ticketDate} · ` : ''}Row G · Seat any</span>
                  </span>
                </a>
              </div>
              <ul class="doors">
                <li><a href="/download">Linux, AUR, apt, Flatpak and every other door <span aria-hidden="true">→</span></a></li>
                <li><a href={brand.github}>Read the source on GitHub <span aria-hidden="true">→</span></a></li>
              </ul>
              <p class="plaque">Free <i>·</i> MIT licensed <i>·</i> No telemetry <i>·</i> Works offline</p>
              <p class="usher usher--ticket" aria-hidden="true">
                psst. it's free
                <svg viewBox="0 0 60 50" class="usher-arrow"><path d="M50 4 C 30 10, 14 22, 10 44 M10 44 l-4 -11 M10 44 l10 -6" /></svg>
              </p>
            </div>
          </div>
        </div>
        <div class="pavement" aria-hidden="true"></div>
      </section>

      <!-- COMING ATTRACTIONS -->
      <section class="lobby" id="attractions" aria-labelledby="attractions-title">
        <div class="wrap">
          <div class="strip-head">
            <h2 id="attractions-title" class="sr">Coming attractions</h2>
            <p class="strip" aria-hidden="true" set:html={stripAttractions} />
            <p class="strip-sub">Everything below is in the build at the box office tonight.</p>
          </div>

          <article class="feature">
            <div class="feature-art">
              <img src="/proto/shots/locker-hero.webp" width="1528" height="924" loading="lazy" alt="Celeste in the Locker: five installed skins in a grid, with Skins, Sounds, Cards and Effects tabs on the left." />
            </div>
            <div class="feature-copy">
              <p class="p-kicker">The feature presentation</p>
              <h3>The Locker</h3>
              <p class="feature-line">All 44 heroes in one gallery. Open a hero to pick their skin, sounds, cards and effects, with a 2D or live 3D preview. One skin per hero is active. The rest wait on disk, ready to swap.</p>
              <p class="billing" aria-label="Featuring skins, sounds, cards, effects, cursors and soul containers">
                <span class="b-small">featuring</span>
                <span class="b-big">Skins</span><span class="b-dot">·</span><span class="b-big">Sounds</span><span class="b-dot">·</span><span class="b-big">Cards</span>
                <span class="b-small">and</span>
                <span class="b-big">Effects</span>
                <span class="b-small">with</span>
                <span class="b-mid">Cursors &amp; Soul Containers</span>
              </p>
              <p class="feature-note">There is even a Shuffle on launch switch.</p>
            </div>
            <p class="lobby-card" aria-hidden="true"><b>44</b> heroes!<br />one gallery!</p>
          </article>

          <div class="posters">
            {posters.map((p) => (
              <article class="case" style={`--tilt:${p.tilt}`}>
                <div class="poster">
                  <p class="p-kicker">{p.kicker}</p>
                  <h3>{p.title}</h3>
                  <div class="p-art">
                    <img src={`/proto/shots/${p.img}`} width={p.w ?? 1528} height={p.h ?? 924} loading="lazy" alt={p.alt} />
                  </div>
                  <p class="p-line">{p.line}</p>
                  <p class="p-foot" aria-hidden="true">A Grimoire picture</p>
                </div>
              </article>
            ))}
            <article class="case case--type" style="--tilt:0.4deg">
              <div class="poster poster--type">
                <p class="p-kicker">Bring a friend</p>
                <h3>Profiles</h3>
                <p class="mp1" aria-hidden="true">mp1:</p>
                <p class="p-line">Save whole loadouts and swap them in one click. Share one as a short <code>mp1:</code> code or a <code>.modprofile.json</code> file.</p>
                <p class="p-foot" aria-hidden="true">A Grimoire picture</p>
              </div>
            </article>
          </div>

          <aside class="handbill" aria-labelledby="bill-title">
            <p class="hb-top">Grand double bill</p>
            <h3 id="bill-title">Also on the program</h3>
            <p class="hb-launch"><b>Launch Modded</b> <span>or</span> <b>Launch Vanilla</b></p>
            <p class="hb-italic">Vanilla stashes your mods and puts them back once the game starts.</p>
            <dl class="hb-list">
              <div><dt>Autoexec</dt><dd>console commands that run every time the game launches</dd></div>
              <div><dt>Conflicts</dt><dd>see which mods overwrite the same game files</dd></div>
              <div><dt>Merge</dt><dd>fold several mods into one VPK, and pull them apart again</dd></div>
              <div><dt>Collections</dt><dd>import a GameBanana collection by its URL</dd></div>
              <div><dt>Sounds</dt><dd>pick which sound mod plays for each ability</dd></div>
            </dl>
            <p class="hb-exp"><b>Late show, opt in:</b> Stats (MMR, match history and hero stats from deadlock-api.com), a crosshair designer with live preview, and Discover for shared profiles.</p>
            <p class="usher usher--bill" aria-hidden="true">the late show is in Settings</p>
          </aside>
        </div>
      </section>

      <!-- BOX OFFICE -->
      <section class="boxoffice" id="box-office" aria-labelledby="box-title">
        <div class="wrap">
          <div class="strip-head">
            <h2 id="box-title" class="sr">Box office</h2>
            <p class="strip strip--dark" aria-hidden="true" set:html={stripBox} />
          </div>

          <div class="bo-grid">
            <div class="returns">
              <h3>Box office returns</h3>
              {returns.length ? (
                <ul>
                  {returns.map((r) => (
                    <li>
                      <span class="r-n">{fmt(r.n)}</span>
                      <span class="r-label">{r.label}</span>
                      <span class="r-src">{r.src}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="r-dark">The counters are dark tonight.</p>
              )}
              <p class="r-note">Public counters kept by other people, read when this page was built. Grimoire itself counts nothing.</p>
            </div>

            <div class="prices">
              <h3>Every door in</h3>
              <ul>
                <li>
                  <a href={dl.primaryHref}>
                    <span class="pr-name">Windows installer</span><span class="pr-lead" aria-hidden="true"></span><span class="pr-val">{win ? fmtBytes(win.size) : 'get it'}</span>
                  </a>
                </li>
                {dl.windowsPortable && (
                  <li>
                    <a href="/download">
                      <span class="pr-name">Windows portable</span><span class="pr-lead" aria-hidden="true"></span><span class="pr-val">{fmtBytes(dl.windowsPortable.size)}</span>
                    </a>
                  </li>
                )}
                {dl.linuxAppImage && (
                  <li>
                    <a href="/download">
                      <span class="pr-name">Linux AppImage</span><span class="pr-lead" aria-hidden="true"></span><span class="pr-val">{fmtBytes(dl.linuxAppImage.size)}</span>
                    </a>
                  </li>
                )}
                <li>
                  <a href="/download">
                    <span class="pr-name">Debian / Ubuntu</span><span class="pr-lead" aria-hidden="true"></span><span class="pr-val">apt repo</span>
                  </a>
                </li>
                {flatpak && (
                  <li>
                    <a href="/download">
                      <span class="pr-name">Flatpak</span><span class="pr-lead" aria-hidden="true"></span><span class="pr-val">{fmtBytes(flatpak.size)}</span>
                    </a>
                  </li>
                )}
                <li>
                  <a href={brand.aur}>
                    <span class="pr-name">Arch (AUR)</span><span class="pr-lead" aria-hidden="true"></span><span class="pr-val"><code>yay -S grimoire-bin</code></span>
                  </a>
                </li>
                <li>
                  <a href={brand.github}>
                    <span class="pr-name">Nix flake</span><span class="pr-lead" aria-hidden="true"></span><span class="pr-val"><code>github:Slush97/grimoire</code></span>
                  </a>
                </li>
              </ul>
              <p class="pr-note">v{dl.version}, released {dl.releaseDate}. SHA256SUMS ship with every release. Needs Deadlock installed through Steam.</p>
              <p class="usher usher--prices" aria-hidden="true">no ushers were harmed</p>
            </div>
          </div>
        </div>
      </section>

      <!-- INTERMISSION -->
      <section class="intermission" aria-labelledby="int-title">
        <div class="int-card">
          <h2 id="int-title">Intermission</h2>
          <p class="int-sub">Stretch your legs. Read the player guide while the reels change.</p>
          <ol class="program">
            <li><a href="/docs/first-run">Setting up Grimoire for the first time</a></li>
            <li><a href="/docs/installing-mods">Installing mods</a></li>
            <li><a href="/docs/load-order">Load order and the mod limit</a></li>
            <li><a href="/docs/troubleshooting">Fixing mods that do not load</a></li>
            <li><a href="/docs/privacy">Privacy and what leaves your machine</a></li>
          </ol>
          <a class="int-all" href="/docs">The whole program <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <!-- END CREDITS -->
      <section class="credits" aria-labelledby="end-title">
        <h2 id="end-title" class="the-end">The End</h2>
        <p class="credits-lede">Grimoire is free and open source. It collects nothing. A fresh install phones home for nothing.</p>
        <dl class="roll">
          <div><dt>Source</dt><dd><a href={brand.github}>github.com/Slush97/grimoire</a></dd></div>
          <div><dt>License</dt><dd><a href={`${brand.github}/blob/main/LICENSE`}>MIT</a></dd></div>
          <div><dt>Telemetry</dt><dd>none, ever</dd></div>
          <div><dt>Works</dt><dd>offline</dd></div>
          <div><dt>Community</dt><dd><a href={brand.discord}>Discord</a></dd></div>
          <div><dt>Also playing at</dt><dd><a href={brand.gamebanana}>GameBanana</a> · <a href={brand.aur}>AUR</a></dd></div>
        </dl>
      </section>
    </main>

    <footer class="house">
      <div class="seats" aria-hidden="true">
        {Array.from({ length: 15 }, (_, i) => (
          <div class="seat">
            <span class="seat-no">G{i + 1}</span>
          </div>
        ))}
      </div>
      <div class="egg-spot">
        <EasterEgg size={14} label="Something rolled under seat G8" />
      </div>

      <div class="pins">
        <a class="pin" style="--c1:#1f3a8a;--c2:#0f1d4a;--r:-3deg" href={`${brand.github}/blob/main/LICENSE`}><span>★ MIT ★</span><small>licensed</small></a>
        <a class="pin" style="--c1:#b3202a;--c2:#6e0f17;--r:2deg" href="/docs/privacy"><span>no</span><small>telemetry</small></a>
        <span class="pin" style="--c1:#e9dcb8;--c2:#c9b27a;--fg:#1a1424;--r:-1deg"><span>offline</span><small>first</small></span>
        <a class="pin" style="--c1:#0f766e;--c2:#064e47;--r:3deg" href={brand.aur}><span>on the</span><small>AUR</small></a>
        <a class="pin" style="--c1:#f2c94c;--c2:#b8860b;--fg:#1a1424;--r:-2deg" href={brand.gamebanana}><span>Game</span><small>Banana</small></a>
        <a class="pin" style="--c1:#4f46e5;--c2:#2e2a8f;--r:1.5deg" href={brand.discord}><span>join the</span><small>Discord</small></a>
        <span class="pin" style="--c1:#111827;--c2:#000;--fg:#ffd27a;--r:-2.5deg"><span>best viewed</span><small>in Deadlock</small></span>
      </div>

      <p class="fine">Grimoire {brand.year}. Deadlock is a trademark of Valve Corporation. Grimoire is a fan-made tool and is not affiliated with Valve.</p>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Big Shoulders Display';
    font-style: normal;
    font-weight: 500 900;
    font-display: swap;
    src: url('/fonts/proto/big-shoulders-display-500-900-normal-latin.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Limelight';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/proto/limelight-400-normal-latin.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Libre Caslon Text';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/proto/libre-caslon-text-400-normal-latin.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Libre Caslon Text';
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/proto/libre-caslon-text-400-italic-latin.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Libre Caslon Text';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/proto/libre-caslon-text-700-normal-latin.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Courier Prime';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/proto/courier-prime-400-normal-latin.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Courier Prime';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/proto/courier-prime-700-normal-latin.woff2') format('woff2');
  }

---
/*
 * Direction F: Summoning. The OSS page's plain structure and copy, with
 * the mark's own picture made literal in the hero: the Locker's hero cards
 * rise out of the open book in a whirlwind. Screenshots stay 1:1 crops of
 * the 1528x924 captures, same rule as /proto/oss.
 */
import '../../styles/fonts.css';
import EasterEgg from '../../components/proto/EasterEgg.astro';
import { brand, getDownloadUrls, getReach, fmtBytes } from '../../data/content';

const dl = await getDownloadUrls();
const reach = await getReach();

const crop = (name: string) => `/proto/shots/crop/${name}.webp`;
const win = dl.windowsInstaller ?? dl.windowsPortable;
const assets = dl.release?.assets ?? [];
const flatpak = assets.find((a) => a.name.toLowerCase().endsWith('.flatpak')) ?? null;
const dmg = assets.find((a) => a.name.toLowerCase().endsWith('.dmg')) ?? null;

// Ordered so neighbours on the spiral differ in colour. The last five repeat
// heroes from far up the strand, so the funnel stays full.
const deck = [
  'celeste', 'seven', 'vindicta', 'holliday', 'mina', 'graves', 'paige', 'drifter', 'calico',
  'lash', 'rem', 'silver', 'victor', 'apollo', 'billy', 'ladygeist', 'abrams',
  'paige', 'celeste', 'drifter', 'mina', 'silver',
];

const features = [
  {
    tab: 'Browse',
    title: 'Browse GameBanana',
    body: 'Search the Deadlock catalog and install mods without leaving the app. Archives are extracted for you, and 1-Click Install links on GameBanana open straight in Grimoire.',
    img: 'browse',
    alt: 'Browse view: mod cards with like and view counts and an Install button on each',
    w: 760,
    h: 660,
    glow: 'rgba(239, 68, 68, 0.22)',
    docs: [{ href: '/docs/installing-mods', label: 'Installing mods' }],
  },
  {
    tab: 'Locker',
    title: 'Variants and a 3D preview',
    body: 'Mods that ship in several colors let you pick the variant. On a wide window, flip the hero portrait to 3D and orbit the skin you have on.',
    img: 'locker',
    alt: "Celeste's locker page listing five installed skins",
    w: 760,
    h: 600,
    glow: 'rgba(217, 70, 239, 0.24)',
    docs: [{ href: '/docs/locker-skins', label: 'Managing skins' }],
    figure: true,
  },
  {
    tab: 'Installed · Conflicts',
    title: 'Load order and conflicts',
    body: 'Lower numbers win. When two mods replace the same game files, the one higher on your list is what you see in game, and the Conflicts tab lists every pair that overlaps.',
    img: 'installed',
    alt: 'Installed view: enabled mods numbered in load order, each with a toggle',
    w: 760,
    h: 580,
    glow: 'rgba(132, 204, 22, 0.16)',
    docs: [
      { href: '/docs/load-order', label: 'Load order' },
      { href: '/docs/conflicts', label: 'Conflicts' },
    ],
  },
  {
    tab: 'Locker · General',
    title: 'Cursors, HUDs and the rest',
    body: "Cosmetics that aren't tied to a hero get their own shelves: soul containers, cursors, HUDs, icon packs, announcers, killstreak music.",
    img: 'general',
    alt: 'The General shelf: categories on the left, cursor sets on the right',
    w: 760,
    h: 600,
    glow: 'rgba(245, 158, 11, 0.2)',
    docs: [{ href: '/docs/locker-global', label: 'Global cosmetics' }],
  },
];

const more = [
  {
    title: 'Profiles',
    body: 'Save a loadout, switch setups without reinstalling, share it as a code.',
    href: '/docs/profiles',
    icon: '<path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="m3 13 9 5 9-5"/>',
  },
  {
    title: 'Launch vanilla',
    body: 'Start a clean session without uninstalling anything.',
    href: '/docs/launching',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M10 8.5v7l5.5-3.5L10 8.5Z"/>',
  },
  {
    title: 'Autoexec',
    body: 'Console commands that run at game start, plus Steam launch options.',
    href: '/docs/autoexec',
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/>',
  },
  {
    title: 'Ability colors',
    body: "Recolor a hero's ability effects: one color, a gradient, or rainbow.",
    href: '/docs/locker-effects',
    icon: '<path d="M12 3s6 6.2 6 10.5a6 6 0 0 1-12 0C6 9.2 12 3 12 3Z"/>',
  },
  {
    title: 'Ability sounds',
    body: 'One sound mod per ability, with its own volume and pitch.',
    href: '/docs/locker-sounds',
    icon: '<path d="M3 12h2M7 8v8M11 5v14M15 9v6M19 11v2"/>',
  },
  {
    title: 'Snapshots',
    body: 'Recovery points taken before risky operations, so you can undo them.',
    href: '/docs/snapshots',
    icon: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/>',
  },
];

const ledger = [
  {
    heading: 'Out of the box',
    on: true,
    rows: [
      { who: 'GameBanana', when: 'When you browse, search, or install a mod.' },
      {
        who: 'GitHub',
        when: 'A release check after launch, skipped when a package manager installed the app. A language pack, once, if you pick a language other than English.',
      },
    ],
  },
  {
    heading: 'Off until you turn it on',
    on: false,
    rows: [
      { who: 'deadlock-api.com', when: 'Stats for the accounts you choose to track, and match data if you opt in to contributing it.' },
      { who: 'Steam', when: 'Public names and avatars for Stats, and the sign-in page for Discover. Grimoire never sees your password.' },
      { who: 'Discover', when: 'Profiles you publish, plus a check for new ones every couple of minutes while it is on.' },
      { who: 'Deadworks servers', when: 'The server list, and a ping to each server so you can see latency.' },
      { who: 'Discord', when: 'Rich Presence, over a local socket to the Discord app on your PC.' },
    ],
  },
];

const stats = [
  reach.githubInstalls !== null && { n: reach.githubInstalls, label: 'installer downloads on GitHub' },
  reach.gamebananaDownloads !== null && { n: reach.gamebananaDownloads, label: 'downloads on GameBanana' },
  reach.aptInstalls !== null && { n: reach.aptInstalls, label: 'machines set up through apt' },
].filter(Boolean) as { n: number; label: string }[];
const nf = new Intl.NumberFormat('en-US');

const aptSetup = [
  'sudo install -d -m 0755 /etc/apt/keyrings',
  'curl -fsSL https://apt.grimoiremods.com/grimoire.gpg | sudo tee /etc/apt/keyrings/grimoire.gpg >/dev/null',
  'echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/grimoire.gpg] https://apt.grimoiremods.com stable main" | sudo tee /etc/apt/sources.list.d/grimoire.list >/dev/null',
  'sudo apt update && sudo apt install grimoire',
].join('\n');
const nixInput = 'inputs.grimoire.url = "github:Slush97/grimoire";';

const badges = [
  { top: 'MIT', bottom: 'LICENSED', href: `${brand.github}/blob/main/LICENSE`, tone: 'lime' },
  { top: 'NO', bottom: 'TELEMETRY', href: '/docs/privacy', tone: 'red' },
  { top: 'GET IT', bottom: 'ON AUR', href: brand.aur, tone: 'blue' },
  { top: 'JOIN DA', bottom: 'DISCORD', href: brand.discord, tone: 'plum' },
  { top: 'ON', bottom: 'GAMEBANANA', href: brand.gamebanana, tone: 'gold' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark" />
    <title>Grimoire: mod manager for Deadlock</title>
    <meta
      name="description"
      content="Grimoire is a free, open-source mod manager for Deadlock. Browse GameBanana, manage load order, and pick which skin every hero wears. No telemetry."
    />
    <link rel="icon" href="/proto/grimoire-mark.svg" type="image/svg+xml" />
  </head>
  <body>
    <svg width="0" height="0" class="defs" aria-hidden="true">
      <symbol id="spark" viewBox="0 0 24 24">
        <path d="M12 0c.7 7.3 4.7 11.3 12 12-7.3.7-11.3 4.7-12 12-.7-7.3-4.7-11.3-12-12 7.3-.7 11.3-4.7 12-12Z" />
      </symbol>
      <symbol id="gh" viewBox="0 0 16 16">
        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
      </symbol>
      <symbol id="dl" viewBox="0 0 24 24">
        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14" />
      </symbol>
      <symbol id="shuffle" viewBox="0 0 24 24">
        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5" />
      </symbol>
    </svg>

    <div class="stars" aria-hidden="true"></div>

    <div class="page">
      <header class="bar">
        <div class="wrap bar-inner">
          <a class="brand" href="/proto/summon">
            <img src="/proto/grimoire-mark.svg" alt="" width="30" height="27" />
            <span>Grimoire</span>
          </a>
          <nav aria-label="Main">
            <a href="#features">Features</a>
            <a href="#privacy">Privacy</a>
            <a href="/docs">Docs</a>
            <a href={brand.discord}>Discord</a>
          </nav>
          <div class="bar-actions">
            <a class="icon-btn" href={brand.github} aria-label="Source on GitHub">
              <svg width="18" height="18" aria-hidden="true"><use href="#gh" /></svg>
            </a>
            <a class="btn btn-accent" href={dl.primaryHref} data-primary-href>Download</a>
          </div>
        </div>
      </header>

      <main>
        <section class="hero">
          <div class="wrap hero-grid">
            <div class="hero-copy">
              {dl.version && (
                <a class="release" href={dl.releaseUrl}>
                  <span class="release-dot" aria-hidden="true"></span>
                  <span>v{dl.version}{dl.releaseDate && <span class="release-date"> · {dl.releaseDate}</span>}</span>
                  <span class="release-cta">Release notes <span aria-hidden="true">→</span></span>
                </a>
              )}
              <h1>
                <span class="h1-word">Grimoire</span>
                <span class="h1-sub">Mod manager for Deadlock</span>
              </h1>
              <p class="lede">
                Browse and install mods from GameBanana without leaving the app, keep your load
                order straight, and pick which skin every hero wears. Free, open source, and it
                collects nothing.
              </p>
              <div class="cta">
                <a class="btn btn-accent btn-lg" href={dl.primaryHref} data-primary>
                  <svg width="18" height="18" aria-hidden="true"><use href="#dl" /></svg>
                  <span data-primary-label>Download for Windows</span>
                  {win && <span class="size" data-primary-size>{fmtBytes(win.size)}</span>}
                </a>
                <a class="btn btn-ghost btn-lg" href="#download">Other platforms</a>
              </div>
              <ul class="meta">
                <li><svg width="10" height="10" aria-hidden="true"><use href="#spark" /></svg>Windows and Linux</li>
                <li><svg width="10" height="10" aria-hidden="true"><use href="#spark" /></svg>MIT licensed</li>
                <li><svg width="10" height="10" aria-hidden="true"><use href="#spark" /></svg><a href="#privacy">No telemetry</a></li>
              </ul>
            </div>

            <div class="vortex" data-vortex>
              <div class="stage" role="img" aria-label="Hero cards from the Locker spiralling up out of an open book, like the Grimoire logo">
                <div class="beam"></div>
                <canvas class="back" width="560" height="660"></canvas>
                <canvas class="front" width="560" height="660"></canvas>
                {deck.map((h, i) => (
                  <div class="vcard" data-w={((i * 37) % 15) - 7}>
                    <img src={`/proto/shots/cards/${h}.webp`} alt="" width="188" height="251" decoding="async" />
                    <span class="fog"></span>
                  </div>
                ))}
                <img class="book" src="/proto/grimoire-book.svg" alt="" width="360" height="264" />
                <span class="core"></span>
              </div>
              <div class="shuffle">
                <button type="button" class="shuffle-btn" data-shuffle>
                  <svg width="16" height="16" aria-hidden="true"><use href="#shuffle" /></svg>
                  Shuffle
                </button>
                <p>
                  In the app, <a href="/docs/locker-skins">Shuffle on launch</a> picks a random skin
                  for every hero, each time you play.
                </p>
              </div>
            </div>
          </div>
        </section>

        <section class="showcase" aria-labelledby="locker-h">
          <div class="wrap showcase-head reveal">
            <p class="kicker">
              <svg width="12" height="12" aria-hidden="true"><use href="#spark" /></svg>
              The Locker
            </p>
            <h2 id="locker-h">Pick what every hero wears</h2>
            <p>
              Every skin you download stays installed. Choose one per hero and the rest wait on
              disk, so switching takes a click. Star the heroes you play and they stay up top.
            </p>
            <p class="docs">
              <a href="/docs/locker">The Locker <span aria-hidden="true">→</span></a>
              <a href="/docs/locker-skins">Skins and variants <span aria-hidden="true">→</span></a>
            </p>
          </div>
          <div class="showcase-frame">
            <picture>
              <source media="(max-width: 719px)" srcset={crop('hero-sm')} width="610" height="530" />
              <img
                src={crop('hero')}
                alt="The Hero Locker: Deadlock heroes in a grid, each card showing the skin it's wearing"
                width="1528"
                height="700"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
        </section>

        <section id="features" class="features" aria-labelledby="features-h">
          <h2 id="features-h" class="sr-only">Features</h2>
          {features.map((f, i) => (
            <article class:list={['wrap', 'row', { flip: i % 2 === 1 }]}>
              <div class="row-copy reveal">
                <p class="kicker">
                  <svg width="12" height="12" aria-hidden="true"><use href="#spark" /></svg>
                  {f.tab}
                </p>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
                <p class="docs">
                  {f.docs.map((d) => (
                    <a href={d.href}>{d.label} <span aria-hidden="true">→</span></a>
                  ))}
                </p>
              </div>
              <div class="row-shot reveal" style={`--glow:${f.glow}`}>
                <img class="shot" src={crop(f.img)} alt={f.alt} width={f.w} height={f.h} loading="lazy" decoding="async" />
                {f.figure && (
                  <figure class="model">
                    <span class="model-toggle" aria-hidden="true"><span>2D</span><span class="on">3D</span></span>
                    <img
                      src={crop('celeste-3d')}
                      alt="The 3D preview: Celeste standing in her equipped skin"
                      width="388"
                      height="758"
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                )}
              </div>
            </article>
          ))}
        </section>

        <section class="wrap more" aria-labelledby="more-h">
          <h2 id="more-h" class="reveal">More in the app</h2>
          <ul>
            {more.map((m) => (
              <li class="reveal">
                <a href={m.href}>
                  <svg class="more-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={m.icon} />
                  <strong>{m.title}</strong>
                  <span>{m.body}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section id="privacy" class="wrap privacy" aria-labelledby="privacy-h">
          <div class="privacy-head reveal">
            <h2 id="privacy-h">What leaves your machine</h2>
            <p>
              No telemetry: no usage tracking, no heartbeat, no analytics. A fresh install phones
              home for nothing. This is every place the app can talk to, and what makes it.
            </p>
            <p class="docs">
              <a href="/docs/privacy">Every request, in detail <span aria-hidden="true">→</span></a>
            </p>
          </div>
          <div class="ledger reveal">
            {ledger.map((g) => (
              <div class="ledger-group">
                <h3 class:list={['ledger-h', { on: g.on }]}>
                  <span class="lamp" aria-hidden="true"></span>
                  {g.heading}
                </h3>
                <dl>
                  {g.rows.map((r) => (
                    <div>
                      <dt>{r.who}</dt>
                      <dd>{r.when}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
            <p class="ledger-foot">
              Bug reports are built on your machine, scrubbed of paths and IDs, and never sent for you.
            </p>
          </div>
        </section>

        <section class="wrap open" aria-labelledby="open-h">
          <div class="reveal">
            <h2 id="open-h">Free and open source</h2>
            <p>
              MIT licensed and built in the open. Read the code, build it yourself, or send a pull
              request. Every release ships a SHA256SUMS file and build provenance that ties each
              installer to the commit it was built from.
            </p>
            <div class="cta">
              <a class="btn btn-ghost" href={brand.github}>
                <svg width="16" height="16" aria-hidden="true"><use href="#gh" /></svg>
                Slush97/grimoire
              </a>
              <a class="btn btn-ghost" href={brand.discord}>Discord</a>
            </div>
          </div>
          {stats.length > 0 && (
            <div class="stats-wrap reveal">
              <dl class="stats">
                {stats.map((s) => (
                  <div>
                    <dt>{s.label}</dt>
                    <dd>
                      <span class="sr-only">{nf.format(s.n)}</span>
                      <span aria-hidden="true" data-count={s.n}>{nf.format(s.n)}</span>
                    </dd>
                  </div>
                ))}
              </dl>
              <p class="stats-note">
                Public counters kept by GitHub, GameBanana and the apt server. Nothing is counted
                inside the app.
              </p>
            </div>
          )}
        </section>

        <section id="download" class="wrap get" aria-labelledby="get-h">
          <div class="get-head reveal">
            <h2 id="get-h">Download</h2>
            <p class="sub">
              {dl.version && <>Version {dl.version}{dl.releaseDate && `, ${dl.releaseDate}`}. </>}
              Needs Deadlock installed through Steam.
            </p>
          </div>
          <div class="get-grid">
            <div class="card reveal" data-os="windows">
              <div class="card-head">
                <h3>Windows</h3>
                <span class="yours">Your system</span>
              </div>
              <div class="btn-col">
                {dl.windowsInstaller && (
                  <a class="btn btn-accent btn-lg" href={dl.windowsInstaller.browser_download_url}>
                    <svg width="18" height="18" aria-hidden="true"><use href="#dl" /></svg>
                    Installer <span class="size">{fmtBytes(dl.windowsInstaller.size)}</span>
                  </a>
                )}
                {dl.windowsPortable && (
                  <a class="btn btn-ghost btn-lg" href={dl.windowsPortable.browser_download_url}>
                    Portable .exe <span class="size">{fmtBytes(dl.windowsPortable.size)}</span>
                  </a>
                )}
              </div>
              <p class="card-note">
                The installer isn't code-signed yet, so Windows warns about an unknown publisher the
                first time. Click <strong>More info</strong>, then <strong>Run anyway</strong>.
              </p>
            </div>
            <div class="card reveal" data-os="linux">
              <div class="card-head">
                <h3>Linux</h3>
                <span class="yours">Your system</span>
              </div>
              <div class="pm">
                <div class="pm-row">
                  <span class="pm-label">Arch (AUR)</span>
                  <div class="cmd">
                    <code>yay -S grimoire-bin</code>
                    <button type="button" class="copy" data-copy="yay -S grimoire-bin">Copy</button>
                  </div>
                </div>
                <details class="pm-row">
                  <summary><span class="pm-label">Debian and Ubuntu (apt)</span><span class="pm-more">Show setup</span></summary>
                  <div class="cmd cmd-block">
                    <pre><code>{aptSetup}</code></pre>
                    <button type="button" class="copy" data-copy={aptSetup}>Copy</button>
                  </div>
                </details>
                <div class="pm-row">
                  <span class="pm-label">Nix flake</span>
                  <div class="cmd">
                    <code>{nixInput}</code>
                    <button type="button" class="copy" data-copy={nixInput}>Copy</button>
                  </div>
                </div>
              </div>
              <div class="btn-row">
                {dl.linuxAppImage && (
                  <a class="btn btn-ghost" href={dl.linuxAppImage.browser_download_url}>
                    AppImage <span class="size">{fmtBytes(dl.linuxAppImage.size)}</span>
                  </a>
                )}
                {dl.linuxDeb && (
                  <a class="btn btn-ghost" href={dl.linuxDeb.browser_download_url}>
                    .deb <span class="size">{fmtBytes(dl.linuxDeb.size)}</span>
                  </a>
                )}
                {flatpak && (
                  <a class="btn btn-ghost" href={flatpak.browser_download_url}>
                    .flatpak <span class="size">{fmtBytes(flatpak.size)}</span>
                  </a>
                )}
              </div>
              <p class="card-note">Package-manager installs update through the package manager, not the app.</p>
            </div>
          </div>
          {dmg && (
            <p class="mac reveal" data-os="macos">
              <span>
                <strong>macOS:</strong> an experimental Apple Silicon build, for Deadlock running in a
                CrossOver bottle.
              </span>
              <a href={dmg.browser_download_url}>.dmg <span class="size">{fmtBytes(dmg.size)}</span></a>
            </p>
          )}
          <p class="fine-links reveal">
            <a href={dl.releaseUrl}>Release notes</a>
            {dl.sha256Sums && <a href={dl.sha256Sums.browser_download_url}>SHA256SUMS</a>}
            <a href="/docs/privacy#verifying-what-you-downloaded">Verify a download</a>
            <a href={`${brand.github}/releases`}>All releases</a>
          </p>
        </section>
      </main>

      <footer class="foot">
        <svg class="spark" style="left:12%;top:20%;width:18px;height:18px;animation-delay:-1s" aria-hidden="true"><use href="#spark" /></svg>
        <svg class="spark gold" style="right:14%;top:40%;width:14px;height:14px;animation-delay:-2.5s" aria-hidden="true"><use href="#spark" /></svg>
        <img class="foot-mark" src="/proto/grimoire-mark.svg" alt="" width="44" height="40" />
        <div class="badges">
          {badges.map((b) => (
            <a class={`b88 b88-${b.tone}`} href={b.href}>
              <span>{b.top}</span>
              <strong>{b.bottom}</strong>
            </a>
          ))}
        </div>
        <nav class="foot-links" aria-label="Footer">
          <a href={brand.github}>GitHub</a>
          <a href={brand.discord}>Discord</a>
          <a href={brand.gamebanana}>GameBanana</a>
          <a href="/docs">Docs</a>
          <a href="/">The 1996 version</a>
        </nav>
        <p class="fine">
          Best viewed with any browser. Not affiliated with Valve.
          <EasterEgg size={12} label="A small egg" />
        </p>
      </footer>
    </div>
  </body>
</html>

<script>
  const TAU = Math.PI * 2;
  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const smooth = (v: number) => v * v * (3 - 2 * v);
  const easeOut = (v: number) => 1 - Math.pow(1 - v, 3);

  function calm(): boolean {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return true;
    try {
      return localStorage.getItem('geo-calm') === '1';
    } catch {
      return false;
    }
  }

  /*
   * The whirlwind. Cards ride one strand of a cone-shaped helix that leans
   * like the tornado in the mark: narrow where it leaves the book, wide at
   * the top. Each card rises for RISE_T seconds, fades at the top and comes
   * back out of the book. Everything is in the stage's own 560x660 space;
   * CSS zoom scales the stage on smaller screens.
   */
  function vortex(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const cards = [...stage.querySelectorAll<HTMLElement>('.vcard')];
    const fogs = cards.map((c) => c.querySelector<HTMLElement>('.fog')!);
    const imgs = cards.map((c) => c.querySelector('img')!);
    const wob = cards.map((c) => Number(c.dataset.w ?? 0));
    const [back, front] = [...stage.querySelectorAll('canvas')].map((c) => c.getContext('2d')!);
    const btn = root.querySelector<HTMLButtonElement>('[data-shuffle]');
    const still = calm();

    const N = cards.length;
    const W = 560, H = 660, CX = 280;
    const OX = 314, OY = 560, RISE = 500, LEAN = 60;
    const R0 = 10, R1 = 236, F = 1100, TURNS = 2.3;
    const CW = 116, CH = 155;
    const SPIN = 0.3, RISE_T = 50;

    let spin = 0.9, rise = 0.02, boost = 0, slow = 1, slowTo = 1;
    let turn = 0, turnTo = 0, pitch = 0, pitchTo = 0;
    let last = performance.now();
    const born = last;

    const radius = (u: number) => R0 + (R1 - R0) * Math.pow(u, 0.85);
    const axis = (u: number) => OX - LEAN * Math.pow(u, 1.4);

    function project(u: number, th: number, r: number) {
      const s = Math.sin(th);
      const c = Math.cos(th);
      const z = r * c;
      const k = F / (F - z);
      return { x: CX + (axis(u) + r * s - CX) * k, y: OY - u * RISE + z * (0.2 + pitch), k, s, c };
    }
    const helix = (u: number, phase: number, squeeze: number) =>
      project(u, spin + turn + phase + u * TURNS * TAU, radius(u) * squeeze);

    function layout(t: number, squeeze: number) {
      for (let i = 0; i < N; i++) {
        const target = (i / N + rise) % 1;
        const u = target * (still ? 1 : easeOut(clamp01((t - 0.2 - i * 0.05) / 1.6)));
        const p = helix(u, 0, squeeze);
        const grow = 0.3 + 0.7 * Math.pow(u, 0.7);
        const fade = clamp01(u / 0.05) * (1 - smooth(clamp01((u - 0.84) / 0.16)));
        const el = cards[i];
        el.style.transform =
          `translate3d(${(p.x - CW / 2).toFixed(1)}px, ${(p.y - CH / 2).toFixed(1)}px, 0) ` +
          `perspective(700px) rotateY(${(-p.s * 32).toFixed(1)}deg) rotate(${wob[i]}deg) scale(${(grow * p.k).toFixed(3)})`;
        el.style.opacity = fade.toFixed(3);
        el.style.zIndex = String(1000 + Math.round(p.c * 200));
        fogs[i].style.opacity = (0.74 * Math.pow((1 - p.c) / 2, 1.2)).toFixed(3);
      }
    }

    const dpr = Math.min(2, devicePixelRatio || 1);
    for (const g of [back, front]) {
      g.canvas.width = W * dpr;
      g.canvas.height = H * dpr;
      g.scale(dpr, dpr);
      g.globalCompositeOperation = 'lighter';
      g.strokeStyle = 'rgb(196, 181, 253)';
      g.lineCap = 'butt';
    }

    // The swirl bands of the mark: tapered arcs that orbit at fixed heights.
    const BANDS = [0.13, 0.29, 0.46, 0.63, 0.8];
    function bands(squeeze: number) {
      const SEGS = 40;
      for (let j = 0; j < BANDS.length; j++) {
        const u = BANDS[j];
        const r = radius(u) * squeeze * 1.08;
        const a0 = spin * 1.5 + turn + j * 1.9;
        const span = TAU * 0.6;
        const width = 1.4 + 6 * u;
        let prev = project(u, a0, r);
        for (let k = 1; k <= SEGS; k++) {
          const p = project(u, a0 + (span * k) / SEGS, r);
          const f = Math.sin((Math.PI * k) / SEGS);
          const g = p.c >= 0 ? front : back;
          g.globalAlpha = (0.1 + 0.42 * (p.c + 1) * 0.5) * f;
          g.lineWidth = width * f * p.k;
          g.beginPath();
          g.moveTo(prev.x, prev.y);
          g.lineTo(p.x, p.y);
          g.stroke();
          prev = p;
        }
      }
    }

    const sprites = ['#c4b5fd', '#a78bfa', '#f5d27a', '#ffffff', '#a5b4fc'].map((col) => {
      const c = document.createElement('canvas');
      c.width = c.height = 32;
      const g = c.getContext('2d')!;
      const grd = g.createRadialGradient(16, 16, 0, 16, 16, 16);
      grd.addColorStop(0, '#fff');
      grd.addColorStop(0.18, col);
      grd.addColorStop(1, 'rgba(0,0,0,0)');
      g.fillStyle = grd;
      g.fillRect(0, 0, 32, 32);
      return c;
    });
    const motes = Array.from({ length: 110 }, () => ({
      u: Math.random(),
      v: 1 / (7 + Math.random() * 9),
      ph: Math.random() * TAU,
      rj: 0.6 + Math.random() * 0.6,
      sz: 3 + Math.random() * 8,
      img: sprites[(Math.random() * sprites.length) | 0],
      tw: Math.random() * TAU,
    }));

    function draw(dt: number, now: number, squeeze: number) {
      back.clearRect(0, 0, W, H);
      front.clearRect(0, 0, W, H);
      bands(squeeze);
      for (const m of motes) {
        m.u += dt * m.v * slow * (1 + boost * 0.25);
        if (m.u >= 1) m.u -= 1;
        const p = helix(m.u, m.ph, squeeze * m.rj);
        const fade = clamp01(m.u / 0.05) * (1 - smooth(clamp01((m.u - 0.7) / 0.3)));
        const twinkle = 0.55 + 0.45 * Math.sin(now * 0.004 + m.tw);
        const g = p.c >= 0 ? front : back;
        g.globalAlpha = fade * twinkle * (0.35 + 0.65 * (p.c + 1) * 0.5);
        const s = m.sz * p.k;
        g.drawImage(m.img, p.x - s / 2, p.y - s / 2, s, s);
      }
    }

    let raf = 0;
    let visible = false;
    function frame() {
      const now = performance.now();
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      slow += (slowTo - slow) * Math.min(1, dt * 3);
      turn += (turnTo - turn) * Math.min(1, dt * 4);
      pitch += (pitchTo - pitch) * Math.min(1, dt * 4);
      boost *= Math.exp(-dt * 2.2);
      spin += (SPIN * slow + boost) * dt;
      rise += (dt * slow * (1 + boost * 0.12)) / RISE_T;
      const squeeze = 1 - Math.min(0.42, boost * 0.045);
      layout((now - born) / 1000, squeeze);
      draw(dt, now, squeeze);
      raf = requestAnimationFrame(frame);
    }
    function run(on: boolean) {
      cancelAnimationFrame(raf);
      if (on) {
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }
    }

    if (still) {
      layout(99, 1);
      draw(0, 0, 1);
    } else {
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        run(visible && !document.hidden);
      }).observe(root);
      document.addEventListener('visibilitychange', () => run(visible && !document.hidden));

      stage.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        turnTo = ((e.clientX - r.left) / r.width - 0.5) * 1.1;
        pitchTo = ((e.clientY - r.top) / r.height - 0.5) * 0.14;
      });
      stage.addEventListener('pointerenter', () => (slowTo = 0.35));
      stage.addEventListener('pointerleave', () => {
        slowTo = 1;
        turnTo = 0;
        pitchTo = 0;
      });

      // Hovering the download button charges the spell.
      const cta = document.querySelector('[data-primary]');
      cta?.addEventListener('pointerenter', () => {
        slowTo = 3;
        stage.classList.add('is-charged');
      });
      cta?.addEventListener('pointerleave', () => {
        slowTo = 1;
        stage.classList.remove('is-charged');
      });
    }

    const srcs = imgs.map((im) => im.getAttribute('src')!);
    btn?.addEventListener('click', () => {
      for (let i = srcs.length - 1; i > 0; i--) {
        const j = (Math.random() * (i + 1)) | 0;
        [srcs[i], srcs[j]] = [srcs[j], srcs[i]];
      }
      const swap = () => imgs.forEach((im, i) => (im.src = srcs[i]));
      if (still) return swap();
      btn.classList.remove('is-spinning');
      void btn.offsetWidth;
      btn.classList.add('is-spinning');
      boost = 11;
      setTimeout(swap, 360);
    });
  }

  const root = document.querySelector<HTMLElement>('[data-vortex]');
  if (root) vortex(root);

  // Count the public numbers up when they scroll in. Ones already on screen keep their value.
  if (!calm()) {
    const nf = new Intl.NumberFormat('en-US');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          const el = e.target as HTMLElement;
          const to = Number(el.dataset.count);
          const t0 = performance.now();
          const step = (now: number) => {
            const p = clamp01((now - t0) / 1700);
            el.textContent = nf.format(Math.round(to * easeOut(p)));
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      if (el.getBoundingClientRect().top < innerHeight) return;
      el.style.minWidth = `${el.offsetWidth}px`;
      el.textContent = '0';
      io.observe(el);
    });
  }

  // Highlight the visitor's platform. Nothing leaves the browser.
  const ua = navigator.userAgent.toLowerCase();
  const os = /android|iphone|ipad/.test(ua)
    ? ''
    : /windows/.test(ua)
      ? 'windows'
      : /mac os/.test(ua)
        ? 'macos'
        : /linux|x11|cros/.test(ua)
          ? 'linux'
          : '';
  if (os) document.querySelector(`[data-os="${os}"]`)?.setAttribute('data-yours', '');
  if (os === 'linux' || os === 'macos') {
    document.querySelectorAll<HTMLAnchorElement>('[data-primary], [data-primary-href]').forEach((a) => (a.href = '#download'));
    const label = document.querySelector('[data-primary-label]');
    if (label) label.textContent = os === 'linux' ? 'Download for Linux' : 'Download';
    document.querySelector('[data-primary-size]')?.remove();
  }

  document.querySelectorAll<HTMLElement>('.more li a').forEach((a) =>
    a.addEventListener('pointermove', (e) => {
      const r = a.getBoundingClientRect();
      a.style.setProperty('--mx', `${e.clientX - r.left}px`);
      a.style.setProperty('--my', `${e.clientY - r.top}px`);
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        b.textContent = 'Copied';
        b.classList.add('is-done');
        setTimeout(() => {
          b.textContent = 'Copy';
          b.classList.remove('is-done');
        }, 1600);
      } catch {}
    }),
  );
</script>


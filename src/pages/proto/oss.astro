---
/*
 * Screenshots are 1:1 crops of the 1528x924 captures, cut on card edges.
 * Scaling a whole window down to a column blurs the text, so feature shots
 * run off the page edge instead; the side next to the copy is what always
 * shows. Phones get the tight -sm crops at column width.
 */
import '../../styles/fonts.css';
import BrandSprite from '../../components/proto/BrandSprite.astro';
import EasterEgg from '../../components/proto/EasterEgg.astro';
import { brand, getDownloadUrls, getReach, fmtBytes, type ReleaseAsset } from '../../data/content';
import { commas } from '../../lib/reach';

const dl = await getDownloadUrls();
const reach = await getReach();

const shot = (name: string) => `/proto/shots/oss/${name}.webp`;
const assets = dl.release?.assets ?? [];
const find = (suffix: string) => assets.find((a) => a.name.toLowerCase().endsWith(suffix)) ?? null;
const dmg = find('.dmg');
const macZip = find('-mac.zip');
const flatpak = find('.flatpak');

const features = [
  {
    title: 'Browse GameBanana',
    body: 'Search the Deadlock catalog and install mods without leaving the app. Archives are extracted for you, and 1-Click Install links on GameBanana open in Grimoire.',
    img: 'browse',
    alt: 'Browse view: mod cards with like and view counts and an Install button on each',
    w: 1528,
    h: 658,
    sm: [637, 584],
    docs: [{ href: '/docs/installing-mods', label: 'Installing mods' }],
  },
  {
    title: 'Load order and conflicts',
    body: 'Enable, disable and reorder your mods. Grimoire warns you when two mods replace the same game files.',
    img: 'installed',
    alt: 'Installed view: enabled mods numbered in load order, each with a toggle',
    w: 1281,
    h: 626,
    sm: [628, 548],
    docs: [
      { href: '/docs/load-order', label: 'Load order' },
      { href: '/docs/conflicts', label: 'Conflicts' },
    ],
  },
  {
    title: 'Hero Locker',
    body: 'Keep every skin you download and choose one per hero. The others stay installed, so switching takes a click.',
    img: 'locker',
    alt: "Celeste's locker page listing five installed skins",
    w: 1281,
    h: 772,
    sm: [568, 752],
    docs: [{ href: '/docs/locker', label: 'The Locker' }],
  },
  {
    title: 'Cursors, HUDs and more',
    body: "Cosmetics that aren't tied to a hero get their own categories: soul containers, cursors, HUDs, announcers, killstreak music.",
    img: 'general',
    alt: 'The General shelf: categories on the left, cursor sets on the right',
    w: 688,
    h: 644,
    sm: [684, 630],
    docs: [{ href: '/docs/locker-global', label: 'Global cosmetics' }],
  },
];

const more = [
  { title: 'Profiles', body: 'Save a loadout, switch setups without reinstalling, share it as a code.', href: '/docs/profiles' },
  { title: 'Launch vanilla', body: 'Start a clean session without uninstalling anything.', href: '/docs/launching' },
  { title: 'Autoexec', body: 'Console commands that run at game start, plus Steam launch options.', href: '/docs/autoexec' },
  { title: 'Ability colors', body: "Recolor a hero's ability effects: one color, a gradient, or rainbow.", href: '/docs/locker-effects' },
  { title: 'Ability sounds', body: 'One sound mod per ability, with its own volume and pitch.', href: '/docs/locker-sounds' },
  { title: 'Snapshots', body: 'Recovery points taken before risky operations, so you can undo them.', href: '/docs/snapshots' },
];

const stats = [
  reach.githubInstalls !== null && { n: commas(reach.githubInstalls), label: 'downloads on GitHub', icon: 'github' },
  reach.gamebananaDownloads !== null && {
    n: commas(reach.gamebananaDownloads),
    label: 'downloads on GameBanana',
    icon: 'gamebanana',
  },
].filter(Boolean) as { n: string; label: string; icon: string }[];

type FileRow = { label: string; ext: string; noun: string; name: string; href: string; size: string };
const file = (label: string, a: ReleaseAsset | null, ext = '', noun = label) =>
  a && { label, ext, noun, name: a.name, href: a.browser_download_url, size: fmtBytes(a.size) };
const rows = (...r: (FileRow | null)[]) => r.filter(Boolean) as FileRow[];

const platforms = [
  {
    id: 'windows',
    name: 'Windows',
    icon: 'windows',
    files: rows(
      file('Installer', dl.windowsInstaller, '.exe', 'the installer'),
      file('Portable', dl.windowsPortable, '.exe', 'the portable .exe'),
    ),
  },
  {
    id: 'macos',
    name: 'macOS',
    icon: 'apple',
    files: rows(file('Disk image', dmg, '.dmg', 'the disk image'), file('Zip archive', macZip, '.zip', 'the zip')),
  },
  {
    id: 'linux',
    name: 'Linux',
    icon: 'linux',
    files: rows(
      file('AppImage', dl.linuxAppImage, '', 'the AppImage'),
      file('Debian package', dl.linuxDeb, '.deb', 'the .deb'),
      file('Flatpak', flatpak, '', 'the Flatpak'),
    ),
  },
].filter((p) => p.files.length > 0);

const APT = [
  'sudo install -d -m 0755 /etc/apt/keyrings',
  'curl -fsSL https://apt.grimoiremods.com/grimoire.gpg | sudo tee /etc/apt/keyrings/grimoire.gpg >/dev/null',
  'echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/grimoire.gpg] https://apt.grimoiremods.com stable main" | sudo tee /etc/apt/sources.list.d/grimoire.list >/dev/null',
  'sudo apt update && sudo apt install grimoire',
].join('\n');
const pms = [
  { icon: 'archlinux', name: 'Arch Linux', via: 'AUR', cmd: 'yay -S grimoire-bin', href: brand.aur },
  { icon: 'debian', name: 'Debian and Ubuntu', via: 'apt repo', cmd: APT, href: '/download' },
  {
    icon: 'nixos',
    name: 'Nix and NixOS',
    via: 'flake',
    cmd: 'inputs.grimoire.url = "github:Slush97/grimoire";',
    href: `${brand.github}#nix--nixos-flake`,
  },
];

const badges = [
  { top: 'MIT', bottom: 'LICENSED', href: `${brand.github}/blob/main/LICENSE`, tone: 'lime' },
  { top: 'NO', bottom: 'TELEMETRY', href: '/docs/privacy', tone: 'red' },
  { top: 'GET IT', bottom: 'ON AUR', href: brand.aur, tone: 'blue' },
  { top: 'JOIN DA', bottom: 'DISCORD', href: brand.discord, tone: 'plum' },
  { top: 'ON', bottom: 'GAMEBANANA', href: brand.gamebanana, tone: 'gold' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark" />
    <title>Grimoire: mod manager for Deadlock</title>
    <link rel="icon" href="/proto/grimoire-mark.svg" type="image/svg+xml" />
  </head>
  <body>
    <svg width="0" height="0" class="defs" aria-hidden="true">
      <symbol id="download" viewBox="0 0 24 24">
        <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </symbol>
    </svg>
    <BrandSprite />

    <div class="page">
      <header class="bar">
        <div class="wrap bar-inner">
          <a class="brand" href="/proto/oss">
            <img src="/proto/grimoire-mark.svg" alt="" width="30" height="27" />
            <span>Grimoire</span>
          </a>
          <nav aria-label="Main">
            <a href="#features">Features</a>
            <a href="#download">Download</a>
            <a href="/docs">Docs</a>
            <a href={brand.discord}>Discord</a>
          </nav>
          <div class="bar-actions">
            <a class="icon-btn" href={brand.github} aria-label="Source on GitHub">
              <svg width="20" height="20" aria-hidden="true"><use href="#i-github" /></svg>
            </a>
            <a class="btn btn-accent" href={dl.primaryHref} data-primary>Download</a>
          </div>
        </div>
      </header>

      <main>
        <section class="hero">
          <div class="wrap hero-grid">
            <div class="hero-copy">
              <h1>Grimoire</h1>
              <p class="lede">
                A free, open-source mod manager for Deadlock. Browse and install mods from
                GameBanana, set load order, and choose which skin each hero wears.
              </p>
              <div class="cta" data-platform="windows">
                <a class="btn btn-accent btn-lg" href={dl.primaryHref}>
                  <svg width="18" height="18" aria-hidden="true"><use href="#i-windows" /></svg>
                  Download for Windows
                </a>
                <a class="btn btn-ghost btn-lg" href="#download">Other platforms</a>
              </div>
              {dmg && (
                <div class="cta" data-platform="macos" hidden>
                  <a class="btn btn-accent btn-lg" href={dmg.browser_download_url}>
                    <svg width="18" height="18" aria-hidden="true"><use href="#i-apple" /></svg>
                    Download for macOS
                  </a>
                  <a class="btn btn-ghost btn-lg" href="#download">Mac requirements</a>
                </div>
              )}
              {dl.linuxAppImage && (
                <div class="cta" data-platform="linux" hidden>
                  <a class="btn btn-accent btn-lg" href={dl.linuxAppImage.browser_download_url}>
                    <svg width="18" height="18" aria-hidden="true"><use href="#i-linux" /></svg>
                    Download for Linux
                  </a>
                  <a class="btn btn-ghost btn-lg" href="#download">Other packages</a>
                </div>
              )}
              <div class="cta" data-platform="other" hidden>
                <a class="btn btn-accent btn-lg" href="#download">See downloads</a>
              </div>
              <script is:inline>
                (() => {
                  // Swap the hero download for the visitor's OS before paint.
                  // Nothing leaves the browser; without JS, Windows stays.
                  const hint = navigator.userAgentData;
                  const p = (hint && hint.platform) || navigator.platform || '';
                  let os = '';
                  if ((hint && hint.mobile) || /Android|iPhone|iPad|iPod|CrOS/.test(navigator.userAgent) || (/Mac/.test(p) && navigator.maxTouchPoints > 1)) os = 'other';
                  else if (/Win/.test(p)) os = 'windows';
                  else if (/Mac/.test(p)) os = 'macos';
                  else if (/Linux|X11/.test(p)) os = 'linux';
                  if (!os) return;
                  document.documentElement.dataset.os = os;
                  const groups = [...document.querySelectorAll('[data-platform]')];
                  const pick = groups.find((g) => g.dataset.platform === os);
                  if (!pick) return;
                  groups.forEach((g) => (g.hidden = g !== pick));
                  const href = pick.querySelector('a').href;
                  document.querySelectorAll('[data-primary]').forEach((a) => (a.href = href));
                })();
              </script>
              <p class="meta">
                {dl.version && <a href={dl.releaseUrl}>v{dl.version} release notes</a>}
                <span>{brand.license} licensed</span>
                <span>No telemetry</span>
              </p>
            </div>
            <div class="hero-shot">
              <div class="ribbon" aria-hidden="true"></div>
              <picture>
                <source media="(max-width: 719px)" srcset="/proto/shots/crop/hero-sm.webp" width="610" height="530" />
                <img
                  src="/proto/shots/crop/hero.webp"
                  alt="The Hero Locker: Deadlock heroes in a grid, each card showing the skin it's wearing"
                  width="1528"
                  height="700"
                  fetchpriority="high"
                />
              </picture>
            </div>
          </div>
        </section>

        <div class="sheet">
          <section id="features" class="features" aria-labelledby="features-h">
            <h2 id="features-h" class="wrap">Features</h2>
            <div class="rows">
              {features.map((f, i) => (
                <article class:list={['wrap', 'row', { flip: i % 2 === 1 }]}>
                  <div class="row-copy">
                    <h3>{f.title}</h3>
                    <p>{f.body}</p>
                    <p class="docs">
                      {f.docs.map((d) => (
                        <a href={d.href}>{d.label} <span aria-hidden="true">→</span></a>
                      ))}
                    </p>
                  </div>
                  <div class="row-shot">
                    <picture>
                      <source media="(max-width: 719px)" srcset={shot(`${f.img}-sm`)} width={f.sm[0]} height={f.sm[1]} />
                      <img src={shot(f.img)} alt={f.alt} width={f.w} height={f.h} loading="lazy" decoding="async" />
                    </picture>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="wrap more" aria-labelledby="more-h">
            <h2 id="more-h">More features</h2>
            <ul>
              {more.map((m) => (
                <li>
                  <a href={m.href}>
                    <strong>{m.title}</strong>
                    <span>{m.body}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section class="wrap open" aria-labelledby="open-h">
            <div>
              <h2 id="open-h">Free and open source</h2>
              <p>
                MIT licensed and built in the open on GitHub. No telemetry: the docs list
                <a href="/docs/privacy">every network request</a> the app can make.
              </p>
              <div class="cta">
                <a class="btn btn-ghost" href={brand.github}>
                  <svg width="18" height="18" aria-hidden="true"><use href="#i-github" /></svg>
                  Slush97/grimoire
                </a>
                <a class="btn btn-ghost" href={brand.discord}>
                  <svg width="18" height="18" aria-hidden="true"><use href="#i-discord" /></svg>
                  Discord
                </a>
              </div>
            </div>
            {stats.length > 0 && (
              <dl class="stats panel">
                {stats.map((s) => (
                  <div>
                    <dt>
                      <svg width="16" height="16" aria-hidden="true"><use href={`#i-${s.icon}`} /></svg>
                      {s.label}
                    </dt>
                    <dd>{s.n}</dd>
                  </div>
                ))}
              </dl>
            )}
          </section>

          <section id="download" class="wrap get" aria-labelledby="get-h">
            <div class="get-head">
              <h2 id="get-h">Download</h2>
              <p class="sub">
                {dl.version && <>Version {dl.version}{dl.releaseDate && `, released ${dl.releaseDate}`}. </>}
                Needs Deadlock installed through Steam.
              </p>
            </div>

            <div class="dl panel">
              {platforms.map((p, i) => (
                <input class="sr-only" type="radio" name="os" id={`os-${p.id}`} checked={i === 0} />
              ))}
              <div class="os-tabs" role="presentation">
                {platforms.map((p) => (
                  <label for={`os-${p.id}`}>
                    <svg aria-hidden="true"><use href={`#i-${p.icon}`} /></svg>
                    {p.name}
                    <span class="yours" aria-hidden="true"></span>
                  </label>
                ))}
              </div>

              <div class="panes">
                {platforms.map((p) => {
                  const [lead, ...alts] = p.files;
                  return (
                    <div class="pane" data-pane={p.id}>
                      <div class="pane-main">
                        <a class="big" href={lead.href}>
                          <svg class="big-ico" aria-hidden="true"><use href="#download" /></svg>
                          <span class="big-txt">
                            <strong>Download {lead.noun}</strong>
                            <span>{lead.name} · {lead.size}</span>
                          </span>
                        </a>
                        {alts.length > 0 && (
                          <>
                            <p class="cap">Also available</p>
                            <ul class="files">
                              {alts.map((f) => (
                                <li>
                                  <a class="file" href={f.href}>
                                    <span class="file-name">{f.label}{f.ext && <code>{f.ext}</code>}</span>
                                    <span class="size">{f.size}</span>
                                    <svg class="dl-ico" aria-hidden="true"><use href="#download" /></svg>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </>
                        )}
                      </div>

                      <div class="pane-side">
                        {p.id === 'windows' && (
                          <dl class="notes">
                            <div>
                              <dt>Installer</dt>
                              <dd>The usual pick.</dd>
                            </div>
                            {dl.windowsPortable && (
                              <div>
                                <dt>Portable</dt>
                                <dd>A single executable, the same app as the installer. No install step.</dd>
                              </div>
                            )}
                            <div>
                              <dt>Requirements</dt>
                              <dd>Deadlock installed through Steam.</dd>
                            </div>
                          </dl>
                        )}
                        {p.id === 'macos' && (
                          <div class="caution">
                            <p class="cap">Experimental</p>
                            <p>
                              Apple Silicon only. Deadlock has no Mac build, so it needs to run in a CrossOver
                              bottle. The app isn't signed, so macOS asks you to confirm the first launch.
                            </p>
                            <a href={`${brand.github}/blob/main/docs/macos.md`}>Setup notes <span aria-hidden="true">→</span></a>
                          </div>
                        )}
                        {p.id === 'linux' && (
                          <div class="pms">
                            <p class="cap">Package managers</p>
                            {pms.map((m) => (
                              <div class="pm">
                                <div class="pm-head">
                                  <svg aria-hidden="true"><use href={`#i-${m.icon}`} /></svg>
                                  <a href={m.href}>{m.name}</a>
                                  <span class="pm-via">{m.via}</span>
                                  <button class="copy" type="button" data-copy={m.cmd} hidden>Copy</button>
                                </div>
                                <pre><code>{m.cmd.split('\n').map((l) => <span>{l}</span>)}</code></pre>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
            <script is:inline>
              (() => {
                const os = document.documentElement.dataset.os;
                const radio = os && document.getElementById('os-' + os);
                if (radio) radio.checked = true;
                document.querySelectorAll('.copy').forEach((b) => {
                  b.hidden = false;
                  b.addEventListener('click', () => {
                    navigator.clipboard.writeText(b.dataset.copy).then(() => {
                      b.textContent = 'Copied';
                      b.classList.add('done');
                      setTimeout(() => {
                        b.textContent = 'Copy';
                        b.classList.remove('done');
                      }, 1600);
                    });
                  });
                });
              })();
            </script>

            <p class="get-links">
              <a href={dl.releaseUrl}>Release notes</a>
              {dl.sha256Sums && <a href={dl.sha256Sums.browser_download_url}>SHA256SUMS</a>}
              <a href={`${brand.github}/releases`}>All releases</a>
              <a href="/download">Install guide</a>
            </p>
          </section>
        </div>
      </main>

      <footer class="foot">
        <div class="badges">
          {badges.map((b) => (
            <a class={`b88 b88-${b.tone}`} href={b.href}>
              <span>{b.top}</span>
              <strong>{b.bottom}</strong>
            </a>
          ))}
        </div>
        <nav class="foot-links" aria-label="Footer">
          <a href={brand.github}>GitHub</a>
          <a href={brand.discord}>Discord</a>
          <a href={brand.gamebanana}>GameBanana</a>
          <a href="/docs">Docs</a>
          <a href="/">The 1996 version</a>
        </nav>
        <p class="fine">
          Best viewed with any browser. Not affiliated with Valve.
          <EasterEgg size={12} label="A small egg" />
        </p>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(:root) {
    --bg: #0e0e11;
    --sheet: #141418;
    --surface: #1b1b20;
    --surface-hi: #24242a;
    --line: #26262c;
    --line-strong: #313139;
    --text: #f4f4f5;
    --body: #c9c9cf;
    --muted: #a1a1aa;
    --dim: #74747d;
    --accent: #7c3aed;
    --accent-hover: #6d28d9;
    --accent-soft: #a78bfa;
    color-scheme: dark;
  }
  :global(html) {
    background: var(--bg);
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
  }
  :global(body) {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 17px/1.65 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(*, *::before, *::after) {
    box-sizing: border-box;
  }
  :global(::selection) {
    background: rgba(124, 58, 237, 0.45);
    color: #fff;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  a {
    color: var(--accent-soft);
    text-decoration: none;
    transition: color 0.15s;
  }
  a:hover {
    color: var(--text);
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent-soft);
    outline-offset: 3px;
    border-radius: 4px;
  }
  code,
  pre {
    font: 0.85em/1.5 'JetBrains Mono', ui-monospace, monospace;
    color: var(--body);
  }
  h2 {
    margin: 0;
    font-size: 36px;
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: -0.025em;
  }
  h3 {
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .defs {
    position: absolute;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .wrap {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 24px;
  }
  .panel {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }
  .page {
    overflow-x: clip;
  }

  /* ─── Bar ─── */
  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar-inner {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font: 600 25px/1 'Cormorant Garamond', Georgia, serif;
  }
  .brand:hover {
    color: var(--text);
  }
  .bar nav {
    display: flex;
    gap: 28px;
    font-size: 15px;
  }
  .bar nav a {
    color: var(--muted);
  }
  .bar nav a:hover {
    color: var(--text);
  }
  .bar-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--muted);
  }
  .icon-btn:hover {
    color: var(--text);
    background: var(--surface-hi);
  }
  .icon-btn svg,
  .btn svg {
    flex: none;
    fill: currentColor;
  }

  /* ─── Buttons ─── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 0.15s;
  }
  .btn-accent,
  .big {
    color: #fff;
    background: var(--accent);
  }
  .btn-accent:hover,
  .big:hover {
    color: #fff;
    background: var(--accent-hover);
  }
  .btn-ghost {
    color: var(--text);

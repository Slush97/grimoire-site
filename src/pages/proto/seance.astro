  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

  /* Summoning circle: a few rings, an inscription, sigils and a heptagram,
     drawn live on one canvas. Light enough to redraw at ~45fps. */
  const hero = document.querySelector<HTMLElement>('.hero');
  const canvas = document.querySelector<HTMLCanvasElement>('.circle');
  if (hero && canvas) {
    const ctx = canvas.getContext('2d')!;
    const TAU = Math.PI * 2;
    const WORDS = ['BROWSE', 'INSTALL', 'LOCKER', 'PROFILES', 'CONFLICTS', 'AUTOEXEC', 'LAUNCH MODDED', 'LAUNCH VANILLA'];
    let R = 0;
    let dpr = 1;
    let fontPx = 16;
    let glyphRun: { c: string; w: number }[] = [];
    let runScale = 1;
    let t0 = performance.now();
    let last = 0;
    let running = false;
    let visible = true;
    let raf = 0;

    const motes = Array.from({ length: 34 }, () => ({
      a: Math.random() * TAU,
      r: 0.62 + Math.random() * 0.36,
      s: (0.02 + Math.random() * 0.05) * (Math.random() < 0.5 ? -1 : 1),
      z: Math.random(),
      ph: Math.random() * TAU,
    }));

    const clamp = (v: number) => Math.max(0, Math.min(1, v));
    const ease = (v: number) => 1 - Math.pow(1 - v, 3);
    const soul = (a: number) => `rgba(111,247,210,${a})`;
    const violet = (a: number) => `rgba(157,116,255,${a})`;

    function layout() {
      const w = canvas!.clientWidth;
      if (!w) return;
      dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      canvas!.width = Math.round(w * dpr);
      canvas!.height = canvas!.width;
      R = w / 2;
      fontPx = Math.max(9, R * 0.031);
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.font = `600 ${fontPx}px Cinzel, serif`;
      const track = fontPx * 0.5;
      const unit: { c: string; w: number }[] = [];
      for (const word of WORDS) {
        for (const c of word) unit.push({ c, w: ctx.measureText(c).width + track });
        unit.push({ c: '*', w: fontPx * 2.2 });
      }
      const unitW = unit.reduce((s, x) => s + x.w, 0);
      const circ = TAU * R * 0.853;
      const reps = Math.max(1, Math.floor(circ / unitW));
      glyphRun = Array.from({ length: reps }, () => unit).flat();
      runScale = circ / (unitW * reps);
    }

    function ring(r: number, p: number, a: number, dash?: number[]) {
      if (p <= 0) return;
      const start = -Math.PI / 2;
      ctx.setLineDash(dash ?? []);
      ctx.beginPath();
      ctx.arc(0, 0, r, start, start + p * TAU);
      ctx.strokeStyle = soul(a * 0.22);
      ctx.lineWidth = 5;
      ctx.stroke();
      ctx.strokeStyle = soul(a);
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.setLineDash([]);
    }

    function ticks(r: number, rot: number, p: number) {
      const n = 144;
      ctx.beginPath();
      for (let i = 0; i < n; i++) {
        if (i / n > p) break;
        const a = rot + (i / n) * TAU;
        const len = i % 12 === 0 ? R * 0.03 : i % 3 === 0 ? R * 0.016 : R * 0.008;
        const c = Math.cos(a);
        const s = Math.sin(a);
        ctx.moveTo(c * r, s * r);
        ctx.lineTo(c * (r - len), s * (r - len));
      }
      ctx.strokeStyle = soul(0.4);
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    function inscription(r: number, rot: number, p: number) {
      ctx.font = `600 ${fontPx}px Cinzel, serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      let acc = 0;
      const total = glyphRun.reduce((s, x) => s + x.w, 0);
      for (const g of glyphRun) {
        if (acc / total > p) break;
        const a = rot + ((acc + g.w / 2) * runScale) / r;
        acc += g.w;
        ctx.save();
        ctx.rotate(a);
        ctx.translate(0, -r);
        if (g.c === '*') {
          const d = fontPx * 0.32;
          ctx.beginPath();
          ctx.moveTo(0, -d);
          ctx.lineTo(d, 0);
          ctx.lineTo(0, d);
          ctx.lineTo(-d, 0);
          ctx.closePath();
          ctx.fillStyle = violet(0.85);
          ctx.fill();
        } else {
          ctx.fillStyle = soul(0.78);
          ctx.fillText(g.c, 0, 0);
        }
        ctx.restore();
      }
    }

    function sigil(k: number, s: number) {
      ctx.beginPath();
      switch (k % 6) {
        case 0:
          ctx.arc(0, 0, s * 0.5, 0, TAU);
          ctx.moveTo(0, -s * 0.85);
          ctx.lineTo(0, s * 0.85);
          break;
        case 1:
          ctx.moveTo(0, -s * 0.7);
          ctx.lineTo(s * 0.65, s * 0.5);
          ctx.lineTo(-s * 0.65, s * 0.5);
          ctx.closePath();
          ctx.moveTo(-s * 0.8, s * 0.05);
          ctx.lineTo(s * 0.8, s * 0.05);
          break;
        case 2:
          ctx.arc(0, 0, s * 0.6, Math.PI * 0.3, Math.PI * 1.7);
          ctx.arc(s * 0.25, 0, s * 0.45, Math.PI * 1.55, Math.PI * 0.45, true);
          break;
        case 3:
          ctx.moveTo(0, -s * 0.75);
          ctx.lineTo(s * 0.55, 0);
          ctx.lineTo(0, s * 0.75);
          ctx.lineTo(-s * 0.55, 0);
          ctx.closePath();
          ctx.moveTo(s * 0.12, 0);
          ctx.arc(0, 0, s * 0.12, 0, TAU);
          break;
        case 4:
          ctx.arc(0, -s * 0.4, s * 0.3, 0, TAU);
          ctx.moveTo(0, -s * 0.1);
          ctx.lineTo(0, s * 0.8);
          ctx.moveTo(-s * 0.4, s * 0.3);
          ctx.lineTo(s * 0.4, s * 0.3);
          break;
        default:
          ctx.arc(-s * 0.25, 0, s * 0.4, 0, TAU);
          ctx.moveTo(s * 0.65, 0);
          ctx.arc(s * 0.25, 0, s * 0.4, 0, TAU);
      }
      ctx.stroke();
    }

    function sigils(r: number, rot: number, p: number) {
      const n = 14;
      const s = R * 0.034;
      for (let i = 0; i < n; i++) {
        const local = clamp(p * n - i);
        if (local <= 0) break;
        const a = rot + (i / n) * TAU;
        ctx.save();
        ctx.rotate(a);
        ctx.translate(0, -r);
        ctx.globalAlpha = local;
        ctx.beginPath();
        ctx.arc(0, 0, s * 1.45, 0, TAU);
        ctx.fillStyle = 'rgba(5,9,9,0.9)';
        ctx.fill();
        ctx.strokeStyle = soul(0.35);
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.strokeStyle = i % 2 ? violet(0.95) : soul(0.9);
        ctx.lineWidth = 1.3;
        sigil(i, s);
        ctx.restore();
      }
      ctx.globalAlpha = 1;
    }

    function star(r: number, rot: number, p: number, n: number, k: number, a: number) {
      if (p <= 0) return;
      const pts: [number, number][] = [];
      for (let i = 0; i <= n; i++) {
        const idx = (i * k) % n;
        const ang = rot + (idx / n) * TAU - Math.PI / 2;
        pts.push([Math.cos(ang) * r, Math.sin(ang) * r]);
      }
      const segs = p * n;
      ctx.beginPath();
      ctx.moveTo(pts[0][0], pts[0][1]);
      for (let i = 1; i <= n; i++) {
        const f = clamp(segs - (i - 1));
        if (f <= 0) break;
        const [x0, y0] = pts[i - 1];
        const [x1, y1] = pts[i];
        ctx.lineTo(x0 + (x1 - x0) * f, y0 + (y1 - y0) * f);
      }
      ctx.strokeStyle = soul(a * 0.25);
      ctx.lineWidth = 4;
      ctx.stroke();
      ctx.strokeStyle = soul(a);
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    function draw(now: number) {
      const t = (now - t0) / 1000;
      const P = (i: number) => (reduce ? 1 : ease(clamp((t - 0.2 - i * 0.18) / 1.4)));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, R * 2, R * 2);
      ctx.translate(R, R);

      const breathe = reduce ? 0.5 : 0.5 + 0.5 * Math.sin(t * 0.8);
      const ignite = P(0);
      const g = ctx.createRadialGradient(0, 0, 0, 0, 0, R * 0.7);
      g.addColorStop(0, soul((0.2 + 0.08 * breathe) * ignite));
      g.addColorStop(0.5, `rgba(70,190,165,${(0.07 + 0.03 * breathe) * ignite})`);
      g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(0, 0, R * 0.7, 0, TAU);
      ctx.fill();

      const spin = reduce ? 0 : t;
      ring(R * 0.985, P(0), 0.18);
      ticks(R * 0.955, spin * 0.018, P(0));
      ring(R * 0.9, P(1), 0.3);
      ring(R * 0.806, P(1), 0.3);
      inscription(R * 0.853, -spin * 0.024, P(1));
      sigils(R * 0.735, spin * 0.04, P(2));
      ring(R * 0.68, P(2), 0.16, [2, 7]);
      star(R * 0.64, -spin * 0.012, P(3), 7, 3, 0.32);
      star(R * 0.64, spin * 0.009, P(3), 7, 2, 0.14);
      ring(R * 0.64, P(3), 0.22);

      if (!reduce) {
        for (const m of motes) {
          const a = m.a + t * m.s;
          const r = R * (m.r + Math.sin(t * 0.6 + m.ph) * 0.02);
          const alpha = (0.25 + 0.45 * m.z) * (0.6 + 0.4 * Math.sin(t * 1.3 + m.ph)) * ignite;
          ctx.beginPath();
          ctx.arc(Math.cos(a) * r, Math.sin(a) * r, 0.8 + m.z * 1.6, 0, TAU);
          ctx.fillStyle = m.z > 0.7 ? violet(alpha) : soul(alpha);
          ctx.fill();
        }
      }
    }

    function loop() {
      raf = requestAnimationFrame(loop);
      const now = performance.now();
      if (now - last < 22) return;
      last = now;
      draw(now);
    }
    function sync() {
      const should = visible && !document.hidden && !reduce;
      if (should && !running) {
        running = true;
        raf = requestAnimationFrame(loop);
      } else if (!should && running) {
        running = false;
        cancelAnimationFrame(raf);
      }
    }

    const start = () => {
      layout();
      t0 = performance.now();
      if (reduce) draw(t0);
      sync();
      /* Throttled tabs and slow devices may skip frames; land the settled frame anyway. */
      setTimeout(() => { console.log('DBGsettle', R, canvas!.width); draw(performance.now()); }, 2600);
    };
    Promise.race([document.fonts.load(`600 20px Cinzel`), new Promise((r) => setTimeout(r, 900))]).finally(start);

    new ResizeObserver(() => {
      layout();
      draw(performance.now());
    }).observe(canvas);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      sync();
    }).observe(hero);
    document.addEventListener('visibilitychange', sync);
  }

  /* Window tilt and the planchette, desktop pointers only. */
  if (hero && finePointer && !reduce) {
    const win = hero.querySelector<HTMLElement>('.window');
    const pl = hero.querySelector<HTMLElement>('.planchette');
    let tx = 0;
    let ty = 0;
    let px = 0;
    let py = 0;
    let ang = 0;
    let active = false;
    let raf = 0;

    const step = () => {
      const dx = tx - px;
      const dy = ty - py;
      px += dx * 0.08;
      py += dy * 0.08;
      const target = Math.max(-22, Math.min(22, dx * 0.35));
      ang += (target - ang) * 0.08;
      if (pl) pl.style.transform = `translate(${px}px, ${py}px) rotate(${ang}deg)`;
      if (Math.abs(dx) + Math.abs(dy) > 0.3 || Math.abs(target - ang) > 0.2) raf = requestAnimationFrame(step);
      else raf = 0;
    };

    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      if (win) {
        win.style.setProperty('--ry', `${(x * 9).toFixed(2)}deg`);
        win.style.setProperty('--rx', `${(-y * 7).toFixed(2)}deg`);
        win.style.setProperty('--sx', `${(45 + x * 60).toFixed(1)}%`);
      }
      tx = e.clientX - r.left + 18;
      ty = e.clientY - r.top + 22;
      if (!active) {
        active = true;
        px = tx;
        py = ty;
        pl?.classList.add('on');
      }
      if (!raf) raf = requestAnimationFrame(step);
    });
    hero.addEventListener('pointerleave', () => {
      active = false;
      pl?.classList.remove('on');
      if (win) {
        win.style.setProperty('--ry', '0deg');
        win.style.setProperty('--rx', '0deg');
      }
    });
  }

  /* Spotlight borders on the cards. */
  document.querySelectorAll<HTMLElement>('.bento, .community').forEach((grid) => {
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
    grid.addEventListener('pointermove', (e) => {
      for (const c of cards) {
        const r = c.getBoundingClientRect();
        c.style.setProperty('--mx', `${e.clientX - r.left}px`);
        c.style.setProperty('--my', `${e.clientY - r.top}px`);
      }
    });
    grid.addEventListener('pointerleave', () => {
      for (const c of cards) {
        c.style.setProperty('--mx', '-999px');
        c.style.setProperty('--my', '-999px');
      }
    });
  });

  /* Platform tabs. */
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    }
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      const next = tabs[(i + dir + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });

  /* Copy buttons. */
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const pre = document.getElementById(btn.dataset.copy ?? '');
      if (!pre) return;
      const text = [...pre.querySelectorAll('.ln')].map((l) => l.textContent ?? '').join('\n');
      const flash = (label: string) => {
        btn.textContent = label;
        btn.dataset.state = 'done';
        setTimeout(() => {
          btn.textContent = 'Copy';
          delete btn.dataset.state;
        }, 1600);
      };
      try {
        await navigator.clipboard.writeText(text);
        flash('Copied');
      } catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        flash('Selected');
      }
    });
  });

  /* Webring random. */
  const rnd = document.querySelector<HTMLAnchorElement>('[data-ring-random]');
  rnd?.addEventListener('click', (e) => {
    const list = JSON.parse(rnd.dataset.ringRandom ?? '[]') as string[];
    if (!list.length) return;
    e.preventDefault();
    location.assign(list[Math.floor(Math.random() * list.length)]);
  });
</script>

---
import '../../styles/fonts.css';
import EasterEgg from '../../components/proto/EasterEgg.astro';
import { brand, getDownloadUrls, getReach, fmtBytes } from '../../data/content';

const dl = await getDownloadUrls();
const reach = await getReach();
const nf = new Intl.NumberFormat('en-US');

const reachParts = [
  reach.githubInstalls !== null ? { n: nf.format(reach.githubInstalls), label: 'downloads from GitHub' } : null,
  reach.gamebananaDownloads !== null ? { n: nf.format(reach.gamebananaDownloads), label: 'from GameBanana' } : null,
  reach.aptInstalls !== null ? { n: nf.format(reach.aptInstalls), label: 'apt installs' } : null,
].filter((p): p is { n: string; label: string } => p !== null);

const win = dl.windowsInstaller;
const winHref = win?.browser_download_url ?? dl.primaryHref;
const version = dl.version ? `v${dl.version}` : 'Latest';
const winMeta = [version, win ? fmtBytes(win.size) : null, 'Installer'].filter(Boolean).join(' · ');

const APT = [
  'sudo install -d -m 0755 /etc/apt/keyrings',
  'curl -fsSL https://apt.grimoiremods.com/grimoire.gpg | sudo tee /etc/apt/keyrings/grimoire.gpg >/dev/null',
  'echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/grimoire.gpg] https://apt.grimoiremods.com stable main" | sudo tee /etc/apt/sources.list.d/grimoire.list >/dev/null',
  'sudo apt update && sudo apt install grimoire',
];
const AUR = ['yay -S grimoire-bin'];
const NIX = [
  '# flake.nix',
  'inputs.grimoire.url = "github:Slush97/grimoire";',
  '',
  'nixpkgs.overlays = [ inputs.grimoire.overlays.default ];',
  'environment.systemPackages = [ pkgs.grimoire ];',
];

const ringPages = JSON.stringify(['/download', '/docs', '/tools', brand.github, brand.gamebanana]);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#050909" />
    <title>Grimoire · Séance</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23050909' stroke='%236ff7d2' stroke-width='2'/%3E%3Cpath d='M16 7 L23 21 H9 Z' fill='none' stroke='%236ff7d2' stroke-width='2'/%3E%3Ccircle cx='16' cy='17' r='2.4' fill='%238b5cf6'/%3E%3C/svg%3E" />
    <link rel="preload" href="/fonts/proto/syne-400-800-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/proto/geist-300-700-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/proto/shots/locker.webp" as="image" />
  </head>
  <body>
    <a class="skip" href="#features">Skip to features</a>

    <header class="nav">
      <div class="nav-in wrap">
        <a class="brand" href="#top" aria-label="Grimoire home">
          <svg class="seal" viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="14" />
            <circle cx="16" cy="16" r="10.5" class="seal-dash" />
            <path d="M16 6.5 L24.2 21.5 H7.8 Z" />
            <circle cx="16" cy="17" r="2.6" class="seal-eye" />
          </svg>
          <span>Grimoire</span>
        </a>
        <nav class="nav-links" aria-label="Sections">
          <a href="#features">Features</a>
          <a href="#install">Install</a>
          <a href="/docs">Docs</a>
          <a href={brand.github}>GitHub</a>
        </nav>
        <a class="btn btn-cta btn-sm" href={winHref}>Download</a>
      </div>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="planchette" aria-hidden="true">
          <svg viewBox="0 0 80 92">
            <path d="M40 4 C58 4 76 22 76 46 C76 66 62 84 40 88 C18 84 4 66 4 46 C4 22 22 4 40 4 Z" />
            <circle cx="40" cy="38" r="13" class="lens" />
            <circle cx="40" cy="38" r="17" class="lens-ring" />
            <circle cx="22" cy="74" r="2" /><circle cx="58" cy="74" r="2" /><circle cx="40" cy="82" r="2" />
          </svg>
        </div>

        <div class="hero-in wrap">
          <div class="hero-copy">
            <a class="pill" href={dl.releaseUrl}>
              <span class="pulse" aria-hidden="true"></span>
              <span>{version} is out{dl.releaseDate ? ` · ${dl.releaseDate}` : ''}</span>
              <span class="pill-go">Release notes <span aria-hidden="true">→</span></span>
            </a>

            <h1 id="hero-title">Deadlock mods, <em>summoned</em> in one click.</h1>

            <p class="lede">
              Grimoire is a free, open-source mod manager for Deadlock. Browse GameBanana from inside the app,
              install with one click, pick a skin for every hero, and launch modded or vanilla from the same window.
            </p>

            <div class="cta-row">
              <a class="btn btn-cta btn-lg" href={winHref}>
                <svg class="win-ico" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M0 2.2 6.5 1.3v6.2H0zM7.3 1.2 16 0v7.5H7.3zM0 8.3h6.5v6.3L0 13.7zM7.3 8.3H16V16l-8.7-1.2z" />
                </svg>
                <span class="btn-stack">
                  <span>Download for Windows</span>
                  <small>{winMeta}</small>
                </span>
              </a>
              <a class="btn btn-ghost btn-lg" href="/download">Linux, Nix and more</a>
            </div>

            <ul class="trust-chips" aria-label="Project facts">
              <li><span class="chip-ico" aria-hidden="true">§</span>MIT licensed</li>
              <li><span class="chip-ico" aria-hidden="true">⊘</span>No telemetry</li>
              <li><span class="chip-ico" aria-hidden="true">◐</span>Works offline</li>
              <li><a href={brand.github}>Source on GitHub <span aria-hidden="true">↗</span></a></li>
            </ul>

            {reachParts.length > 0 && (
              <p class="reach">
                {reachParts.map((p, i) => (
                  <span class="reach-item">
                    {i > 0 && <span class="reach-sep" aria-hidden="true">·</span>}
                    <b>{p.n}</b> {p.label}
                  </span>
                ))}
              </p>
            )}
          </div>

          <div class="stage">
            <canvas class="circle" width="1" height="1" aria-hidden="true"></canvas>
            <figure class="window">
              <div class="titlebar" aria-hidden="true">
                <span class="tb-name">Grimoire</span>
                <span class="tb-ctl"><i class="tb-min"></i><i class="tb-max"></i><i class="tb-x"></i></span>
              </div>
              <img
                src="/proto/shots/locker.webp"
                width="1528"
                height="924"
                alt="Grimoire's Locker: a gallery of Deadlock heroes, each card showing how many skins are installed for that hero."
                fetchpriority="high"
              />
              <span class="sheen" aria-hidden="true"></span>
            </figure>
          </div>
        </div>
      </section>

      <div class="chain wrap" aria-hidden="true"><span class="chain-node"></span></div>

      <section class="section" id="features" aria-labelledby="features-title">
        <div class="wrap">
          <header class="sec-head">
            <p class="label">What it does</p>
            <h2 id="features-title">One window for the whole <em>ritual</em>.</h2>
            <p class="sec-lede">Find mods, sort them, dress your heroes and launch. Your library lives on your machine.</p>
          </header>

          <div class="bento">
            <article class="card c-locker">
              <div class="card-text">
                <p class="card-k">Locker</p>
                <h3>Every hero in one gallery</h3>
                <p>Pick the skin each hero wears and star your favorites. Can't decide? Turn on Shuffle on launch and let it pick.</p>
              </div>
              <div class="shot shot-big">
                <img src="/proto/shots/locker-alt.webp" width="1528" height="924" loading="lazy" alt="Locker gallery with hero cards, favorite stars and the Shuffle on launch toggle." />
              </div>
            </article>

            <article class="card c-browse">
              <div class="card-text">
                <p class="card-k">Browse</p>
                <h3>GameBanana, inside the app</h3>
                <p>Sort by popularity, filter by type, and switch between mods, sounds and WiPs.</p>
              </div>
              <div class="shot">
                <img src="/proto/shots/browse.webp" width="1528" height="924" loading="lazy" alt="Browse view listing GameBanana mods with like and view counts and Install buttons." style="object-position: 30% 0%" />
              </div>
            </article>

            <article class="card c-variants">
              <div class="card-text">
                <p class="card-k">Variants</p>
                <h3>Pick the exact file</h3>
                <p>Mods with several files list each one with its size and download count.</p>
              </div>
              <div class="shot">
                <img src="/proto/shots/browse-detail.webp" width="1528" height="924" loading="lazy" alt="A mod window listing four color variants, each with its own Install button." style="object-position: 88% 14%" />
              </div>
            </article>

            <article class="card c-cursors">
              <div class="card-text">
                <p class="card-k">Cursors</p>
                <h3>Swap the cursor</h3>
                <p>Install cursor mods from the General tab, or import your own.</p>
              </div>
              <div class="shot">
                <img src="/proto/shots/cursors.webp" width="1528" height="924" loading="lazy" alt="Cursor mods in the Locker's General tab, with one set marked Active." style="object-position: 62% 8%" />
              </div>
            </article>

            <article class="card c-installed">
              <div class="card-text">
                <p class="card-k">Library</p>
                <h3>A load order you can see</h3>
                <p>Enable, disable, reorder and bulk-select. Conflict detection flags mods that overwrite the same game files.</p>
              </div>
              <div class="shot">
                <img src="/proto/shots/installed.webp" width="1528" height="924" loading="lazy" alt="Installed mods in numbered load order, each with an on and off toggle." style="object-position: 40% 6%" />
              </div>
            </article>

            <article class="card c-profiles">
              <div class="card-text">
                <p class="card-k">Profiles</p>
                <h3>Save a loadout</h3>
                <p>Swap whole mod sets in one click. Share one as a short <code>mp1:</code> code or a <code>.modprofile.json</code> file.</p>
              </div>
              <div class="mock-code" aria-hidden="true">
                <span class="mc-pre">mp1:</span>
                <span class="mc-sig">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="6" /><path d="M12 3v18" /></svg>
                  <svg viewBox="0 0 24 24"><path d="M12 4 20 19H4Z" /><path d="M3 13h18" /></svg>
                  <svg viewBox="0 0 24 24"><path d="M15 4a8 8 0 1 0 0 16a6 6 0 1 1 0-16Z" /></svg>
                  <svg viewBox="0 0 24 24"><path d="M12 3 20 12 12 21 4 12Z" /><circle cx="12" cy="12" r="1.6" /></svg>
                  <svg viewBox="0 0 24 24"><circle cx="9" cy="12" r="5" /><circle cx="15" cy="12" r="5" /></svg>
                </span>
                <span class="mc-copy">Copy</span>
              </div>
            </article>

            <article class="card c-launch">
              <div class="card-text">
                <p class="card-k">Play</p>
                <h3>Modded or vanilla</h3>
                <p>Launch Vanilla stashes your mods and puts them back once the game starts.</p>
              </div>
              <div class="mock-launch" aria-hidden="true">
                <span class="ml ml-on"><svg viewBox="0 0 24 24"><path d="m5 19 9-9M14 5l1 2 2 1-2 1-1 2-1-2-2-1 2-1zM19 11l.6 1.4L21 13l-1.4.6L19 15l-.6-1.4L17 13l1.4-.6z" /></svg>Launch Modded</span>
                <span class="ml"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>Launch Vanilla</span>
              </div>
            </article>

            <article class="card c-detail">
              <div class="card-text">
                <p class="card-k">Per hero</p>
                <h3>Skins, sounds, cards, effects</h3>
                <p>Each hero gets a page with every skin you own and the variants inside them.</p>
              </div>
              <div class="shot">
                <img src="/proto/shots/locker-hero.webp" width="1528" height="924" loading="lazy" alt="A hero page in the Locker with Skins, Sounds, Cards and Effects tabs and a grid of installed skins." style="object-position: 26% 8%" />
              </div>
            </article>

            <article class="card c-recolor">
              <div class="card-text">
                <p class="card-k">Recolor</p>
                <h3>Repaint abilities</h3>
                <p>Shift a hero's ability VFX to a solid color, a gradient or a rainbow.</p>
              </div>
              <div class="shot">
                <img src="/proto/shots/recolor-old.webp" width="1442" height="826" loading="lazy" alt="Ability color editor with hue, saturation and brightness sliders and color swatches." style="object-position: 16% 46%" />
              </div>
            </article>

            <article class="card c-more">
              <div class="card-text">
                <p class="card-k">Also in the box</p>
                <h3>The rest of the toolkit</h3>
              </div>
              <ul class="more-list">
                <li><b>Autoexec</b> Console commands that run at every launch.</li>
                <li><b>Merge</b> Fold several mods into one VPK, and pull sources back out.</li>
                <li><b>Collections</b> Import a GameBanana collection by URL.</li>
                <li><b>Archives</b> ZIP, 7Z and RAR extract on their own.</li>
                <li><b>Stats</b> MMR, match history and hero stats from deadlock-api.com. Opt in under Settings.</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <div class="chain wrap" aria-hidden="true"><span class="chain-node"></span></div>

      <section class="section" id="how" aria-labelledby="how-title">
        <div class="wrap">
          <header class="sec-head">
            <p class="label">How it works</p>
            <h2 id="how-title">Three steps. No <em>folder</em> digging.</h2>
          </header>

          <ol class="steps">
            <li class="step">
              <span class="step-n" aria-hidden="true">I</span>
              <div class="step-mock" aria-hidden="true">
                <span class="sm-search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6" /><path d="m20 20-4.5-4.5" /></svg>Holliday remodel<i class="caret"></i></span>
              </div>
              <h3>Find it</h3>
              <p>Search GameBanana inside Grimoire, or press the 1-Click Install button on the GameBanana site and Grimoire picks it up.</p>
            </li>
            <li class="step">
              <span class="step-n" aria-hidden="true">II</span>
              <div class="step-mock" aria-hidden="true">
                <span class="sm-install"><span class="sm-bar"><i></i></span><span class="sm-btn"><svg viewBox="0 0 24 24"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" /></svg>Install</span></span>
              </div>
              <h3>Install it</h3>
              <p>Grimoire downloads the file, unpacks ZIP, 7Z or RAR archives, and adds the mod to your load order.</p>
            </li>
            <li class="step">
              <span class="step-n" aria-hidden="true">III</span>
              <div class="step-mock" aria-hidden="true">
                <span class="ml ml-on"><svg viewBox="0 0 24 24"><path d="m5 19 9-9M14 5l1 2 2 1-2 1-1 2-1-2-2-1 2-1z" /></svg>Launch Modded</span>
              </div>
              <h3>Launch modded</h3>
              <p>Hit Launch Modded in the sidebar. Want a clean match? Launch Vanilla.</p>
            </li>
          </ol>
        </div>
      </section>

      <div class="chain wrap" aria-hidden="true"><span class="chain-node"></span></div>

      <section class="section section-install" id="install" aria-labelledby="install-title">
        <div class="wrap install">
          <header class="sec-head">
            <p class="label">Install</p>
            <h2 id="install-title">Pick your platform.</h2>
            <p class="sec-lede">Grimoire needs Deadlock installed through Steam. Everything else is on this card.</p>
          </header>

          <div class="term">
            <div class="tabs" role="tablist" aria-label="Platform">
              <button type="button" role="tab" id="tab-win" aria-controls="panel-win" aria-selected="true">Windows</button>
              <button type="button" role="tab" id="tab-apt" aria-controls="panel-apt" aria-selected="false" tabindex="-1">Debian / Ubuntu</button>
              <button type="button" role="tab" id="tab-aur" aria-controls="panel-aur" aria-selected="false" tabindex="-1">Arch</button>
              <button type="button" role="tab" id="tab-nix" aria-controls="panel-nix" aria-selected="false" tabindex="-1">Nix</button>
            </div>

            <div class="panel" role="tabpanel" id="panel-win" aria-labelledby="tab-win">
              <div class="win-panel">
                <div>
                  <p class="file">{win?.name ?? 'Grimoire-Setup.exe'}</p>
                  <p class="file-meta">{[version, win ? fmtBytes(win.size) : null, dl.releaseDate].filter(Boolean).join(' · ')}</p>
                  <ul class="file-links">
                    {dl.windowsPortable && (
                      <li><a href={dl.windowsPortable.browser_download_url}>Portable build · {fmtBytes(dl.windowsPortable.size)}</a></li>
                    )}
                    {dl.sha256Sums && <li><a href={dl.sha256Sums.browser_download_url}>SHA256SUMS</a></li>}
                    <li><a href={dl.releaseUrl}>Release notes</a></li>
                  </ul>
                </div>
                <a class="btn btn-cta btn-lg" href={winHref}>
                  <svg class="win-ico" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M0 2.2 6.5 1.3v6.2H0zM7.3 1.2 16 0v7.5H7.3zM0 8.3h6.5v6.3L0 13.7zM7.3 8.3H16V16l-8.7-1.2z" />
                  </svg>
                  Download installer
                </a>
              </div>
            </div>

            <div class="panel" role="tabpanel" id="panel-apt" aria-labelledby="tab-apt" hidden>
              <div class="code-wrap">
                <pre id="code-apt" class="code shell">{APT.map((l) => <span class="ln">{l}</span>)}</pre>
                <button type="button" class="copy" data-copy="code-apt">Copy</button>
              </div>
              <p class="panel-note">
                Afterwards <code>sudo apt upgrade</code> keeps it current.
                {dl.linuxAppImage && (
                  <> Other distro? Grab the <a href={dl.linuxAppImage.browser_download_url}>AppImage</a> ({fmtBytes(dl.linuxAppImage.size)}).</>
                )}
              </p>
            </div>

            <div class="panel" role="tabpanel" id="panel-aur" aria-labelledby="tab-aur" hidden>
              <div class="code-wrap">
                <pre id="code-aur" class="code shell">{AUR.map((l) => <span class="ln">{l}</span>)}</pre>
                <button type="button" class="copy" data-copy="code-aur">Copy</button>
              </div>
              <p class="panel-note">Pre-built binary package. <a href={brand.aur}>grimoire-bin on the AUR</a>.</p>
            </div>

            <div class="panel" role="tabpanel" id="panel-nix" aria-labelledby="tab-nix" hidden>
              <div class="code-wrap">
                <pre id="code-nix" class="code">{NIX.map((l) => <span class="ln">{l}</span>)}</pre>
                <button type="button" class="copy" data-copy="code-nix">Copy</button>
              </div>
              <p class="panel-note">Built from source through the repo's flake. Updates come through the flake, not the in-app updater.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section trust" id="trust" aria-labelledby="trust-title">
        <div class="wrap">
          <header class="sec-head">
            <p class="label">Trust</p>
            <h2 id="trust-title">Nothing <em>phones home</em>.</h2>
            <p class="sec-lede">A mod manager touches your game files. Here is what this one does and does not do.</p>
          </header>
          <dl class="trust-grid">
            <div>
              <dt><span class="t-ico" aria-hidden="true">§</span>MIT licensed</dt>
              <dd>All of the source is on GitHub. Read it, build it, fork it.</dd>
            </div>
            <div>
              <dt><span class="t-ico" aria-hidden="true">⊘</span>No telemetry</dt>
              <dd>No usage tracking, no analytics, no heartbeat. A fresh install phones home for nothing.</dd>
            </div>
            <div>
              <dt><span class="t-ico" aria-hidden="true">◐</span>Offline-first</dt>
              <dd>Your library and an offline mod catalog with full-text search live on your machine.</dd>
            </div>
            <div>
              <dt><span class="t-ico" aria-hidden="true">✓</span>Built in public</dt>
              <dd>Every change runs through public CI on GitHub Actions. Issues and the changelog are open too.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="section" id="community" aria-labelledby="community-title">
        <div class="wrap">
          <header class="sec-head">
            <p class="label">Help and community</p>
            <h2 id="community-title">The circle is open.</h2>
          </header>
          <div class="community">
            <a class="card link-card" href="/docs">
              <span class="lc-k">Docs</span>
              <span class="lc-t">Player guide</span>
              <span class="lc-d">Walkthroughs for every screen, from first install to profiles.</span>
              <span class="lc-go" aria-hidden="true">→</span>
            </a>
            <a class="card link-card" href={brand.discord}>
              <span class="lc-k">Discord</span>
              <span class="lc-t">Ask the circle</span>
              <span class="lc-d">Help, bug reports and talk about new mods.</span>
              <span class="lc-go" aria-hidden="true">↗</span>
            </a>
            <a class="card link-card" href={brand.gamebanana}>
              <span class="lc-k">GameBanana</span>
              <span class="lc-t">Tool page</span>
              <span class="lc-d">Grimoire's listing, next to the mods it installs.</span>
              <span class="lc-go" aria-hidden="true">↗</span>
            </a>
            <a class="card link-card" href={brand.github}>
              <span class="lc-k">GitHub</span>
              <span class="lc-t">Source and releases</span>
              <span class="lc-d">Code, issues, every release and its notes.</span>
              <span class="lc-go" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="board">
          <a class="board-yes" href={winHref} aria-label="Yes: download Grimoire for Windows">
            <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="7" /><path d="M20 3v6M20 31v6M3 20h6M31 20h6M8 8l4 4M28 28l4 4M8 32l4-4M28 12l4-4" /></svg>
            YES
          </a>
          <a class="board-no" href={brand.github} aria-label="No: read the source first">
            NO
            <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M26 6a14 14 0 1 0 8 22A11 11 0 1 1 26 6Z" /></svg>
          </a>
          <svg class="board-letters" viewBox="0 0 1000 320" aria-hidden="true">
            <defs>
              <path id="arc-a" d="M140 175 Q500 -35 860 175" />
              <path id="arc-b" d="M70 305 Q500 75 930 305" />
            </defs>
            <text><textPath href="#arc-a" startOffset="50%" text-anchor="middle">A B C D E F G H I J K L M</textPath></text>
            <text><textPath href="#arc-b" startOffset="50%" text-anchor="middle">N O P Q R S T U V W X Y Z</textPath></text>
          </svg>
          <p class="board-nums" aria-hidden="true">1 2 3 4 5 6 7 8 9 0</p>
          <p class="board-bye">

---
import '../../styles/fonts.css';

const directions = [
  {
    slug: 'lodge',
    name: 'The Gilded Lodge',
    blurb: 'Art deco occult. Black lacquer, bone and brass, a sunburst behind the Locker.',
  },
  {
    slug: 'seance',
    name: 'Séance',
    blurb: 'A modern product site lit by a summoning circle. Soul light, glyph rings, spotlight cards.',
  },
  {
    slug: 'marquee',
    name: 'Midnight Marquee',
    blurb: 'A 1920s picture house on a city street. Chaser bulbs, letterboard, playbills, a ticket to download.',
  },
  {
    slug: 'arcana',
    name: 'Arcana Plate',
    blurb: 'Patent drawings drawn by an occultist. Cyanotype linework, annotated screenshots, the source up front.',
  },
  {
    slug: 'oss',
    name: 'Open Source',
    blurb: 'A plain project page in the Prism Launcher mold. The 1996 lodge survives as starfield, sparkles and webring badges.',
  },
  {
    slug: 'summon',
    name: 'Summoning',
    blurb: 'Open Source, with the logo brought to life: Locker hero cards whirl up out of the open book. Shuffle them, steer them, read every request the app makes.',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Grimoire prototypes</title>
  </head>
  <body>
    <main>
      <p class="kicker">design/prototypes</p>
      <h1>Six directions</h1>
      <ol>
        {directions.map((d) => (
          <li>
            <a href={`/proto/${d.slug}`}>
              <span class="name">{d.name}</span>
              <span class="blurb">{d.blurb}</span>
              <span class="path">/proto/{d.slug}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="note">Each one hides a small egg somewhere.</p>
    </main>
  </body>
</html>

<style>
  :global(html) {
    color-scheme: dark;
    background: #0f0f0f;
  }
  :global(body) {
    margin: 0;
    color: #f4f4f5;
    font: 16px/1.5 'JetBrains Mono', ui-monospace, monospace;
  }
  main {
    max-width: 44rem;
    margin: 0 auto;
    padding: 4rem 16px;
  }
  .kicker {
    color: #a1a1aa;
    font-size: 13px;
    margin: 0;
  }
  h1 {
    font-size: 2rem;
    margin: 0.25rem 0 2rem;
  }
  ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }
  a {
    display: grid;
    gap: 4px;
    padding: 18px 20px;
    border: 1px solid #2d2d2d;
    background: #1a1a1a;
    color: inherit;
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    border-color: #f97316;
    outline: none;
  }
  .name {
    font-weight: 700;
    font-size: 1.1rem;
  }
  .blurb {
    color: #a1a1aa;
    font-size: 14px;
  }
  .path {
    color: #f97316;
    font-size: 12px;
  }
  .note {
    color: #71717a;
    font-size: 13px;
    margin-top: 2rem;
  }
</style>

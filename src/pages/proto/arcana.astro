  }
  .arc-label {
    font: 500 12.5px var(--f-mono);
    fill: var(--amber-2);
    letter-spacing: 0.06em;
  }
  .spark {
    fill: var(--amber);
    filter: drop-shadow(0 0 6px rgba(249, 115, 22, 0.9));
  }

  .seal-base {
    fill: var(--ground);
    stroke: var(--ink);
    stroke-width: 1.4;
  }
  .seal-hatch {
    fill: url(#hatch);
  }
  .seal-line {
    fill: var(--ground);
    stroke: var(--ink);

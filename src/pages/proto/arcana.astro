</style>

<script>
  /* FIG. 1: hovering or focusing a station lights it on the plate and in the legend. */
  const stepEls = document.querySelectorAll<HTMLElement | SVGElement>('[data-step]');
  const lightStep = (n: string | null) =>
    stepEls.forEach((el) => el.classList.toggle('is-on', n !== null && (el as HTMLElement).dataset.step === n));
  stepEls.forEach((el) => {
    const n = (el as HTMLElement).dataset.step ?? null;
    el.addEventListener('pointerenter', () => lightStep(n));
    el.addEventListener('pointerleave', () => lightStep(null));
    el.addEventListener('focus', () => lightStep(n));
    el.addEventListener('blur', () => lightStep(null));
  });

  /* Callout figures: legend rows and bubbles light their leader and target. */
  document.querySelectorAll<HTMLElement>('[data-callouts]').forEach((fig) => {
    const parts = fig.querySelectorAll<HTMLElement | SVGElement>('[data-c]');
    const light = (id: string | null) =>
      parts.forEach((el) => el.classList.toggle('is-on', id !== null && (el as HTMLElement).dataset.c === id));
    fig.querySelectorAll<HTMLElement>('.legend li, .bub').forEach((el) => {
      el.addEventListener('pointerenter', () => light(el.dataset.c ?? null));
      el.addEventListener('pointerleave', () => light(null));
    });
  });

  /* Copy buttons. */
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
      } catch {
        const pre = btn.parentElement?.querySelector('pre');
        if (pre) {
          const range = document.createRange();
          range.selectNodeContents(pre);
          const sel = getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
          btn.textContent = 'Selected';
        }
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1600);
    });
  });

  /* The spark on FIG. 1 only runs while the plate is on screen and the tab is visible. */
  const plate = document.querySelector<SVGSVGElement>('.plate-svg');
  if (plate) {
    let onScreen = true;
    const sync = () => (onScreen && !document.hidden ? plate.unpauseAnimations() : plate.pauseAnimations());
    new IntersectionObserver((entries) => {
      onScreen = entries[0]?.isIntersecting ?? true;
      sync();
    }).observe(plate);
    document.addEventListener('visibilitychange', sync);
  }
</script>

  }
  .ring--thin {
    stroke-width: 0.8;
    stroke-opacity: 0.55;
  }
  .ticks {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    stroke-opacity: 0.8;
  }
  .star {
    fill: none;
    stroke: var(--wash);
    stroke-opacity: 0.55;
    stroke-width: 1;
    stroke-dasharray: 6 5;
  }
  .guide {
    fill: none;
    stroke: var(--wash);
    stroke-opacity: 0.5;

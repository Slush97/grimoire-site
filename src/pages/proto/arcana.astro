---
/*
 * Arcana Plate. Prototype direction: the site as a set of patent sheets
 * drawn by an occultist. Cyanotype ground, bone linework, Grimoire orange
 * for annotations and the one button that matters.
 */
import EasterEgg from '../../components/proto/EasterEgg.astro';
import { brand, getDownloadUrls, getReach, fmtBytes } from '../../data/content';

const dl = await getDownloadUrls();
const reach = await getReach();
const win = dl.windowsInstaller;
const portable = dl.windowsPortable;
const appImg = dl.linuxAppImage;
const version = dl.version ? `v${dl.version}` : 'latest';
const isoDate = dl.release?.published_at ? dl.release.published_at.slice(0, 10) : '';
const commas = (n: number) => n.toLocaleString('en-US');
const SHEETS = 6;

const readings = [
  reach.githubInstalls !== null && {
    src: 'GitHub',
    href: `${brand.github}/releases`,
    n: reach.githubInstalls,
    what: 'installer downloads',
    note: 1,
  },
  reach.gamebananaDownloads !== null && {
    src: 'GameBanana',
    href: brand.gamebanana,
    n: reach.gamebananaDownloads,
    what: 'listing downloads',
    note: 2,
  },
  reach.aptInstalls !== null && {
    src: 'apt',
    href: 'https://apt.grimoiremods.com',
    n: reach.aptInstalls,
    what: 'new machines',
    note: 3,
  },
].filter(Boolean) as { src: string; href: string; n: number; what: string; note: number }[];

/* FIG. 1 geometry. Center, flow radius, and one node every 72 degrees. */
const C = { x: 450, y: 360 };
const R = 200;
const rad = (d: number) => (d * Math.PI) / 180;
const pt = (deg: number, r: number) => ({
  x: +(C.x + r * Math.cos(rad(deg))).toFixed(2),
  y: +(C.y + r * Math.sin(rad(deg))).toFixed(2),
});

const steps = [
  {
    n: 'I',
    name: 'GameBanana',
    sub: 'browse the catalog',
    text: 'Search the GameBanana catalog from inside the app. One-click installs ride the gb1click:// link, and collections import by URL.',
  },
  {
    n: 'II',
    name: 'Queue + extract',
    sub: 'download queue',
    text: 'Downloads wait in a queue. ZIP, 7Z and RAR archives unpack on their own.',
  },
  {
    n: 'III',
    name: 'Conflict check',
    sub: 'before the match',
    text: 'Mods that overwrite the same game files get flagged. Several mods can merge into one VPK and come back apart.',
  },
  {
    n: 'IV',
    name: 'Load order',
    sub: 'you set it',
    text: 'Enable, disable, reorder. Save the set as a profile and share it as a short mp1: code.',
  },
  {
    n: 'V',
    name: 'Deadlock',
    sub: 'citadel/addons',
    text: 'Launch Modded from the sidebar. Launch Vanilla stashes your mods and puts them back once the game starts.',
  },
].map((s, i) => {
  const a = -90 + 72 * i;
  const p = pt(a, R);
  const lp = pt(a, 286);
  const c = Math.cos(rad(a));
  const anchor = c > 0.3 ? 'start' : c < -0.3 ? 'end' : 'middle';
  const dy = Math.sin(rad(a)) < -0.9 ? -14 : Math.sin(rad(a)) > 0.5 ? 10 : 0;
  return { ...s, a, p, lp, anchor, dy, i: i + 1 };
});

const TRIM = 13;
const arcs = steps.slice(0, 4).map((s) => {
  const a1 = s.a + TRIM;
  const a2 = s.a + 72 - TRIM;
  const p1 = pt(a1, R);
  const p2 = pt(a2, R);
  /* Arrowhead at the end of each arc, pointing along the clockwise tangent. */
  const t = rad(a2 + 90);
  const back = { x: p2.x - 12 * Math.cos(t), y: p2.y - 12 * Math.sin(t) };
  const nx = -Math.sin(t) * 5.5;
  const ny = Math.cos(t) * 5.5;
  const head = `M${p2.x} ${p2.y} L${(back.x + nx).toFixed(2)} ${(back.y + ny).toFixed(2)} L${(back.x - nx).toFixed(2)} ${(back.y - ny).toFixed(2)} Z`;
  return { d: `M${p1.x} ${p1.y} A${R} ${R} 0 0 1 ${p2.x} ${p2.y}`, head };
});
const closing = (() => {
  const p1 = pt(steps[4].a + TRIM, R);
  const p2 = pt(270 - TRIM, R);
  return `M${p1.x} ${p1.y} A${R} ${R} 0 0 1 ${p2.x} ${p2.y}`;
})();

/* Text that rides each arc. The bottom arc runs backwards so it reads upright. */
const arcText = ['gb1click://', 'zip · 7z · rar', 'same file twice? flagged', '#1 · #2 · #3 · #n'];
const arcTextPaths = steps.slice(0, 4).map((s, i) => {
  const a1 = s.a + 9;
  const a2 = s.a + 63;
  if (i === 2) {
    const r = 220;
    const p1 = pt(a2, r);
    const p2 = pt(a1, r);
    return `M${p1.x} ${p1.y} A${r} ${r} 0 0 0 ${p2.x} ${p2.y}`;
  }
  const r = 209;
  const p1 = pt(a1, r);
  const p2 = pt(a2, r);
  return `M${p1.x} ${p1.y} A${r} ${r} 0 0 1 ${p2.x} ${p2.y}`;
});

const spark = (() => {
  const p1 = pt(-90, R);
  const p2 = pt(198, R);
  return `M${p1.x} ${p1.y} A${R} ${R} 0 1 1 ${p2.x} ${p2.y}`;
})();

const star = [0, 2, 4, 1, 3].map((k) => steps[k].p);
const starPath = `M${star.map((p) => `${p.x} ${p.y}`).join(' L')} Z`;

let ticks = '';
for (let d = 0; d < 360; d += 5) {
  const r2 = d % 30 === 0 ? 268 : 258;
  const a = pt(d - 90, 250);
  const b = pt(d - 90, r2);
  ticks += `M${a.x} ${a.y} L${b.x} ${b.y} `;
}

/* Callout figures. Coordinates are pixels on the 1528x924 v1.30.1 captures. */
type Callout = { x: number; y: number; bx: number; by: number; t: string; d: string };
type Fig = {
  id: string;
  n: number;
  file: string;
  w: number;
  h: number;
  name: string;
  alt: string;
  callouts: Callout[];
};
const W = 1528;
const H = 924;

const fig2: Fig = {
  id: 'fig-2',
  n: 2,
  file: 'locker.webp',
  w: W,
  h: H,
  name: 'Locker, hero gallery',
  alt: 'The Locker: a gallery of hero cards with a General card first, favorites starred, and Shuffle on launch, Hide empty and Gallery or List controls in the header.',
  callouts: [
    { x: 330, y: 45, bx: 560, by: 45, t: 'Counts', d: 'The header counts heroes, skins and sounds you have.' },
    { x: 410, y: 300, bx: 180, by: 450, t: 'General', d: 'Cosmetics that belong to no hero: soul containers, hideout, icon packs, HUD, cursors.' },
    { x: 645, y: 113, bx: 760, by: 45, t: 'Favorites', d: 'Starred heroes sort to the front of the gallery.' },
    { x: 1148, y: 45, bx: 1150, by: 140, t: 'Shuffle on launch', d: 'Pick a pool of mods per hero. Each launch from Grimoire equips one of them.' },
    { x: 1420, y: 45, bx: 1420, by: 140, t: 'Gallery or list', d: 'Big cards, or a dense list when you know what you want.' },
  ],
};
const fig3: Fig = {
  id: 'fig-3',
  n: 3,
  file: 'locker-hero.webp',
  w: W,
  h: H,
  name: 'One hero, opened',
  alt: 'Celeste opened in the Locker: Skins, Sounds, Cards and Effects tabs on the left, five skin cards in a grid, and the hero art behind them.',
  callouts: [
    { x: 330, y: 165, bx: 500, by: 240, t: 'Four tabs', d: 'Skins, Sounds, Cards, Effects. Effects recolors ability VFX and is experimental.' },
    { x: 975, y: 258, bx: 1100, by: 258, t: 'Variants', d: 'One mod, several versions. Pick which one is on.' },
    { x: 1477, y: 33, bx: 1400, by: 112, t: '2D or 3D', d: 'Flip the preview to a live 3D pose of the hero.' },
    { x: 917, y: 730, bx: 917, by: 815, t: 'Browse more skins', d: 'Opens Browse to find more for this hero.' },
  ],
};
const fig4: Fig = {
  id: 'fig-4',
  n: 4,
  file: 'cursors.webp',
  w: W,
  h: H,
  name: 'Cursor mods',
  alt: 'The General section of the Locker with Cursors selected: Default, Kitty Paw, Wizard101, Gauntlet and an active Mask of Eternity cursor pack.',
  callouts: [
    { x: 312, y: 522, bx: 480, by: 700, t: 'Cursors', d: 'Cursor packs live under General, beside soul containers, hideout, icon packs and HUD.' },
    { x: 995, y: 335, bx: 1320, by: 400, t: 'One active', d: 'Click a pack to apply it. Restart Deadlock if it is running.' },
    { x: 1400, y: 41, bx: 1250, by: 175, t: 'Create or import', d: 'Import a pack from its images or an archive, or make one.' },
    { x: 685, y: 246, bx: 685, by: 335, t: 'Default', d: "Deadlock's own cursors, one click away." },
  ],
};
const fig5: Fig = {
  id: 'fig-5',
  n: 5,
  file: 'browse.webp',
  w: W,
  h: H,
  name: 'Browse',
  alt: 'Browse: a grid of GameBanana mods sorted by popularity, each card with likes, views and an Install button, plus Mods, Sounds and WiPs tabs.',
  callouts: [
    { x: 470, y: 39, bx: 590, by: 39, t: 'Search', d: 'The catalog is mirrored locally, so search answers as you type.' },
    { x: 1095, y: 39, bx: 1095, by: 140, t: 'Mods, Sounds, WiPs', d: 'Three shelves of the catalog. WiPs are works in progress.' },
    { x: 1292, y: 39, bx: 1340, by: 140, t: 'Sort', d: 'Popularity here. The dropdown holds the other orders.' },
    { x: 486, y: 334, bx: 486, by: 285, t: 'Install', d: 'One click. The archive unpacks on its own.' },
    { x: 330, y: 334, bx: 330, by: 373, t: 'Likes and views', d: "GameBanana's own numbers, on every card." },
  ],
};
const fig6: Fig = {
  id: 'fig-6',
  n: 6,
  file: 'browse-detail.webp',
  w: W,
  h: H,
  name: 'A mod, opened',
  alt: 'A mod window for Yamato redesign: two preview images, four variant files each with its own Install button, the artist, and the description.',
  callouts: [
    { x: 800, y: 183, bx: 1100, by: 183, t: 'Variant files', d: 'Some mods ship several versions. Each file installs on its own.' },
    { x: 1289, y: 202, bx: 1460, by: 260, t: 'Per-file install', d: 'Pick the version you want and install only that.' },
    { x: 1050, y: 77, bx: 1000, by: 135, t: 'History', d: 'Added and updated dates and the download count, from GameBanana.' },
    { x: 1260, y: 77, bx: 1240, by: 135, t: 'Hide mod', d: 'Not your thing? Hide it from Browse.' },
    { x: 1290, y: 604, bx: 1290, by: 682, t: 'Hide creator', d: 'Hide everything from one creator.' },
  ],
};
const fig7: Fig = {
  id: 'fig-7',
  n: 7,
  file: 'installed.webp',
  w: W,
  h: H,
  name: 'Installed',
  alt: 'Installed: twelve enabled mods numbered one to twelve with toggles, a profile switcher, and a Disabled group below.',
  callouts: [
    { x: 306, y: 158, bx: 205, by: 205, t: 'Load order', d: 'Enabled mods are numbered. Reorder them when two touch the same files.' },
    { x: 519, y: 339, bx: 571, by: 374, t: 'Toggle', d: 'On or off without deleting anything.' },
    { x: 330, y: 100, bx: 600, by: 100, t: 'Groups', d: 'Enabled up top, disabled below. Here, 12 on and 31 parked.' },
    { x: 1435, y: 101, bx: 1300, by: 100, t: 'Profile switcher', d: 'Swap the whole set in one move.' },
    { x: 519, y: 158, bx: 571, by: 122, t: 'Variants', d: '1/3 means the mod has three variants and one is active.' },
    { x: 115, y: 834, bx: 180, by: 720, t: 'Launch', d: 'Launch Modded, or switch to Vanilla. Vanilla stashes your mods and restores them once the game starts.' },
  ],
};

type Row = { kind: 'wide' | 'flip' | 'pair'; figs: Fig[] };
const sheets: {
  id: string;
  no: number;
  title: string;
  figs: string;
  lede: string;
  note?: string;
  rows: Row[];
}[] = [
  {
    id: 'locker',
    no: 2,
    title: 'The Locker',
    figs: 'Fig. 2, 3, 4',
    lede: 'Every hero gets a card. Skins, sounds, cards and effects sit behind it, and the General card holds the cosmetics that belong to no hero.',
    note: 'gold star = favorite',
    rows: [
      { kind: 'wide', figs: [fig2] },
      { kind: 'pair', figs: [fig3, fig4] },
    ],
  },
  {
    id: 'browse',
    no: 3,
    title: 'Browse and install',
    figs: 'Fig. 5, 6',
    lede: 'The GameBanana catalog, inside the app. Install from the card, or open a mod to pick the exact file you want.',
    note: 'hidden means gone from your Browse, nothing more',
    rows: [
      { kind: 'wide', figs: [fig5] },
      { kind: 'flip', figs: [fig6] },
    ],
  },
  {
    id: 'library',
    no: 4,
    title: 'Library and launch',
    figs: 'Fig. 7',
    lede: 'Everything you have installed, numbered in load order. Flip mods on and off, swap profiles, launch.',
    note: '12 on, 31 parked',
    rows: [{ kind: 'wide', figs: [fig7] }],
  },
];

const parts = [
  ['Conflicts', 'Flags mods that overwrite the same game files.', 'Sidebar'],
  ['VPK merge', 'Merges several mods into one VPK, and pulls single sources back out.', 'Installed'],
  ['Profiles', 'Saves and swaps sets of enabled mods. Shares them as mp1: codes or .modprofile.json files.', 'Sidebar'],
  ['Autoexec', 'Console commands that run when the game launches.', 'Sidebar'],
  ['Launch Vanilla', 'Stashes your mods for a clean game and restores them once it starts.', 'Sidebar'],
  ['Effects', "Recolors a hero's ability VFX: solid, gradient or rainbow. Experimental.", 'Locker'],
  ['Ability sounds', 'Picks one sound source per ability.', 'Locker'],
  ['Collection import', 'Imports a GameBanana collection by URL.', 'Browse'],
  ['Stats', 'MMR, match history and hero stats from deadlock-api.com. Opt in.', 'Sidebar'],
  ['Crosshair designer', 'Builds a crosshair with a live preview. Experimental, opt in.', 'Settings'],
];

const APT = [
  'sudo install -d -m 0755 /etc/apt/keyrings',
  'curl -fsSL https://apt.grimoiremods.com/grimoire.gpg | sudo tee /etc/apt/keyrings/grimoire.gpg >/dev/null',
  'echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/grimoire.gpg] https://apt.grimoiremods.com stable main" | sudo tee /etc/apt/sources.list.d/grimoire.list >/dev/null',
  'sudo apt update && sudo apt install grimoire',
].join('\n');
const AUR = 'yay -S grimoire-bin';
const APPIMAGE = appImg ? `chmod +x ${appImg.name} && ./${appImg.name}` : '';
const NIX = [
  '# flake.nix',
  'inputs.grimoire.url = "github:Slush97/grimoire";',
  '',
  'nixpkgs.overlays = [ inputs.grimoire.overlays.default ];',
  'environment.systemPackages = [ pkgs.grimoire ];',
].join('\n');

const stamps = [
  { a: 'MIT', b: 'licensed', tone: 'ink' },
  { a: 'No', b: 'telemetry', tone: 'amber' },
  { a: 'Offline', b: 'first', tone: 'line' },
  { a: 'AUR', b: 'grimoire-bin', tone: 'line', href: brand.aur },
  { a: 'GameBanana', b: 'tool 22583', tone: 'ink', href: brand.gamebanana },
  { a: 'GitHub', b: 'read the source', tone: 'amber', href: brand.github },
  { a: 'Discord', b: 'come say hi', tone: 'line', href: brand.discord },
  { a: 'Best viewed', b: 'at 1 : 1', tone: 'ink' },
  { a: 'Hand drawn', b: 'svg inside', tone: 'line' },
];

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Grimoire, Arcana Plate</title>
    <meta name="description" content="Grimoire is a free, open source mod manager for Deadlock." />
    <link rel="preload" href="/fonts/proto/unifrakturcook-700-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/proto/ibm-plex-sans-condensed-600-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>

    <header class="bar">
      <a class="bar-wm" href="#top" aria-label="Grimoire, back to top">Grimoire</a>
      <span class="bar-meta">Mod manager for Deadlock · Rev. {version}</span>
      <nav class="bar-nav" aria-label="Sheets">
        <a href="#sheet-1">Fig. 1</a>
        <a href="#sheet-locker">Locker</a>
        <a href="#sheet-browse">Browse</a>
        <a href="#sheet-library">Library</a>
        <a href="#sheet-spec">Spec</a>
        <a href="#sheet-source">Source</a>
        <a href="/docs">Docs</a>
      </nav>
      <a class="bar-cta" href={dl.primaryHref}>Download</a>
    </header>

    <main id="main" class="wrap">
      <!-- SHEET 1 -->
      <section class="plate plate--hero" id="sheet-1" aria-labelledby="h1">
        <div class="zones zones--top" aria-hidden="true">{[1, 2, 3, 4, 5, 6, 7, 8].map((z) => <span>{z}</span>)}</div>
        <div class="zones zones--bottom" aria-hidden="true">{[1, 2, 3, 4, 5, 6, 7, 8].map((z) => <span>{z}</span>)}</div>
        <div class="zones zones--left" aria-hidden="true">{['A', 'B', 'C', 'D'].map((z) => <span>{z}</span>)}</div>
        <div class="zones zones--right" aria-hidden="true">{['A', 'B', 'C', 'D'].map((z) => <span>{z}</span>)}</div>

        <div class="hero">
          <div class="hero-text">
            <p class="eyebrow">Sheet 1 of {SHEETS} · General arrangement</p>
            <h1 id="h1">
              <span class="wm">Grimoire</span>
              <span class="h1-sub">A mod manager for <em>Deadlock</em>.</span>
            </h1>
            <p class="lede">
              Browse GameBanana, install in one click, and catch conflicts before they crash a match. Then
              launch. Free, open source, and it phones home for nothing.
            </p>

            <div class="cta-row">
              <a class="cta" href={dl.primaryHref}>
                <svg class="cta-ico" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3v12m0 0-5-5m5 5 5-5M4 20h16" />
                </svg>
                <span class="cta-main">Download for Windows</span>
                <span class="cta-sub">
                  {win ? `${version} · installer · ${fmtBytes(win.size)}` : `${version} · all builds`}
                </span>
              </a>
              <div class="cta-alt">
                <a class="ghost" href="/download">Linux, Nix, more <span aria-hidden="true">→</span></a>
                <a class="ghost" href={brand.github}>Source on GitHub <span aria-hidden="true">→</span></a>
              </div>
            </div>
            <p class="req">Requires Deadlock installed through Steam.</p>

            <dl class="mini">
              <div><dt>License</dt><dd>MIT</dd></div>
              <div><dt>Telemetry</dt><dd>None</dd></div>
              <div><dt>Network</dt><dd>Offline-first</dd></div>
              <div><dt>Runs on</dt><dd>Windows · Linux</dd></div>
            </dl>

            {
              readings.length > 0 && (
                <p class="reach">
                  {readings.map((r, i) => (
                    <span>
                      {i > 0 && <span class="reach-sep" aria-hidden="true">/</span>}
                      <b>{commas(r.n)}</b> {r.what} from {r.src}
                      <sup>
                        <a href={`#note-${r.note}`} id={`ref-hero-${r.note}`} aria-label={`Note ${r.note}`}>
                          {r.note}
                        </a>
                      </sup>
                    </span>
                  ))}
                </p>
              )
            }
          </div>

          <figure class="fig1" data-fig1>
            <p class="hand hand--fig1" aria-hidden="true">
              everything after the download<br />happens on your machine
              <svg viewBox="0 0 120 70" class="hand-arrow">
                <path d="M4 8 C 40 4, 86 14, 104 52" />
                <path d="M94 46 L104 54 L108 41" />
              </svg>
            </p>
            <svg
              class="plate-svg"
              viewBox="0 0 900 720"
              role="img"
              aria-labelledby="fig1-title fig1-desc"
            >
              <title id="fig1-title">Figure 1: how a mod reaches the game</title>
              <desc id="fig1-desc">
                Five stations on a circle, joined by arrows: GameBanana, then the download queue and
                extraction, then the conflict check, then load order, then Deadlock. Grimoire sits in the
                center.
              </desc>
              <defs>
                <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                  <line class="hatch-line" x1="0" y1="0" x2="0" y2="7" />
                </pattern>
                <pattern id="hatch-amber" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                  <line class="hatch-line hatch-line--amber" x1="0" y1="0" x2="0" y2="7" />
                </pattern>
                <path id="seal-ring" d={`M${C.x - 94} ${C.y} a94 94 0 1 1 188 0 a94 94 0 1 1 -188 0`} />
                {arcTextPaths.map((d, i) => <path id={`arc-t-${i}`} d={d} />)}
              </defs>

              <g class="centerlines">
                <line class="cl draw-fade" style="--d:80" x1="30" y1={C.y} x2="870" y2={C.y} />
                <line class="cl draw-fade" style="--d:160" x1={C.x} y1="24" x2={C.x} y2="696" />
              </g>

              <circle class="ring draw" style="--d:0" cx={C.x} cy={C.y} r="250" pathLength="1" />
              <circle class="ring ring--thin draw" style="--d:120" cx={C.x} cy={C.y} r="274" pathLength="1" />
              <path class="ticks draw" style="--d:200" d={ticks} pathLength="1" />

              <path class="star draw-fade" style="--d:420" d={starPath} />
              <circle class="guide draw-fade" style="--d:480" cx={C.x} cy={C.y} r="76.4" />
              {
                steps.map((s) => {
                  const o = pt(s.a, 262);
                  return <line class="radial draw-fade" style="--d:520" x1={C.x} y1={C.y} x2={o.x} y2={o.y} />;
                })
              }

              <circle class="flow-ghost draw-fade" style="--d:600" cx={C.x} cy={C.y} r={R} />
              <path class="flow flow--closing draw-fade" style="--d:1500" d={closing} />
              {
                arcs.map((a, i) => (
                  <g>
                    <path class="flow draw" style={`--d:${760 + i * 240}`} d={a.d} pathLength="1" />
                    <path class="arrow draw-fade" style={`--d:${960 + i * 240}`} d={a.head} />
                  </g>
                ))
              }
              {
                arcText.map((t, i) => (
                  <text class="arc-label draw-fade" style={`--d:${1400 + i * 120}`}>
                    <textPath href={`#arc-t-${i}`} startOffset="50%" text-anchor="middle">
                      {t}
                    </textPath>
                  </text>
                ))
              }

              <circle class="spark" r="5" opacity="0">
                <animateMotion dur="6.5s" begin="2.6s" repeatCount="indefinite" path={spark} />
                <animate
                  attributeName="opacity"
                  values="0;1;1;0"
                  keyTimes="0;0.06;0.92;1"
                  dur="6.5s"
                  begin="2.6s"
                  repeatCount="indefinite"
                />
              </circle>

              <g class="seal draw-fade" style="--d:900">
                <circle class="seal-base" cx={C.x} cy={C.y} r="72" />
                <path
                  class="seal-hatch"
                  fill-rule="evenodd"
                  d={`M${C.x - 72} ${C.y} a72 72 0 1 0 144 0 a72 72 0 1 0 -144 0 Z M${C.x - 58} ${C.y} a58 58 0 1 0 116 0 a58 58 0 1 0 -116 0 Z`}
                />
                <circle class="seal-line" cx={C.x} cy={C.y} r="58" />
                <text class="seal-ring-text">
                  <textPath href="#seal-ring" textLength="584" lengthAdjust="spacing">
                    offline first ✦ no telemetry ✦ MIT licensed ✦ open source ✦
                  </textPath>
                </text>
                <path
                  class="seal-glyph"
                  d={`M${C.x} ${C.y - 40} l4 10 l10 4 l-10 4 l-4 10 l-4 -10 l-10 -4 l10 -4 Z`}
                />
                <text class="seal-wm" x={C.x} y={C.y + 14} text-anchor="middle">Grimoire</text>
                <text class="seal-sub" x={C.x} y={C.y + 34} text-anchor="middle">est. {brand.year}</text>
              </g>

              {
                steps.map((s) => (
                  <g
                    class="node"
                    data-step={s.i}
                    tabindex="0"
                    aria-label={`Step ${s.n}, ${s.name}: ${s.text}`}
                    style={`--d:${700 + s.i * 200}; --sweep:${2000 + s.i * 260}`}
                  >
                    <circle class="node-halo" cx={s.p.x} cy={s.p.y} r="42" />
                    <circle class="node-base" cx={s.p.x} cy={s.p.y} r="34" />
                    <circle class="node-hatch" cx={s.p.x} cy={s.p.y} r="34" />
                    <circle class="node-core" cx={s.p.x} cy={s.p.y} r="23" />
                    <text class="node-n" x={s.p.x} y={s.p.y + 7} text-anchor="middle">
                      {s.n}
                    </text>
                    <text class="lbl" x={s.lp.x} y={s.lp.y + s.dy} text-anchor={s.anchor}>
                      {s.name}
                    </text>
                    <text class="lbl-sub" x={s.lp.x} y={s.lp.y + s.dy + 20} text-anchor={s.anchor}>
                      {s.sub}
                    </text>
                  </g>
                ))
              }
            </svg>
            <figcaption class="fig1-cap">
              <span class="fig-no">Fig. 1</span>
              <span>How a mod reaches the game</span>
            </figcaption>
          </figure>
        </div>

        <div class="hero-foot">
          <ol class="steps" aria-label="Stations in figure 1">
            {
              steps.map((s) => (
                <li data-step={s.i}>
                  <span class="step-n">{s.n}</span>
                  <span class="step-name">{s.name}</span>
                  <span class="step-text">{s.text}</span>
                </li>
              ))
            }
          </ol>

          <div class="tblock-wrap">
            <p class="stamp" aria-hidden="true"><span>Inspected</span><b>No telemetry</b></p>
            <div class="tblock" role="group" aria-label="Title block">
              <div class="tb-title">
                <span class="tb-k">Title</span>
                <span class="tb-wm">Grimoire</span>
                <span class="tb-v">Mod manager for Deadlock</span>
              </div>
              <div class="tb-grid">
                <div><span class="tb-k">Drawn</span><span class="tb-v">Slush97</span></div>
                <div><span class="tb-k">License</span><span class="tb-v">MIT</span></div>
                <div><span class="tb-k">Rev.</span><span class="tb-v">{version}</span></div>
                <div><span class="tb-k">Date</span><span class="tb-v">{isoDate || 'n/a'}</span></div>
                <div><span class="tb-k">Sheet</span><span class="tb-v">1 of {SHEETS}</span></div>
                <div><span class="tb-k">Scale</span><span class="tb-v">1 : 1</span></div>
                <div class="tb-chk">
                  <span class="tb-k">Chk.</span>
                  <span class="egg-slot"><EasterEgg size={13} label="Checked by: a small egg" /></span>
                </div>
                <div>
                  <span class="tb-k">Proj.</span>
                  <svg class="proj" viewBox="0 0 54 20" aria-label="First angle projection symbol" role="img">
                    <path d="M2 6 L18 3 L18 17 L2 14 Z" />
                    <circle cx="38" cy="10" r="7" />
                    <circle cx="38" cy="10" r="3" />
                    <line x1="0" y1="10" x2="54" y2="10" class="proj-cl" />
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SHEETS 2 to 4 -->
      {
        sheets.map((s) => (
          <section class="plate" id={`sheet-${s.id}`} aria-labelledby={`h-${s.id}`}>
            <div class="zones zones--top" aria-hidden="true">{[1, 2, 3, 4, 5, 6, 7, 8].map((z) => <span>{z}</span>)}</div>
            <div class="zones zones--bottom" aria-hidden="true">{[1, 2, 3, 4, 5, 6, 7, 8].map((z) => <span>{z}</span>)}</div>
            <div class="zones zones--left" aria-hidden="true">{['A', 'B', 'C', 'D'].map((z) => <span>{z}</span>)}</div>
            <div class="zones zones--right" aria-hidden="true">{['A', 'B', 'C', 'D'].map((z) => <span>{z}</span>)}</div>

            <header class="strip">
              <span class="strip-k">Sheet {s.no} of {SHEETS}</span>
              <h2 id={`h-${s.id}`}>{s.title}</h2>
              <span class="strip-k strip-k--r">{s.figs}</span>
            </header>
            <div class="sheet-intro">
              <p class="sheet-lede">{s.lede}</p>
              {s.note && <p class="hand hand--sheet" aria-hidden="true">{s.note}</p>}
            </div>

            {s.rows.map((row) => (
              <div class:list={['row', `row--${row.kind}`]}>
                {row.figs.map((f) => (
                  <figure class="fig" id={f.id} data-callouts style={`--ar:${f.w} / ${f.h}`}>
                    <div class="fig-plate">
                      <div class="shot">
                        <img
                          src={`/proto/shots/${f.file}`}
                          width={f.w}
                          height={f.h}
                          alt={f.alt}
                          loading="lazy"
                          decoding="async"
                        />
                        <svg class="leaders" viewBox={`0 0 ${f.w} ${f.h}`} preserveAspectRatio="none" aria-hidden="true">
                          {f.callouts.map((c, i) => (
                            <line x1={c.x} y1={c.y} x2={c.bx} y2={c.by} data-c={`${f.id}-${i + 1}`} />
                          ))}
                        </svg>
                        {f.callouts.map((c, i) => (
                          <Fragment>
                            <span
                              class="tgt"
                              data-c={`${f.id}-${i + 1}`}
                              style={`--x:${pct(c.x, f.w)};--y:${pct(c.y, f.h)}`}
                            />
                            <span
                              class="bub"
                              data-c={`${f.id}-${i + 1}`}
                              style={`--x:${pct(c.x, f.w)};--y:${pct(c.y, f.h)};--bx:${pct(c.bx, f.w)};--by:${pct(c.by, f.h)}`}
                              aria-hidden="true"
                            >
                              {i + 1}
                            </span>
                          </Fragment>
                        ))}
                      </div>
                      <figcaption class="fig-cap">
                        <span class="fig-no">Fig. {f.n}</span>
                        <span class="fig-name">{f.name}</span>
                        <span class="fig-meta">
                          {f.file} · {f.w} × {f.h} · drawn from v1.30.1
                        </span>
                      </figcaption>
                    </div>
                    <ol class="legend" aria-label={`Callouts for figure ${f.n}`}>
                      {f.callouts.map((c, i) => (
                        <li data-c={`${f.id}-${i + 1}`}>
                          <span class="lg-n">{i + 1}</span>
                          <span class="lg-body">
                            <span class="lg-t">{c.t}</span>
                            <span class="lg-d">{c.d}</span>
                          </span>
                        </li>
                      ))}
                    </ol>
                  </figure>
                ))}
              </div>
            ))}

            {s.id === 'library' && (
              <div class="parts-wrap">
                <table class="parts">
                  <caption>
                    <span class="fig-no">Schedule</span> Parts not pictured
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Item</th>
                      <th scope="col">Part</th>
                      <th scope="col">What it does</th>
                      <th scope="col">Where</th>
                    </tr>
                  </thead>
                  <tbody>
                    {parts.map(([name, what, where], i) => (
                      <tr>
                        <td class="parts-n">{String(i + 1).padStart(2, '0')}</td>
                        <th scope="row">{name}</th>
                        <td>{what}</td>
                        <td class="parts-w">{where}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        ))
      }

      <!-- SHEET 5 -->
      <section class="plate" id="sheet-spec" aria-labelledby="h-spec">
        <div class="zones zones--top" aria-hidden="true">{[1, 2, 3, 4, 5, 6, 7, 8].map((z) => <span>{z}</span>)}</div>
        <div class="zones zones--bottom" aria-hidden="true">{[1, 2, 3, 4, 5, 6, 7, 8].map((z) => <span>{z}</span>)}</div>
        <div class="zones zones--left" aria-hidden="true">{['A', 'B', 'C', 'D'].map((z) => <span>{z}</span>)}</div>
        <div class="zones zones--right" aria-hidden="true">{['A', 'B', 'C', 'D'].map((z) => <span>{z}</span>)}</div>

        <header class="strip">
          <span class="strip-k">Sheet 5 of {SHEETS}</span>
          <h2 id="h-spec">Specification</h2>
          <span class="strip-k strip-k--r">Procedures A to E</span>
        </header>

        <div class="spec-grid">
          <div class="spec-col">
            <dl class="spec">
              <div><dt>Name</dt><dd>Grimoire</dd></div>
              <div><dt>Kind</dt><dd>Desktop mod manager for Deadlock</dd></div>
              <div>
                <dt>Release</dt>
                <dd>
                  <a href={dl.releaseUrl}>{version}</a>
                  {dl.releaseDate && <span>, {dl.releaseDate}</span>}
                </dd>
              </div>
              <div><dt>License</dt><dd>MIT</dd></div>
              <div>
                <dt>Telemetry</dt>
                <dd><b>None.</b> A fresh install phones home for nothing.</dd>
              </div>
              <div>
                <dt>Network</dt>
                <dd>Offline-first. It talks to GameBanana when you browse or install. Stats is opt in and reads deadlock-api.com.</dd>
              </div>
              <div><dt>Requires</dt><dd>Deadlock, installed through Steam</dd></div>
              <div><dt>Platforms</dt><dd>Windows, Linux</dd></div>
              <div>
                <dt>Packages</dt>
                <dd>Installer .exe{portable && ', portable .exe'}, AppImage, .deb, apt repo, AUR, Nix flake</dd>
              </div>
              <div><dt>Source</dt><dd><a href={brand.github}>github.com/Slush97/grimoire</a></dd></div>
              <div><dt>Guide</dt><dd><a href="/docs">grimoiremods.com/docs</a></dd></div>
            </dl>
            <p class="hand hand--spec" aria-hidden="true">read it twice. nothing phones home.</p>
          </div>

          <div class="procs">
            <section class="proc">
              <h3><span class="proc-k">Proc. A</span>Windows</h3>
              <ol class="proc-steps">
                <li>
                  Download the installer.
                  <a class="cta cta--sm" href={dl.primaryHref}>
                    <span class="cta-main">{win ? win.name : 'Grimoire for Windows'}</span>
                    <span class="cta-sub">{win ? fmtBytes(win.size) : 'all builds'}</span>
                  </a>
                </li>
                <li>Run it.</li>
              </ol>
              {
                portable && (
                  <p class="proc-note">
                    No installer wanted? <a href={portable.browser_download_url}>Portable build</a>, {fmtBytes(portable.size)}.
                  </p>
                )
              }
            </section>

            <section class="proc proc--wide">
              <h3><span class="proc-k">Proc. B</span>Debian and Ubuntu, through apt</h3>
              <div class="cmd">
                <pre><code>{APT}</code></pre>
                <button type="button" class="copy" data-copy={APT}>Copy</button>
              </div>
              <p class="proc-note">Afterwards <code>sudo apt upgrade</code> keeps it current.</p>
            </section>

            <section class="proc">
              <h3><span class="proc-k">Proc. C</span>Arch Linux, AUR</h3>
              <div class="cmd">
                <pre><code>{AUR}</code></pre>
                <button type="button" class="copy" data-copy={AUR}>Copy</button>
              </div>
            </section>

            <section class="proc">
              <h3><span class="proc-k">Proc. D</span>AppImage</h3>
              {
                appImg ? (
                  <div class="cmd">
                    <pre><code>{APPIMAGE}</code></pre>
                    <button type="button" class="copy" data-copy={APPIMAGE}>Copy</button>
                  </div>
                ) : (
                  <p class="proc-note"><a href={dl.releaseUrl}>Get it from the release page</a>.</p>
                )
              }
              {
                appImg && (
                  <p class="proc-note">
                    <a href={appImg.browser_download_url}>Download the AppImage</a>, {fmtBytes(appImg.size)}.
                  </p>
                )
              }
            </section>

            <section class="proc proc--wide">
              <h3><span class="proc-k">Proc. E</span>Nix and NixOS, flake</h3>
              <div class="cmd">
                <pre><code>{NIX}</code></pre>
                <button type="button" class="copy" data-copy={NIX}>Copy</button>
              </div>
              <p class="proc-note">Updates come through the flake, not the in-app updater.</p>
            </section>

            {
              dl.sha256Sums && (
                <p class="proc-note proc-sums">
                  Check your download against <a href={dl.sha256Sums.browser_download_url}>SHA256SUMS</a>.
                </p>
              )
            }
          </div>
        </div>
      </section>

      <!-- SHEET 6 -->
      <section class="plate" id="sheet-source" aria-labelledby="h-source">
        <div class="zones zones--top" aria-hidden="true">{[1, 2, 3, 4, 5, 6, 7, 8].map((z) => <span>{z}</span>)}</div>
        <div class="zones zones--bottom" aria-hidden="true">{[1, 2, 3, 4, 5, 6, 7, 8].map((z) => <span>{z}</span>)}</div>
        <div class="zones zones--left" aria-hidden="true">{['A', 'B', 'C', 'D'].map((z) => <span>{z}</span>)}</div>
        <div class="zones zones--right" aria-hidden="true">{['A', 'B', 'C', 'D'].map((z) => <span>{z}</span>)}</div>

        <header class="strip">
          <span class="strip-k">Sheet 6 of {SHEETS}</span>
          <h2 id="h-source">Source and notes</h2>
          <span class="strip-k strip-k--r">MIT</span>
        </header>
        <div class="sheet-intro">
          <p class="sheet-lede">The whole app is on GitHub under the MIT license. Read it, build it, send a patch.</p>
        </div>

        <div class="src-grid">
          <a class="src" href={brand.github}><span class="src-k">Repository</span><span class="src-v">Slush97/grimoire</span></a>
          <a class="src" href={`${brand.github}/releases`}><span class="src-k">Releases</span><span class="src-v">every build, every asset</span></a>
          <a class="src" href={`${brand.github}/blob/main/CHANGELOG.md`}><span class="src-k">Changelog</span><span class="src-v">CHANGELOG.md</span></a>
          <a class="src" href={`${brand.github}/blob/main/CONTRIBUTING.md`}><span class="src-k">Contributing</span><span class="src-v">CONTRIBUTING.md</span></a>
          <a class="src" href={`${brand.github}/issues`}><span class="src-k">Issues</span><span class="src-v">report a bug</span></a>
          <a class="src" href="/docs"><span class="src-k">Player guide</span><span class="src-v">/docs</span></a>
          <a class="src" href={brand.discord}><span class="src-k">Discord</span><span class="src-v">ask a person</span></a>
          <a class="src" href={brand.gamebanana}><span class="src-k">GameBanana</span><span class="src-v">tool 22583</span></a>
        </div>

        <div class="notes-grid">
          {
            readings.length > 0 && (
              <div class="readings">
                <h3 class="minor-h">Readings</h3>
                <p class="minor-p">Public counters other sites keep about Grimoire. Nothing is collected from anyone running it.</p>
                <table class="read-t">
                  <tbody>
                    {readings.map((r) => (
                      <tr>
                        <th scope="row"><a href={r.href}>{r.src}</a></th>
                        <td class="read-n">{commas(r.n)}</td>
                        <td>
                          {r.what}
                          <sup>
                            <a href={`#note-${r.note}`} aria-label={`Note ${r.note}`}>{r.note}</a>
                          </sup>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )
          }

          <div class="notes">
            <h3 class="minor-h">Notes</h3>
            <ol>
              <li id="note-1">
                Installer files across every GitHub release: .exe, .AppImage, .deb and the rest. Updater plumbing
                (latest.yml, .blockmap) is left out, because running copies fetch it on their own.
                {readings.some((r) => r.note === 1) && <a class="back" href="#ref-hero-1" aria-label="Back to text">↩</a>}
              </li>
              <li id="note-2">
                GameBanana counts downloads of its own listing, and some of those point at the same GitHub files.
                The two numbers overlap, so they are never added together.
                {readings.some((r) => r.note === 2) && <a class="back" href="#ref-hero-2" aria-label="Back to text">↩</a>}
              </li>
              <li id="note-3">
                apt counts a new machine fetching the repo signing key, once. Upgrades do not count.
                {readings.some((r) => r.note === 3) && <a class="back" href="#ref-hero-3" aria-label="Back to text">↩</a>}
              </li>
            </ol>
            <h3 class="minor-h">Errata</h3>
            <p class="minor-p">
              Earlier editions of this site showed screenshots from v1.9.2. Every figure on these sheets is drawn
              from v1.30.1.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <ul class="stamps" aria-label="Badges">
        {
          stamps.map((s, i) => (
            <li style={`--r:${[-2, 1.5, -1, 2, -1.5, 1, -2.5, 1.5, -0.5][i]}deg`}>
              {s.href ? (
                <a class:list={['s88', `s88--${s.tone}`]} href={s.href}>
                  <span class="s88-a">{s.a}</span>
                  <span class="s88-b">{s.b}</span>
                </a>
              ) : (
                <span class:list={['s88', `s88--${s.tone}`]}>
                  <span class="s88-a">{s.a}</span>
                  <span class="s88-b">{s.b}</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
      <p class="foot-line">
        <span><span class="foot-wm">Grimoire</span> · {brand.year} · Slush97</span>
        <span>Fan-made and open source. Not affiliated with Valve.</span>
        <span class="foot-links">
          <a href="/download">Download</a>
          <a href="/docs">Docs</a>
          <a href="/tools">Tools</a>
        </span>
      </p>
    </footer>
  </body>
</html>


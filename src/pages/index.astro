---
/*
 * The museum page. Six era stages, descending backward through time:
 *   1. FUGAZI     2024 SaaS lie
 *   2. AERO       2004-2013 glossy aqua
 *   3. WIN95      1995-1999 desktop chrome
 *   4. GEOCITIES  1996-2001 amateur web
 *   5. GRIMOIRE   timeless parchment (the real brand)
 *   6. TERMINAL   final form, man-page, real install
 *
 * Every stage receives the same DownloadUrls so its in-character CTA
 * resolves to a real GitHub release asset.
 */
import Museum from '../layouts/Museum.astro';
import Fugazi from '../components/stages/Fugazi.astro';
import Aero from '../components/stages/Aero.astro';
import Win95 from '../components/stages/Win95.astro';
import Geocities from '../components/stages/Geocities.astro';
import Grimoire from '../components/stages/Grimoire.astro';
import Terminal from '../components/stages/Terminal.astro';

import FugaziToAero from '../components/transitions/FugaziToAero.astro';
import AeroToWin95 from '../components/transitions/AeroToWin95.astro';
import Win95ToGeocities from '../components/transitions/Win95ToGeocities.astro';
import GeocitiesToGrimoire from '../components/transitions/GeocitiesToGrimoire.astro';
import GrimoireToTerminal from '../components/transitions/GrimoireToTerminal.astro';

import { getDownloadUrls } from '../data/content';

const dl = await getDownloadUrls();
---

<Museum>
  <Fugazi {...dl} />
  <FugaziToAero />
  <Aero {...dl} />
  <AeroToWin95 />
  <Win95 {...dl} />
  <Win95ToGeocities />
  <Geocities {...dl} />
  <GeocitiesToGrimoire />
  <Grimoire {...dl} />
  <GrimoireToTerminal />
  <Terminal {...dl} />
</Museum>

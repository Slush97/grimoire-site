---
import Base from '../layouts/Base.astro';
import Doodle from '../components/Doodle.astro';

const githubUrl = 'https://github.com/Slush97/grimoire';
const discordUrl = 'https://discord.gg/KgYGHEMq2P';
const gameBananaUrl = 'https://gamebanana.com/tools/22583';

const features = [
  {
    title: 'Browse the GameBanana catalog',
    body:
      "GameBanana's full Deadlock library, mirrored locally and searchable in milliseconds. One-click install via gb1click:// straight from the site.",
    image: '/screenshots/browse.png',
    alt: 'Grimoire browsing Deadlock mods from GameBanana',
  },
  {
    title: 'Manage your library',
    body:
      'Toggle, reorder, prioritize. Catch overlapping VPK paths before they crash a match.',
    image: '/screenshots/installed.png',
    alt: 'Installed mods view with toggle and reorder controls',
  },
  {
    title: 'Hero Locker',
    body:
      'One active skin per hero, picked from every variant you have installed. The rest stay on disk, ready to swap.',
    image: '/screenshots/locker.png',
    alt: 'Hero Locker grid showing every Deadlock hero with their active skin',
    image2: '/screenshots/locker2.png',
    alt2: 'Per-hero skin picker showing every installed variant for Yamato',
  },
  {
    title: 'Profiles',
    body:
      'Save full mod loadouts and switch between them in one click. Profiles export as short mp1: codes for sharing, or as .modprofile.json files if a link feels too sketchy.',
    image: '/screenshots/profiles.png',
    alt: 'Profiles view with two saved mod configurations',
  },
];

const extras = [
  { title: 'Crosshair designer', body: 'Live preview, saved presets, and direct apply to your autoexec.' },
  { title: 'Autoexec manager', body: 'Edit console commands without leaving the app.' },
  { title: 'Conflict detection', body: 'Find overlapping VPK paths between mods.' },
  { title: 'Player stats', body: 'MMR, match history, hero stats, leaderboards.' },
];
---

<Base>
  <main class="relative z-10">
    <section class="relative overflow-hidden">
      <div class="relative mx-auto max-w-6xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-20">
        <div
          class="pointer-events-none absolute right-4 top-1/2 z-10 hidden -translate-y-1/2 lg:block"
          aria-hidden="true"
        >
          <div class="candle">
            <span class="glow"></span>
            <span class="flame"></span>
            <span class="wick"></span>
            <span class="drip"></span>
            <span class="body"></span>
            <span class="puddle"></span>
          </div>
        </div>

        <div class="relative max-w-4xl">
          <span class="kicker">An open-source spellbook</span>
          <h1 class="font-display mt-6 text-5xl leading-[1.05] text-white sm:text-7xl">
            A mod manager<br />bound for <em>Deadlock</em>.
          </h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-muted">
            Summon the full GameBanana catalog: indexed locally so search is
            instant, and install is one click. From there Grimoire handles your
            library, your crosshair, and as many mod loadouts as you want bound
            to the book.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a href="/download" class="btn-win95 btn-win95--lg btn-win95--accent">Download Grimoire</a>
            <a href={githubUrl} target="_blank" rel="noopener" class="btn-win95 btn-win95--lg">
              View on GitHub
            </a>
            <span class="text-xs text-muted">Windows + Linux. MIT. <span class="blink" aria-hidden="true">▸</span></span>
          </div>

          <div class="mt-14 hidden max-w-2xl items-start gap-10 lg:flex" aria-hidden="true">
            <span class="marginalia">vide: gb1click protocol. one click pulls the VPK, the manifest, and the icon. no folder spelunking.</span>
            <span class="marginalia marginalia--right" style="max-width: 220px;">profiles export as short mp1: codes. share like a sigil.</span>
          </div>
        </div>
      </div>

      <div class="mx-auto mt-6 max-w-6xl px-6">
        <div class="glyph-rule" aria-hidden="true">
          <span class="glyph-rule-text">✦ ⚝ ☥ ⚝ ✦</span>
        </div>
      </div>
    </section>

    <section class="relative mx-auto max-w-6xl px-6 pb-28">
      <div class="hero-shot relative">
        <div
          class="overflow-hidden rounded-xl border border-border bg-surface"
        >
          <img
            src="/screenshots/browse.png"
            alt="The Grimoire app showing the GameBanana browse view with a grid of Deadlock mods"
            width="1920"
            height="1080"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="block w-full"
          />
        </div>
        <div
          class="pointer-events-none absolute -top-6 right-6 z-10 hidden sm:block"
          aria-hidden="true"
        >
          <span class="stamp">Bound by the Order of Slush · mmxxvi</span>
        </div>
      </div>
    </section>

    <section id="features" class="relative mx-auto max-w-6xl overflow-hidden px-6 pb-28">
      <span class="kicker">What it does</span>
      <h2 class="font-display mt-4 text-4xl text-white sm:text-5xl">All in one cursed window.</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Browsing, installing, organizing, profile-swapping: in the app, not across
        five browser tabs and a folder you forgot about.
      </p>

      <div class="mt-14 grid gap-16 sm:gap-20">
        {
          features.map((f, i) => (
            <div
              class={`grid items-center gap-8 lg:grid-cols-2 lg:gap-14 ${
                i % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''
              }`}
            >
              <div>
                <h3 class="font-display text-3xl text-white sm:text-4xl">
                  {f.title}
                </h3>
                <p class="mt-3 text-muted">{f.body}</p>
              </div>
              {f.image2 ? (
                <button
                  type="button"
                  class="stack-wrap group"
                  data-stack
                  aria-label={`Cycle through ${f.title} views`}
                >
                  <div class="stack-card" data-stack-card style="--i:0">
                    <img
                      src={f.image}
                      alt={f.alt}
                      width="1600"
                      height="1000"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="stack-card" data-stack-card style="--i:1">
                    <img
                      src={f.image2}
                      alt={f.alt2}
                      width="1600"
                      height="1000"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <span class="stack-counter" data-stack-counter>1 / 2</span>
                </button>
              ) : (
                <div class="overflow-hidden rounded-lg border border-border bg-surface">
                  <img
                    src={f.image}
                    alt={f.alt}
                    width="1600"
                    height="1000"
                    loading="lazy"
                    decoding="async"
                    class="block w-full"
                  />
                </div>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section class="relative mx-auto max-w-6xl px-6 pb-28">
      <div class="mb-10 glyph-rule" aria-hidden="true">
        <span class="glyph-rule-text">❉ ✶ ⚜ ✶ ❉</span>
      </div>
      <div class="color-block color-block-loud font-fun relative sm:p-10">
        <div class="absolute -top-8 right-6 hidden sm:block" aria-hidden="true">
          <Doodle name="chaos-star" size={80} opacity={0.85} color="#ff9ad5" spin />
        </div>
        <div class="absolute -bottom-6 -left-4 hidden sm:block" aria-hidden="true">
          <Doodle name="ouroboros" size={90} rotate={14} opacity={0.7} color="#7dd3fc" />
        </div>
        <div class="absolute top-6 left-6 hidden sm:block" aria-hidden="true">
          <Doodle name="sparkle" size={36} opacity={0.9} color="#fde047" />
        </div>
        <div class="relative">
          <span class="inline-block rounded bg-fuchsia-500/40 px-2 py-0.5 text-xs font-bold uppercase tracking-widest text-fuchsia-50">
            ★ Side spells ★
          </span>
          <h2 class="font-fun mt-3 text-3xl font-bold text-white sm:text-4xl">
            Other incantations on the shelf
          </h2>
          <p class="font-fun mt-2 max-w-2xl text-base text-white/85">
            stuff that ships in the box. extras for the obsessed.
          </p>
          <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
              extras.map((x) => (
                <div class="rounded-lg border border-white/20 bg-black/30 p-5 backdrop-blur-sm">
                  <div class="font-fun text-base font-bold text-white">{x.title}</div>
                  <div class="font-fun mt-1 text-sm text-white/80">{x.body}</div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="inline-marquee mt-8" aria-hidden="true">
          <div class="inline-marquee-track">
            <span>★ crosshair designer ★ autoexec manager ★ conflict detection ★ player stats ★ profile codes ★ hero locker ★ gb1click:// ★</span>
            <span>★ crosshair designer ★ autoexec manager ★ conflict detection ★ player stats ★ profile codes ★ hero locker ★ gb1click:// ★</span>
          </div>
        </div>
      </div>
    </section>

    <section class="relative mx-auto max-w-6xl overflow-hidden px-6 pb-28">
      <div class="mb-10 glyph-rule" aria-hidden="true">
        <span class="glyph-rule-text">⚝ ☉ ⚝ ☽ ⚝</span>
      </div>
      <div class="codex-entry relative flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
        <div class="relative">
          <h2 class="font-display text-3xl text-white sm:text-4xl">Ready to bind it to your PC?</h2>
          <p class="mt-2 text-muted">
            Windows, Linux (.AppImage / .deb), or Arch via the AUR.
          </p>
        </div>
        <a href="/download" class="btn-win95 btn-win95--accent relative">Go to downloads</a>
      </div>
    </section>

    <section class="relative mx-auto max-w-6xl px-6 pb-28">
      <div class="grid gap-5 sm:grid-cols-3">
        <a href={githubUrl} target="_blank" rel="noopener" class="codex-entry block group">
          <div class="relative">
            <div class="codex-entry-title">Open source</div>
            <div class="codex-entry-body">MIT licensed. Read the code, build from source, audit any release.</div>
            <div class="mt-3 font-sc text-[11px] tracking-[0.22em] uppercase text-paper opacity-70 group-hover:text-accent group-hover:opacity-100">github →</div>
          </div>
        </a>
        <a href={discordUrl} target="_blank" rel="noopener" class="codex-entry block group">
          <div class="relative">
            <div class="codex-entry-title">Discord</div>
            <div class="codex-entry-body">Help, mod recommendations, bug reports.</div>
            <div class="mt-3 font-sc text-[11px] tracking-[0.22em] uppercase text-paper opacity-70 group-hover:text-accent group-hover:opacity-100">discord.gg/KgYGHEMq2P →</div>
          </div>
        </a>
        <a href={gameBananaUrl} target="_blank" rel="noopener" class="codex-entry block group">
          <div class="relative">
            <div class="codex-entry-title">GameBanana</div>
            <div class="codex-entry-body">Listed under Deadlock tools. Same catalog, web-side.</div>
            <div class="mt-3 font-sc text-[11px] tracking-[0.22em] uppercase text-paper opacity-70 group-hover:text-accent group-hover:opacity-100">gamebanana/22583 →</div>
          </div>
        </a>
      </div>
    </section>
  </main>
</Base>

<script>
  for (const stack of document.querySelectorAll<HTMLElement>('[data-stack]')) {
    const cards = Array.from(stack.querySelectorAll<HTMLElement>('[data-stack-card]'));
    const counter = stack.querySelector<HTMLElement>('[data-stack-counter]');
    const total = cards.length;
    let active = 0;
    const update = () => {
      cards.forEach((card, idx) => {
        const offset = (idx - active + total) % total;
        card.style.setProperty('--i', String(offset));
      });
      if (counter) counter.textContent = `${active + 1} / ${total}`;
    };
    stack.addEventListener('click', () => {
      active = (active + 1) % total;
      update();
    });
    update();
  }
</script>

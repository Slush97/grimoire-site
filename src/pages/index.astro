---
/*
 * Index. Single-stage Geocities marketing page.
 *
 * The other era-museum stages and transitions still live in
 * src/components/stages/ and src/components/transitions/ but are no
 * longer mounted here. Re-enabling any of them is a single import +
 * render.
 */
import Museum from '../layouts/Museum.astro';
import Geocities from '../components/stages/Geocities.astro';

import { getDownloadUrls } from '../data/content';

const dl = await getDownloadUrls();
---

<Museum>
  <Geocities {...dl} />
</Museum>

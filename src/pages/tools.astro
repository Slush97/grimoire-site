---
/*
 * /tools : the open-source repo, the mp1 mod-profile spec, and vpkmerge.
 */
import Site from '../layouts/Site.astro';
import { brand } from '../data/content';

const VPKMERGE_REPO = 'https://github.com/Slush97/vpkmerge';
const VPKMERGE_RELEASES = 'https://github.com/Slush97/vpkmerge/releases/latest';
const SPEC_DOC = `${brand.github}/blob/main/docs/profile-spec.md`;
const GB_ONECLICK = 'https://gamebanana.com/wikis/1999';

const tools = [
  {
    id: 'repo',
    kicker: 'Slush97/grimoire',
    title: 'The source',
    body: 'The desktop client, the docs and the issue tracker all live in one public repo. Electron and React on the desktop, better-sqlite3 underneath.',
    points: [
      ['MIT', 'Fork it, read it, ship your own. No login, no subscription.'],
      ['Works offline', 'Managing the mods you already have needs no internet. The docs list every request the app does make.'],
      ['1-Click', 'The Grimoire button on a GameBanana mod page downloads, scans, extracts and registers the mod.'],
    ],
    code: null,
    links: [
      { href: brand.github, label: 'View on GitHub', icon: 'github', primary: true },
      { href: GB_ONECLICK, label: 'GameBanana 1-Click wiki' },
    ],
  },
  {
    id: 'spec',
    kicker: 'mp1',
    title: 'The mod profile spec',
    body: 'A mod profile is a whole loadout: every mod, in priority order, with its settings. The mp1 format makes one portable and readable by any tool, not only Grimoire.',
    points: [
      ['Share codes', 'mp1:<base64url(gzip(json))>. A 30-mod profile fits in 1 to 2 KB, small enough to paste in a Discord message.'],
      ['Files', 'Or save it as .modprofile.json (proposed MIME application/vnd.modprofile+json). Readable and diffable.'],
      ['Open', 'Game and manager agnostic. The spec is public, with resolution rules, a conformance checklist and security notes.'],
      ['v1.1', 'Grimoire layers optional extensions on top (crosshair, autoexec) without breaking other readers.'],
    ],
    code: 'mp1:H4sIAAAA...<gzipped json>',
    links: [{ href: SPEC_DOC, label: 'Read the spec', primary: true }],
  },
  {
    id: 'vpkmerge',
    kicker: 'Rust',
    title: 'vpkmerge',
    body: 'Combines a pile of .vpk files into one, or splits one back into many. Deadlock mounts roughly 100 mod VPKs at most, so pre-merging lets you run a stack the engine would otherwise refuse.',
    points: [
      ['CLI and GUI', 'A command-line binary and a desktop app with drag and drop, reorderable priority, and a conflict resolver with Source 2 texture previews.'],
      ['Collisions', 'LastWins (the default), FirstWins, or Error (--strict) to refuse to merge on any conflict.'],
      ['Library', 'The vpkmerge-core crate: inspect(), detect_conflicts(), merge(), split(). Reads chunked VPKs transparently.'],
    ],
    code: 'vpkmerge out_dir.vpk mod1_dir.vpk mod2_dir.vpk --verbose',
    links: [
      { href: VPKMERGE_RELEASES, label: 'Download binaries', primary: true },
      { href: VPKMERGE_REPO, label: 'Source', icon: 'github' },
    ],
  },
];
---

<Site
  title="Tools and Specs · Grimoire Deadlock Mod Manager"
  description="The Grimoire open-source repo, the mp1 portable mod-profile spec, and vpkmerge: the VPK merging tool for Deadlock modding."
>
  <header class="wrap page-head">
    <p class="kicker">Tools</p>
    <h1>The toolbox</h1>
    <p>
      Everything Grimoire is built on is open: the code, the format for trading mod loadouts,
      and the companion tool that gets around Deadlock's mod limit.
    </p>
  </header>

  <div class="sheet">
    {tools.map((t) => (
      <section class="wrap tool" id={t.id} aria-labelledby={`${t.id}-h`}>
        <div class="tool-head">
          <p class="kicker">{t.kicker}</p>
          <h2 id={`${t.id}-h`}>{t.title}</h2>
          <p class="body">{t.body}</p>
          <div class="cta">
            {t.links.map((l) => (
              <a class:list={['btn', l.primary ? 'btn-accent' : 'btn-ghost']} href={l.href}>
                {l.icon && <svg width="18" height="18" aria-hidden="true"><use href={`#i-${l.icon}`} /></svg>}
                {l.label}
              </a>
            ))}
          </div>
        </div>
        <div class="tool-detail">
          <dl class="points panel">
            {t.points.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
          {t.code && <pre><code>{t.code}</code></pre>}
        </div>
      </section>
    ))}
  </div>
</Site>

<style>
  .sheet {
    padding: 72px 0 96px;
  }
  .tool {
    display: grid;
    grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    scroll-margin-top: 88px;
  }
  .tool + .tool {
    margin-top: 112px;
  }
  .tool-head h2 {
    margin-bottom: 14px;
  }
  .body {
    margin: 0 0 24px;
    color: var(--body);
  }
  .points {
    margin: 0;
  }
  .points div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 20px;
    padding: 18px 22px;
  }
  .points div + div {
    border-top: 1px solid var(--line);
  }
  .points dt {
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
  }
  .points dd {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }
  .tool-detail pre {
    margin: 12px 0 0;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    font-size: 13px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  @media (max-width: 960px) {
    .tool {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
  @media (max-width: 719px) {
    .sheet {
      padding: 48px 0 64px;
    }
    .tool + .tool {
      margin-top: 72px;
    }
    .points div {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>

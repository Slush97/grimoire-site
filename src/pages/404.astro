---
/*
 * 404 : prerenders to /404.html, which the Worker serves for any route that
 * matches neither a page nor an asset.
 */
import Site from '../layouts/Site.astro';
import { brand } from '../data/content';
---

<Site title="404 · Grimoire" description="This page doesn't exist.">
  <section class="wrap nf">
    <p class="code" aria-hidden="true">404</p>
    <h1>This page was never written</h1>
    <p>
      The link may be old, or the page moved. Guide pages live under <a href="/docs">/docs</a>.
      If a link on this site brought you here, tell us on <a href={brand.discord}>Discord</a>.
    </p>
    <div class="cta">
      <a class="btn btn-accent btn-lg" href="/">Back to the homepage</a>
      <a class="btn btn-ghost btn-lg" href="/download">Download Grimoire</a>
    </div>
  </section>
</Site>

<style>
  .nf {
    max-width: 720px;
    padding-top: 120px;
    padding-bottom: 160px;
    text-align: center;
  }
  .code {
    margin: 0;
    color: var(--line-strong);
    font: 600 160px/0.9 'Cormorant Garamond', Georgia, serif;
  }
  h1 {
    margin: 8px 0 16px;
    font: 600 48px/1.05 'Cormorant Garamond', Georgia, serif;
  }
  p {
    margin: 0 0 32px;
    color: var(--body);
  }
  p a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(167, 139, 250, 0.4);
  }
  .cta {
    justify-content: center;
  }
  @media (max-width: 719px) {
    .nf {
      padding-top: 72px;
      padding-bottom: 96px;
    }
    .code {
      font-size: 112px;
    }
    h1 {
      font-size: 38px;
    }
  }
</style>

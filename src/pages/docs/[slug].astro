---
/*
 * /docs/<slug> : one player-guide page, rendered from the synced markdown in
 * src/content/docs/. The slug comes from front matter and is a contract: the
 * app's in-app Help links point at grimoiremods.com/docs/<slug>, so routes
 * here must never be renamed unilaterally (see docs/guide/STYLE.md in the
 * app repo). The markdown carries its own H1.
 */
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { getDocSections } from '../../data/docs';

export async function getStaticPaths() {
  const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
  return docs.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: { entry, prev: docs[i - 1] ?? null, next: docs[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const sections = await getDocSections();
const updated = entry.data.updated.toISOString().slice(0, 10);
const section = sections.find((s) => s.pages.some((p) => p.data.slug === entry.data.slug));
---

<Site title={`${entry.data.title} · Grimoire Guide`} description={entry.data.description}>
  <div class="wrap docs">
    <nav class="side" aria-label="Guide pages">
      <a class="side-home" href="/docs">All docs</a>
      {sections.map((s) => (
        <div class="side-group">
          <p>{s.title}</p>
          <ul>
            {s.pages.map((p) => (
              <li>
                <a href={`/docs/${p.data.slug}`} aria-current={p.data.slug === entry.data.slug ? 'page' : undefined}>
                  {p.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <article class="doc">
      <p class="crumb">
        <a href="/docs">Docs</a>
        {section && <span>{section.title}</span>}
      </p>
      <div class="prose">
        <Content />
      </div>
      <p class="updated">Updated {updated}</p>

      {(prev || next) && (
        <nav class="pager" aria-label="Previous and next page">
          {prev ? (
            <a href={`/docs/${prev.data.slug}`}>
              <span>Previous</span>
              <strong>{prev.data.title}</strong>
            </a>
          ) : <span />}
          {next && (
            <a class="next" href={`/docs/${next.data.slug}`}>
              <span>Next</span>
              <strong>{next.data.title}</strong>
            </a>
          )}
        </nav>
      )}
    </article>
  </div>
</Site>

<style>
  .docs {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 64px;
    padding-top: 48px;
    padding-bottom: 96px;
  }
  .side {
    position: sticky;
    top: 88px;
    align-self: start;
    max-height: calc(100vh - 112px);
    overflow-y: auto;
    padding-right: 8px;
    font-size: 14px;
    scrollbar-width: thin;
  }
  .side-home {
    display: block;
    margin-bottom: 20px;
    color: var(--text);
    font-weight: 600;
  }
  .side-group + .side-group {
    margin-top: 20px;
  }
  .side-group p {
    margin: 0 0 6px;
    color: var(--dim);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .side ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .side li a {
    display: block;
    margin-left: -1px;
    padding: 4px 0 4px 14px;
    border-left: 1px solid transparent;
    color: var(--muted);
    line-height: 1.45;
  }
  .side li a:hover {
    color: var(--text);
  }
  .side li a[aria-current='page'] {
    border-left-color: var(--accent-soft);
    color: var(--text);
    font-weight: 600;
  }
  .doc {
    max-width: 760px;
  }
  .crumb {
    display: flex;
    gap: 10px;
    margin: 0 0 12px;
    color: var(--dim);
    font-size: 14px;
  }
  .crumb a {
    color: var(--muted);
  }
  .crumb span::before {
    content: '/';
    margin-right: 10px;
  }
  .updated {
    margin: 48px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font-size: 14px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 24px;
  }
  .pager a {
    display: grid;
    gap: 2px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    transition: border-color 0.15s, background-color 0.15s;
  }
  .pager a:hover {
    border-color: var(--line-strong);
    background: var(--surface-hi);
  }
  .pager span {
    color: var(--dim);
    font-size: 13px;
  }
  .pager strong {
    color: var(--text);
    font-weight: 600;
  }
  .pager .next {
    text-align: right;
  }
  @media (max-width: 960px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-top: 32px;
    }
    .side {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      text-align: left;
    }
  }
</style>
